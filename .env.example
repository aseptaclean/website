# Public configuration. Copy approved values from the authority files; keep this
# committed example blank.
PUBLIC_SITE_URL=
PUBLIC_BUSINESS_NAME=
PUBLIC_LEGAL_NAME=
PUBLIC_EMAIL=
PUBLIC_SERVICE_AREA=
PUBLIC_SERVICE_COUNTY=
PUBLIC_RESPONSE_TIME=
PUBLIC_ASSESSMENT_FEE=
PUBLIC_STARTING_PRICE=
PUBLIC_RESIDENCE_STARTING_PRICE=
PUBLIC_FOUNDER_NAME=
PUBLIC_TSWMP_STATUS=
PUBLIC_BUSINESS_HOURS=
PUBLIC_PHONE=
PUBLIC_SMS_NUMBER=
PUBLIC_FORM_ENDPOINT=
PUBLIC_PRIVACY_CONTACT=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_TERMLY_PRIVACY_URL=
PUBLIC_TERMLY_TERMS_URL=
PUBLIC_TERMLY_COOKIE_POLICY_URL=
PUBLIC_TERMLY_WEBSITE_UUID=
PUBLIC_TERMLY_PRIVACY_POLICY_ID=
PUBLIC_TERMLY_TERMS_POLICY_ID=
PUBLIC_TERMLY_COOKIE_POLICY_ID=
PUBLIC_TERMLY_CONSENT_ENABLED=

# Optional; unsupported claims and links are suppressed when empty
PUBLIC_INSURANCE_STATUS=
PUBLIC_GBP_URL=
PUBLIC_LOGO_URL=
PUBLIC_LOGO_REVERSED_URL=
PUBLIC_SITE_ICON_URL=
PUBLIC_GA_ID=
PUBLIC_GTM_ID=

# Use "production" only for the public site. Other values add noindex.
PUBLIC_DEPLOYMENT_ENV=
PUBLIC_LAUNCH_MODE=
PUBLIC_FORM_ENABLED=

# Cloudflare bindings (configure in the Cloudflare dashboard or wrangler).
# LEAD_UPLOADS is a private R2 bucket and LEAD_RATE_LIMIT is an optional KV namespace.
LEAD_UPLOADS=
LEAD_RATE_LIMIT=

# Server-only secrets. Never prefix these with PUBLIC_.
TURNSTILE_SECRET_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
OWNER_ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_ALERT_PHONE=

---
// 2026-08-18 visual port. docs/mockups .stages / .stage — five equal columns under a 2px navy
// rule, numeral over heading over body over a ruled record caption. Replaces the FINAL-v2
// stacked list rail. Copy is doc 27 §9.8 via homepage.handoffStages; stage 02 carries §9.15.2
// amendment 2 (recorded at the data source, src/data/site.ts).
//
// The mechanism name is Scope → Protect → Clear → Reset → Verify. The retired
// Assess → Define → Authorize → Clear → Document sequence is dead (AGENTS.md §7).
import { homepage } from "@data/site";
---

<section class="ac-sec" id="standards" aria-labelledby="standard-title">
  <div class="ac-shell">
    <div class="ac-sec__head">
      <p class="ac-label">Five-stage standard</p>
      <h2 id="standard-title" class="ac-type-h2">
        One company stays accountable from the first decision to final closeout.
      </h2>
    </div>

    <ol class="ac-stages">
      {homepage.handoffStages.map((stage, index) => (
        <li class="ac-stage">
          <b>{String(index + 1).padStart(2, "0")}</b>
          <h3 class="ac-type-h3">{stage.name}</h3>
          <p>{stage.detail}</p>
          <em>{stage.record}</em>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The mockup's .stages children are <div>s; these are <li>s inside an <ol> so the sequence
     is in the markup, not only in the numerals. Both list affordances are reset here. */
  .ac-stages {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ac-stage {
    max-width: none;
  }
</style>

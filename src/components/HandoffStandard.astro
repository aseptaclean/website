---
// docs/aseptaclean-FINAL-v2.html STAGES section — ported verbatim (05-DECISIONS-LOG.md).
import { homepage } from "@data/site";
---

<section class="stage-section" id="standards" aria-labelledby="standard-title">
  <div class="ac-measure-wide">
    <div class="stage-head">
      <p class="ac-eyebrow">Five-stage standard</p>
      <h2 id="standard-title" class="ac-type-h2">One company stays accountable from the first decision to the final closeout</h2>
    </div>
    <ol class="stages">
      {
        homepage.handoffStages.map((stage, index) => (
          <li class="stage">
            <span class="stage__n">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="ac-type-h3">{stage.name}</h3>
              <p class="ac-type-body">{stage.detail}</p>
            </div>
            <span class="stage__rec">{stage.record}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .stage-section {
    background: var(--ac-color-paper);
  }

  .stage-head {
    margin-bottom: var(--ac-s5);
  }

  .stage-head h2 {
    max-width: 24ch;
    line-height: 1.08;
  }

  .stages {
    border-top: 2px solid var(--ac-color-navy-900);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: st;
  }

  .stage {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: start;
    gap: var(--ac-s3);
    border-bottom: 1px solid var(--ac-color-line);
    padding-block: var(--ac-s3);
  }

  .stage__n {
    color: var(--ac-color-ink-400);
    font-family: var(--ac-font-mono);
    font-size: 1.05rem;
  }

  .stage h3 {
    margin-bottom: 5px;
  }

  .stage p {
    max-width: 62ch;
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }

  .stage__rec {
    margin-top: 6px;
    border: 1px solid var(--ac-color-line);
    border-radius: 5px;
    background: var(--ac-color-blue-ghost);
    padding: 6px 10px;
    color: var(--ac-color-blue-deep);
    font-family: var(--ac-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .stage {
      grid-template-columns: 44px 1fr;
    }

    .stage__rec {
      grid-column: 2;
    }
  }
</style>

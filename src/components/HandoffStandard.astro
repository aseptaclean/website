---
import { homepage } from "@data/site";
---

<section class="standard" id="standards" aria-labelledby="standard-title">
  <div class="ac-measure-wide">
    <header class="standard__header">
      <p class="ac-eyebrow">Five-stage standard</p>
      <h2 id="standard-title" class="ac-type-h2">One company stays accountable from the first decision to the final closeout</h2>
      <p class="ac-type-body">
        You should not have to coordinate a hauler, a cleaner, disposal, access,
        family approvals, and a final walkthrough just to get one property
        finished. The Aseptaclean Five-Stage Handoff Standard keeps the work in
        one defined path.
      </p>
    </header>

    <ol class="standard__stages">
      {
        homepage.handoffStages.map((stage, index) => (
          <li>
            <span class="standard__number">{String(index + 1).padStart(2, "0")}</span>
            <div class="standard__content">
              <h3 class="ac-type-h3">{stage.name}</h3>
              <p class="ac-type-body">{stage.detail}</p>
              <small class="standard__record ac-type-xs">Record: {stage.record}</small>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .standard {
    background: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-open);
    padding-bottom: 0;
  }

  .standard__header {
    display: grid;
    gap: var(--ac-space-4);
    max-width: 48rem;
  }

  h2 {
    max-width: 22ch;
  }

  .standard__header > p.ac-type-body {
    max-width: 38rem;
  }

  .standard__stages {
    display: grid;
    gap: 0;
    margin: var(--ac-space-8) 0 0;
    border-top: 2px solid var(--ac-color-navy-900);
    padding: 0;
    list-style: none;
  }

  .standard__stages li {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(3.5rem, 22%) 1fr;
    gap: var(--ac-space-4);
    border-bottom: 1px solid var(--ac-color-rule);
    padding-block: var(--ac-space-6);
  }

  .standard__number {
    color: var(--ac-color-steel-200);
    font-family: var(--ac-font-display);
    font-size: var(--ac-text-h3);
    font-weight: 500;
  }

  .standard__content h3,
  .standard__content p {
    margin: 0;
  }

  .standard__content p {
    margin-top: var(--ac-space-2);
    color: var(--ac-color-ink-500);
  }

  .standard__record {
    display: block;
    margin-top: var(--ac-space-3);
    color: var(--ac-color-navy-800);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

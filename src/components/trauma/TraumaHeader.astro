---
import { site } from '@data/site';
import ServiceDisclosure from '@components/ServiceDisclosure.astro';
import TraumaIcon from './TraumaIcon.astro';
// Current owner instruction preserves existing destinations, including About and Contact.
const links = [
 {label:'What We Clean', href:'#trauma-scope'}, {label:'Our Process', href:'#trauma-process'},
 {label:'Service Area', href:'#trauma-area'}, {label:'FAQs', href:'#trauma-faq'}, {label:'Contact', href:'#trauma-contact'}
];
---
<div class="utility"><div class="wrap"><span>Specialty property cleanup · South Bay &amp; Peninsula</span><span>Available 7 AM–7 PM</span></div></div>
<header class="trauma-kit-header">
 <div class="wrap navrow">
  <a class="brand" href="/" aria-label="Aseptaclean — home"><img src={site.business.logoUrl} width="900" height="215" alt="Aseptaclean" /></a>
  <nav aria-label="Main navigation">
   <div class="service-nav"><ServiceDisclosure id="trauma-desktop" /></div>
   {links.map(link => <a href={link.href}>{link.label}</a>)}
  </nav>
  <a class="navcall" href={site.business.phoneUri}>Call {site.business.phone}</a>
  <details class="menu mobilemenu" data-trauma-menu><summary aria-label="Open navigation"><TraumaIcon name="menu" /></summary><div class="dropdown">
   <ServiceDisclosure id="trauma-mobile" mobile />
   {links.map(link => <a href={link.href}>{link.label}</a>)}
   <a href="/about/">About</a><a href="#trauma-contact">Request an Assessment</a><a href={site.business.phoneUri}>Call {site.business.phone}</a>
  </div></details>
 </div>
</header>
<script>
 const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-trauma-menu]')];
 for (const menu of menus) {
  const trigger=menu.querySelector('summary');
  const sync=()=>trigger?.setAttribute('aria-expanded',String(menu.open));
  sync(); menu.addEventListener('toggle',sync);
  menu.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;trigger?.focus();}});
  menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
  menu.addEventListener('focusout',event=>{if(!menu.contains(event.relatedTarget as Node))menu.open=false;});
 }
 document.addEventListener('click',event=>{for(const menu of menus)if(!menu.contains(event.target as Node))menu.open=false;});
</script>

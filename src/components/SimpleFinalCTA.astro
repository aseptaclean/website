---
// SimpleFinalCTA — full-width deep-navy, centered final CTA band: heading, short supporting
// copy, primary CTA, optional secondary text link / phone.
//
// FinalCTA.astro is the homepage's image-led close (two-column, "Used by `/` only" per its own
// header comment). ServicesClose.astro and every gold-standard service page's own *-close
// section are likewise two-column by deliberate design choice (see this session's component
// audit). None of them is the plain centered pattern this spec calls for, so this is a new,
// separately-named component rather than a rewrite of any of those already-shipped sections.
interface Props {
  heading: string;
  headingId?: string;
  lede?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { heading, headingId, lede, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="ac-simple-final-cta" aria-labelledby={headingId}>
  <div class="ac-simple-final-cta__inner">
    <h2 id={headingId} class="ac-type-h2-final">{heading}</h2>
    {lede && <p class="ac-simple-final-cta__lede">{lede}</p>}

    <div class="ac-simple-final-cta__actions">
      <a class="ac-simple-final-cta__primary" href={primaryHref}>{primaryLabel}</a>
      {secondaryLabel && secondaryHref && (
        <a class="ac-simple-final-cta__secondary" href={secondaryHref}>{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .ac-simple-final-cta {
    background: var(--ac-color-navy-950);
    color: var(--ac-color-paper);
    padding-block: 88px;
    text-align: center;
  }

  .ac-simple-final-cta__inner {
    width: min(100% - 64px, 720px);
    margin-inline: auto;
  }

  .ac-simple-final-cta__inner h2 {
    color: var(--ac-color-paper);
  }

  .ac-simple-final-cta__lede {
    margin: 20px 0 0;
    color: var(--ac-color-steel-on-navy);
    font-size: var(--ac-text-lead);
    line-height: 1.6;
  }

  .ac-simple-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 28px;
    margin-top: 34px;
  }

  .ac-simple-final-cta__primary {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--ac-color-paper);
    padding-inline: 30px;
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .ac-simple-final-cta__primary:hover {
    background: var(--ac-color-blue-pale);
  }

  .ac-simple-final-cta__primary:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 4px;
  }

  .ac-simple-final-cta__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .ac-simple-final-cta__secondary:hover {
    color: var(--ac-color-blue-pale);
  }

  @media (max-width: 760px) {
    .ac-simple-final-cta {
      padding-block: 64px;
    }

    .ac-simple-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .ac-simple-final-cta__primary {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-simple-final-cta__primary {
      transition: none;
    }
  }
</style>

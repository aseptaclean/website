---
// Question set per docs/aseptaclean-BUILD-EXACT-v3-STANDALONE.md §9 HOME 11 — owner-directed
// 2026-09-04 ("follow instructions" on the FAQ-content question; see docs/05-DECISIONS-LOG.md).
// Replaces the prior 8-question set (05-DECISIONS-LOG.md, superseded by this entry) with the v3
// spec's 6 questions, verbatim. index.astro's FAQPage JSON-LD reads this same list, so schema and
// visible copy cannot drift apart — required by docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6.1; the
// schema block in index.astro needed no separate edit since it derives from this array directly.
export const faqItems = [
  {
    question: "I do not know which service I need. What should I choose?",
    answer:
      "You do not have to choose one before contacting us. Send photos and tell us what is happening. We will help you determine which Aseptaclean service fits the property, if any."
  },
  {
    question: "Can I start by sending photos?",
    answer:
      "Yes. Photos are often the easiest place to start. Send wider photos of the affected rooms along with closer photos of the conditions you are concerned about. For more complicated properties, we may still recommend seeing the property in person."
  },
  {
    question: "Do I need to clean or move anything before you see the property?",
    answer:
      "Usually, no. We would rather understand the property in its actual condition. If something needs to be moved before an assessment, we can tell you."
  },
  {
    question: "What happens if you find more than expected?",
    answer:
      "If we uncover a condition that materially changes the approved work, we explain what we found before additional work is performed. We do not want major scope changes to show up as a surprise after the fact."
  },
  {
    question: "How do you determine the price?",
    answer:
      "We look at the size, condition, access, contents, affected surfaces, waste, level of buildup, and amount of work required. For straightforward projects, photos may provide enough information to begin pricing. Larger or more complicated properties may need an on-site assessment."
  },
  {
    question: "What areas do you serve?",
    answer:
      "Aseptaclean serves the South Bay, Santa Clara County, the Peninsula, and selected surrounding Bay Area communities. Contact us with the property location and we will confirm whether it falls within our current service area."
  }
] as const;
---

{/* 2026-08-18 visual port. docs/mockups .faq — 2px navy rule over hairline-divided <details>,
    +/– affordance supplied by CSS (.ac-faq summary::after) rather than a span in the markup.
    Label and heading are §9.15.1's FAQ slots ("Common questions" / "Asked before almost every
    project."), which supersede both the mockup's wording and the FINAL-v2 strings here.
    Question set replaced 2026-09-04 — see faqItems above for the current source and rationale. */}
<section class="ac-sec faq" id="faq" aria-labelledby="faq-title">
  <div class="ac-shell">
    <div class="ac-sec__head">
      <p class="ac-label">Common questions</p>
      <h2 id="faq-title" class="ac-type-h2">Common questions before a project starts.</h2>
    </div>

    <div class="ac-faq">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Container only. Every rule the FAQ needs now lives in global.css (.ac-faq), because the
     same treatment appears on /faq/ and on all 14 service pages. */
  .faq {
    background: var(--ac-color-warm-white);
  }
</style>

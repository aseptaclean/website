---
import { homepage } from "@data/site";
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="ac-measure-read faq__layout">
    <header>
      <p class="ac-eyebrow">Before you request a plan</p>
      <h2 id="faq-title" class="ac-type-h2">Questions that affect scope, authority, and timing</h2>
      <p class="ac-type-body">
        These answers describe the assessment process. The signed scope controls
        the actual project.
      </p>
    </header>

    <div class="faq__list">
      {
        homepage.faq.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <h3 class="ac-type-h3">{item.question}</h3>
              <span class="faq__toggle" aria-hidden="true" />
            </summary>
            <p class="ac-type-body">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-tight);
    padding-bottom: 0;
  }

  .faq__layout {
    display: grid;
    gap: var(--ac-space-6);
  }

  h2 {
    max-width: 20ch;
    margin-top: var(--ac-space-3);
  }

  header > p.ac-type-body {
    max-width: 34rem;
    margin-top: var(--ac-space-4);
  }

  .faq__list {
    margin-top: var(--ac-space-6);
    border-top: 2px solid var(--ac-color-navy-900);
  }

  details {
    border-bottom: 1px solid var(--ac-color-rule);
  }

  summary {
    display: grid;
    min-height: 4rem;
    cursor: pointer;
    grid-template-columns: 1fr 1.5rem;
    align-items: center;
    gap: var(--ac-space-3);
    padding-block: var(--ac-space-4);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3,
  details p {
    margin: 0;
  }

  details p {
    max-width: 50rem;
    margin: 0 2rem var(--ac-space-5) 0;
    color: var(--ac-color-ink-500);
  }

  .faq__toggle {
    position: relative;
    width: 1rem;
    height: 1rem;
    justify-self: end;
  }

  .faq__toggle::before,
  .faq__toggle::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--ac-color-navy-800);
    content: "";
    transition: transform var(--ac-transition-fast);
  }

  .faq__toggle::after {
    transform: rotate(90deg);
  }

  details[open] .faq__toggle::after {
    transform: rotate(0);
  }

  summary:hover h3 {
    color: var(--ac-color-navy-800);
  }
</style>

---
// Question set per 05-DECISIONS-LOG.md (supersedes docs/06-APPROVED-HOMEPAGE-COPY.md's larger
// set for this section). index.astro's FAQPage JSON-LD reads this same list, so schema and
// visible copy cannot drift apart — required by docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6.1.
export const faqItems = [
  {
    question: "Can I approve the project remotely?",
    answer:
      "Yes, when access and decision authority are clear. Scope review, approvals, updates and closeout can be handled electronically."
  },
  {
    question: "Will you throw anything away without asking?",
    // doc 27 §9.15.2 amendment 1 (approved 2026-08-18) — replaces "Uncertain items are not
    // automatically discarded." Same sentence swap applied to §9.6 in WhyAseptaclean.astro.
    answer:
      "No. The scope identifies keep, remove and review areas. Anything we’re not sure about goes into a labeled clear bag and waits for your decision."
  },
  {
    question: "Do you handle animal or organic conditions?",
    answer:
      "Yes — cleaning of animal-affected and organic conditions is included under our organic pathogen endorsement, as cleaning within lawful scope. Cleaning only — not a decontamination, sterilization, or health-safety determination."
  },
  {
    question: "What happens if a specialist condition is discovered?",
    answer:
      "Work stops on that item. We document the condition and explain which qualified provider is needed before work continues."
  },
  {
    question: "What can change the price?",
    answer:
      "Concealed conditions or customer-requested additions that materially change the work — documented before work proceeds, never as a surprise invoice."
  },
  {
    question: "How quickly can the project begin?",
    answer:
      "Assessment requests are reviewed within one business day. Scheduling depends on scope, access, labor and the deadline."
  },
  {
    question: "Do you handle properties with heavy accumulation or hoarding conditions?",
    answer:
      "Yes, within our current lawful and insured operating scope. Heavy accumulation and whole-house cleanouts go through the same written-scope process as every project: keep, remove, and review areas are identified before work begins, and nothing is discarded automatically. Some conditions remain outside our current scope: human blood, bodily fluids, or regulated medical waste; sewage cleanup or active mold remediation; asbestos, lead, unknown chemicals, or hazardous materials; structural repair, construction, or demolition; pest extermination or chemical treatment; and appraisal, estate-sale, legal, or habitability determinations. If we observe one of these conditions, work in the affected area stops and you are notified before the project moves forward."
  }
] as const;
---

{/* 2026-08-18 visual port. docs/mockups .faq — 2px navy rule over hairline-divided <details>,
    +/– affordance supplied by CSS (.ac-faq summary::after) rather than a span in the markup.
    Label and heading are §9.15.1's FAQ slots ("Common questions" / "Asked before almost every
    project."), which supersede both the mockup's wording and the FINAL-v2 strings here.
    The seven-question set is unchanged — four are doc 27 §9.12, three have no doc 27
    counterpart and are carried forward per the 2026-08-16 entry in 05-DECISIONS-LOG.md. */}
<section class="ac-sec faq" id="faq" aria-labelledby="faq-title">
  <div class="ac-shell">
    <div class="ac-sec__head">
      <p class="ac-label">Common questions</p>
      <h2 id="faq-title" class="ac-type-h2">Asked before almost every project.</h2>
    </div>

    <div class="ac-faq">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Container only. Every rule the FAQ needs now lives in global.css (.ac-faq), because the
     same treatment appears on /faq/ and on all 14 service pages. */
  .faq {
    background: var(--ac-color-warm-white);
  }
</style>

---
// SERVICES HUB HERO — built 2026-08-26 to docs/30-WEBSITE-MASTER-SPEC.md §18 and §20A.7.
//
// DELIBERATELY NOT THE HOMEPAGE HERO WITH DIFFERENT WORDS. §16's page-family principle — one
// visual DNA, not one layout — and §20A.7's "do not assume every service hero must copy the
// centered homepage hero" both point the same way, so the two heroes differ on three axes:
//
//   `/`          centered copy · 600px · emotional situation headline · one CTA
//   `/services/` left-aligned  · 500px · a question the visitor is here to answer · CTA + phone
//
// The shared DNA is what stays: full-width photograph, ONE flat dark overlay, white rectangular
// primary button, no gradient, no badge, no floating card. §11 makes photography structural.
//
// SHORTER THAN THE HOMEPAGE HERO ON PURPOSE. This page's job is routing, and the chooser is the
// thing the visitor came for. A hub hero that fills the viewport puts the six doors below the
// fold on every laptop; 500px at 1440 leaves the first door visible, which is the whole point of
// §5.2's above-the-fold priority.
import { Image } from "astro:assets";
import heroImage from "../assets/homepage/service-development-cleanup-asurnipal.jpg";
import { servicesHub } from "@data/servicePages";
import { site } from "@data/site";

// TEMPORARY DEVELOPMENT REFERENCE PHOTOGRAPH — NOT Aseptaclean work, not a client property, and
// not proof of a completed job. `[ATMOS]`-class under docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6:
// no crew, no technician, no vehicle, no equipment and no work in progress, so nothing in the
// frame implies Aseptaclean performed anything.
//   service-development-cleanup-asurnipal.jpg
//     Asurnipal — CC BY-SA 4.0
//     https://commons.wikimedia.org/wiki/File:Bregenz-Cluttered_interiors_(compulsive_hoarding)-dining_room-06ASD.jpg
//
// REUSED FROM `/`, NOT NEWLY ADDED, AND THAT IS A CONSTRAINT RATHER THAN A PREFERENCE.
// docs/06-ASSET-MANIFEST.md §4 records the atmosphere-slot cap as already knowingly exceeded and
// says "do not add a fifth without a new owner decision", with two owner questions still open —
// including whether CC BY-SA attribution is acceptable on a commercial page at all. Sourcing new
// licensed photography for this page would deepen an unresolved question; reusing an asset the
// owner has already accepted as temporary does not. It carries a different role and a different
// crop here (full-bleed hero at 21:9 rather than a 4:3 side figure on `/`).
//
// Replace with owner-shot photography before launch (docs/06-ASSET-MANIFEST.md §5).

const phoneHref = site.business.phoneUri;
const { eyebrow, h1, lede } = servicesHub.hero;
---

<section class="svc-hero" aria-labelledby="svc-hero-title">
  <div class="svc-hero__media">
    {/* alt="" is deliberate and matches Hero.astro: the photograph is atmosphere behind the H1,
        which carries the meaning. A description here is read out before the headline for no gain. */}
    <Image
      src={heroImage}
      alt=""
      layout="full-width"
      widths={[480, 768, 1024, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={74}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="svc-hero__overlay" aria-hidden="true"></div>

  <div class="svc-hero__shell">
    <div class="svc-hero__content">
      <p class="svc-hero__eyebrow">{eyebrow}</p>
      <h1 id="svc-hero-title" class="ac-type-h1-hub">{h1}</h1>
      {/* Four short lines, not one paragraph. They are four separate recognitions and the
          visitor is meant to stop on the one that sounds like their property. */}
      <div class="svc-hero__lede">
        {lede.map((line) => <p>{line}</p>)}
      </div>
      <div class="svc-hero__actions">
        <a class="svc-hero__primary" href="/request-assessment/">Request an Assessment</a>
        {/* Suppression rule (AGENTS.md §3): never render an empty phone link. */}
        {phoneHref && (
          <a class="svc-hero__call" href={phoneHref}>Call {site.business.phone}</a>
        )}
      </div>
      <p class="svc-hero__note">
        Not sure which service you need? Send us photos and tell us what is happening.
      </p>
    </div>
  </div>

  <p class="svc-hero__development-note">
    Development reference photograph · not Aseptaclean project work
  </p>
</section>

<style>
  /* Sizes ride --ac-text-h1-hub rather than a font-size on the h1: AGENTS.md §6 law 1 requires a
     heading's computed size to resolve through its .ac-type-* role class. 46px at 1440 sits
     inside doc 30 §8.2's 42–52px desktop H1 band and one step under the homepage hero's 45px…
     which it deliberately does NOT undercut — the hub H1 is a shorter string, so the same optical
     weight needs slightly more size. */
  .svc-hero {
    --ac-text-h1-hub: 2.875rem;
    position: relative;
    min-height: 500px;
    overflow: hidden;
    padding: 0;
    background: var(--ac-color-navy-950);
  }

  .svc-hero__media,
  .svc-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .svc-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Pulled right of centre: the left third of this frame is the quietest area in it, which is
       where the left-aligned copy column lands. */
    object-position: 68% 52%;
  }

  /* ONE flat overlay. 0.52 rather than `/`'s 0.54 — this frame is darker to begin with, and the
     copy column only occupies the left half, so the photograph keeps more of itself on the right. */
  .svc-hero__overlay {
    z-index: 1;
    background: rgb(10 30 45 / 52%);
  }

  .svc-hero__shell {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100% - 64px, 1320px);
    min-height: inherit;
    align-items: center;
    margin-inline: auto;
    padding-block: 72px;
  }

  .svc-hero__content {
    max-width: 660px;
    color: var(--ac-color-paper);
  }

  .svc-hero__eyebrow {
    margin: 0 0 18px;
    max-width: none;
    color: rgb(255 255 255 / 76%);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .svc-hero__content h1 {
    /* .ac-type-h1-hub ships a 20ch cap, which breaks this six-word question across three lines
       in a column that has room for two. */
    max-width: 16ch;
    color: var(--ac-color-paper);
  }

  .svc-hero__lede {
    margin-top: 24px;
  }

  .svc-hero__lede p {
    max-width: 46ch;
    margin: 0;
    color: #e6edf5;
    font-size: 1.0625rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .svc-hero__lede p:last-child {
    margin-top: 12px;
    color: var(--ac-color-paper);
    font-weight: 600;
  }

  .svc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 32px;
    gap: 8px 26px;
  }

  .svc-hero__primary {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--ac-color-paper);
    padding-inline: 30px;
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .svc-hero__primary:hover {
    background: var(--ac-color-blue-pale);
  }

  .svc-hero__primary:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 4px;
  }

  /* Text link, not a second button — doc 30 §13.2's hierarchy. 44px keeps the touch target. */
  .svc-hero__call {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .svc-hero__call:hover {
    color: var(--ac-color-blue-pale);
  }

  .svc-hero__note {
    margin: 22px 0 0;
    max-width: 46ch;
    color: rgb(255 255 255 / 85%);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .svc-hero__call:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 3px;
  }

  .svc-hero__development-note {
    position: absolute;
    z-index: 2;
    right: 18px;
    bottom: 14px;
    left: 18px;
    /* Opts out of global.css's 62ch prose measure for the same reason Hero.astro does: at 10px
       the cap resolves to ~413px against a nowrap string that is wider, and the section's
       `overflow: hidden` would clip the last word off a compliance label. */
    max-width: none;
    white-space: nowrap;
    margin: 0;
    color: rgb(255 255 255 / 76%);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 70rem) {
    .svc-hero {
      --ac-text-h1-hub: 2.625rem;
      min-height: 470px;
    }

    .svc-hero__shell {
      width: min(100% - 52px, 1000px);
    }

    .svc-hero__content {
      max-width: 600px;
    }

    .svc-hero__media :global(img) {
      object-position: 62% 50%;
    }
  }

  @media (max-width: 50rem) {
    .svc-hero {
      --ac-text-h1-hub: 2.5rem;
      min-height: 460px;
    }

    .svc-hero__shell {
      width: calc(100% - 64px);
      padding-block: 60px;
    }

    .svc-hero__content {
      max-width: none;
    }

    .svc-hero__lede p {
      max-width: none;
      font-size: 1rem;
    }
  }

  @media (max-width: 30rem) {
    .svc-hero {
      --ac-text-h1-hub: 2.375rem;
      min-height: 500px;
    }

    /* The frame is 4:3 and the slot is roughly 3:4 here, so a centred crop throws away the
       quiet left wall the copy sits against. */
    .svc-hero__media :global(img) {
      object-position: 54% 46%;
    }

    .svc-hero__shell {
      width: calc(100% - 44px);
      padding-block: 52px 60px;
    }

    .svc-hero__content h1 {
      max-width: 14ch;
    }

    .svc-hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 4px;
      margin-top: 28px;
    }

    .svc-hero__primary {
      width: 100%;
    }

    .svc-hero__call {
      justify-content: center;
    }

    .svc-hero__development-note {
      right: 12px;
      bottom: 10px;
      left: 12px;
      font-size: 0.5625rem;
      white-space: normal;
      text-align: center;
    }
  }

  @media (max-width: 22.5rem) {
    .svc-hero {
      --ac-text-h1-hub: 2.1875rem;
    }

    .svc-hero__shell {
      width: calc(100% - 40px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-hero__primary {
      transition: none;
    }
  }
</style>

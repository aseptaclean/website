---
// HOW TO START + FINAL CTA — built 2026-08-26. §20A.20 lists these as jobs 07 and 09; they are
// one visual movement here because the four steps ARE the answer to the closing question, and a
// separate band between them would put a heading between "here is how this starts" and the
// button that starts it. §20A.6: adopt the jobs, do not automatically create a band per job.
//
// NO FORM ON THIS PAGE. The route this replaces embedded RequestForm — the full navy form band
// with a live QuickHandoffForm, Turnstile widget and consent block — on a hub whose job is
// routing. §20A.8's destination rule and the task brief both say the same thing: feed the
// existing assessment system, do not create separate lead infrastructure for the hub. So the
// close links to /request-assessment/ instead of instantiating a second form. That also removes
// the Turnstile console errors this page emitted at every width, since the widget no longer
// loads on a page nobody came here to submit from.
//
// NO QUERY PARAMETER IS INVENTED. §20A.8 sketches `/request-assessment/?service=<key>` and then
// says "do not invent query keys without inspecting the current form code." Inspected: the only
// parameter AssessmentForm reads is `offer=private-residence-reset`, which switches it into the
// residence branch. There is no `service` key and no general context key, so the link is the
// bare route. The assessment's own first questions already open on the property rather than on a
// service name, which is what the hub needs to hand off. Building the branch is a separate task.
//
// NOT THE HOMEPAGE CLOSE WITH DIFFERENT WORDS. FinalCTA.astro on `/` is a large photograph
// beside the copy on navy. This page has already spent three photographs above, and repeating
// that composition would make the last two pages a visitor sees the same shape. This close is
// typographic on navy: numbered sequence left, action right. Doc 30 §7.2's natural-rhythm check
// asks whether a major layout pattern repeats more than twice — this is the page's only navy
// band besides the hero, and the hero is image-led.
import { servicesHub } from "@data/servicePages";
import { site } from "@data/site";

const { start, close } = servicesHub;
const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
---

<section class="svc-close" aria-labelledby="svc-close-title">
  <div class="svc-close__inner">
    <div class="svc-close__steps">
      <p class="ac-eyebrow ac-eyebrow--on-dark">{start.eyebrow}</p>
      <h2 id="svc-close-title" class="ac-type-h2-home-feature">{start.heading}</h2>

      {/* An ordered list, because the order is the content. Large numerals on rules —
          §20A.14's "vertical numbered sequence… thin rules", not four rounded process cards. */}
      <ol class="steps">
        {start.steps.map((step, index) => (
          <li class="step">
            <span class="step__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="step__body">
              <b>{step.title}</b>
              <span>{step.detail}</span>
            </span>
          </li>
        ))}
      </ol>

      <a class="svc-close__method" href={start.methodLink.href}>
        {start.methodLink.label} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="svc-close__action">
      <h3 class="ac-type-h3-home-feature">{close.heading}</h3>
      <p class="svc-close__lede">{close.lede}</p>

      <div class="svc-close__actions">
        <a class="svc-close__primary" href="/request-assessment/">{site.offer.primaryCta}</a>
        {/* doc 27 §8 — the secondary door appears wherever the primary does. Both suppressed
            with the phone value they derive from (AGENTS.md §3: never render an empty phone
            link). This is also why the mobile bar can drop to two actions on this route: the
            text door still ships here, on the same page. */}
        <div class="svc-close__secondary">
          {phoneHref && <a href={phoneHref}>Call {site.business.phone}</a>}
          {smsHref && <a href={smsHref}>{site.offer.secondaryCta}</a>}
        </div>
      </div>

      {/* docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6's assessment disclaimer, kept with the CTA. */}
      <p class="svc-close__note">{close.note}</p>
    </div>
  </div>
</section>

<style>
  .svc-close {
    background: var(--ac-color-navy-950);
    padding-block: clamp(80px, 8vw, 116px);
  }

  .svc-close__inner {
    display: grid;
    width: min(100% - 64px, 1320px);
    align-items: start;
    margin-inline: auto;
    gap: 56px 88px;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  /* Token override, not a size on the heading — AGENTS.md §6 law 1. */
  .svc-close__steps {
    --ac-text-h2-home-feature: 2.25rem;
  }

  .svc-close__steps h2 {
    max-width: 20ch;
    margin-top: 12px;
    color: var(--ac-color-paper);
  }

  .steps {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    align-items: baseline;
    border-top: 1px solid rgb(255 255 255 / 16%);
    padding: 18px 0;
    gap: 4px 24px;
    grid-template-columns: auto minmax(0, 1fr);
    max-width: none;
  }

  .step:first-child {
    border-top-color: rgb(255 255 255 / 40%);
    border-top-width: 2px;
  }

  .step__index {
    color: var(--ac-color-steel-on-navy);
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .step__body b {
    display: block;
    color: var(--ac-color-paper);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .step__body > span {
    display: block;
    margin-top: 6px;
    max-width: 56ch;
    color: #ccd9e8;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .svc-close__method {
    /* inline-flex makes the label and the arrow flex items, which drops the whitespace
       text node between them. `gap` puts the space back. */
    gap: 0.4em;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 18px;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 5px;
  }

  .svc-close__method:hover {
    color: var(--ac-color-blue-pale);
    text-decoration: underline;
  }

  .svc-close__method:focus-visible,
  .svc-close__primary:focus-visible,
  .svc-close__secondary a:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 4px;
  }

  /* The action column sits on a rule rather than in a card: doc 30 §8.4 defaults to square and
     warns off generic card shadows, and a boxed panel here would be the "floating card" the
     brief rules out. */
  .svc-close__action {
    border-top: 2px solid rgb(255 255 255 / 40%);
    padding-top: 26px;
  }

  .svc-close__action h3 {
    max-width: 16ch;
    color: var(--ac-color-paper);
  }

  .svc-close__lede {
    margin: 18px 0 0;
    max-width: 46ch;
    color: #ccd9e8;
    font-size: 1.0625rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .svc-close__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 30px;
    gap: 14px 26px;
  }

  .svc-close__primary {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--ac-color-paper);
    padding-inline: 30px;
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .svc-close__primary:hover {
    background: var(--ac-color-blue-pale);
  }

  .svc-close__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
  }

  .svc-close__secondary a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .svc-close__secondary a:hover {
    color: var(--ac-color-blue-pale);
  }

  .svc-close__note {
    margin: 24px 0 0;
    max-width: 52ch;
    color: #7f96b4;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  @media (max-width: 64rem) {
    .svc-close__inner {
      width: min(100% - 52px, 1320px);
      gap: 44px 56px;
    }

    .svc-close__steps {
      --ac-text-h2-home-feature: 2.0625rem;
    }
  }

  @media (max-width: 50rem) {
    .svc-close__inner {
      gap: 44px;
      grid-template-columns: minmax(0, 1fr);
    }

    /* The action moves ABOVE the steps once the columns stack. On a phone the closing question
       is what the visitor scrolled this far to answer; making them read four steps first to
       reach the button is a desktop layout stacked, which §14 rules out. */
    .svc-close__action {
      order: -1;
    }

    .svc-close__steps h2,
    .svc-close__action h3 {
      max-width: 24ch;
    }

    .svc-close__lede,
    .step__body > span {
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .svc-close {
      padding-block: 68px;
    }

    .svc-close__inner {
      width: calc(100% - 40px);
    }

    .svc-close__steps {
      --ac-text-h2-home-feature: 1.875rem;
    }

    .svc-close__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 8px;
    }

    .svc-close__primary {
      width: 100%;
    }

    .svc-close__secondary {
      justify-content: center;
      gap: 4px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-close__primary {
      transition: none;
    }
  }
</style>

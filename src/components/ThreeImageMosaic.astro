---
// ThreeImageMosaic — three vertical photographs, second image offset down. Homepage reframe
// section only, per docs/aseptaclean-BUILD-EXACT-v3-STANDALONE.md §7.5 ("use no more than twice
// site-wide") and §9 HOME 03 ("mosaic left, copy right").
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface MosaicImage {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  images: readonly [MosaicImage, MosaicImage, MosaicImage];
}

const { images } = Astro.props;
---

<div class="ac-mosaic">
  {images.map((item) => (
    <figure class="ac-mosaic__item">
      <Image
        src={item.image}
        alt={item.alt}
        widths={[240, 360, 480]}
        sizes="(min-width: 850px) 16vw, 30vw"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
      />
    </figure>
  ))}
</div>

<style>
  .ac-mosaic {
    display: grid;
    min-height: 390px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .ac-mosaic__item {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
  }

  .ac-mosaic__item:nth-child(2) {
    transform: translateY(26px);
  }

  .ac-mosaic__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 850px) {
    .ac-mosaic {
      min-height: 300px;
    }

    .ac-mosaic__item:nth-child(2) {
      transform: none;
    }
  }

  @media (max-width: 40rem) {
    .ac-mosaic {
      min-height: 220px;
      gap: 8px;
    }
  }
</style>

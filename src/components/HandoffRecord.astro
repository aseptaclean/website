---
// 2026-08-18 visual port. docs/mockups .photoband / .rec — the overlay-card-on-photo-band with
// a flush bottom CTA bar (PORT-PROMPT §3). The card is pulled up over the photo band by a
// negative margin; the band itself is the labelled gray/navy photo slot per §5.
//
// Copy: the section label, heading, lede and CTA are §9.15.1's Handoff Record slots verbatim,
// which supersede the mockup's own wording ("The artifact" / "Every project closes with…") —
// §9.15 is copy source 4 in PORT-PROMPT §1, the mockups are visual source 3. Record facts and
// the room table are doc 27 §9.9; the closing note is §9.9's required disclaimer, read from
// legal.documentationDisclaimer so it stays single-sourced (AGENTS.md §3).
//
// "Sample · not a client record" is §9.9's REQUIRED label. It must never read as a real
// customer record (AGENTS.md §0.3).
import { homepage, legal } from "@data/site";

const record = homepage.sampleRecord;
---

<section class="ac-photoband" id="record" aria-labelledby="record-title">
  <div class="ac-photoband__img">
    <p class="ac-photoband__slot" aria-hidden="true">
      Photo slot<br />Completed property · closeout day<br />2000 × 900
    </p>
  </div>

  <div class="ac-shell">
    <div class="ac-rec">
      <div class="ac-rec__b">
        <p class="ac-label">The record</p>
        <h2 id="record-title" class="ac-type-h2-record">
          Every project ends with a Property Handoff Record in your hands.
        </h2>
        <p class="ac-rec__lede">
          A room-by-room account of what was decided, what left, what was cleaned, and what was
          held back for you.
        </p>

        <div class="ac-rec__meta">
          <span>Project <b>{record.projectId}</b></span>
          <span>Sample · not a client record</span>
          <span>Decision-maker <b>{record.decisionMaker}</b></span>
        </div>

        <table class="ac-table">
          <thead>
            <tr><th scope="col">Area</th><th scope="col">Decision</th><th scope="col">Note</th></tr>
          </thead>
          <tbody>
            {record.rooms.map((room) => (
              <tr>
                <td>{room.area}</td>
                <td>{room.disposition}</td>
                <td>{room.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="ac-rec__note">{legal.documentationDisclaimer}</p>

      <a class="ac-rec__cta" href="/handoff-standard/">
        See how a scope gets written <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

---
// docs/07-ONE-PAGE-DIRECTIVE.md §7 — inline, no wizard, no progress bar. Four fields as of
// 2026-09-06 (email added; see below). Appears in the hero (movement 1) and the final movement.
// One shared component so both instances stay identical instead of drifting.
//
// EMAIL ADDED 2026-09-06 (owner requirement: customer confirmation must be possible from every
// active form — this component is Form B, used by RequestForm.astro's ten pages and
// CityHero.astro). `email` joined functions/_lib/lead.ts's commonRequiredFields, so it is
// required here like every other active form on the site.
import { legal, site } from "@data/site";

interface Props {
  formId: string;
  entryRoute: string;
}

const { formId, entryRoute } = Astro.props;

const endpointAvailable = Boolean(
  site.integrations.formEnabled &&
    site.urls.formEndpoint &&
    site.integrations.turnstileSiteKey
);
---

<form
  id={formId}
  class="quick-form"
  method="post"
  action={endpointAvailable ? site.urls.formEndpoint : undefined}
  aria-label="Send Aseptaclean a message about the property"
  data-quick-form
  data-contact-phone={site.business.phone}
>
  <input type="hidden" name="offer_type" value="handoff_reset" />
  <input type="hidden" name="entry_route" value={entryRoute} />
  <input type="hidden" name="submitted_from" value={entryRoute} />
  <input type="hidden" name="submission_timestamp" value="" />
  <input type="hidden" name="idempotency_key" value="" />
  <input
    class="quick-form__honeypot"
    type="text"
    name="company_website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="quick-form__errors" tabindex="-1" role="alert" hidden data-quick-form-errors>
    <ul></ul>
  </div>

  <p class="quick-form__required-note ac-type-sm">
    Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">required</span> are required.
  </p>

  <div class="quick-form__field">
    <label for={`${formId}-name`}>Name <span aria-hidden="true">*</span></label>
    <input
      id={`${formId}-name`}
      name="full_name"
      type="text"
      autocomplete="name"
      required
    />
  </div>

  <div class="quick-form__field">
    <label for={`${formId}-phone`}>Phone <span aria-hidden="true">*</span></label>
    <input
      id={`${formId}-phone`}
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      required
    />
    <p class="quick-form__phone-note ac-type-xs">
      We call this number back — usually same business day.
    </p>
  </div>

  <div class="quick-form__field">
    <label for={`${formId}-email`}>Email <span aria-hidden="true">*</span></label>
    <input
      id={`${formId}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
    />
  </div>

  <div class="quick-form__field">
    <label for={`${formId}-detail`}>
      What are you looking at? <span class="quick-form__optional">(optional)</span>
    </label>
    {/* This short form does not send form_version, so the endpoint treats property_detail as
        optional. Keep the DOM contract aligned with the visible “(optional)” label. */}
    <textarea
      id={`${formId}-detail`}
      name="property_detail"
      rows="3"
      placeholder="A quick description of the property and what needs to happen."
    ></textarea>
  </div>

  <label class="quick-form__consent">
    <input type="checkbox" name="privacy_consent" value="yes" required />
    {/* legal.consentBase — the shared base statement, not a local copy. See src/data/site.ts:
        10DLC-relevant, pending owner/counsel. The explicit {" "} before the anchor is load-
        bearing: Astro trims a line-ending space, which renders "read thePrivacy Policy". */}
    <span>
      {legal.consentBase.lead}{" "}
      <a class="quick-form__link" href={site.urls.privacyPolicy}>
        {legal.consentBase.privacyLabel}
      </a>{legal.consentBase.tail}
    </span>
  </label>

  {
    site.integrations.turnstileSiteKey && (
      <div class="quick-form__turnstile">
        <div
          class="cf-turnstile"
          data-sitekey={site.integrations.turnstileSiteKey}
          data-theme="light"
          data-size="flexible"
        />
      </div>
    )
  }
  <noscript>
    <p class="quick-form__note">
      Security verification requires JavaScript. Please call Aseptaclean if
      you cannot enable it.
    </p>
  </noscript>

  {
    !endpointAvailable && (
      <p class="quick-form__note" role="status">
        Online submission is not fully configured in this preview. Your
        answers will not be sent.
      </p>
    )
  }

  <button
    class="button quick-form__submit"
    type="submit"
    disabled={!endpointAvailable}
    data-quick-form-submit
  >
    {/* OWNER DECISION 2026-09-04 (AGENTS.md §2.2.3): a form button submits the form and is
        labelled "Send Message". It is never a telephone link. This used to render
        site.offer.primaryCta, which the same decision repointed at the phone — so the label now
        comes from its own field, and the two can no longer be confused for one another. */}
    <span data-quick-form-submit-label>{site.offer.formSubmitCta}</span>
  </button>
  {/* doc 27 §18 "Submission clarification", shipped 2026-08-19; RESTATED by §8 "Directly under
      the submit button", owner-approved verbatim 2026-08-20. §18 read "This only starts the
      conversation. It does not book or authorize work." §8 is the same promise with the hedge
      out of the first clause and the second clause widened past "work".

      This does NOT replace the doc 21 §6 assessment disclaimer ("Submitting this form
      authorizes Aseptaclean to contact you. It does not authorize work or create a service
      agreement."), which is a claims-law requirement and still ships in FinalCTA and on
      /thank-you/. §8's line is the reassurance beside the button, not the legal clause. */}
  <p class="quick-form__clarification ac-type-xs">
    This starts a conversation. It does not book work or authorize anything.
  </p>
  {/* doc 27 §8 — the secondary CTA appears everywhere the primary does, and the submit button
      renders site.offer.primaryCta directly above this. */}
  {site.business.smsUri && (
    <p class="quick-form__secondary ac-type-xs">
      <a href={site.business.smsUri}>{site.offer.smsCta}</a>
    </p>
  )}
  <p
    class="quick-form__status"
    data-quick-form-status
    role="status"
    aria-live="polite"
    hidden
  ></p>
</form>

{
  site.integrations.turnstileSiteKey && (
    <script
      is:inline
      data-categories="essential"
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import { storeAcceptedInquiryReceipt } from "../scripts/acceptedInquiryReceipt";

  type FormControl = HTMLInputElement | HTMLTextAreaElement;

  document
    .querySelectorAll<HTMLFormElement>("[data-quick-form]")
    .forEach((form) => {
      if (form.dataset.enhanced === "true") return;
      form.dataset.enhanced = "true";
      form.noValidate = true;

      const errorBox = form.querySelector<HTMLElement>(
        "[data-quick-form-errors]"
      );
      const errorList = errorBox?.querySelector("ul");
      const statusEl = form.querySelector<HTMLElement>(
        "[data-quick-form-status]"
      );
      const submitButton = form.querySelector<HTMLButtonElement>(
        "[data-quick-form-submit]"
      );
      const submitLabel = form.querySelector<HTMLElement>(
        "[data-quick-form-submit-label]"
      );
      const defaultLabel = submitLabel?.textContent ?? "Submit";
      const timestampInput = form.elements.namedItem(
        "submission_timestamp"
      );
      const idempotencyInput = form.elements.namedItem("idempotency_key");

      if (idempotencyInput instanceof HTMLInputElement) {
        idempotencyInput.value =
          window.crypto?.randomUUID?.() ??
          `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      const resetTurnstile = () => {
        const turnstile = (
          window as Window & {
            turnstile?: { reset: (widget?: string | HTMLElement) => void };
          }
        ).turnstile;
        const widget = form.querySelector<HTMLElement>(".cf-turnstile");
        if (turnstile && widget) turnstile.reset(widget);
      };

      const clearFieldErrors = () => {
        form
          .querySelectorAll<HTMLElement>("[data-generated-error]")
          .forEach((el) => el.remove());
        form
          .querySelectorAll<FormControl>('[aria-invalid="true"]')
          .forEach((control) => control.removeAttribute("aria-invalid"));
      };

      const labelFor = (control: FormControl) => {
        const label = form.querySelector<HTMLLabelElement>(
          `label[for="${CSS.escape(control.id)}"]`
        );
        return label?.textContent?.replace("*", "").trim() ?? "Field";
      };

      // docs/27-SECTION-9-15-CONNECTIVE-COPY.md §9.15.5 approved form-state strings. This form
      // has no client-side field validation — these two messages are produced by
      // functions/_lib/lead.ts, which PORT-PROMPT §4 forbids touching. Mapping them here puts
      // the approved wording in front of the visitor without editing the endpoint.
      const approvedFieldMessage: Record<string, string> = {
        phone: "Add a phone number so Matthew can reach you about the property.",
        email: "Add a valid email address so we can send a confirmation.",
        privacy_consent:
          "Check the consent box so we're allowed to call or text you back."
      };

      // §9.15.5's submission-error string interpolates {site.business.phone} rather than a
      // literal (amended 2026-08-19; AGENTS.md §3 forbids hardcoding business facts). This
      // script is bundled and cannot read frontmatter, so the value arrives on the form's
      // data attribute. If the attribute is ever missing, the sentence drops the number
      // rather than printing a stale or empty one.
      const contactPhone = form.dataset.contactPhone ?? "";
      const submissionErrorMessage = contactPhone
        ? `Something went wrong on our end and the form didn't send. Call or text ${contactPhone} and we'll take it from there.`
        : "Something went wrong on our end and the form didn't send. Call or text us and we'll take it from there.";

      // Match the PPC and compact-form measurement contract without sending submitted values.
      // The backend confirmation code is used only to prevent a retry/redirect from counting the
      // same accepted lead twice; it is never included in the analytics payload.
      const pagePath = window.location.pathname;
      const offerType =
        (form.elements.namedItem("offer_type") as HTMLInputElement | null)?.value ?? "";
      const trackingPayload = (
        event: string,
        detail: Record<string, string | number | boolean> = {}
      ) => ({
        event,
        form_id: form.id,
        page_path: pagePath,
        ...(offerType ? { offer_type: offerType } : {}),
        ...detail
      });
      const track = (
        event: string,
        detail: Record<string, string | number | boolean> = {}
      ) => {
        (window as Window & { dataLayer?: unknown[] }).dataLayer ??= [];
        (window as Window & { dataLayer?: unknown[] }).dataLayer!.push(
          trackingPayload(event, detail)
        );
      };
      const containerLoaded = () => {
        const containers = (window as Window & { google_tag_manager?: Record<string, unknown> })
          .google_tag_manager;
        return Boolean(containers && Object.keys(containers).some((key) => key.startsWith("GTM-")));
      };
      const trackAndSettle = (
        event: string,
        detail: Record<string, string | number | boolean>
      ) =>
        new Promise<void>((resolve) => {
          (window as Window & { dataLayer?: unknown[] }).dataLayer ??= [];
          if (!containerLoaded()) {
            (window as Window & { dataLayer?: unknown[] }).dataLayer!.push(
              trackingPayload(event, detail)
            );
            resolve();
            return;
          }
          let settled = false;
          const settle = () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timer);
            resolve();
          };
          const timer = window.setTimeout(settle, 1000);
          (window as Window & { dataLayer?: unknown[] }).dataLayer!.push({
            ...trackingPayload(event, detail),
            eventTimeout: 1000,
            eventCallback: settle
          });
        });
      const claimLead = (code: string) => {
        if (!code) return false;
        try {
          const key = `ac_ppc_lead:${code}`;
          if (window.sessionStorage.getItem(key)) return false;
          window.sessionStorage.setItem(key, "1");
          return true;
        } catch {
          return false;
        }
      };
      const errorCategory = (status: number) => {
        if (status === 400) return "verification_failed";
        if (status === 403) return "origin_rejected";
        if (status === 413) return "payload_too_large";
        if (status === 422) return "server_validation";
        if (status === 429) return "rate_limited";
        if (status === 503) return "service_unavailable";
        if (status >= 500) return "server_error";
        if (status >= 400) return "request_rejected";
        return "unexpected_response";
      };
      let startRecorded = false;
      const recordStart = () => {
        if (startRecorded) return;
        startRecorded = true;
        track("form_start");
      };
      form.addEventListener("input", recordStart);
      form.addEventListener("change", recordStart);

      const renderErrors = (errors: Record<string, string>) => {
        clearFieldErrors();
        const messages: string[] = [];

        for (const [key, serverMessage] of Object.entries(errors)) {
          const message = approvedFieldMessage[key] ?? serverMessage;
          if (key === "form") {
            messages.push(message);
            continue;
          }
          const control = form.elements.namedItem(key);
          if (control instanceof HTMLInputElement && control.type === "checkbox") {
            control.setAttribute("aria-invalid", "true");
            const wrapper = control.closest("label");
            if (wrapper) {
              const inline = document.createElement("p");
              inline.className = "form-error";
              inline.dataset.generatedError = "";
              inline.textContent = message;
              wrapper.after(inline);
            }
            messages.push(message);
            continue;
          }
          if (
            control instanceof HTMLInputElement ||
            control instanceof HTMLTextAreaElement
          ) {
            control.setAttribute("aria-invalid", "true");
            const field = control.closest(".quick-form__field");
            if (field) {
              const inline = document.createElement("p");
              inline.className = "form-error";
              inline.dataset.generatedError = "";
              inline.textContent = message;
              field.append(inline);
            }
            messages.push(`${labelFor(control)}: ${message}`);
            continue;
          }
          messages.push(message);
        }

        if (errorBox && errorList) {
          errorList.replaceChildren();
          if (messages.length) {
            messages.forEach((message) => {
              const item = document.createElement("li");
              item.textContent = message;
              errorList.append(item);
            });
            errorBox.hidden = false;
            errorBox.focus({ preventScroll: true });
            errorBox.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            errorBox.hidden = true;
          }
        }
      };

      const setSubmitting = (submitting: boolean, message = "") => {
        if (submitButton) submitButton.disabled = submitting;
        form.setAttribute("aria-busy", String(submitting));
        if (submitLabel) {
          submitLabel.textContent = submitting
            ? "Sending request…"
            : defaultLabel;
        }
        if (statusEl) {
          statusEl.hidden = !message;
          statusEl.textContent = message;
        }
      };

      let inFlight = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.action) return;
        if (inFlight) return;

        clearFieldErrors();
        if (errorBox) errorBox.hidden = true;

        const turnstileWidget = form.querySelector(".cf-turnstile");
        const turnstileToken = form.elements.namedItem(
          "cf-turnstile-response"
        );
        if (
          turnstileWidget &&
          (!(turnstileToken instanceof HTMLInputElement) ||
            !turnstileToken.value)
        ) {
          setSubmitting(
            false,
            "Complete the security verification, then submit again."
          );
          return;
        }

        if (timestampInput instanceof HTMLInputElement) {
          timestampInput.value = new Date().toISOString();
        }

        inFlight = true;
        track("ppc_form_submit_attempt", { photos_attached: false });
        setSubmitting(true, "Sending your request…");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form)
          });
          let payload: Record<string, unknown> = {};
          try {
            payload = await response.json();
          } catch {
            payload = {};
          }

          if (response.ok && payload.ok === true) {
            const code =
              typeof payload.confirmationCode === "string" ? payload.confirmationCode : "";
            const codeIsValid = /^AC-[0-9A-HJKMNP-TV-Z]{6}$/.test(code);
            if (!codeIsValid || claimLead(code)) {
              await trackAndSettle("ppc_form_success", { photos_attached: false });
            }
            storeAcceptedInquiryReceipt(payload);
            window.location.assign("/thank-you/");
            return;
          }

          if (
            payload.errors &&
            typeof payload.errors === "object"
          ) {
            renderErrors(payload.errors as Record<string, string>);
          }
          track("ppc_form_error", {
            error_type: errorCategory(response.status),
            photos_attached: false
          });
          // §9.15.5 approved submission-error string, as the fallback when the server sends
          // no specific message of its own.
          inFlight = false;
          setSubmitting(
            false,
            typeof payload.message === "string"
              ? payload.message
              : submissionErrorMessage
          );
          resetTurnstile();
        } catch {
          track("ppc_form_error", {
            error_type: "network",
            photos_attached: false
          });
          inFlight = false;
          setSubmitting(false, submissionErrorMessage);
          resetTurnstile();
        }
      });
    });
</script>

<style>
  .quick-form {
    --quick-form-label-color: var(--ac-color-navy-900);
    --quick-form-muted-color: var(--ac-color-ink-500);
    --quick-form-link-color: var(--ac-color-navy-800);
    display: grid;
    gap: var(--ac-space-4);
  }

  .quick-form__required-note {
    margin: 0;
    color: var(--quick-form-muted-color);
  }

  .quick-form__errors {
    scroll-margin-top: 6rem;
    border: 2px solid var(--ac-color-error);
    padding: var(--ac-space-4);
    background: #f8ecea;
    color: #6f211e;
  }

  .quick-form__errors ul {
    display: grid;
    gap: var(--ac-space-2);
    margin: 0;
    padding-left: 1.25rem;
  }

  .quick-form :global(.form-error) {
    margin: var(--ac-space-1) 0 0;
    color: var(--ac-color-error);
    font-size: var(--ac-text-sm);
    font-weight: 700;
  }

  .quick-form__turnstile {
    display: flex;
  }

  .quick-form__status {
    margin: 0;
    color: var(--quick-form-muted-color);
    font-size: var(--ac-text-sm);
  }

  .quick-form__field label,
  .quick-form__consent {
    display: block;
    color: var(--quick-form-label-color);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-sm);
    font-weight: 700;
    line-height: 1.4;
  }

  .quick-form__optional {
    color: var(--quick-form-muted-color);
    font-weight: 400;
  }

  .quick-form__phone-note {
    margin: var(--ac-space-1) 0 0;
    color: var(--quick-form-muted-color);
    font-weight: 400;
  }

  .quick-form__link {
    color: var(--quick-form-link-color);
  }

  .quick-form__field input,
  .quick-form__field textarea {
    width: 100%;
    min-height: 3rem;
    margin-top: var(--ac-space-2);
    border: 1px solid var(--ac-color-steel-300);
    border-radius: var(--ac-radius-control);
    padding: 0.75rem;
    background: var(--ac-color-paper);
    color: var(--ac-color-ink-700);
  }

  .quick-form__field textarea {
    min-height: 5rem;
    resize: vertical;
  }

  .quick-form__field input:hover,
  .quick-form__field textarea:hover {
    border-color: var(--ac-color-navy-800);
  }

  .quick-form__field input:focus-visible,
  .quick-form__field textarea:focus-visible {
    border-color: var(--ac-color-focus);
  }

  .quick-form__consent {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: var(--ac-space-3);
    cursor: pointer;
    font-weight: 400;
  }

  .quick-form__consent input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    accent-color: var(--ac-color-navy-800);
  }

  .quick-form__consent span {
    font-weight: 400;
  }

  .quick-form__note {
    margin: 0;
    color: var(--quick-form-muted-color);
    font-size: var(--ac-text-sm);
  }

  /* Size comes from the .ac-type-xs role class on the element, not from here. */
  .quick-form__clarification {
    margin: calc(var(--ac-space-3) * -1) 0 0;
    color: var(--quick-form-muted-color);
    text-align: center;
  }

  /* Size comes from the .ac-type-xs role class on the element, not from here. */
  .quick-form__secondary {
    margin: var(--ac-space-2) 0 0;
    text-align: center;
  }

  .quick-form__secondary a {
    color: var(--quick-form-muted-color);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .quick-form__submit {
    width: 100%;
  }

  .quick-form__honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }

  @media (min-width: 40rem) {
    .quick-form__submit {
      width: auto;
      justify-self: start;
      padding-inline: var(--ac-space-6);
    }
  }
</style>

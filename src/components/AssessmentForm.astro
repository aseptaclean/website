---
// Rebuilt 2026-09-02 for conversion. Service pages already explain the service, qualify the
// customer, and set expectations — this form's only job is: situation, location, a short
// description, optional photos, contact info, submit. One page, no wizard, no draft
// persistence (nothing here takes long enough to need it).
//
// The Private Residence Reset offer (`?offer=private-residence-reset`) is a distinct premium
// offer outside the main service taxonomy (doc 30 §33) and keeps its own longer residence-
// baseline block, hidden by default and revealed by the same client-side branch this form
// used before the rebuild. Nothing about that offer's fields or requirements changed.
import { assessment } from "@data/assessment";
import { legal, site } from "@data/site";

const endpointAvailable = Boolean(
  site.integrations.formEnabled &&
    site.urls.formEndpoint &&
    site.integrations.turnstileSiteKey
);
---

<section class="assessment" aria-labelledby="assessment-title">
  <div class="assessment__masthead ac-measure-wide">
    <p class="assessment__eyebrow" data-offer-eyebrow>Request an Assessment</p>
    <h1 id="assessment-title" class="ac-type-h1" data-offer-title>
      Tell Us What Is Happening at the Property.
    </h1>
    <p class="assessment__lead" data-offer-lead>
      You don&rsquo;t need to know the exact service or scope. Tell us what you&rsquo;re
      dealing with, add photos if you have them, and we&rsquo;ll determine the right next
      step.
    </p>
  </div>

  <div class="assessment__body ac-measure-wide">
    <p class="assessment__privacy-note">
      Photos and property details are used to review your request.
    </p>

    <form
      class="intake-form"
      action={endpointAvailable ? site.urls.formEndpoint : undefined}
      method="post"
      enctype="multipart/form-data"
      data-assessment-form
      data-contact-phone={site.business.phone}
    >
      <input type="hidden" name="form_version" value={assessment.version} />
      <input type="hidden" name="offer_type" value="handoff_reset" />
      <input type="hidden" name="entry_route" value="/request-assessment/" />
      <input type="hidden" name="submitted_from" value="/request-assessment/" />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="utm_term" value="" />
      <input type="hidden" name="utm_content" value="" />
      <input type="hidden" name="gclid" value="" />
      <input type="hidden" name="landing_page" value="" />
      <input type="hidden" name="referrer" value="" />
      <input type="hidden" name="submission_timestamp" value="" />
      <input type="hidden" name="idempotency_key" value="" />
      <input
        class="intake-form__honeypot"
        type="text"
        name="company_website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div
        class="intake-form__errors"
        tabindex="-1"
        aria-labelledby="assessment-error-title"
        hidden
      >
        <h2 id="assessment-error-title" class="ac-type-lead">Review the highlighted fields</h2>
        <ul></ul>
      </div>

      <fieldset class="form-group" data-handoff-only>
        <legend>What are you dealing with? <span aria-hidden="true">*</span></legend>
        <div class="choice-grid" data-situation-choices>
          {assessment.situations.map((situation) => (
            <label class="choice-control">
              <input
                type="radio"
                name="property_situation"
                value={situation.value}
                required
              />
              <span>{situation.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="form-grid" data-service-question hidden></div>

      <div class="form-grid">
        <div class="form-field">
          <label for="property-city">City <span aria-hidden="true">*</span></label>
          <input
            id="property-city"
            name="property_city"
            type="text"
            autocomplete="address-level2"
            required
          />
        </div>
        <div class="form-field">
          <label for="property-zip">
            ZIP code <span class="form-field__optional">(optional)</span>
          </label>
          <input
            id="property-zip"
            name="property_zip"
            type="text"
            inputmode="numeric"
            autocomplete="postal-code"
            pattern="[0-9]{5}(?:-[0-9]{4})?"
          />
        </div>
      </div>

      <div class="form-field">
        <label for="property-detail">Tell us what is going on at the property.</label>
        <p class="form-field__hint">
          A few sentences is enough. Tell us what you are seeing and what you need the
          property to become.
        </p>
        <textarea
          id="property-detail"
          name="property_detail"
          rows="4"
          placeholder="Helping my dad with a packed 3-bedroom home. We need to keep family photos and clear most of the house before it can be sold."
        ></textarea>
      </div>

      <div class="upload-field">
        <label for="property-media">
          Photos <span class="form-field__optional">(optional, but strongly encouraged)</span>
        </label>
        <p id="property-media-help">
          Photos help us understand the condition faster. For most jobs, useful photos are
          one wide photo of the area, a few closer photos of the main problem, and additional
          rooms if several areas are affected.
        </p>
        <div class="upload-field__control">
          <input
            id="property-media"
            name="property_media[]"
            type="file"
            accept={assessment.upload.acceptedTypes}
            capture="environment"
            aria-describedby="property-media-help property-media-limits"
            multiple
            data-upload-input
            data-max-files={assessment.upload.maxFiles}
            data-max-image-bytes={assessment.upload.maxImageBytes}
            data-max-video-bytes={assessment.upload.maxVideoBytes}
            data-max-total-bytes={assessment.upload.maxTotalBytes}
            data-allowed-extensions={assessment.upload.allowedExtensions.join(",")}
            data-image-extensions={assessment.upload.imageExtensions.join(",")}
          />
          <p id="property-media-limits">{assessment.upload.visibleLimits}</p>
          <p class="upload-field__empty" data-upload-empty>No files selected.</p>
          <ul
            class="upload-field__files"
            data-upload-list
            aria-label="Selected property files"
            hidden
          ></ul>
          <p class="upload-field__error form-error" data-upload-error role="alert" hidden
          ></p>
          <p class="visually-hidden" data-upload-status role="status" aria-live="polite"
          ></p>
        </div>
      </div>

      <div class="residence-questions" data-residence-only hidden>
        <div class="residence-questions__heading">
          <p class="condition-review__label">Residence baseline</p>
          <h2 class="ac-type-h3">Rooms, finishes, access, and priorities</h2>
          <p>
            Describe the baseline you want established. These answers shape the room-by-room
            assessment; they do not authorize work.
          </p>
        </div>
        <div class="form-grid">
          <div class="form-field">
            <label for="number-levels">Number of levels <span aria-hidden="true">*</span></label>
            <select id="number-levels" name="number_of_levels" data-residence-required disabled>
              <option value="">Select a level count</option>
              <option>1</option>
              <option>2</option>
              <option>3+</option>
            </select>
          </div>
          <div class="form-field">
            <label for="occupancy">Residence status <span aria-hidden="true">*</span></label>
            <select id="occupancy" name="occupancy_status" data-residence-required disabled>
              <option value="">Select a status</option>
              <option>Occupied</option>
              <option>Temporarily vacant</option>
              <option>Move-in pending</option>
              <option>Second home</option>
            </select>
          </div>
          <div class="form-field form-field--wide">
            <label for="priority-rooms">Priority rooms or areas <span aria-hidden="true">*</span></label>
            <textarea id="priority-rooms" name="priority_rooms" rows="4" data-residence-required disabled placeholder="List the rooms that matter most and what should feel different at completion."></textarea>
          </div>
          <div class="form-field form-field--wide">
            <label for="detail-priorities">Detail priorities <span aria-hidden="true">*</span></label>
            <textarea id="detail-priorities" name="detail_priorities" rows="4" data-residence-required disabled placeholder="Appliance or cabinet interiors, closets, interior windows, high dusting, trim, or other detail areas."></textarea>
          </div>
          <div class="form-field form-field--wide">
            <label for="important-finishes">Important surfaces or finishes</label>
            <textarea id="important-finishes" name="important_finishes" rows="4" disabled placeholder="Natural stone, oiled wood, specialty fixtures, delicate surfaces, restricted products, or areas not to disturb."></textarea>
          </div>
          <div class="form-field">
            <label for="pets">Pets or animal instructions</label>
            <input id="pets" name="pets" type="text" disabled />
          </div>
          <div class="form-field">
            <label for="presence">Will someone be present?</label>
            <select id="presence" name="someone_present" disabled>
              <option value="">Select an answer</option>
              <option>Yes</option>
              <option>No</option>
              <option>Part of the time</option>
              <option>Not sure</option>
            </select>
          </div>
          <div class="form-field">
            <label for="safety-routing">Known condition requiring specialist review? <span aria-hidden="true">*</span></label>
            <select id="safety-routing" name="safety_routing" data-residence-required disabled>
              <option value="">Select an answer</option>
              <option value="no_known_condition">No known condition</option>
              <option value="possible_condition">Possibly / not sure</option>
              <option value="known_condition">Yes</option>
            </select>
            <p class="form-field__hint">This does not imply service availability. Hazardous, regulated, severe-contamination, or specialist conditions are outside this campaign offer.</p>
          </div>
        </div>
      </div>

      <div class="form-grid">
        <div class="form-field">
          <label for="full-name">Name <span aria-hidden="true">*</span></label>
          <input id="full-name" name="full_name" type="text" autocomplete="name" required />
        </div>

        <div class="form-field">
          <label for="phone">Phone <span aria-hidden="true">*</span></label>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            required
          />
          <p class="form-field__hint">We call this number back — usually same business day.</p>
        </div>

        <div class="form-field">
          <label for="email">
            Email <span class="form-field__optional" data-residence-only hidden aria-hidden="true">*</span>
            <span class="form-field__optional" data-email-optional-label>(optional)</span>
          </label>
          <input id="email" name="email" type="email" autocomplete="email" inputmode="email" />
        </div>
      </div>

      <div class="intake-form__consent">
        <label class="consent-control">
          <input type="checkbox" name="privacy_consent" value="yes" required />
          <span>
            {legal.consentBase.lead}{" "}
            <a href={site.urls.privacyPolicy}>{legal.consentBase.privacyLabel}</a>{legal.consentBase.tail}{" "}
            {legal.consentAssessmentAppendix.lead}{" "}
            <a href={site.urls.terms}>{legal.consentAssessmentAppendix.termsLabel}</a>{legal.consentAssessmentAppendix.tail}
            <span aria-hidden="true">*</span>
          </span>
        </label>
        <p>
          Submitting this form authorizes Aseptaclean to contact you. It does not authorize
          work or create a service agreement. Private. No pressure to have everything figured
          out.
        </p>
      </div>

      {
        site.integrations.turnstileSiteKey && (
          <div class="intake-form__turnstile">
            <div
              class="cf-turnstile"
              data-sitekey={site.integrations.turnstileSiteKey}
              data-theme="light"
              data-size="flexible"
            />
          </div>
        )
      }
      <noscript>
        <p class="intake-form__no-script">
          Security verification requires JavaScript. Please call Aseptaclean if you cannot
          enable it.
        </p>
      </noscript>

      {!endpointAvailable && (
        <div class="intake-form__availability" role="status">
          <p>
            Online submission is not fully configured in this preview. Your answers will not
            be sent.
          </p>
        </div>
      )}

      <div class="intake-form__actions">
        <button
          class="button"
          type="submit"
          disabled={!endpointAvailable}
          data-submit-button
        >
          <span data-submit-label data-offer-submit>Send My Request</span>
        </button>
        <p class="intake-form__submit-status" data-submit-status role="status" aria-live="polite" hidden
        ></p>
      </div>
    </form>
  </div>
</section>

{
  site.integrations.turnstileSiteKey && (
    <script
      is:inline
      data-categories="essential"
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  type FormControl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  interface ValidationIssue {
    control: FormControl;
    container: HTMLElement;
    message: string;
    key: string;
    existingError?: HTMLElement;
  }

  interface ServiceQuestion {
    name: string;
    label: string;
    type?: "date";
    options?: string[];
  }

  const form = document.querySelector<HTMLFormElement>("[data-assessment-form]");

  if (form) {
    // RESIDENCE OFFER — a distinct premium offer outside the eight-service taxonomy (doc 30
    // §33). Unrelated to the lean rebuild: it keeps its own longer required fields.
    const isResidenceOffer =
      new URLSearchParams(window.location.search).get("offer") ===
      "private-residence-reset";
    if (isResidenceOffer) {
      form.dataset.offer = "private_residence_reset";
      const offerInput = form.querySelector<HTMLInputElement>('input[name="offer_type"]');
      const entryRouteInput = form.querySelector<HTMLInputElement>('input[name="entry_route"]');
      if (offerInput) offerInput.value = "private_residence_reset";
      if (entryRouteInput) entryRouteInput.value = "/private-residence-reset/";

      const copy = new Map<string, string>([
        ["[data-offer-eyebrow]", "Private Residence Reset assessment"],
        ["[data-offer-title]", "Tell Us About the Residence."],
        [
          "[data-offer-lead]",
          "Share the residence, priority rooms, finish instructions, access, and completion details Aseptaclean needs to make a fit decision."
        ],
        ["[data-offer-submit]", "Request My Residence Assessment"]
      ]);
      copy.forEach((content, selector) => {
        const element = document.querySelector<HTMLElement>(selector);
        if (element) element.textContent = content;
      });

      form.querySelectorAll<HTMLElement>("[data-handoff-only]").forEach((block) => {
        block.hidden = true;
        block
          .querySelectorAll<FormControl>("input, select, textarea")
          .forEach((control) => {
            control.disabled = true;
            control.required = false;
          });
      });
      form.querySelectorAll<HTMLElement>("[data-residence-only]").forEach((block) => {
        block.hidden = false;
        block
          .querySelectorAll<FormControl>("input, select, textarea")
          .forEach((control) => {
            control.disabled = false;
          });
      });
      form
        .querySelectorAll<FormControl>("[data-residence-required]")
        .forEach((control) => {
          control.disabled = false;
          control.required = true;
        });
      const propertyZip = form.querySelector<HTMLInputElement>('input[name="property_zip"]');
      if (propertyZip) propertyZip.required = true;
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      if (emailInput) emailInput.required = true;
      const emailOptionalLabel = form.querySelector<HTMLElement>(
        "[data-email-optional-label]"
      );
      if (emailOptionalLabel) emailOptionalLabel.hidden = true;
    }

    const errorSummary = form.querySelector<HTMLElement>(".intake-form__errors");
    const errorSummaryList = errorSummary?.querySelector("ul");
    const uploadInput = form.querySelector<HTMLInputElement>("[data-upload-input]");
    const uploadList = form.querySelector<HTMLUListElement>("[data-upload-list]");
    const uploadEmpty = form.querySelector<HTMLElement>("[data-upload-empty]");
    const uploadError = form.querySelector<HTMLElement>("[data-upload-error]");
    const uploadStatus = form.querySelector<HTMLElement>("[data-upload-status]");
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const submitStatus = form.querySelector<HTMLElement>("[data-submit-status]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const defaultSubmitLabel = submitLabel?.textContent ?? "Send My Request";

    const timestampInput = form.elements.namedItem("submission_timestamp");
    if (timestampInput instanceof HTMLInputElement) {
      timestampInput.value = new Date().toISOString();
    }
    const idempotencyInput = form.elements.namedItem("idempotency_key");
    if (idempotencyInput instanceof HTMLInputElement) {
      idempotencyInput.value =
        window.crypto?.randomUUID?.() ??
        `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    }

    // SERVICE CONTEXT FROM THE REFERRING SERVICE PAGE — docs/30-WEBSITE-MASTER-SPEC.md
    // §20A.8's destination rule and §20A.9's service branch: service page CTA →
    // /request-assessment/?service=<verified-service-key> → this form recognizes the context
    // and preselects the situation so the visitor never re-answers a question the page they
    // came from already asked. A service may add AT MOST ONE qualifying question
    // (assessment.serviceQuestions), rendered into the empty [data-service-question] slot.
    //
    // WHITELIST, NOT PASSTHROUGH. An unrecognized `service` value is a no-op — nothing from
    // the query string is ever written into the DOM or a field verbatim. Skipped entirely for
    // the residence offer, which owns `entry_route` on its own branch above.
    if (!isResidenceOffer) {
      const serviceContexts = new Map<
        string,
        { entryRoute: string; situation: string; question?: ServiceQuestion }
      >([
        [
          "hoarding-cleanup",
          {
            entryRoute: "/hoarding-cleanup-san-jose/",
            situation: "Accumulated contents",
            question: {
              name: "belongings_must_be_kept",
              label: "Are there belongings that must be kept?",
              options: ["Yes", "No", "Not sure"]
            }
          }
        ],
        [
          "estate-cleanout",
          {
            entryRoute: "/estate-cleanout-san-jose/",
            situation: "Inherited or estate property",
            question: {
              name: "items_must_be_saved",
              label: "Are there specific items or documents that must be saved?",
              options: ["Yes", "No", "Not sure"]
            }
          }
        ],
        [
          "property-cleanouts",
          {
            entryRoute: "/property-cleanouts-san-jose/",
            // "Other" — not one of the six transition-based situations above. Every other
            // entry describes why the property is being cleaned (hoarding, estate, deep
            // clean, move-out, extreme cleanup); a landlord/property-manager cleanout doesn't
            // fit any of those specifically and the direct-visitor situation list has no
            // dedicated option for it. "Other" is the honest answer, same reasoning as the
            // rodent-droppings/animal-waste entries below before they got their own options.
            situation: "Other",
            question: {
              name: "items_must_remain",
              label: "Does anything need to stay at the property?",
              options: ["Yes", "No", "Not sure"]
            }
          }
        ],
        [
          "deep-cleaning",
          {
            entryRoute: "/deep-cleaning-san-jose/",
            situation: "Already empty but requires detailed cleaning"
          }
        ],
        [
          "move-out",
          {
            entryRoute: "/move-out-cleaning-san-jose/",
            situation: "Difficult move-out",
            question: {
              name: "desired_completion_date",
              label: "When does the property need to be ready?",
              type: "date"
            }
          }
        ],
        [
          "extreme-cleanup",
          {
            entryRoute: "/extreme-cleaning-san-jose/",
            situation: "Overwhelmed property",
            question: {
              name: "belongings_block_access",
              label: "Are belongings blocking access to the areas that need cleaning?",
              options: ["Yes", "No", "Some areas", "Not sure"]
            }
          }
        ],
        [
          "rodent-droppings",
          {
            entryRoute: "/rodent-dropping-cleanup-san-jose/",
            situation: "Rodent droppings",
            question: {
              name: "pest_control_involved",
              label: "Has pest control already been involved?",
              options: ["Yes", "No", "Scheduled", "Not sure"]
            }
          }
        ],
        [
          "animal-waste",
          {
            entryRoute: "/animal-waste-cleanup-san-jose/",
            situation: "Animal waste",
            question: {
              name: "animal_waste_pattern",
              label: "Is this a one-time accident or a repeated condition?",
              options: ["One-time", "Repeated", "Not sure"]
            }
          }
        ]
      ]);
      const serviceKey = new URLSearchParams(window.location.search).get("service") ?? "";
      const context = serviceContexts.get(serviceKey);

      if (context) {
        const entryRouteInput = form.querySelector<HTMLInputElement>('input[name="entry_route"]');
        if (entryRouteInput) entryRouteInput.value = context.entryRoute;

        // Preselect and hide the situation question entirely — the visitor already told the
        // service page what they're dealing with.
        const situationGroup = form.querySelector<HTMLElement>("[data-situation-choices]");
        const situationFieldset = situationGroup?.closest("fieldset");
        const matchingRadio = form.querySelector<HTMLInputElement>(
          `input[name="property_situation"][value="${CSS.escape(context.situation)}"]`
        );
        if (matchingRadio) {
          matchingRadio.checked = true;
          if (situationFieldset) situationFieldset.hidden = true;
          form
            .querySelectorAll<HTMLInputElement>('input[name="property_situation"]')
            .forEach((radio) => {
              if (radio !== matchingRadio) radio.required = false;
            });
        }

        const questionSlot = form.querySelector<HTMLElement>("[data-service-question]");
        if (questionSlot && context.question) {
          const question = context.question;
          questionSlot.hidden = false;
          const field = document.createElement("div");
          field.className = "form-field";
          const label = document.createElement("label");
          const inputId = `service-question-${question.name}`;
          label.setAttribute("for", inputId);
          label.textContent = question.label;
          field.append(label);

          if (question.type === "date") {
            const input = document.createElement("input");
            input.type = "date";
            input.id = inputId;
            input.name = question.name;
            field.append(input);
          } else if (question.options) {
            field.removeChild(label);
            const fieldset = document.createElement("fieldset");
            fieldset.className = "form-group";
            const legend = document.createElement("legend");
            legend.textContent = question.label;
            fieldset.append(legend);
            const row = document.createElement("div");
            row.className = "choice-row choice-row--wrap";
            question.options.forEach((option) => {
              const optionLabel = document.createElement("label");
              optionLabel.className = "choice-control choice-control--compact";
              const radio = document.createElement("input");
              radio.type = "radio";
              radio.name = question.name;
              radio.value = option;
              const span = document.createElement("span");
              span.textContent = option;
              optionLabel.append(radio, span);
              row.append(optionLabel);
            });
            fieldset.append(row);
            field.append(fieldset);
          }
          questionSlot.append(field);
        }
      }
    }

    const sanitizeReferrer = (referrer: string) => {
      if (!referrer) return "";
      try {
        const url = new URL(referrer);
        return `${url.origin}${url.pathname}`;
      } catch {
        return "";
      }
    };

    const populateAttribution = () => {
      const allowed = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid"];
      const parameters = new URLSearchParams(window.location.search);
      for (const name of allowed) {
        const value = parameters.get(name);
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        if (value && input) input.value = value.slice(0, 250);
      }
      const landingPageInput = form.querySelector<HTMLInputElement>('input[name="landing_page"]');
      if (landingPageInput) landingPageInput.value = window.location.pathname;
      const referrerInput = form.querySelector<HTMLInputElement>('input[name="referrer"]');
      if (referrerInput) referrerInput.value = sanitizeReferrer(document.referrer);
    };
    populateAttribution();

    const formatBytes = (bytes: number) => {
      if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };

    const fileExtension = (file: File) => file.name.split(".").pop()?.toLowerCase() ?? "";

    const renderUpload = () => {
      if (!uploadInput || !uploadList || !uploadEmpty || !uploadError || !uploadStatus) {
        return [];
      }

      const files = Array.from(uploadInput.files ?? []);
      const maxFiles = Number(uploadInput.dataset.maxFiles);
      const maxImageBytes = Number(uploadInput.dataset.maxImageBytes);
      const maxVideoBytes = Number(uploadInput.dataset.maxVideoBytes);
      const maxTotalBytes = Number(uploadInput.dataset.maxTotalBytes);
      const allowedExtensions = new Set(uploadInput.dataset.allowedExtensions?.split(",") ?? []);
      const imageExtensions = new Set(uploadInput.dataset.imageExtensions?.split(",") ?? []);
      const errorsByIndex = new Map<number, string[]>();
      const overallErrors: string[] = [];
      const totalBytes = files.reduce((sum, file) => sum + file.size, 0);

      if (files.length > maxFiles) {
        overallErrors.push(`Select no more than ${maxFiles} property files.`);
      }
      if (totalBytes > maxTotalBytes) {
        overallErrors.push(
          `The combined selection is ${formatBytes(totalBytes)}; the limit is ${formatBytes(maxTotalBytes)}.`
        );
      }

      files.forEach((file, index) => {
        const extension = fileExtension(file);
        const fileErrors: string[] = [];
        if (!allowedExtensions.has(extension)) {
          fileErrors.push("Unsupported file type");
        } else {
          const limit = imageExtensions.has(extension) ? maxImageBytes : maxVideoBytes;
          if (file.size > limit) fileErrors.push(`Exceeds the ${formatBytes(limit)} file limit`);
        }
        if (fileErrors.length) errorsByIndex.set(index, fileErrors);
      });

      uploadList.replaceChildren();
      files.forEach((file, index) => {
        const item = document.createElement("li");
        const details = document.createElement("span");
        const name = document.createElement("strong");
        const metadata = document.createElement("small");
        const remove = document.createElement("button");
        const fileErrors = errorsByIndex.get(index) ?? [];

        item.dataset.state = fileErrors.length ? "error" : "selected";
        name.textContent = file.name;
        metadata.textContent = `${formatBytes(file.size)}${
          fileErrors.length ? ` · ${fileErrors.join(" · ")}` : ""
        }`;
        details.append(name, metadata);

        remove.type = "button";
        remove.className = "upload-field__remove";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.addEventListener("click", () => {
          try {
            const transfer = new DataTransfer();
            files.forEach((candidate, candidateIndex) => {
              if (candidateIndex !== index) transfer.items.add(candidate);
            });
            uploadInput.files = transfer.files;
            renderUpload();
            uploadStatus.textContent = `${file.name} removed.`;
          } catch {
            uploadInput.value = "";
            renderUpload();
            uploadStatus.textContent =
              "The file selection was cleared because this browser does not support individual removal.";
          }
        });

        item.append(details, remove);
        uploadList.append(item);
      });

      const allErrors = [...overallErrors, ...Array.from(errorsByIndex.values()).flat()];
      uploadInput.setCustomValidity(allErrors[0] ?? "");
      uploadInput.setAttribute("aria-invalid", allErrors.length ? "true" : "false");
      uploadEmpty.hidden = files.length > 0;
      uploadList.hidden = files.length === 0;
      uploadError.hidden = allErrors.length === 0;
      uploadError.textContent = allErrors.length
        ? `${overallErrors.join(" ")} ${
            errorsByIndex.size ? "Remove files marked with an error before continuing." : ""
          }`.trim()
        : "";
      uploadError.id = "property-media-error";

      const describedBy = new Set(
        (uploadInput.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(Boolean)
      );
      if (allErrors.length) describedBy.add(uploadError.id);
      else describedBy.delete(uploadError.id);
      uploadInput.setAttribute("aria-describedby", Array.from(describedBy).join(" "));
      uploadStatus.textContent = files.length
        ? `${files.length} file${files.length === 1 ? "" : "s"} selected.`
        : "No property files selected.";

      return allErrors;
    };

    let announcedPhotoAdded = false;
    uploadInput?.addEventListener("change", () => {
      renderUpload();
      if (!announcedPhotoAdded && (uploadInput.files?.length ?? 0) > 0) {
        announcedPhotoAdded = true;
        window.dataLayer = window.dataLayer ?? [];
        window.dataLayer.push({ event: "photo_added" });
      }
    });
    renderUpload();

    const labelForControl = (control: FormControl) => {
      if (control.id) {
        const label = form.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(control.id)}"]`);
        if (label) return label.textContent?.replace("*", "").trim() ?? "Field";
      }
      const fieldset = control.closest("fieldset");
      const legend = fieldset?.querySelector<HTMLElement>(":scope > legend");
      return legend?.textContent?.replace("*", "").trim() ?? "Field";
    };

    const approvedMissingMessage: Record<string, string> = {
      phone: "Add a phone number so we can follow up.",
      full_name: "Add your name so we know who to ask for.",
      privacy_consent: "Check the consent box so we're allowed to call or text you back.",
      property_situation: "Let us know what you're dealing with."
    };

    const contactPhone = form.dataset.contactPhone ?? "";
    const submissionErrorMessage = contactPhone
      ? `Something went wrong on our end and the form didn't send. Call or text ${contactPhone} and we'll take it from there.`
      : "Something went wrong on our end and the form didn't send. Call or text us and we'll take it from there.";

    const validationMessage = (control: FormControl) => {
      const label = labelForControl(control);
      if (control.validity.valueMissing) {
        return approvedMissingMessage[control.name] ?? `${label} is required.`;
      }
      if (control.validity.typeMismatch) {
        return `Enter a valid ${label.toLowerCase()}.`;
      }
      return `Review ${label.toLowerCase()}.`;
    };

    const issueContainer = (control: FormControl) =>
      (control.closest(".form-field, .form-group, .upload-field") ?? control.parentElement) as HTMLElement;

    const collectIssues = () => {
      const issues: ValidationIssue[] = [];
      const seen = new Set<string>();
      const controls = Array.from(form.querySelectorAll<FormControl>("input, select, textarea")).filter(
        (control) => !["hidden", "button", "submit"].includes(control.type) && !control.disabled
      );

      for (const control of controls) {
        if (control === uploadInput) {
          if (!control.validity.valid && uploadError) {
            issues.push({
              control,
              container: issueContainer(control),
              message: uploadError.textContent?.trim() || "Review the selected property files.",
              key: "property_media",
              existingError: uploadError
            });
          }
          continue;
        }

        const key =
          control instanceof HTMLInputElement && ["radio", "checkbox"].includes(control.type)
            ? control.name
            : control.id || control.name;
        if (!key || seen.has(key) || control.validity.valid) continue;
        seen.add(key);
        issues.push({ control, container: issueContainer(control), message: validationMessage(control), key });
      }
      return issues;
    };

    const clearValidation = () => {
      form.querySelectorAll<HTMLElement>("[data-generated-error]").forEach((error) => error.remove());
      form.querySelectorAll<FormControl>('[aria-invalid="true"]').forEach((control) => {
        if (control !== uploadInput) control.removeAttribute("aria-invalid");
        const errorIds = (control.getAttribute("aria-describedby") ?? "")
          .split(/\s+/)
          .filter((id) => id && !id.startsWith("assessment-error-"));
        if (errorIds.length) control.setAttribute("aria-describedby", errorIds.join(" "));
        else control.removeAttribute("aria-describedby");
      });
    };

    const prepareIssueControl = (issue: ValidationIssue, index: number) => {
      if (!issue.control.id) {
        issue.control.id = `assessment-field-${issue.key.replace(/[^a-z0-9]+/gi, "-")}-${index}`;
      }
      const groupControls =
        issue.control instanceof HTMLInputElement && ["radio", "checkbox"].includes(issue.control.type)
          ? Array.from(form.querySelectorAll<FormControl>(`[name="${CSS.escape(issue.control.name)}"]`))
          : [issue.control];
      const errorId = issue.existingError?.id || `assessment-error-${issue.control.id}`;

      groupControls.forEach((control) => {
        control.setAttribute("aria-invalid", "true");
        const describedBy = new Set(
          (control.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(Boolean)
        );
        describedBy.add(errorId);
        control.setAttribute("aria-describedby", Array.from(describedBy).join(" "));
      });

      if (!issue.existingError) {
        const inlineError = document.createElement("p");
        inlineError.className = "form-error";
        inlineError.id = errorId;
        inlineError.dataset.generatedError = "";
        inlineError.textContent = issue.message;
        issue.container.append(inlineError);
      }
    };

    const renderIssues = (issues: ValidationIssue[], focusSummary: boolean) => {
      if (!errorSummary || !errorSummaryList) return;
      errorSummaryList.replaceChildren();

      if (!issues.length) {
        errorSummary.hidden = true;
        errorSummary.removeAttribute("role");
        return;
      }

      issues.forEach((issue, index) => {
        prepareIssueControl(issue, index);
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `#${issue.control.id}`;
        link.textContent = issue.message;
        link.addEventListener("click", () => issue.control.focus());
        item.append(link);
        errorSummaryList.append(item);
      });

      errorSummary.hidden = false;
      errorSummary.setAttribute("role", "alert");
      if (focusSummary) {
        errorSummary.focus({ preventScroll: true });
        errorSummary.scrollIntoView({
          behavior: reducedMotion.matches ? "auto" : "smooth",
          block: "start"
        });
      }
    };

    form.noValidate = true;
    form.dataset.enhanced = "true";
    form.addEventListener("change", () => renderUpload());

    const resetTurnstile = () => {
      const turnstile = (window as Window & { turnstile?: { reset: (widget?: string | HTMLElement) => void } })
        .turnstile;
      const widget = form.querySelector<HTMLElement>(".cf-turnstile");
      if (turnstile && widget) turnstile.reset(widget);
    };

    const setSubmitting = (submitting: boolean, message = "") => {
      if (submitButton) submitButton.disabled = submitting;
      form.setAttribute("aria-busy", String(submitting));
      if (submitLabel) submitLabel.textContent = submitting ? "Sending…" : defaultSubmitLabel;
      if (submitStatus) {
        submitStatus.hidden = !message;
        submitStatus.textContent = message;
      }
    };

    const submitWithProgress = () =>
      new Promise<{ status: number; payload: Record<string, unknown> }>((resolve, reject) => {
        const request = new XMLHttpRequest();
        request.open("POST", form.action);
        request.setRequestHeader("Accept", "application/json");
        request.timeout = 90_000;
        request.upload.addEventListener("progress", (progressEvent) => {
          if (!submitStatus || !progressEvent.lengthComputable) return;
          const percentage = Math.round((progressEvent.loaded / progressEvent.total) * 100);
          submitStatus.hidden = false;
          submitStatus.textContent =
            percentage < 100
              ? `Uploading property details and photos: ${percentage}%`
              : "Upload complete. Confirming delivery…";
        });
        request.addEventListener("load", () => {
          let payload: Record<string, unknown> = {};
          try {
            payload = JSON.parse(request.responseText) as Record<string, unknown>;
          } catch {
            payload = {};
          }
          resolve({ status: request.status, payload });
        });
        request.addEventListener("error", () => reject(new Error("network")));
        request.addEventListener("timeout", () => reject(new Error("timeout")));
        request.send(new FormData(form));
      });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearValidation();
      renderUpload();
      const issues = collectIssues();
      if (issues.length) {
        renderIssues(issues, true);
        return;
      }
      if (!form.action) return;

      const turnstileToken = form.elements.namedItem("cf-turnstile-response");
      if (!(turnstileToken instanceof HTMLInputElement) || !turnstileToken.value) {
        if (submitStatus) {
          submitStatus.hidden = false;
          submitStatus.textContent = "Complete the security verification, then submit again.";
          submitStatus.focus();
        }
        return;
      }

      if (timestampInput instanceof HTMLInputElement) {
        timestampInput.value = new Date().toISOString();
      }
      setSubmitting(true, "Sending your request…");

      try {
        const { status, payload } = await submitWithProgress();
        if (status >= 200 && status < 300 && payload.ok === true) {
          const code = typeof payload.confirmationCode === "string" ? payload.confirmationCode : "";
          const callbackWindow =
            typeof payload.callbackWindow === "string" ? payload.callbackWindow : "next-business-window";
          const parameters = new URLSearchParams({
            received: "1",
            callback: callbackWindow,
            email: payload.confirmationEmailSent === true ? "sent" : "attention"
          });
          if (isResidenceOffer) parameters.set("offer", "private-residence-reset");
          if (code) parameters.set("code", code);
          window.location.assign(`/thank-you/?${parameters.toString()}`);
          return;
        }

        const message = typeof payload.message === "string" ? payload.message : submissionErrorMessage;
        setSubmitting(false, message);
        resetTurnstile();
      } catch {
        setSubmitting(false, submissionErrorMessage);
        resetTurnstile();
      }
    });
  }
</script>


---
// 2026-08-18 visual port. docs/mockups .founder / .portrait / .creds / .disc — warm-white
// band, 4:5 portrait slot on the left, credentials as a hairline-ruled label/value list.
// Copy is doc 27 §9.11 (eyebrow, H2, body, three credentials, required disclaimer).
//
// The portrait is an image slot, so it renders the flat gray placeholder with its own label
// per PORT-PROMPT §5 — not a stand-in graphic, and never an AI-generated person (AGENTS.md
// §0.3). The founder-authority limit is verbatim-mandatory wherever this background appears
// (docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §2.4) and is read from legal.founderAuthorityLimit.
import { legal, site } from "@data/site";

// doc 27 §9.11 lists three. The fourth row ("On project") is the FINAL-v2 port's addition and
// restates site.founder's role rather than claiming anything new; kept, and flagged in the
// gate-6 trace table as having no doc 27 counterpart.
const credentials = [
  { k: "Education", v: "B.S. Biochemistry, UC Riverside" },
  { k: "Background", v: "Pharmaceutical manufacturing" },
  { k: "Background", v: "Histology and surgical pathology" },
  { k: "On project", v: "Scope, planning, operating oversight" }
] as const;
---

<section class="ac-sec founder" id="about" aria-labelledby="founder-title">
  <div class="ac-shell">
    <div class="ac-two founder__two">
      <div class="ac-portrait" role="presentation">
        Photo slot<br />Founder portrait<br />1200 × 1500
      </div>

      <div>
        {/* doc 27 §9.11's homepage eyebrow. §9.15.1's shorter "The operator" is the ABOUT
            page's founder label, not this one — different slot, different source line. */}
        <p class="ac-label">The operator, not a call center</p>
        <h2 id="founder-title" class="ac-type-h2-record">
          The person defining the work stays accountable for how it is carried out.
        </h2>
        <p class="founder__lead">
          {site.founder.name} is directly involved in scope review, project planning and operating
          oversight—a controlled-process background applied to properties that require more than
          a truck and a guess.
        </p>

        <ul class="ac-creds">
          {credentials.map((item) => (
            <li>
              <b>{item.k}</b>
              <span>{item.v}</span>
            </li>
          ))}
        </ul>

        <p class="ac-disc">{legal.founderAuthorityLimit}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .founder {
    background: var(--ac-color-warm-white);
  }

  .founder__two {
    align-items: center;
    gap: 56px;
    grid-template-columns: 0.82fr 1.18fr;
  }

  .founder__lead {
    margin-top: 16px;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-lead);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .founder__two {
      grid-template-columns: 1fr;
    }
  }
</style>

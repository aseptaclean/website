---
import { homepage, site } from "@data/site";

const currency = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0
});
---

<section class="pricing" aria-labelledby="pricing-title">
  <div class="container pricing__layout">
    <header>
      <p class="pricing__index">07 / Starting context</p>
      <h2 id="pricing-title">
        Know the starting point before you tell the whole story
      </h2>
      <p>
        You should be able to decide whether this type of service is realistic
        before spending an hour explaining the property. Photo review comes
        first. Complex properties may require an on-site assessment before a
        final scope and price can be issued.
      </p>
    </header>

    <div class="pricing__figure">
      <p>Full Handoff Reset projects generally begin at</p>
      <strong>{currency.format(site.offer.startingPrice)}</strong>
      <small>Not a flat package price</small>
    </div>

    <div class="pricing__drivers">
      <p>Final pricing depends on</p>
      <ul>
        {homepage.pricingDrivers.map((driver) => <li>{driver}</li>)}
      </ul>
    </div>

    <aside class="pricing__assessment">
      <p>When remote scoping is not reliable</p>
      <strong>{currency.format(site.offer.assessmentFee)} on-site assessment</strong>
      <span>
        Credited toward an approved project booked within seven days.
      </span>
    </aside>
  </div>
</section>

<style>
  .pricing {
    border-bottom: 1px solid var(--color-rule);
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-paper);
  }

  .pricing__layout {
    display: grid;
    gap: var(--space-7);
  }

  .pricing__index,
  .pricing__figure p,
  .pricing__figure small,
  .pricing__drivers > p,
  .pricing__assessment p {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 21ch;
    margin: var(--space-4) 0 0;
    letter-spacing: -0.025em;
  }

  .pricing__nowrap {
    white-space: nowrap;
  }

  header > p:last-child {
    max-width: 37rem;
    margin: var(--space-5) 0 0;
  }

  .pricing__figure {
    border-block: 2px solid var(--color-navy-900);
    padding-block: var(--space-5);
  }

  .pricing__figure strong {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-navy-900);
    font-family: var(--font-heading);
    font-size: clamp(4rem, 18vw, 8.5rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .pricing__figure small {
    display: block;
    margin-top: var(--space-4);
    color: var(--color-blue-500);
  }

  .pricing__drivers ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-4) 0 0;
    border-top: 1px solid var(--color-rule);
    padding: 0;
    list-style: none;
  }

  .pricing__drivers li {
    max-width: none;
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
  }

  .pricing__assessment {
    border-left: 3px solid var(--color-blue-500);
    padding: var(--space-5);
    background: var(--color-warm-white);
  }

  .pricing__assessment strong,
  .pricing__assessment span {
    display: block;
  }

  .pricing__assessment strong {
    margin-top: var(--space-3);
    color: var(--color-navy-900);
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .pricing__assessment span {
    margin-top: var(--space-3);
    color: var(--color-ink-500);
  }

  @media (min-width: 70rem) {
    .pricing__layout {
      grid-template-columns: minmax(18rem, 4fr) minmax(22rem, 5fr) minmax(16rem, 3fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .pricing__figure {
      grid-column: 2 / 4;
      grid-row: 1;
    }

    .pricing__figure strong {
      font-size: clamp(6rem, 10vw, 9.5rem);
    }

    .pricing__drivers {
      grid-column: 2;
    }

    .pricing__assessment {
      grid-column: 3;
      margin-top: var(--space-7);
    }
  }
</style>

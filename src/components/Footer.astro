---
// Owner-approved 2026-09-03 launch footer: brand/contact plus the four public services,
// company/action links, and legal/consent utilities. Retained marketing routes are intentionally
// absent because the footer is a sitewide discovery and crawl surface.
//
// The legal line is §9.15.5's approved footer legal line, verbatim. The two longer scope and
// documentation disclaimers stay under it: they are verbatim-mandatory from
// docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §2.3/§2.4 by way of src/data/site.ts, and §9.15.5 adds
// a line rather than replacing them.
import { launchServiceLinks } from "@data/launchArchitecture";
import { legal, site } from "@data/site";

const year = new Date().getFullYear();
const phoneHref = site.business.phoneUri;
const termlyConsentEnabled = site.integrations.termly.consentEnabled;
---

<footer class="foot">
  <div class="ac-shell">
    <div class="foot__g">
      <div>
        <a class="foot__logo" href="/">
          {/* I1 — declared size is the reversed wordmark's actual intrinsic 900×215, not the
              old 180×28 (a 6.43 ratio against a real 4.19). CSS sizes it by height with
              `width: auto`, so the wrong ratio reserved a 180px-wide box and reflowed to 117px
              on decode. Settled rendering is unchanged; the shift is gone.
              I3 — `loading="lazy"`: the footer mark is below the fold on every route, and it was
              the only remaining eagerly-fetched image on an otherwise image-free site. */}
          <img
            src={site.business.logoReversedUrl}
            alt={`${site.business.name} — home`}
            width="900"
            height="215"
            loading="lazy"
            decoding="async"
          />
        </a>
        {/* B2 — the geography reads "the South Bay & Peninsula". docs/27-SECTION-9-15's approved
            tagline said "for San Jose and the South Bay & Peninsula", which named the region
            twice in two different shapes inside one sentence and put the forbidden "and the
            South Bay" form in the footer of all 37 routes. The rest of the line is unchanged
            §9.15 copy. This is the NAP wording of record — it must match GBP and Yelp character
            for character, so it is now the same string site.location.serviceArea carries. */}
        {/* 2026-08-21. Was "Property clearing, detailed cleaning, and documented closeout for
            the {region}." The B2 geography ruling above is untouched — the region still renders
            from site.location.serviceArea and nothing else. What changed is the first half:
            "property clearing" led the sitewide tagline on all 46 routes, and a closeout document
            was one of the three things the company was described as selling. */}
        <p class="foot__tagline">
          Specialty property cleaning and complex cleanup for the
          {" "}{site.location.serviceArea}.
        </p>
        {phoneHref && (
          <p class="foot__phone"><a href={phoneHref}>{site.business.phone}</a></p>
        )}
        <p class="foot__email"><a href={`mailto:${site.business.email}`}>{site.business.email}</a></p>
      </div>

      {/* FOUR COLUMNS — doc 30 §6.0 item 11, read off reference page 27: brand and contact,
          Services, Service Area, Company. Legal moved down to the utility bar with the cookie
          control, per docs/aseptaclean-website-design-system.md §24 ("keep legal / privacy links
          in the bottom utility row"). No route was added or removed by the move. */}
      <nav aria-label="Services">
        <h2 class="ac-type-label-head foot__h">Services</h2>
        {launchServiceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      {/* The verified city list from src/data/site.ts, and nothing else. The reference footer
          lists counties; Aseptaclean's own counties are NOT a verified fact in this repository
          (AGENTS.md §3 explicitly rejects "Santa Clara County" as the region because Atherton is
          San Mateo), and inventing a county list would be a service-coverage claim. Plain text,
          not links: no /locations/* route exists and AGENTS.md §2 forbids one. */}
      <div>
        <h2 class="ac-type-label-head foot__h">Service Area</h2>
        <ul class="foot__cities">
          {site.location.cities.map((city) => <li>{city}</li>)}
        </ul>
        <p class="foot__cities-note">
          Additional {site.location.serviceArea} locations reviewed by project.
        </p>
      </div>

      <nav aria-label="Company">
        <h2 class="ac-type-label-head foot__h">Company</h2>
        <a href="/services/">Services</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href={site.offer.contactFormUrl}>{site.offer.secondaryCta}</a>
      </nav>

    </div>

    {/* Legal and consent utilities stay in the low-emphasis bottom bar. */}
    <div class="foot__bot">
      <nav class="foot__utility" aria-label="Legal and preferences">
        <a href={site.urls.privacyPolicy}>Privacy Policy</a>
        <a href={site.urls.terms}>Terms &amp; Conditions</a>
        {site.urls.cookiePolicy && <a href={site.urls.cookiePolicy}>Cookie Policy</a>}
        {termlyConsentEnabled && (
          <button type="button" class="foot__button termly-display-preferences">
            Cookie Preferences
          </button>
        )}
      </nav>

      <p>
        © {year} {site.business.legalName} · Aseptaclean is not a licensed general contractor,
        remediation contractor, pest-control operator, or appraiser.
      </p>
      <p>{legal.scopeDisclaimer} {legal.documentationDisclaimer}</p>
      {termlyConsentEnabled && (
        <noscript>
          <p>
            Cookie Preferences requires JavaScript. The Cookie Policy remains available above, or
            email {site.business.privacyContact || site.business.email} for help.
          </p>
        </noscript>
      )}
    </div>
  </div>
</footer>

<style>
  .foot {
    background: #0a1725;
    padding: 64px 0 0;
    color: #8fa6bf;
    font-size: var(--ac-text-sm);
    line-height: 1.85;
  }

  .foot__g {
    display: grid;
    gap: 36px;
    grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
  }

  .foot__cities {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__cities-note {
    margin: 14px 0 0;
    max-width: 26ch;
    color: #7f96b4;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .foot__utility a {
    display: inline;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot__h {
    margin: 0 0 14px;
    color: #fff;
  }

  .foot__logo {
    display: block;
    margin-bottom: 14px;
  }

  .foot__logo img {
    width: auto;
    height: 28px;
    object-fit: contain;
  }

  .foot__tagline {
    max-width: 30ch;
  }

  .foot__phone {
    margin-top: 14px;
    color: #fff;
    font-weight: 600;
  }

  .foot a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .foot a:hover {
    color: #fff;
  }

  .foot__phone a,
  .foot__email a {
    display: inline;
  }

  .foot__button {
    display: block;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot__button:hover {
    color: #fff;
  }

  .foot__bot {
    border-top: 1px solid rgb(255 255 255 / 12%);
    margin-top: 52px;
    padding: 20px 0 30px;
    /* The mockup's #6E86A2 measures 4.35:1 on #0A1725 and fails WCAG AA for this legal text.
       #7f96b4 clears 5.2:1 in the same muted-steel hue — the same AA correction tokens.css
       already records for --ac-color-ink-400 and the FINAL-v2 footer. */
    color: #7f96b4;
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .foot__bot p + p {
    margin-top: 10px;
  }

  .foot__utility {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 18px;
    gap: 8px 22px;
  }

  .foot__utility a,
  .foot__utility button {
    display: inline;
    font-size: 0.75rem;
  }

  @media (max-width: 1050px) {
    /* minmax(0,1fr) rather than 1fr: a bare 1fr floors at min-content, so the brand
       column's longest word took 141px of the 272px available at 320px and squeezed the
       link column to 95px. Even tracks keep the two columns actually equal. */
    .foot__g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  /* Below ~480px two columns leave ~120px per track, which wrapped nearly every link to
     two lines ("Complex Property Cleanup hub" ran to three). One column gives each link
     the full shell width and removes the wrapping entirely. */
  @media (max-width: 480px) {
    .foot__g {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .foot__tagline {
      max-width: none;
    }
  }
</style>

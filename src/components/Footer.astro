---
// docs/aseptaclean-FINAL-v2.html footer / .fgrid / .flegal — ported verbatim
// (05-DECISIONS-LOG.md).
import { legal, site } from "@data/site";

const year = new Date().getFullYear();
const phoneHref = site.business.phoneUri;
const termlyConsentEnabled = site.integrations.termly.consentEnabled;
---

<footer class="site-footer">
  <div class="ac-measure-wide">
    <div class="fgrid">
      <div>
        <a class="logo footer-logo" href="/">
          <span class="mark" aria-hidden="true">A</span>Asepta<span class="sept">clean</span>
          <span class="visually-hidden">— home</span>
        </a>
        <p>{site.offer.category} for {site.location.serviceArea} and the Peninsula.</p>
      </div>
      {/*
        Footer is the crawl path for pages that are indexable but sit outside the primary nav.
        Before 2026-08-17 the category hubs, /service-areas/, /projects/ and /faq/ were in the
        XML sitemap with ZERO inbound internal links — orphans, which Google crawls rarely and
        passes no internal signal to. Anything indexable belongs in a nav or here.
        /specialty-cleaning/ is deliberately excluded: it is noindex until doc 27 §21 clears.
      */}
      {/* Kept as ONE nav on purpose: .fgrid is a 3-column grid (1.4fr 1fr 1fr) and a fourth
          child would wrap to a second row, which is a layout change. New links are appended
          here instead. */}
      <nav class="flinks" aria-label="Footer navigation">
        <a href="/#request">Request an assessment</a>
        <a href="/services/">Services</a>
        <a href="/detailed-cleaning/">Detailed Cleaning</a>
        <a href="/property-clearing/">Property Clearing</a>
        <a href="/who-we-help/">Who We Help</a>
        <a href="/service-areas/">Service Areas</a>
        <a href="/handoff-standard/">Handoff Standard</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
        {/* /faq/ is a real page as of 2026-08-17; the old /#faq anchor pointed at a homepage
            section and left the standalone route orphaned. */}
        <a href="/faq/">FAQ</a>
      </nav>
      <nav class="flinks" aria-label="Legal and contact">
        <a href="/contact/">Contact</a>
        <a href={`mailto:${site.business.email}`}>{site.business.email}</a>
        {phoneHref && <a href={phoneHref}>{site.business.phone}</a>}
        <a href={site.urls.privacyPolicy}>Privacy</a>
        <a href={site.urls.terms}>Terms</a>
        {site.urls.cookiePolicy && <a href={site.urls.cookiePolicy}>Cookie Policy</a>}
        {termlyConsentEnabled && (
          <button type="button" class="footer-link-button termly-display-preferences">
            Cookie Preferences
          </button>
        )}
      </nav>
    </div>
    <div class="flegal">
      {legal.scopeDisclaimer} {legal.documentationDisclaimer}<br />
      © {year} {site.business.legalName}. All rights reserved.
    </div>
    {termlyConsentEnabled && (
      <noscript>
        <p class="flegal">
          Cookie Preferences requires JavaScript. The Cookie Policy remains
          available above, or email {site.business.privacyContact || site.business.email}
          for help.
        </p>
      </noscript>
    )}
  </div>
</footer>

<style>
  /* docs/aseptaclean-FINAL-v2.html footer / .fgrid / .logo / .flinks / .flegal — ported verbatim */
  .site-footer {
    background: var(--ac-color-navy-950);
    color: #8ea2bc;
    padding-block: clamp(3rem, 5vw, 4rem);
  }

  .fgrid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 16px;
    color: #fff;
    font-family: var(--ac-font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .footer-logo .mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 8px;
    background: #fff;
    color: var(--ac-color-navy-950);
    font-family: var(--ac-font-mono);
    font-weight: 600;
  }

  .footer-logo .sept {
    color: #8fb4de;
  }

  .fgrid p {
    max-width: 44ch;
    color: #7d92ad;
    font-size: 0.88rem;
  }

  .flinks {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .flinks a,
  .footer-link-button {
    color: #c2d0e2;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .flinks a:hover {
    color: #fff;
  }

  .footer-link-button {
    display: inline-flex;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-link-button:hover {
    color: #fff;
  }

  .flegal {
    margin-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 26px;
    /* v2's literal #68809d measures 4.34:1 on navy-950 — fails WCAG AA 4.5:1 for this legal
       disclaimer text (confirmed via Lighthouse). #7891a9 clears 5.41:1, same muted-steel hue. */
    color: #7891a9;
    font-size: 0.76rem;
    line-height: 1.65;
  }

  @media (min-width: 51.25rem) {
    .fgrid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>

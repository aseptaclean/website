---
import { legal, site } from "@data/site";

const year = new Date().getFullYear();
const phoneHref = site.business.phone
  ? `tel:${site.business.phone.replace(/[^\d+]/g, "")}`
  : "";
const termlyConsentEnabled = site.integrations.termly.consentEnabled;
---

<footer class="site-footer">
  <div class="site-footer__main container">
    <div class="site-footer__identity">
      <img
        class="site-footer__wordmark"
        src={site.business.logoReversedUrl}
        width="900"
        height="215"
        alt={site.business.name}
      />
      <p>{site.offer.category} for {site.location.serviceArea}.</p>
      <p class="site-footer__cities">
        Serving {site.location.cities.join(", ")}, and surrounding South Bay communities.
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <a href="/request-assessment/">{site.offer.primaryCta}</a>
      <a href="/#standards">Handoff Standard</a>
      <a href="/#faq">Frequently Asked Questions</a>
      <a class="site-footer__campaign-link" href="/private-residence-reset/">
        Private Residence Reset
      </a>
      <a href={site.urls.privacyPolicy}>Privacy</a>
      <a href={site.urls.terms}>Terms</a>
      {site.urls.cookiePolicy && <a href={site.urls.cookiePolicy}>Cookie Policy</a>}
      {termlyConsentEnabled && (
        <button type="button" class="site-footer__link termly-display-preferences">
          Cookie Preferences
        </button>
      )}
    </nav>

    <address>
      <a href={`mailto:${site.business.email}`}>{site.business.email}</a>
      {phoneHref && <a href={phoneHref}>{site.business.phone}</a>}
      <p>Assessment responses {site.offer.responseTime}.</p>
    </address>
  </div>

  <div class="site-footer__legal container">
    <p>{legal.scopeDisclaimer}</p>
    <p>© {year} {site.business.legalName}. All rights reserved.</p>
  </div>
  {termlyConsentEnabled && (
    <noscript>
      <p class="site-footer__noscript container">
        Cookie Preferences requires JavaScript. The Cookie Policy remains
        available above, or email {site.business.privacyContact || site.business.email}
        for help.
      </p>
    </noscript>
  )}
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-steel-300);
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-navy-900);
    color: var(--color-warm-white);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__wordmark {
    width: min(13rem, 72%);
    height: auto;
    margin-bottom: var(--space-3);
  }

  .site-footer p {
    margin-block: 0;
  }

  .site-footer__cities,
  .site-footer address p {
    margin-top: var(--space-3) !important;
    color: var(--color-steel-300);
    font-size: var(--step--1);
  }

  .site-footer nav,
  .site-footer address {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-2);
    font-style: normal;
  }

  .site-footer a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: var(--color-warm-white);
  }

  .site-footer__link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-warm-white);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-footer__campaign-link {
    color: var(--color-steel-300) !important;
    font-size: var(--text-sm);
  }

  .site-footer__link:hover {
    text-decoration-thickness: 0.12em;
  }

  .site-footer__legal {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid rgb(168 184 200 / 0.35);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    color: var(--color-steel-300);
    font-size: var(--step--1);
  }

  .site-footer__noscript {
    margin-top: var(--space-4);
    color: var(--color-steel-300);
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(0, 2fr) minmax(10rem, 1fr) minmax(12rem, 1fr);
    }

    .site-footer__legal {
      grid-template-columns: minmax(0, 2fr) minmax(12rem, 1fr);
    }
  }
</style>

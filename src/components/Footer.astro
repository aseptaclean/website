---
import { legal, site } from "@data/site";

const year = new Date().getFullYear();
const phoneHref = site.business.phoneUri;
const termlyConsentEnabled = site.integrations.termly.consentEnabled;
---

<footer class="site-footer">
  <div class="site-footer__main ac-measure-wide">
    <div class="site-footer__identity">
      <img
        class="site-footer__wordmark"
        src={site.business.logoReversedUrl}
        width="900"
        height="215"
        alt={site.business.name}
      />
      <p class="ac-type-xs">{site.offer.category} for {site.location.serviceArea}.</p>
      <p class="site-footer__cities ac-type-xs">
        Serving {site.location.cities.join(", ")}, and surrounding South Bay communities.
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <a class="ac-type-xs" href="/request-assessment/">{site.offer.primaryCta}</a>
      <a class="ac-type-xs" href="/#standards">Handoff Standard</a>
      <a class="ac-type-xs" href="/#faq">Frequently Asked Questions</a>
      <a class="site-footer__campaign-link ac-type-xs" href="/private-residence-reset/">
        Private Residence Reset
      </a>
      <a class="ac-type-xs" href={site.urls.privacyPolicy}>Privacy</a>
      <a class="ac-type-xs" href={site.urls.terms}>Terms</a>
      {site.urls.cookiePolicy && <a class="ac-type-xs" href={site.urls.cookiePolicy}>Cookie Policy</a>}
      {termlyConsentEnabled && (
        <button type="button" class="site-footer__link termly-display-preferences ac-type-xs">
          Cookie Preferences
        </button>
      )}
    </nav>

    <address>
      <a class="ac-type-xs" href={`mailto:${site.business.email}`}>{site.business.email}</a>
      {phoneHref && <a class="ac-type-xs" href={phoneHref}>{site.business.phone}</a>}
      <p class="ac-type-xs">Assessment responses {site.offer.responseTime}.</p>
    </address>
  </div>

  <div class="site-footer__legal ac-measure-wide">
    <div class="site-footer__disclaimers">
      <p class="ac-type-xs">{legal.scopeDisclaimer}</p>
      <p class="ac-type-xs">{legal.documentationDisclaimer}</p>
    </div>
    <p class="ac-type-xs">© {year} {site.business.legalName}. All rights reserved.</p>
  </div>
  {termlyConsentEnabled && (
    <noscript>
      <p class="site-footer__noscript ac-measure-wide ac-type-xs">
        Cookie Preferences requires JavaScript. The Cookie Policy remains
        available above, or email {site.business.privacyContact || site.business.email}
        for help.
      </p>
    </noscript>
  )}
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ac-color-steel-on-navy);
    background: var(--ac-color-navy-900);
    color: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-standard);
    padding-bottom: var(--ac-rhythm-tight);
  }

  .site-footer__main {
    display: grid;
    gap: var(--ac-space-6);
  }

  .site-footer__wordmark {
    width: min(13rem, 72%);
    height: auto;
    margin-bottom: var(--ac-space-3);
  }

  .site-footer p {
    margin-block: 0;
  }

  .site-footer__cities,
  .site-footer address p {
    margin-top: var(--ac-space-3) !important;
    color: var(--ac-color-steel-on-navy);
  }

  .site-footer nav,
  .site-footer address {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--ac-space-2);
    font-style: normal;
  }

  .site-footer a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: var(--ac-color-warm-white);
  }

  .site-footer__link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ac-color-warm-white);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-footer__campaign-link {
    color: var(--ac-color-steel-on-navy) !important;
  }

  .site-footer__link:hover {
    text-decoration-thickness: 0.12em;
  }

  .site-footer__legal {
    display: grid;
    gap: var(--ac-space-4);
    border-top: 1px solid rgb(168 184 200 / 0.35);
    margin-top: var(--ac-space-6);
    padding-top: var(--ac-space-5);
    color: var(--ac-color-steel-on-navy);
  }

  .site-footer__disclaimers {
    display: grid;
    gap: var(--ac-space-3);
  }

  .site-footer__noscript {
    margin-top: var(--ac-space-4);
    color: var(--ac-color-steel-on-navy);
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(0, 2fr) minmax(10rem, 1fr) minmax(12rem, 1fr);
    }

    .site-footer__legal {
      grid-template-columns: minmax(0, 2fr) minmax(12rem, 1fr);
    }
  }
</style>

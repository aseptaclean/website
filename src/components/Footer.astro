---
// 2026-08-18 visual port. docs/mockups .foot — five columns (brand + four link groups) over a
// hairline legal bar. Structure and grouping follow doc 27 §23.
//
// LINK SET. The mockup's four columns list every service route. This footer lists the same
// routes the sitewide mega-menu lists and no others, because footer and nav must agree — they
// are both sitewide crawl surfaces, and a route that is unsafe to advertise in one is unsafe
// in the other. The three held items are identical to the header's, for identical reasons
// (see `megaNav` in src/data/site.ts): /rodent-dropping-cleanup-san-jose/ and
// /pigeon-dropping-cleanup-san-jose/ on B&P §8505/§8550(a) plus docs/18-VISUAL-DIRECTION.md §7
// and doc 27 §21, and /projects/ under its own 2026-08-18 removal note ("restore in the same
// change that lifts the noindex — not before").
//
// The legal line is §9.15.5's approved footer legal line, verbatim. The two longer scope and
// documentation disclaimers stay under it: they are verbatim-mandatory from
// docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §2.3/§2.4 by way of src/data/site.ts, and §9.15.5 adds
// a line rather than replacing them.
import { legal, megaNav, site } from "@data/site";

const year = new Date().getFullYear();
const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
const termlyConsentEnabled = site.integrations.termly.consentEnabled;

const linkGroups = megaNav.filter((group) => group.children && group.hub);
const directGroups = megaNav.filter((group) => !group.children);
---

<footer class="foot">
  <div class="ac-shell">
    <div class="foot__g">
      <div>
        <a class="foot__logo" href="/">
          {/* I1 — declared size is the reversed wordmark's actual intrinsic 900×215, not the
              old 180×28 (a 6.43 ratio against a real 4.19). CSS sizes it by height with
              `width: auto`, so the wrong ratio reserved a 180px-wide box and reflowed to 117px
              on decode. Settled rendering is unchanged; the shift is gone.
              I3 — `loading="lazy"`: the footer mark is below the fold on every route, and it was
              the only remaining eagerly-fetched image on an otherwise image-free site. */}
          <img
            src={site.business.logoReversedUrl}
            alt={`${site.business.name} — home`}
            width="900"
            height="215"
            loading="lazy"
            decoding="async"
          />
        </a>
        {/* B2 — the geography reads "the South Bay & Peninsula". docs/27-SECTION-9-15's approved
            tagline said "for San Jose and the South Bay & Peninsula", which named the region
            twice in two different shapes inside one sentence and put the forbidden "and the
            South Bay" form in the footer of all 37 routes. The rest of the line is unchanged
            §9.15 copy. This is the NAP wording of record — it must match GBP and Yelp character
            for character, so it is now the same string site.location.serviceArea carries. */}
        {/* 2026-08-21. Was "Property clearing, detailed cleaning, and documented closeout for
            the {region}." The B2 geography ruling above is untouched — the region still renders
            from site.location.serviceArea and nothing else. What changed is the first half:
            "property clearing" led the sitewide tagline on all 46 routes, and a closeout document
            was one of the three things the company was described as selling. */}
        <p class="foot__tagline">
          Specialty property cleaning and complex cleanup for the
          {" "}{site.location.serviceArea}.
        </p>
        {phoneHref && (
          <p class="foot__phone"><a href={phoneHref}>{site.business.phone}</a></p>
        )}
        <p class="foot__email"><a href={`mailto:${site.business.email}`}>{site.business.email}</a></p>
      </div>

      {linkGroups.map((group) => (
        <nav aria-label={group.label}>
          <h2 class="ac-type-label-head foot__h">{group.label}</h2>
          {group.hub && <a href={group.hub.href}>{group.hub.label} hub</a>}
          {group.children?.map((child) => <a href={child.href}>{child.label}</a>)}
        </nav>
      ))}

    </div>

    {/* The mockup's .foot__g is exactly five tracks: brand + the four service/company groups.
        The direct-link groups and the legal routes go in the bottom bar as an inline row, so
        the grid keeps the mockup's shape instead of wrapping a sixth column under the brand. */}
    <div class="foot__bot">
      <nav class="foot__utility" aria-label="More">
        {directGroups.map((group) => <a href={group.href}>{group.label}</a>)}
        {/* Resource + campaign routes, deliberately in the low-emphasis utility row rather than
            the five-column link grid above.

            /estate-cleanout-checklist/ — docs/19-SYSTEM-AND-SITEMAP.md §2.1 lists it under
            "RESOURCES (footer)" and §2's linking rules say "Checklist ← estate page + footer +
            every letter." The estate-page link shipped with the 2026-08-20 launch; this is the
            footer half of the same rule, and it was the missing one. Anchor text is the asset's
            own approved title (src/data/servicePages.ts), not a written-for-SEO phrase.

            /private-residence-reset/ — an 814-word commercial page with Service schema that had
            ZERO inbound links anywhere in the build (register P13). AGENTS.md §2 records it as a
            "campaign page, out of nav", so it does NOT go in megaNav: that export feeds both the
            header mega-panel and the footer link grid, and putting it there would put a campaign
            route into primary navigation. One low-emphasis crawlable link here satisfies
            discoverability without contradicting the out-of-nav ruling. Anchor text is
            site.residenceOffer.name, the label the page itself renders. */}
        <a href="/estate-cleanout-checklist/">The Executor's Estate Cleanout Checklist</a>
        <a href="/private-residence-reset/">{site.residenceOffer.name}</a>
        {/* ONE LABEL FOR /request-assessment/, 2026-08-25 —
            docs/ASEPTACLEAN-CODEX-HOMEPAGE-BRIEF-V3-LEAN-SEVENSON.md §17: "Fix duplicate
            destinations/labels. Do not list the assessment route twice under different names."
            The footer was exposing one route twice: the Company column rendered megaNav's
            "Request an assessment" child, and this row rendered site.offer.primaryCta, so the
            same href shipped as two differently-named links a few hundred pixels apart on all 45
            routes.

            The megaNav child is the one that was removed (see src/data/site.ts) — it also fed the
            header Company dropdown, where "Request an assessment" sat directly beneath a navy
            button reading "Tell Us About the Property" pointing at the same place. This slot
            survives because site.offer.primaryCta is the single owner-approved visible label for
            this route (2026-08-25 ruling); the nav child was the stale spelling of it. */}
        <a href="/request-assessment/">{site.offer.primaryCta}</a>
        {/* doc 27 §8 — the secondary CTA appears everywhere the primary does. */}
        {smsHref && <a href={smsHref}>{site.offer.secondaryCta}</a>}
        <a href={site.urls.privacyPolicy}>Privacy</a>
        <a href={site.urls.terms}>Terms</a>
        {site.urls.cookiePolicy && <a href={site.urls.cookiePolicy}>Cookie Policy</a>}
        {termlyConsentEnabled && (
          <button type="button" class="foot__button termly-display-preferences">
            Cookie Preferences
          </button>
        )}
      </nav>

      <p>
        © {year} {site.business.legalName} · Aseptaclean is not a licensed general contractor,
        remediation contractor, pest-control operator, or appraiser.
      </p>
      <p>{legal.scopeDisclaimer} {legal.documentationDisclaimer}</p>
      {termlyConsentEnabled && (
        <noscript>
          <p>
            Cookie Preferences requires JavaScript. The Cookie Policy remains available above, or
            email {site.business.privacyContact || site.business.email} for help.
          </p>
        </noscript>
      )}
    </div>
  </div>
</footer>

<style>
  .foot {
    background: #0a1725;
    padding: 64px 0 0;
    color: #8fa6bf;
    font-size: var(--ac-text-sm);
    line-height: 1.85;
  }

  .foot__g {
    display: grid;
    gap: 36px;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
  }

  .foot__h {
    margin: 0 0 14px;
    color: #fff;
  }

  .foot__logo {
    display: block;
    margin-bottom: 14px;
  }

  .foot__logo img {
    width: auto;
    height: 28px;
    object-fit: contain;
  }

  .foot__tagline {
    max-width: 30ch;
  }

  .foot__phone {
    margin-top: 14px;
    color: #fff;
    font-weight: 600;
  }

  .foot a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .foot a:hover {
    color: #fff;
  }

  .foot__phone a,
  .foot__email a {
    display: inline;
  }

  .foot__button {
    display: block;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot__button:hover {
    color: #fff;
  }

  .foot__bot {
    border-top: 1px solid rgb(255 255 255 / 12%);
    margin-top: 52px;
    padding: 20px 0 30px;
    /* The mockup's #6E86A2 measures 4.35:1 on #0A1725 and fails WCAG AA for this legal text.
       #7f96b4 clears 5.2:1 in the same muted-steel hue — the same AA correction tokens.css
       already records for --ac-color-ink-400 and the FINAL-v2 footer. */
    color: #7f96b4;
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .foot__bot p + p {
    margin-top: 10px;
  }

  .foot__utility {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 18px;
    gap: 8px 22px;
  }

  .foot__utility a,
  .foot__utility button {
    display: inline;
    font-size: 0.75rem;
  }

  @media (max-width: 1050px) {
    /* minmax(0,1fr) rather than 1fr: a bare 1fr floors at min-content, so the brand
       column's longest word took 141px of the 272px available at 320px and squeezed the
       link column to 95px. Even tracks keep the two columns actually equal. */
    .foot__g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  /* Below ~480px two columns leave ~120px per track, which wrapped nearly every link to
     two lines ("Complex Property Cleanup hub" ran to three). One column gives each link
     the full shell width and removes the wrapping entirely. */
  @media (max-width: 480px) {
    .foot__g {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .foot__tagline {
      max-width: none;
    }
  }
</style>

---
// 2026-08-18 visual port. docs/mockups .formsec + .stepform — navy band, copy column left,
// white 8px-radius form card right. Presentation-only: it still wires the existing
// QuickHandoffForm (lead endpoint, Turnstile, consent, honeypot). PORT-PROMPT §4 — the
// endpoint and its plumbing are untouched.
//
// Copy: doc 27 §9.13 eyebrow, H2 and body — the body carries §9.15.2 amendment 3, which
// replaces "Include the city, approximate size, current condition and deadline." with the
// phone-photos sentence. The callout is §9.15.1's Form callout heading and body, which
// supersede the mockup's own "Need the full intake instead?" wording.
//
// NO 01/02/03 RAIL HERE, deliberately. PORT-PROMPT §3 asks for the stepped rail "on every form
// instance", and the mockup draws one with the labels "Your details / The property / Photos &
// deadline". Those three strings exist only in the mockup — not in §9.15, not in doc 27 — and
// §1 forbids writing copy to fill a slot. They would also misdescribe this form, which doc 27
// §18 defines as a single four-field compact form, not a three-step one. The white 8px card
// ships; the rail ships on /request-assessment/, where the three step labels are real,
// already-approved copy in src/data/assessment.ts. Reported as an unfilled slot, not written.
// §9.15.1 defines TWO form callouts, not one: the Homepage table (§9.15.1 "Homepage") and the
// Service pages table (§9.15.1 "Service pages (all 14)"). This component is shared by `/`,
// the four hubs, /about/, /faq/, /service-areas/ and all 14 service pages, and shipped the
// homepage pair everywhere. The props below let a caller pass the service-page pair; the
// defaults remain the homepage strings, which is what every other caller should keep — no
// approved callout exists for hubs or company pages, so those must not be given one.
import QuickHandoffForm from "@components/QuickHandoffForm.astro";

interface Props {
  calloutHeading?: string;
  calloutBody?: string;
}

const {
  calloutHeading = "Have a bigger or more complicated property?",
  calloutBody = "The full assessment form captures access, decision authority, deadline, and disposal detail — useful when more than one person is involved in the decision."
} = Astro.props;
---

<section class="ac-sec ac-formsec" id="request" aria-labelledby="request-title">
  <div class="ac-shell">
    <div class="ac-two request__two">
      <div>
        <p class="ac-label ac-label--on-dark">Request an assessment</p>
        <h2 id="request-title" class="ac-type-h2">Tell us about the property.</h2>
        <p class="ac-formsec__lede">
          Tell us the city, roughly how big it is, what shape it&rsquo;s in, and when it has to be
          done. Two or three phone photos are more useful than a long description.
        </p>

        <div class="ac-callout">
          <b>{calloutHeading}</b>
          <span>{calloutBody}</span>
        </div>
      </div>

      <div class="ac-stepform request__card">
        <QuickHandoffForm formId="request-quick-form" entryRoute="/#request" />
      </div>
    </div>
  </div>
</section>

<style>
  .request__two {
    align-items: start;
    gap: 60px;
  }

  /* Single-column .ac-stepform: no rail track, so the form card fills the whole grid. */
  .request__card {
    grid-template-columns: 1fr;
  }
</style>

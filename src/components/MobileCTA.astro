---
// MOBILE CALL BAR — the fixed bottom action bar below 760px.
//
// REBUILT 2026-09-04. It previously rendered up to three actions with per-route variants for ten
// individual paths, all of them citing specs the documentation consolidation retired. It now
// renders the same two actions on every route, in the sitewide hierarchy: Call Aseptaclean
// (filled, wider, first) then Send a Message (quiet, to Contact's form).
//
// doc 30 §3 permits this control only "if it does not obscure forms, content, focus, or cookie
// controls and the page reserves its actual height plus safe-area inset". The reservation is
// `body.has-mobile-cta` in global.css; the safe-area padding is on the anchors, not the
// container, so each button keeps its fill to the physical screen edge while its text sits above
// the home indicator.
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

{/* CALL-FIRST, 2026-09-04. AGENTS.md §2.2.2 and docs/03-INTEGRATION-CONTRACT.md make
    Call Aseptaclean the primary action; this bar is the most persistent action surface on the
    site, so the call is now FIRST in DOM and reading order, filled, and the wider of the two.

    Two changes from the previous bar:
      1. It rendered "Call now", a label that existed nowhere else. It now renders the one
         approved primary string from site.offer, so no surface has its own private wording.
      2. "Request an assessment" was first and widest. The message action is secondary and
         takes the narrower slot, pointing at Contact's form like every other secondary. */}
<div class="mbar">
  {/* Suppression rule (AGENTS.md §3): never render an empty phone link. */}
  {phoneHref && <a class="mbar__call" href={phoneHref}>{site.offer.primaryCta}</a>}
  <a class="mbar__message" href={site.offer.contactFormUrl}>{site.offer.secondaryCta}</a>
</div>

<style>
  .mbar {
    display: none;
  }

  @media (max-width: 760px) {
    .mbar {
      position: fixed;
      z-index: 80;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      border-top: 1px solid rgb(255 255 255 / 15%);
    }

    .mbar a {
      display: flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      flex: 1;
      box-sizing: border-box;
      padding: 15px 8px;
      /* SAFE-AREA INSET, 2026-08-26. The bar is `bottom: 0` fixed, so on a device with a home
         indicator its lower band sat under the system gesture area — on the homepage that band
         is the bottom of the primary conversion action. The padding goes on the ANCHORS, not on
         .mbar: each half carries its own fill, and padding the container would have left a
         transparent strip of page showing through beneath both buttons. Each button therefore
         keeps its own colour all the way to the physical screen edge while its tappable text
         sits above the indicator. Zero on every device that reports no inset. */
      padding-bottom: calc(15px + env(safe-area-inset-bottom, 0px));
      font-size: 0.875rem;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
    }

    /* The call is the dominant action: filled navy and the wider slot. */
    .mbar__call {
      flex: 1.7;
      background: var(--ac-color-navy-800);
      color: #fff;
    }

    /* Secondary: quiet, on paper, so one saturated fill carries the hierarchy. */
    .mbar__message {
      flex: 1;
      border-left: 1px solid var(--ac-color-line-strong);
      background: var(--ac-color-paper);
      color: var(--ac-color-navy-900);
    }

  }

  /* Two slots now, but the tightened type and padding still earn their place: they keep the bar
     one row tall at 390px with the longer approved labels. */
  @media (max-width: 400px) {
    .mbar a {
      padding: 12px 4px;
      padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      font-size: 0.78125rem;
      line-height: 1.25;
    }
  }
</style>

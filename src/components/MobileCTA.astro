---
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<aside class="mobile-cta" aria-label="Request an assessment" hidden>
  {
    phoneHref && (
      <a class="mobile-cta__tel" href={phoneHref} aria-label={`Call ${site.business.phone}`}>
        Call {site.business.phone}
      </a>
    )
  }
  <a class="button mobile-cta__button" href="/request-assessment/">{site.offer.primaryCta}</a>
</aside>

<script>
  const stickyCta = document.querySelector<HTMLElement>(".mobile-cta");
  const heroFormBlock = document.querySelector<HTMLElement>(".hero__form-block");
  const finalCta = document.querySelector<HTMLElement>(".final-cta");
  const footer = document.querySelector<HTMLElement>(".site-footer");
  const scrollThreshold = 400;
  let heroFormVisible = Boolean(heroFormBlock);
  let finalCtaVisible = false;
  let footerVisible = false;
  let pastScrollThreshold = window.scrollY > scrollThreshold;

  const updateStickyCta = () => {
    if (!stickyCta) return;
    stickyCta.hidden =
      !pastScrollThreshold || heroFormVisible || finalCtaVisible || footerVisible;
  };

  if (stickyCta) {
    if (heroFormBlock) {
      const heroObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          heroFormVisible = entry.isIntersecting;
          updateStickyCta();
        },
        { threshold: 0.15 }
      );
      heroObserver.observe(heroFormBlock);
    }

    if (footer) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          footerVisible = entry.isIntersecting;
          updateStickyCta();
        },
        { threshold: 0.01 }
      );
      footerObserver.observe(footer);
    }

    if (finalCta) {
      const finalCtaObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          finalCtaVisible = entry.isIntersecting;
          updateStickyCta();
        },
        { threshold: 0.01 }
      );
      finalCtaObserver.observe(finalCta);
    }

    window.addEventListener(
      "scroll",
      () => {
        pastScrollThreshold = window.scrollY > scrollThreshold;
        updateStickyCta();
      },
      { passive: true }
    );

    updateStickyCta();
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    z-index: 18;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ac-space-3);
    min-height: var(--ac-sticky-cta-height);
    border-top: 1px solid var(--ac-color-rule);
    padding: var(--ac-space-3) var(--ac-gutter);
    padding-bottom: max(var(--ac-space-3), env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--ac-color-paper) 97%, transparent);
  }

  .mobile-cta__tel {
    flex-shrink: 0;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-xs);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .mobile-cta__button {
    flex: 1;
    max-width: 20rem;
  }

  .mobile-cta[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .mobile-cta {
      display: none;
    }
  }
</style>

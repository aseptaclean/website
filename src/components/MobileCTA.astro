---
// 2026-08-18 visual port. docs/mockups .mbar — the bottom mobile action bar: navy "Request an
// assessment" beside an amber "Call now", fixed to the viewport bottom below 760px, always
// visible rather than scroll-revealed. That replaces the FINAL-v2 .sticky-bar and its
// IntersectionObserver, which the mockup has no equivalent for; the CSS-only version has no
// script at all, so it cannot fail to appear before hydration.
//
// The amber half is the second and last use of --ac-color-amber on any page, alongside the
// deadline band (owner ruling D1's "one rationed accent").
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<div class="mbar">
  <a href="/request-assessment/">{site.offer.primaryCta}</a>
  {/* Suppression rule (AGENTS.md §3): never render an empty phone link. */}
  {phoneHref && <a href={phoneHref}>Call now</a>}
</div>

<style>
  .mbar {
    display: none;
  }

  @media (max-width: 760px) {
    .mbar {
      position: fixed;
      z-index: 80;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      border-top: 1px solid rgb(255 255 255 / 15%);
    }

    .mbar a {
      flex: 1;
      padding: 15px 8px;
      font-size: 0.875rem;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
    }

    .mbar a:first-child {
      background: var(--ac-color-navy-800);
      color: #fff;
    }

    .mbar a:last-child {
      background: var(--ac-color-amber);
      color: #2a1d02;
    }
  }
</style>

---
// 2026-08-18 visual port. docs/mockups .band — the amber deadline band. Owner ruling D1
// (§9.15.3): KEEP amber #C8912E as the site's sole warm accent, one rationed accent against
// navy. Tokenised as --ac-color-amber; docs/18-VISUAL-DIRECTION.md §4/§6 row 5's "one accent
// band per page, maximum" still holds.
//
// Copy defaults are doc 27 §9.7 verbatim: heading, supporting line, CTA. The supporting line
// reads site.offer.responseTime rather than hardcoding "within one business day" (AGENTS.md §3).
//
// Parameterised 2026-08-19. §9.15.1 "Company pages" and §9.15.5 "FAQ / Projects connective"
// approve two further bands on this same mockup pattern (.band) — /service-areas/ and /faq/.
// Props rather than a second component: PORT-PROMPT §3 forbids a parallel file where one
// exists. Doc 18 §4/§6 row 5's "one accent band per page, maximum" still governs the callers.
import { site } from "@data/site";

interface Props {
  heading?: string;
  headingId?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = "Working against a listing, transfer or family deadline?",
  headingId = "deadline-band-title",
  ctaLabel = site.offer.primaryCta,
  ctaHref = "/request-assessment/"
} = Astro.props;
---

<section class="ac-band" aria-labelledby={headingId}>
  <div class="ac-shell">
    <div>
      <h3 id={headingId} class="ac-type-h3-band">{heading}</h3>
      <p>Assessment response {site.offer.responseTime}</p>
    </div>
    <a href={ctaHref}>
      {ctaLabel} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

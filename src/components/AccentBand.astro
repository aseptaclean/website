---
// 2026-08-18 visual port. docs/mockups .band — the amber deadline band. Owner ruling D1
// (§9.15.3): KEEP amber #C8912E as the site's sole warm accent, one rationed accent against
// navy. Tokenised as --ac-color-amber; docs/18-VISUAL-DIRECTION.md §4/§6 row 5's "one accent
// band per page, maximum" still holds.
//
// Copy is doc 27 §9.7 verbatim: heading, supporting line, CTA. The supporting line reads
// site.offer.responseTime rather than hardcoding "within one business day" (AGENTS.md §3).
import { site } from "@data/site";
---

<section class="ac-band" aria-labelledby="deadline-band-title">
  <div class="ac-shell">
    <div>
      <h3 id="deadline-band-title" class="ac-type-h3-band">
        Working against a listing, transfer or family deadline?
      </h3>
      <p>Assessment response {site.offer.responseTime}</p>
    </div>
    <a href="/request-assessment/">
      {site.offer.primaryCta} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

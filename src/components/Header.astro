---
import {
  debrisRemovalPage,
  deepCleaningPage,
  estatePage,
  extremeCleaningPage,
  hoardingPage,
  moveOutCleaningPage,
  propertyCleanoutsPage
} from "@data/doc27ServicePages";
import { megaNav, site } from "@data/site";

const normalizePath = (value: string) => {
  const path = value.split(/[?#]/, 1)[0] || "/";
  return path === "/" ? "/" : `/${path.replace(/^\/+|\/+$/g, "")}/`;
};
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href?: string) => Boolean(href && normalizePath(href) === currentPath);

// Header service links are derived from current service records. Gated records never enter the
// set, so the global header cannot advertise one merely because it remains in legacy megaNav.
const currentServiceRecords = [
  deepCleaningPage,
  moveOutCleaningPage,
  extremeCleaningPage,
  propertyCleanoutsPage,
  hoardingPage,
  estatePage,
  debrisRemovalPage
];
const indexableServicePaths = new Set(
  currentServiceRecords.filter((page) => page.indexable).map((page) => page.slug)
);
const headerServiceGroups = megaNav
  .filter((group) => group.children && group.hub)
  .map((group) => ({
    label: group.label,
    hub:
      group.hub && ["/detailed-cleaning/", "/property-clearing/"].includes(group.hub.href)
        ? group.hub
        : undefined,
    children: group.children?.filter((child) => indexableServicePaths.has(child.href)) ?? []
  }))
  .filter((group) => group.hub || group.children.length > 0);

const primaryLinks = [
  { label: "What We Handle", href: "/who-we-help/" },
  { label: "How We Work", href: "/handoff-standard/" },
  { label: "About", href: "/about/" },
  { label: "Service Areas", href: "/service-areas/" }
] as const;
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__inner">
    <a class="site-nav__logo" href="/" aria-current={isCurrent("/") ? "page" : undefined}>
      <img
        src={site.business.logoUrl}
        alt={`${site.business.name} — home`}
        width="900"
        height="215"
      />
    </a>

    <div class="site-nav__desktop">
      <a href="/who-we-help/" aria-current={isCurrent("/who-we-help/") ? "page" : undefined}>
        What We Handle
      </a>

      <details class="services-menu" data-services-menu>
        <summary>Services</summary>
        <div class="services-menu__panel">
          <div class="services-menu__inner">
            <div class="services-menu__intro">
              <p>Current services</p>
              <h2 class="ac-type-h4-mega">Property work with the scope defined first.</h2>
              <a href="/services/" aria-current={isCurrent("/services/") ? "page" : undefined}>
                View all current services
              </a>
            </div>

            <div class="services-menu__groups">
              {headerServiceGroups.map((group) => (
                <section aria-label={group.label}>
                  {group.hub ? (
                    <a
                      class="services-menu__group-heading"
                      href={group.hub.href}
                      aria-current={isCurrent(group.hub.href) ? "page" : undefined}
                    >
                      {group.hub.label}
                    </a>
                  ) : (
                    <p class="services-menu__group-heading">{group.label}</p>
                  )}
                  {group.children.map((child) => (
                    <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                      <strong>{child.label}</strong>
                      <span>{child.note}</span>
                    </a>
                  ))}
                </section>
              ))}
            </div>
          </div>
        </div>
      </details>

      {primaryLinks.slice(1).map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </div>

    {/* DUPLICATE PHONE REMOVED 2026-08-25 — docs/ASEPTACLEAN-CODEX-HOMEPAGE-BRIEF-V3-LEAN-SEVENSON.md
        §8: "Do not show the same phone number twice inside the header hierarchy. Choose the most
        useful location." The number rendered here AND in the utility bar directly above, both
        visible at the same time on every route above 70rem.

        The utility bar keeps it. It is the conventional location in the reference direction, it
        is the first thing in the document, and it survives at every width — this slot did not,
        because the whole actions group is hidden when the nav collapses. Removing it also buys
        back ~117px of horizontal space, which is what lets the full navigation and the primary
        CTA both survive at 1024px (see the breakpoint note in the style block). The phone is
        still reachable from the mobile drawer, the footer, the closing CTA and the mobile bar. */}
    <div class="site-nav__actions">
      <a
        class="site-nav__cta"
        href="/request-assessment/"
        aria-current={isCurrent("/request-assessment/") ? "page" : undefined}
      >
        {site.offer.primaryCta}
      </a>
    </div>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Open navigation"><span aria-hidden="true"></span></summary>
      <div class="mobile-nav__drawer">
        <div class="mobile-nav__top">
          <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>
            <img
              src={site.business.logoUrl}
              alt={`${site.business.name} — home`}
              width="900"
              height="215"
            />
          </a>
        </div>

        <div class="mobile-nav__content">
          <a class="mobile-nav__primary-link" href="/who-we-help/">What We Handle</a>

          <details class="mobile-nav__services">
            <summary>Services</summary>
            <div>
              <a href="/services/">All current services</a>
              {headerServiceGroups.map((group) => (
                <section aria-label={group.label}>
                  {group.hub ? (
                    <a class="mobile-nav__group" href={group.hub.href}>{group.hub.label}</a>
                  ) : (
                    <p class="mobile-nav__group">{group.label}</p>
                  )}
                  {group.children.map((child) => <a href={child.href}>{child.label}</a>)}
                </section>
              ))}
            </div>
          </details>

          {primaryLinks.slice(1).map((link) => (
            <a class="mobile-nav__primary-link" href={link.href}>{link.label}</a>
          ))}
        </div>

        <div class="mobile-nav__actions">
          <a class="mobile-nav__cta" href="/request-assessment/">{site.offer.primaryCta}</a>
          {site.business.phoneUri && (
            <a class="mobile-nav__phone" href={site.business.phoneUri}>
              Call {site.business.phone}
            </a>
          )}
        </div>
      </div>
    </details>
  </div>
</nav>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
  const servicesMenu = document.querySelector<HTMLDetailsElement>("[data-services-menu]");

  mobileNav?.addEventListener("toggle", () => {
    document.body.classList.toggle("is-navigation-open", mobileNav.open);
    const summary = mobileNav.querySelector<HTMLElement>(":scope > summary");
    summary?.setAttribute("aria-label", mobileNav.open ? "Close navigation" : "Open navigation");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (servicesMenu?.open) servicesMenu.open = false;
    if (mobileNav?.open) {
      mobileNav.open = false;
      mobileNav.querySelector<HTMLElement>(":scope > summary")?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (!servicesMenu?.open) return;
    const target = event.target as Node | null;
    if (target && !servicesMenu.contains(target)) servicesMenu.open = false;
  });

  // Must stay in step with the collapse breakpoint in the style block (max-width: 63.9375rem).
  // If the drawer is open and the viewport grows past it, the desktop bar returns and the drawer
  // has to close with it or focus is trapped behind an invisible overlay.
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches && mobileNav?.open) mobileNav.open = false;
  });
</script>

<style>
  .site-nav {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--ac-color-line);
    background: var(--ac-color-paper);
  }

  .site-nav__inner {
    position: relative;
    display: flex;
    width: min(100% - 64px, 1504px);
    min-height: 68px;
    align-items: center;
    margin-inline: auto;
  }

  .site-nav__logo {
    display: flex;
    flex: 0 0 auto;
    min-height: 48px;
    align-items: center;
  }

  .site-nav__logo img,
  .mobile-nav__top img {
    width: auto;
    height: 34px;
  }

  .site-nav__desktop {
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    justify-content: center;
    margin-inline: clamp(28px, 4vw, 68px);
    gap: clamp(24px, 2.4vw, 38px);
  }

  .site-nav__desktop > a,
  .services-menu > summary {
    display: flex;
    min-height: 68px;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--ac-color-ink-900);
    font-size: 0.875rem;
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .site-nav__desktop > a:hover,
  .site-nav__desktop > a[aria-current="page"],
  .services-menu[open] > summary,
  .services-menu > summary:hover {
    border-bottom-color: var(--ac-color-navy-800);
    color: var(--ac-color-navy-800);
  }

  .services-menu {
    position: static;
  }

  .services-menu > summary {
    list-style: none;
  }

  .services-menu > summary::-webkit-details-marker,
  .mobile-nav > summary::-webkit-details-marker,
  .mobile-nav__services > summary::-webkit-details-marker {
    display: none;
  }

  .services-menu > summary::after {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    margin: -4px 0 0 8px;
    content: "";
    transform: rotate(45deg);
  }

  .services-menu[open] > summary::after {
    margin-top: 4px;
    transform: rotate(225deg);
  }

  .services-menu__panel {
    position: absolute;
    right: 0;
    left: 0;
    top: 100%;
    border-top: 1px solid var(--ac-color-line);
    border-bottom: 1px solid var(--ac-color-line);
    background: var(--ac-color-paper);
  }

  .services-menu__inner {
    display: grid;
    width: min(100% - 64px, 1504px);
    margin-inline: auto;
    padding-block: 42px 46px;
    gap: 52px;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 2.3fr);
  }

  .services-menu__intro {
    border-right: 1px solid var(--ac-color-line);
    padding-right: 44px;
  }

  .services-menu__intro > p {
    margin: 0 0 16px;
    color: var(--ac-color-ink-500);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services-menu__intro > h2 {
    max-width: 18ch;
  }

  .services-menu__intro > a {
    display: inline-block;
    margin-top: 22px;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .services-menu__groups {
    display: grid;
    gap: 44px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .services-menu__groups section {
    min-width: 0;
  }

  .services-menu__group-heading {
    display: block;
    min-height: 44px;
    border-bottom: 1px solid var(--ac-color-line-strong);
    margin: 0 0 10px;
    padding: 0 0 12px;
    color: var(--ac-color-navy-900);
    font-size: 0.875rem;
    font-weight: 800;
    text-decoration: none;
  }

  .services-menu__groups section > a:not(.services-menu__group-heading) {
    display: block;
    border-bottom: 1px solid var(--ac-color-line);
    padding: 12px 0;
    color: var(--ac-color-ink-900);
    text-decoration: none;
  }

  .services-menu__groups strong,
  .services-menu__groups span {
    display: block;
  }

  .services-menu__groups strong {
    font-size: 0.875rem;
  }

  .services-menu__groups span {
    margin-top: 3px;
    color: var(--ac-color-ink-500);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .services-menu__groups a:hover strong,
  .services-menu__groups a[aria-current="page"] strong {
    color: var(--ac-color-blue-deep);
  }

  .site-nav__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    margin-left: auto;
    gap: 16px;
  }

  .site-nav__cta {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: 20px;
    background: var(--ac-color-navy-800);
    color: var(--ac-color-paper);
    font-size: 0.8125rem;
    font-weight: 750;
    white-space: nowrap;
    text-decoration: none;
  }

  .site-nav__cta:hover {
    background: var(--ac-color-navy-900);
    color: var(--ac-color-paper);
  }

  .mobile-nav {
    display: none;
    margin-left: auto;
  }

  .mobile-nav > summary {
    position: relative;
    z-index: 112;
    display: flex;
    width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav > summary span,
  .mobile-nav > summary span::before,
  .mobile-nav > summary span::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ac-color-navy-900);
    content: "";
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .mobile-nav > summary span {
    position: relative;
  }

  .mobile-nav > summary span::before,
  .mobile-nav > summary span::after {
    position: absolute;
    left: 0;
  }

  .mobile-nav > summary span::before {
    top: -7px;
  }

  .mobile-nav > summary span::after {
    top: 7px;
  }

  .mobile-nav[open] > summary {
    position: fixed;
    top: 15px;
    right: max(20px, calc((100vw - 1320px) / 2));
  }

  .mobile-nav[open] > summary span {
    background: transparent;
  }

  .mobile-nav[open] > summary span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-nav[open] > summary span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav__drawer {
    position: fixed;
    z-index: 110;
    inset: 0;
    overflow-y: auto;
    background: var(--ac-color-paper);
  }

  .mobile-nav__top {
    display: flex;
    min-height: 64px;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-line);
    padding-inline: 26px 84px;
  }

  .mobile-nav__top a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
  }

  .mobile-nav__content {
    padding: 12px 26px 24px;
  }

  .mobile-nav__primary-link,
  .mobile-nav__services > summary {
    display: flex;
    min-height: 58px;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-line);
    color: var(--ac-color-ink-900);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav__services > summary {
    justify-content: space-between;
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav__services > summary::after {
    content: "+";
    font-size: 1.4rem;
    font-weight: 400;
  }

  .mobile-nav__services[open] > summary::after {
    content: "−";
  }

  .mobile-nav__services > div {
    border-bottom: 1px solid var(--ac-color-line-strong);
    padding: 10px 0 20px 18px;
  }

  .mobile-nav__services section {
    margin-top: 18px;
  }

  .mobile-nav__services a,
  .mobile-nav__group {
    display: flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-ink-600);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .mobile-nav__group {
    margin: 0;
    color: var(--ac-color-navy-900);
    font-weight: 800;
  }

  .mobile-nav__actions {
    display: grid;
    padding: 8px 26px 36px;
    gap: 10px;
  }

  .mobile-nav__cta,
  .mobile-nav__phone {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    font-weight: 750;
    text-align: center;
    text-decoration: none;
  }

  .mobile-nav__cta {
    background: var(--ac-color-navy-800);
    color: var(--ac-color-paper);
  }

  .mobile-nav__phone {
    border: 1px solid var(--ac-color-navy-800);
    color: var(--ac-color-navy-900);
  }

	:global(body.is-navigation-open .mbar) {
		display: none;
	}

  /* COLLAPSE MOVED FROM 70rem (1120px) TO 63.9375rem (1023px), 2026-08-25 —
     docs/ASEPTACLEAN-CODEX-HOMEPAGE-BRIEF-V3-LEAN-SEVENSON.md §8: "Do not collapse the full
     navigation too early. At approximately 1024px: preserve full navigation if it fits; keep the
     primary CTA visible; drop/reduce less important phone duplication before collapsing the whole
     nav." The audited header did the opposite — it dropped the entire navigation AND the primary
     CTA at 1120px, so a 1024px tablet got a hamburger while 117px of the bar was spent on a phone
     number the utility strip was already showing.

     §8's order is followed literally: the phone came out first (see the markup note above), and
     only then was the breakpoint lowered. Measured at 1024px the row needs ~905px of the 984px
     available — logo 142, nav 521 incl. gaps, CTA 208, plus the 2×28px minimum side margins —
     so the full navigation and the CTA both fit with headroom. Below 1024 it genuinely does not
     fit, and the drawer takes over. 63.9375rem rather than 64rem so that exactly 1024px keeps
     the desktop bar; the two queries must stay mutually exclusive. */
  @media (max-width: 63.9375rem) {
    .site-nav__inner {
      width: min(100% - 40px, 1504px);
      min-height: 64px;
      align-items: center;
    }

    .site-nav__desktop,
    .site-nav__actions {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .site-nav__inner {
      width: calc(100% - 40px);
    }

    .site-nav__logo img,
    .mobile-nav__top img {
      height: 30px;
    }

    .mobile-nav__top {
      min-height: 64px;
      padding-left: 20px;
    }

    .mobile-nav__content,
    .mobile-nav__actions {
      padding-inline: 20px;
    }

    .mobile-nav[open] > summary {
      top: 8px;
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav > summary span,
    .mobile-nav > summary span::before,
    .mobile-nav > summary span::after {
      transition: none;
    }
  }

  @media print {
    .site-nav,
    .mobile-nav__drawer {
      display: none;
    }
  }
</style>

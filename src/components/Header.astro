---
import { navigation, site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<header class="site-header">
  <div class="site-header__inner ac-measure-wide">
    <a class="site-header__brand" href="/" aria-label={`${site.business.name} home`}>
      <img
        src={site.business.logoUrl}
        width="900"
        height="215"
        alt=""
      />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li class="ac-type-xs"><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      {
        phoneHref && (
          <a class="site-header__tel ac-type-xs" href={phoneHref}>{site.business.phone}</a>
        )
      }
      <a class="button" href="/request-assessment/">{site.offer.primaryCta}</a>
    </nav>

    <div class="site-header__mobile-actions">
      {
        phoneHref && (
          <a
            class="site-header__tel site-header__tel--compact ac-type-xs"
            href={phoneHref}
            aria-label={`Call ${site.business.phone}`}
          >
            {site.business.phone}
          </a>
        )
      }

      <details class="mobile-nav">
        <summary aria-label="Open navigation">
          <span class="ac-type-sm">Menu</span>
          <span class="mobile-nav__mark" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <ul>
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const condenseThreshold = 48;

  if (siteHeader) {
    const updateCondensed = () => {
      siteHeader.classList.toggle("site-header--condensed", window.scrollY > condenseThreshold);
    };

    window.addEventListener("scroll", updateCondensed, { passive: true });
    updateCondensed();
  }

  const mobileNavigation = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  const mobileNavigationSummary =
    mobileNavigation?.querySelector<HTMLElement>("summary");

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileNavigation?.open) {
      mobileNavigation.open = false;
      mobileNavigationSummary?.focus();
    }
  });

  mobileNavigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNavigation.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--ac-color-rule);
    background: color-mix(in srgb, var(--ac-color-warm-white) 96%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--ac-space-4);
    transition: min-height var(--ac-transition-fast);
  }

  .site-header--condensed .site-header__inner {
    min-height: 3.5rem;
  }

  .site-header__brand {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    text-decoration: none;
  }

  .site-header__brand img {
    width: clamp(8.75rem, 40vw, 10.5rem);
    height: auto;
    transition: width var(--ac-transition-fast);
  }

  .site-header--condensed .site-header__brand img {
    width: clamp(7.5rem, 32vw, 8.5rem);
  }

  .desktop-nav {
    display: none;
  }

  .site-header__tel {
    flex-shrink: 0;
    color: var(--ac-color-navy-900);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__mobile-actions {
    display: flex;
    align-items: center;
    gap: var(--ac-space-3);
  }

  .site-header__tel--compact {
    font-size: clamp(0.7rem, 3vw, var(--ac-text-xs));
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav summary {
    display: flex;
    min-width: 4.75rem;
    min-height: 3rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: flex-end;
    gap: var(--ac-space-2);
    color: var(--ac-color-navy-900);
    font-weight: 700;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__mark,
  .mobile-nav__mark::before {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: currentColor;
    content: "";
    transition: transform var(--ac-transition-fast);
  }

  .mobile-nav__mark::before {
    transform: translateY(0.35rem);
  }

  .mobile-nav[open] .mobile-nav__mark {
    transform: rotate(45deg);
  }

  .mobile-nav[open] .mobile-nav__mark::before {
    transform: rotate(90deg);
  }

  .mobile-nav nav {
    position: fixed;
    inset: 4.5rem 0 auto;
    border-bottom: 1px solid var(--ac-color-rule);
    padding: var(--ac-space-3) var(--ac-gutter) var(--ac-space-5);
    background: var(--ac-color-warm-white);
    box-shadow: 0 1rem 2rem rgb(18 40 64 / 0.08);
  }

  .mobile-nav ul,
  .desktop-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-rule);
    font-family: var(--ac-font-sans);
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .site-header__brand img {
      width: clamp(9.5rem, 14vw, 11rem);
    }

    .site-header--condensed .site-header__brand img {
      width: clamp(7.75rem, 11vw, 9rem);
    }

    .site-header__mobile-actions {
      display: none;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: var(--ac-space-5);
    }

    .desktop-nav ul {
      display: flex;
      align-items: center;
      gap: clamp(0.8rem, 1.4vw, 1.35rem);
    }

    .desktop-nav a:not(.button) {
      display: flex;
      min-height: 3rem;
      align-items: center;
      font-weight: 600;
      text-decoration: none;
    }

    .desktop-nav .button {
      white-space: nowrap;
    }
  }
</style>

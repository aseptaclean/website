---
import { navigation, site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<header class="site-header">
  <div class="site-header__inner ac-measure-wide nav">
    <a class="logo" href="/">
      <span class="mark" aria-hidden="true">A</span>Asepta<span class="sept">clean</span>
      <span class="visually-hidden">— home</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-links">
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      {
        phoneHref && (
          <a class="site-header__tel" href={phoneHref}>{site.business.phone}</a>
        )
      }
      <a class="btn btn-primary" href="#request">Request an assessment</a>
    </nav>

    <div class="site-header__mobile-actions">
      {
        phoneHref && (
          <a
            class="site-header__tel site-header__tel--compact"
            href={phoneHref}
            aria-label={`Call ${site.business.phone}`}
          >
            {site.business.phone}
          </a>
        )
      }

      <details class="mobile-nav">
        <summary>
          <span>Menu</span>
          <span class="visually-hidden"> navigation</span>
          <span class="mobile-nav__mark" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <ul>
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const mobileNavigation = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  const mobileNavigationSummary =
    mobileNavigation?.querySelector<HTMLElement>("summary");

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileNavigation?.open) {
      mobileNavigation.open = false;
      mobileNavigationSummary?.focus();
    }
  });

  mobileNavigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNavigation.open = false;
    });
  });
</script>

<style>
  /* docs/aseptaclean-FINAL-v2.html header / .nav / .logo — ported verbatim (05-DECISIONS-LOG.md) */
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--ac-color-line);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .logo .mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--ac-color-navy-800), var(--ac-color-navy-950));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
    color: #fff;
    font-family: var(--ac-font-mono);
    font-weight: 600;
  }

  .logo .sept {
    /* v2's literal --blue (#4a7fc1) measures 4.12:1 on white — fails WCAG AA 4.5:1 for this
       18px bold text (confirmed via Lighthouse). --ac-color-blue-deep clears 6.69:1 while
       staying the same hue family; blue-500 is unchanged everywhere else (icon chips,
       borders, non-text uses) where it still matches the mockup exactly. */
    color: var(--ac-color-blue-deep);
  }

  .desktop-nav {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ac-color-ink-600);
    font-size: 0.86rem;
    font-weight: 500;
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: 0.15s;
  }

  .nav-links a:hover {
    color: var(--ac-color-navy-900);
  }

  .site-header__tel {
    flex-shrink: 0;
    color: var(--ac-color-navy-900);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header .btn {
    padding: 9px 16px;
    font-size: 0.82rem;
  }

  .site-header__mobile-actions {
    display: flex;
    align-items: center;
    gap: var(--ac-space-2);
    min-width: 0;
  }

  .site-header__tel--compact {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: clamp(0.62rem, 3vw, 0.82rem);
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav summary {
    display: flex;
    flex-shrink: 0;
    min-height: 3rem;
    padding-inline: var(--ac-space-2);
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: flex-end;
    gap: var(--ac-space-2);
    color: var(--ac-color-navy-900);
    font-weight: 700;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__mark,
  .mobile-nav__mark::before {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: currentColor;
    content: "";
    transition: transform var(--ac-transition-fast);
  }

  .mobile-nav__mark::before {
    transform: translateY(0.35rem);
  }

  .mobile-nav[open] .mobile-nav__mark {
    transform: rotate(45deg);
  }

  .mobile-nav[open] .mobile-nav__mark::before {
    transform: rotate(90deg);
  }

  .mobile-nav nav {
    position: fixed;
    inset: 60px 0 auto;
    border-bottom: 1px solid var(--ac-color-line);
    padding: var(--ac-space-3) var(--ac-gutter) var(--ac-space-5);
    background: #fff;
    box-shadow: 0 1rem 2rem rgb(16 35 63 / 0.08);
  }

  .mobile-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-line);
    font-family: var(--ac-font-sans);
    font-weight: 600;
    text-decoration: none;
    color: var(--ac-color-ink-900);
  }

  @media (min-width: 60rem) {
    .site-header__mobile-actions {
      display: none;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: var(--ac-space-5);
    }
  }
</style>

---
import { launchPrimaryNavLinks, launchServiceLinks } from "@data/launchArchitecture";
import { site } from "@data/site";

const normalizePath = (value: string) => {
  const path = value.split(/[?#]/, 1)[0] || "/";
  return path === "/" ? "/" : `/${path.replace(/^\/+|\/+$/g, "")}/`;
};
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href?: string) => Boolean(href && normalizePath(href) === currentPath);

// Primary nav is Services / About / Contact, and Services is both a real link to /services/ and
// a separate accessible dropdown toggle listing the five service routes — docs/SITEMAP-MASTER.md
// "Navigation", which also forbids putting the five service links alongside Services in the
// primary desktop nav. Dropdown order comes from launchServiceLinks.
const publicLinks = launchPrimaryNavLinks;
const serviceLinks = launchServiceLinks;
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__inner">
    <a class="site-nav__logo" href="/" aria-current={isCurrent("/") ? "page" : undefined}>
      <img
        src={site.business.logoUrl}
        alt={`${site.business.name} — home`}
        width="900"
        height="215"
      />
    </a>

    <div class="site-nav__desktop">
      {publicLinks.map((link) =>
        link.href === "/services/" ? (
          <div class="services-nav" data-services-nav>
            <a
              class="services-nav__link"
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
            <button
              type="button"
              class="services-nav__toggle"
              aria-expanded="false"
              aria-controls="services-nav-panel"
              data-services-toggle
            >
              <span class="visually-hidden">Show current services</span>
              <svg aria-hidden="true" viewBox="0 0 10 6" width="10" height="6">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="services-nav__panel" id="services-nav-panel" data-services-panel>
              {serviceLinks.map((service) => (
                <a href={service.href} aria-current={isCurrent(service.href) ? "page" : undefined}>
                  {service.navLabel}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        )
      )}
    </div>

    {/* ONE header action, 2026-09-04. docs/SITEMAP-MASTER.md "Navigation" specifies
        "logo linking home; Services; About; Contact; primary Call Aseptaclean button" — a single
        button, exactly as reference page 23 shows. The outlined assessment action that used to
        sit here is gone: it only appeared above 86rem (so it was absent at 1366px anyway),
        /request-assessment/ is no longer the primary CTA, and the secondary "Send a Message"
        action now belongs to the hero and closing sections where it has a form to reach. */}
    <div class="site-nav__actions">
      {site.business.phoneUri && (
        <a class="site-nav__cta" href={site.business.phoneUri}>
          <svg class="site-nav__cta-icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
            <path
              d="M5.2 1.8 6.6 4.6 5.2 6a9.4 9.4 0 0 0 4.8 4.8l1.4-1.4 2.8 1.4v2.4c0 .6-.5 1-1.1 1A12.7 12.7 0 0 1 1.2 2.9c0-.6.4-1.1 1-1.1z"
              fill="currentColor"
            />
          </svg>
          <span>{site.offer.primaryCta}</span>
        </a>
      )}
    </div>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Open navigation"><span aria-hidden="true"></span></summary>
      <div class="mobile-nav__drawer">
        <div class="mobile-nav__top">
          <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>
            <img
              src={site.business.logoUrl}
              alt={`${site.business.name} — home`}
              width="900"
              height="215"
            />
          </a>
        </div>

        <div class="mobile-nav__content">
          {publicLinks.map((link) =>
            link.href === "/services/" ? (
              <div class="mobile-services">
                <a
                  class="mobile-nav__primary-link mobile-services__link"
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
                <button
                  type="button"
                  class="mobile-services__toggle"
                  aria-expanded="false"
                  aria-controls="mobile-services-panel"
                  data-mobile-services-toggle
                >
                  <span class="visually-hidden">Show current services</span>
                  <span aria-hidden="true">+</span>
                </button>
                <div class="mobile-services__panel" id="mobile-services-panel" data-mobile-services-panel>
                  {serviceLinks.map((service) => (
                    <a href={service.href} aria-current={isCurrent(service.href) ? "page" : undefined}>
                      {service.navLabel}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                class="mobile-nav__primary-link"
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            )
          )}
        </div>

        {/* Drawer mirrors the desktop hierarchy, primary first: the phone is the filled control
            and carries the number itself, because a visitor who opened the drawer on a phone is
            one tap from dialling. "Send a Message" follows as the outlined action and goes to
            Contact's form — it used to point at /request-assessment/, which stopped matching the
            label when the secondary CTA changed on 2026-09-04. */}
        <div class="mobile-nav__actions">
          {site.business.phoneUri && (
            <a class="mobile-nav__cta" href={site.business.phoneUri}>
              {site.offer.primaryCta} · {site.business.phone}
            </a>
          )}
          <a class="mobile-nav__phone" href={site.offer.contactFormUrl}>
            {site.offer.secondaryCta}
          </a>
        </div>
      </div>
    </details>
  </div>
</nav>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");

  mobileNav?.addEventListener("toggle", () => {
    document.body.classList.toggle("is-navigation-open", mobileNav.open);
    const summary = mobileNav.querySelector<HTMLElement>(":scope > summary");
    summary?.setAttribute("aria-label", mobileNav.open ? "Close navigation" : "Open navigation");
  });

  // Desktop Services dropdown — link stays a normal navigable <a>; the toggle button owns
  // open/close state so keyboard and mouse users both reach every service without either
  // losing direct access to /services/ itself.
  const servicesNav = document.querySelector<HTMLElement>("[data-services-nav]");
  const servicesToggle = servicesNav?.querySelector<HTMLButtonElement>("[data-services-toggle]");
  const servicesPanel = servicesNav?.querySelector<HTMLElement>("[data-services-panel]");

  const setServicesOpen = (open: boolean) => {
    if (!servicesNav || !servicesToggle) return;
    servicesNav.classList.toggle("is-open", open);
    servicesToggle.setAttribute("aria-expanded", String(open));
  };

  const openOnFocusIn = () => setServicesOpen(true);

  if (servicesNav && servicesToggle && servicesPanel) {
    servicesToggle.addEventListener("click", () => {
      setServicesOpen(!servicesNav.classList.contains("is-open"));
    });

    servicesNav.addEventListener("mouseenter", () => setServicesOpen(true));
    servicesNav.addEventListener("mouseleave", () => setServicesOpen(false));

    servicesNav.addEventListener("focusin", openOnFocusIn);
    servicesNav.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !servicesNav.contains(next)) setServicesOpen(false);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node | null;
      if (target && !servicesNav.contains(target)) setServicesOpen(false);
    });
  }

  // Mobile Services expand — same link-plus-toggle pattern inside the drawer.
  const mobileServicesToggle = document.querySelector<HTMLButtonElement>(
    "[data-mobile-services-toggle]"
  );
  const mobileServicesPanel = document.querySelector<HTMLElement>(
    "[data-mobile-services-panel]"
  );

  mobileServicesToggle?.addEventListener("click", () => {
    const open = mobileServicesToggle.getAttribute("aria-expanded") !== "true";
    mobileServicesToggle.setAttribute("aria-expanded", String(open));
    mobileServicesPanel?.classList.toggle("is-open", open);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (servicesNav?.classList.contains("is-open")) {
      // Moving focus to the toggle fires `focusin` on servicesNav, which would otherwise
      // immediately reopen the panel setServicesOpen(false) just closed.
      servicesNav.removeEventListener("focusin", openOnFocusIn);
      setServicesOpen(false);
      servicesToggle?.focus();
      requestAnimationFrame(() => servicesNav?.addEventListener("focusin", openOnFocusIn));
      return;
    }
    if (mobileNav?.open) {
      mobileNav.open = false;
      mobileNav.querySelector<HTMLElement>(":scope > summary")?.focus();
    }
  });

  // The reduced launch labels are wider than the baseline menu; 74rem is the first breakpoint
  // where the same approved desktop spacing fits without clipping or compressing the CTA.
  // If the drawer is open and the viewport grows past it, the desktop bar returns and the drawer
  // has to close with it or focus is trapped behind an invisible overlay.
  window.matchMedia("(min-width: 74rem)").addEventListener("change", (event) => {
    if (event.matches && mobileNav?.open) mobileNav.open = false;
  });
</script>

<style>
  .site-nav {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--ac-color-line);
    background: var(--ac-color-paper);
  }

  .site-nav__inner {
    position: relative;
    display: flex;
    width: min(100% - 2 * var(--ac-gutter), var(--ac-measure-wide));
    min-height: var(--ac-header-stack);
    align-items: center;
    margin-inline: auto;
  }

  .site-nav__logo {
    display: flex;
    flex: 0 0 auto;
    min-height: 48px;
    align-items: center;
  }

  .site-nav__logo img,
  .mobile-nav__top img {
    width: auto;
    height: 34px;
  }

  .site-nav__desktop {
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    justify-content: center;
    margin-inline: clamp(28px, 4vw, 68px);
    gap: clamp(24px, 2.4vw, 38px);
  }

  .site-nav__desktop > a {
    display: flex;
    min-height: var(--ac-header-stack);
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--ac-color-ink-900);
    font-size: 0.875rem;
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .site-nav__desktop > a:hover,
  .site-nav__desktop > a[aria-current="page"] {
    border-bottom-color: var(--ac-color-navy-800);
    color: var(--ac-color-navy-800);
  }

  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  /* Services — link + separate toggle, per docs/aseptaclean-website-design-system.md §10.
     The panel is positioned from `.services-nav`, not `.site-nav__desktop > a`, so it never
     inherits the plain link's border-bottom hover treatment. */
  .services-nav {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .services-nav__link {
    display: flex;
    min-height: var(--ac-header-stack);
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--ac-color-ink-900);
    font-size: 0.875rem;
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
  }

  .services-nav__link:hover,
  .services-nav__link[aria-current="page"] {
    border-bottom-color: var(--ac-color-navy-800);
    color: var(--ac-color-navy-800);
  }

  .services-nav__toggle {
    display: flex;
    width: 26px;
    min-height: var(--ac-header-stack);
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ac-color-ink-900);
    cursor: pointer;
  }

  .services-nav__toggle svg {
    transition: transform 160ms ease;
  }

  .services-nav.is-open .services-nav__toggle svg {
    transform: rotate(180deg);
  }

  .services-nav__panel {
    position: absolute;
    z-index: 60;
    top: 100%;
    left: 0;
    display: none;
    flex-direction: column;
    width: 300px;
    border: 1px solid var(--ac-color-line);
    background: var(--ac-color-paper);
    padding: 8px;
  }

  .services-nav.is-open .services-nav__panel {
    display: flex;
  }

  .services-nav__panel a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding-inline: 12px;
    color: var(--ac-color-ink-900);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .services-nav__panel a:hover,
  .services-nav__panel a[aria-current="page"] {
    background: var(--ac-color-warm-white);
    color: var(--ac-color-navy-800);
  }

  .site-nav__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    margin-left: auto;
    gap: 12px;
  }

  /* Rectangular control, 4px — doc 30 §2. The reference's pill button is not reproduced.
     The outlined secondary that used to sit beside this was removed 2026-09-04; see the
     markup note above. */
  .site-nav__cta {
    display: flex;
    /* doc 30 §2: "Buttons: ... minimum 48px touch height." Was 44px. */
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--ac-r-sm);
    padding-inline: 20px;
    background: var(--ac-color-navy-800);
    color: var(--ac-color-paper);
    font-size: 0.8125rem;
    font-weight: 750;
    white-space: nowrap;
    gap: 8px;
    text-decoration: none;
  }

  .site-nav__cta:hover {
    background: var(--ac-color-navy-900);
    color: var(--ac-color-paper);
  }

  .site-nav__cta-icon {
    flex: 0 0 auto;
  }

  .mobile-nav {
    display: none;
    margin-left: auto;
  }

  .mobile-nav > summary {
    position: relative;
    z-index: 112;
    display: flex;
    width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav > summary span,
  .mobile-nav > summary span::before,
  .mobile-nav > summary span::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ac-color-navy-900);
    content: "";
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .mobile-nav > summary span {
    position: relative;
  }

  .mobile-nav > summary span::before,
  .mobile-nav > summary span::after {
    position: absolute;
    left: 0;
  }

  .mobile-nav > summary span::before {
    top: -7px;
  }

  .mobile-nav > summary span::after {
    top: 7px;
  }

  .mobile-nav[open] > summary {
    position: fixed;
    top: 15px;
    right: max(20px, calc((100vw - 1320px) / 2));
  }

  .mobile-nav[open] > summary span {
    background: transparent;
  }

  .mobile-nav[open] > summary span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-nav[open] > summary span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav__drawer {
    position: fixed;
    z-index: 110;
    inset: 0;
    overflow-y: auto;
    background: var(--ac-color-paper);
  }

  .mobile-nav__top {
    display: flex;
    min-height: 64px;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-line);
    padding-inline: 26px 84px;
  }

  .mobile-nav__top a {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
  }

  .mobile-nav__content {
    padding: 12px 26px 24px;
  }

  .mobile-nav__primary-link {
    display: flex;
    min-height: 58px;
    align-items: center;
    border-bottom: 1px solid var(--ac-color-line);
    color: var(--ac-color-ink-900);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
  }

  /* Mobile Services — link stays full-width and navigable; the toggle is a separate control
     so tapping "Services" never traps a visitor into only expanding the list. */
  .mobile-services {
    display: grid;
    border-bottom: 1px solid var(--ac-color-line);
    grid-template-columns: 1fr auto;
  }

  .mobile-services__link {
    border-bottom: 0;
  }

  .mobile-services__toggle {
    display: flex;
    width: 58px;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ac-color-ink-900);
    font-size: 1.5rem;
    font-weight: 400;
    cursor: pointer;
  }

  .mobile-services__toggle[aria-expanded="true"] span[aria-hidden] {
    display: inline-block;
    transform: rotate(45deg);
  }

  .mobile-services__panel {
    display: none;
    grid-column: 1 / -1;
    flex-direction: column;
    padding: 0 0 12px 18px;
  }

  .mobile-services__panel.is-open {
    display: flex;
  }

  .mobile-services__panel a {
    display: flex;
    min-height: 46px;
    align-items: center;
    color: var(--ac-color-ink-600);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .mobile-services__panel a[aria-current="page"] {
    color: var(--ac-color-navy-800);
    font-weight: 700;
  }

  .mobile-nav__actions {
    display: grid;
    padding: 8px 26px 36px;
    gap: 10px;
  }

  .mobile-nav__cta,
  .mobile-nav__phone {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    font-weight: 750;
    text-align: center;
    text-decoration: none;
  }

  .mobile-nav__cta {
    background: var(--ac-color-navy-800);
    color: var(--ac-color-paper);
  }

  .mobile-nav__phone {
    border: 1px solid var(--ac-color-navy-800);
    color: var(--ac-color-navy-900);
  }

	:global(body.is-navigation-open .mbar) {
		display: none;
	}

  /* Baseline styling is unchanged. The content-only launch link set needs 160px more horizontal
     room than the old compact labels, so the existing mobile treatment begins below 1184px. */
  @media (max-width: 73.9375rem) {
    .site-nav__inner {
      width: min(100% - 40px, 1504px);
      min-height: 64px;
      align-items: center;
    }

    .site-nav__desktop,
    .site-nav__actions {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .site-nav__inner {
      width: calc(100% - 40px);
    }

    .site-nav__logo img,
    .mobile-nav__top img {
      height: 30px;
    }

    .mobile-nav__top {
      min-height: 64px;
      padding-left: 20px;
    }

    .mobile-nav__content,
    .mobile-nav__actions {
      padding-inline: 20px;
    }

    .mobile-nav[open] > summary {
      top: 8px;
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav > summary span,
    .mobile-nav > summary span::before,
    .mobile-nav > summary span::after {
      transition: none;
    }
  }

  @media print {
    .site-nav,
    .mobile-nav__drawer {
      display: none;
    }
  }
</style>

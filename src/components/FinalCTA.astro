---
import { site } from "@data/site";
import QuickHandoffForm from "@components/QuickHandoffForm.astro";

const phoneHref = site.business.phoneUri;
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="ac-measure-intimate final-cta__layout">
    <p class="ac-eyebrow">Final decision</p>
    <h2 id="final-cta-title" class="ac-type-h2">
      Start with what you know. We will help define the <span class="ac-mark">rest.</span>
    </h2>
    <p class="ac-type-lead">
      Tell us what you are looking at, what must remain, and when the
      property needs to be ready. Send photos if you have them.
    </p>
    <p class="final-cta__body ac-type-body">
      We will review the situation, tell you whether it fits, and give you a
      clear next step. No vague promise that every property is the same. No
      pressure to authorize work before the scope is clear.
    </p>
    <p class="final-cta__closing ac-type-body">
      <strong>The goal is not simply an empty room. It is a property you can
      open, enter, and move forward with.</strong>
    </p>

    <div class="final-cta__form-block">
      <QuickHandoffForm formId="final-quick-form" entryRoute="/#final-cta" />
    </div>

    <div class="final-cta__actions">
      {
        phoneHref && (
          <a class="final-cta__phone" href={phoneHref}>
            Call {site.business.phone} and tell us what you are looking at
          </a>
        )
      }
      <small class="ac-type-sm">Submitting this form does not authorize work or create a service agreement.</small>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--ac-color-navy-900);
    color: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-open);
    padding-bottom: 0;
  }

  .final-cta__layout {
    display: grid;
    gap: var(--ac-space-5);
  }

  h2 {
    color: var(--ac-color-paper);
  }

  .final-cta__body {
    margin: 0;
    color: var(--ac-color-steel-on-navy);
  }

  /* This section's own .ac-eyebrow ("Final decision") sits on the navy-900
     background, not the light surface the shared class assumes. */
  .final-cta :global(.ac-eyebrow) {
    color: var(--ac-color-steel-on-navy);
  }

  .final-cta__closing {
    margin: 0;
    color: var(--ac-color-paper);
  }

  .final-cta__form-block {
    max-width: 30rem;
  }

  /* QuickHandoffForm defaults assume a light surface; override for this
     section's dark navy background (docs/07 §7 requires the identical form,
     not a re-themed one, so the override lives here rather than forking it). */
  .final-cta__form-block :global(.quick-form) {
    --quick-form-label-color: var(--ac-color-paper);
    --quick-form-muted-color: var(--ac-color-steel-on-navy);
    --quick-form-link-color: var(--ac-color-paper);
  }

  .final-cta__actions {
    display: grid;
    align-content: start;
    gap: var(--ac-space-4);
    margin-top: var(--ac-space-6);
  }

  .final-cta__phone {
    min-height: 3rem;
    align-items: center;
    color: var(--ac-color-paper);
    font-weight: 700;
  }

  .final-cta__actions small {
    color: var(--ac-color-steel-on-navy);
    line-height: 1.5;
  }
</style>

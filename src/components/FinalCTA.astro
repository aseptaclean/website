---
// 2026-08-18 visual port. docs/mockups .final — flat navy-950 band, left-aligned, no gradient
// or radial wash. Copy is doc 27 §9.14 verbatim (eyebrow, H2, body, both CTAs). Hero and this
// section intentionally offer different secondary actions — Hero = text a photo, Final CTA =
// call — see docs/05-DECISIONS-LOG.md.
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<section class="ac-sec ac-final" aria-labelledby="final-cta-title">
  <div class="ac-shell">
    <p class="ac-label ac-label--on-dark">Final decision</p>
    <h2 id="final-cta-title" class="ac-type-h2-final">
      Start with what you know. We will help define the rest.
    </h2>
    <p>Tell us what you are looking at, what must remain and when the property needs to be ready.</p>
    <div class="ac-btns">
      <a href="/request-assessment/" class="btn btn--w">
        {site.offer.primaryCta} <span aria-hidden="true">&rarr;</span>
      </a>
      {phoneHref && (
        <a href={phoneHref} class="btn btn--o">Call {site.business.phone}</a>
      )}
    </div>
    <p class="cta__sub">Submitting a request does not authorize work or create a service agreement.</p>
  </div>
</section>

<style>
  .cta__sub {
    margin-top: 22px;
    color: #7f96b4;
    font-size: 0.75rem;
  }
</style>

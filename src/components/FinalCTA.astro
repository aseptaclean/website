---
// Final CTA, recomposed 2026-08-25 as the image-led close the brief §20 specifies: large image,
// large simple statement, one CTA. Replaces the flat navy text band. Used by `/` only.
//
// COPY IS §20's, VERBATIM — the heading and the supporting paragraph are the approved strings in
// docs/ASEPTACLEAN-CODEX-HOMEPAGE-REBUILD-BRIEF-SEVENSON.md §20, and the primary CTA reads from
// site.offer.secondaryCta. The old heading ("Start with what you know…") and its body are retired
// with the composition; both were doc 20 Part 2 replacements for a slot §20 now covers.
//
// THREE ACTIONS BECAME ONE PLUS TWO. The previous band rendered three same-shaped buttons.
// docs/30-WEBSITE-MASTER-SPEC.md §13.2 sets the hierarchy — primary, then call, then text-photos
// as "contextual utility, not a competing sitewide primary action" — and says outright "Do not
// present three equal buttons". The assessment CTA is the only button; call and text are text
// links beside it. Doc 27 §8 requires the secondary door to appear wherever the primary does,
// and it still does; it is no longer dressed as an equal demand. Both remain suppressed with the
// phone value they derive from (AGENTS.md §3 — never render an empty phone link).
//
// The submission disclaimer is docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6's assessment disclaimer
// and stays with the CTA.
import { Image } from "astro:assets";
import closeImage from "../assets/homepage/close-development-property-sanfranman59.jpg";
import { site } from "@data/site";

// TEMPORARY DEVELOPMENT REFERENCE PHOTOGRAPH — NOT Aseptaclean work, not a client property, and
// not proof of a completed job. `[ATMOS]`-class under docs/21-CLAIMS-AND-COMPLIANCE-LAW.md §6:
// an exterior street view of a house with no crew, no vehicle, no equipment and no work in
// progress implies nothing about who worked on it. Chosen over generic stock because it is an
// actual single-family home in Palo Alto — one of the ten cities in site.location.cities — and
// the kind of property this page is written for.
//   close-development-property-sanfranman59.jpg
//     Sanfranman59 — CC BY-SA 3.0 — https://commons.wikimedia.org/wiki/File:774_Wildwood_Lane,_Green_Gables_Historic_District,_Palo_Alto,_CA_6-3-2012_4-11-16_PM.JPG
// Replace with owner-shot photography before launch (docs/06-ASSET-MANIFEST.md §5).

const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
---

{/* MIRRORED 2026-08-25. OperatingEvidence directly above this section is image-left / copy-right;
    running the same arrangement again here made the last two sections of the page one repeated
    composition on one continuous dark field. V3 §29C asks whether any major layout pattern
    repeats more than twice — two is the limit, and two IDENTICAL ones back to back read as more
    than that. The close is now copy-left / image-right, so the pair alternates.

    Copy also moved AHEAD of the figure in the DOM. Reading order is now heading → supporting
    line → CTA → photograph, instead of a decorative reference photograph and its development
    caption reaching a screen reader before the closing heading. The image is pulled back to the
    top on small screens with `order`, so the image-led feel §16 asks to keep is unchanged
    visually at every width. */}
<section class="close" aria-labelledby="final-cta-title">
  <div class="close__inner">
    <div class="close__copy">
      <h2 id="final-cta-title" class="ac-type-h2-home-feature">
        You do not need to know exactly what kind of cleanup you need.
      </h2>
      <p class="close__lede">
        Show us the property. Send a few photos and tell us what is happening. We will review the
        condition and help you determine what the next step should be.
      </p>

      <div class="close__actions">
        <a class="close__primary" href="/request-assessment/">Request an Assessment</a>
        <div class="close__secondary">
          {phoneHref && <a href={phoneHref}>Call {site.business.phone}</a>}
          {smsHref && <a href={smsHref}>{site.offer.smsCta}</a>}
        </div>
      </div>

      <p class="close__note">
        Submitting a request does not authorize work or create a service agreement.
      </p>
    </div>

    {/* Capped at 1240w / q72: the source is a detailed foliage-heavy exterior, and a 1600w q78
        variant weighed 927 kB — too much for a lazy below-fold image. */}
    <figure class="close__media">
      <Image
        src={closeImage}
        alt="Reference photograph of a single-family home on a residential street, viewed from the driveway."
        widths={[520, 720, 960, 1240]}
        sizes="(min-width: 64rem) 50vw, 92vw"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Development reference photograph · not Aseptaclean project work · Sanfranman59, Wikimedia
        Commons, CC BY-SA 3.0
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .close {
    background: var(--ac-color-navy-950);
    padding-block: clamp(96px, 10vw, 136px);
  }

  .close__inner {
    display: grid;
    width: min(100% - 64px, 1320px);
    margin-inline: auto;
    align-items: center;
    gap: 48px 80px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .close__media {
    margin: 0;
  }

  .close__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    background: var(--ac-color-navy-900);
    object-fit: cover;
    object-position: 44% 58%;
  }

  .close__media figcaption {
    margin-top: 12px;
    color: rgb(255 255 255 / 52%);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* V3 §23: homepage H2s land at 36–42px. This one was still inheriting the token's own
     clamp and rendered at 52px at 1440 — the last of the audited 52px H2s. Set on the token,
     not on the heading, so the size still resolves through .ac-type-h2-home-feature
     (AGENTS.md §6 law 1). */
  .close__copy {
    --ac-text-h2-home-feature: 2.5rem;
  }

  .close__copy h2 {
    max-width: 15ch;
    color: var(--ac-color-paper);
  }

  .close__lede {
    margin: 26px 0 0;
    max-width: 48ch;
    color: #ccd9e8;
    font-size: 1.0625rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 34px;
    gap: 16px 28px;
  }

  .close__primary {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--ac-color-paper);
    padding-inline: 30px;
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .close__primary:hover {
    background: var(--ac-color-blue-pale);
  }

  .close__primary:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 4px;
  }

  /* Text links, not buttons — §13.2's hierarchy. 44px min height keeps the touch target. */
  .close__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }

  .close__secondary a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .close__secondary a:hover {
    color: var(--ac-color-blue-pale);
  }

  .close__secondary a:focus-visible {
    outline: 3px solid var(--ac-color-paper);
    outline-offset: 3px;
  }

  .close__note {
    margin: 26px 0 0;
    max-width: 52ch;
    color: #7f96b4;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  @media (max-width: 64rem) {
    .close__inner {
      width: min(100% - 52px, 1320px);
      gap: 40px 52px;
    }

    .close__copy {
      --ac-text-h2-home-feature: 2.25rem;
    }

    .close__lede {
      font-size: 1rem;
    }
  }

  @media (max-width: 50rem) {
    .close__copy {
      --ac-text-h2-home-feature: 2rem;
    }

    .close__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    /* Image back to the top once the columns stack: §16 keeps the image-led close, and on a
       phone that means the photograph opens the section. DOM order stays copy-first for
       assistive technology. */
    .close__media {
      order: -1;
    }

    .close__media :global(img) {
      aspect-ratio: 16 / 9;
    }

    .close__copy h2 {
      max-width: 20ch;
    }

    .close__lede {
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .close {
      padding-block: 76px;
    }

    .close__inner {
      width: calc(100% - 40px);
    }

    .close__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 6px;
    }

    .close__primary {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .close__primary {
      transition: none;
    }
  }
</style>

---
// docs/aseptaclean-FINAL-v2.html HERO — ported verbatim (05-DECISIONS-LOG.md supersedes
// docs/06-APPROVED-HOMEPAGE-COPY.md §8.2-8.6 for this section's copy). No inline form here —
// the mockup's hero is two buttons + record link + chips only; the form lives at #request.
import { homepage, site } from "@data/site";

const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
---

<section class="hero" id="overview" aria-labelledby="hero-title">
  <div class="ac-measure-wide hero__shell">
    <div class="hero__main">
      <p class="ac-eyebrow eyebrow">Property clearing &middot; restoration &middot; animal &amp; organic conditions</p>
      <h1 id="hero-title">Complex properties returned to a <span class="hl">controlled, documented</span> condition.</h1>
      <p class="lead">Hoarding, estate, and severe-condition properties — cleared, cleaned, and closed out under one signed scope, by one accountable operator.</p>
      <div class="approve">Nothing leaves the property without your written approval.</div>
      <div class="actions">
        <a href="#request" class="btn btn-on-light">Request an assessment →</a>
        {
          smsHref ? (
            <a href={smsHref} class="btn btn-ghost-dark">Text a photo</a>
          ) : (
            <a href={phoneHref || "#request"} class="btn btn-ghost-dark">Text a photo</a>
          )
        }
      </div>
      <p class="hero__record-link">
        Every project closes with a <a href="#record">Property Handoff Record</a> — see a sample below.
      </p>
      <div class="chips">
        <span class="chip">Written scope before work</span>
        <span class="chip">No unapproved charges</span>
        <span class="chip">Documented closeout</span>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><span>Handoff Status</span><span class="id">HR-1042 &middot; SAMPLE</span></div>
      {
        homepage.sampleRecord.rooms.length > 0 && (
          <>
            <div class="prow"><div><div class="lb">Scope</div><div class="sb">Room-by-room, signed</div></div><span class="ac-tag ac-tag--def">Defined</span></div>
            <div class="prow"><div><div class="lb">Set-aside items</div><div class="sb">Docs · valuables · keys</div></div><span class="ac-tag ac-tag--review">Held</span></div>
            <div class="prow"><div><div class="lb">Clearing</div><div class="sb">Approved contents</div></div><span class="ac-tag ac-tag--clear">Complete</span></div>
            <div class="prow"><div><div class="lb">Reset cleaning</div><div class="sb">Kitchen · bath · surfaces</div></div><span class="ac-tag ac-tag--clear">Complete</span></div>
            <div class="prow"><div><div class="lb">Closeout record</div><div class="sb">Photos + exceptions</div></div><span class="ac-tag ac-tag--def">Issued</span></div>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  /* docs/aseptaclean-FINAL-v2.html .hero — ported verbatim */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2.25rem, 4.5vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background:
      radial-gradient(1100px 500px at 85% -10%, rgba(74, 127, 193, 0.28), transparent 60%),
      radial-gradient(700px 400px at -5% 110%, rgba(74, 127, 193, 0.15), transparent 55%),
      linear-gradient(165deg, var(--ac-color-navy-900) 0%, var(--ac-color-navy-950) 70%);
    color: #fff;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0);
    background-size: 26px 26px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent 80%);
    content: "";
  }

  .hero__shell {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__main {
    max-width: 49rem;
  }

  .hero .eyebrow {
    color: #8fb4de;
  }

  .hero .eyebrow::before {
    background: #8fb4de;
  }

  .hero h1 {
    margin-bottom: 22px;
    color: #fff;
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .hero h1 .hl {
    color: #a8c8ec;
  }

  .hero .lead {
    max-width: 46ch;
    margin: 0 0 26px;
    color: #b9c9dd;
    font-size: 1.12rem;
  }

  .hero .approve {
    margin-bottom: 30px;
    border-left: 3px solid var(--ac-color-gold);
    padding: 4px 0 4px 16px;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
  }

  .hero .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }

  .hero__record-link {
    margin-bottom: 18px;
    color: #8fb4de;
    font-size: 0.85rem;
  }

  .hero__record-link a {
    color: #cfe0f2;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    border: 1px solid rgba(168, 192, 220, 0.35);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.04);
    padding: 6px 11px;
    color: #a8c0dc;
    font-family: var(--ac-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel {
    box-shadow: var(--ac-shadow-pop);
  }

  @media (min-width: 60rem) {
    .hero__shell {
      grid-template-columns: 1.25fr 1fr;
    }
  }
</style>

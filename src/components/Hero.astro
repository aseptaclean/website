---
import { homepage, site } from "@data/site";
import QuickHandoffForm from "@components/QuickHandoffForm.astro";

const trustItems = [
  site.business.insuranceStatus,
  "Written scope",
  "Nothing removed without approval",
  "No unapproved charges",
  "Documented closeout"
].filter(Boolean);

const phoneHref = site.business.phoneUri;
---

<section class="hero" id="overview" aria-labelledby="hero-title">
  <div class="ac-measure-wide hero__layout">
    <div class="hero__main">
      <p class="hero__eyebrow ac-eyebrow">
        Property Cleanout &amp; Deep Cleaning <span aria-hidden="true">/</span>
        {site.location.serviceArea}
      </p>
      <h1 id="hero-title" class="ac-type-h1">
        Walk Back Into a Property That Finally Feels <span class="ac-mark">Ready.</span>
      </h1>
      <p class="hero__lead ac-type-lead">
        When a home is still full of belongings, unfinished cleaning, and
        decisions nobody has made, it follows you everywhere.
      </p>

      <div class="hero__trust" aria-label="Project controls">
        {
          trustItems.map((item) => (
            <span class="ac-type-xs">{item}</span>
          ))
        }
      </div>

      <p class="hero__detail ac-type-body">
        Aseptaclean gives you one accountable path through it. You decide what
        stays. We clear what you approve, complete the defined deep-cleaning
        scope, and document the result so the property can move to its next
        owner, tenant, listing, inspection, or family decision.
      </p>

      <div class="hero__form-block">
        <QuickHandoffForm formId="hero-quick-form" entryRoute="/#hero" />
        <p class="hero__form-microcopy ac-type-sm">
          Send photos and basic property details. We will tell you whether the
          project fits, what the likely path looks like, and what should happen
          next {site.offer.responseTime}.
        </p>
      </div>

      {
        phoneHref && (
          <p class="hero__urgent ac-type-sm">
            Looking at a complex or time-sensitive property?
            {" "}
            <a href={phoneHref}>Call {site.business.phone}</a> and tell us what you are seeing.
          </p>
        )
      }
    </div>

    <aside class="hero__criteria" aria-label="The handoff outcome">
      <p class="hero__criteria-label ac-eyebrow">The handoff outcome</p>
      <ol>
        {
          homepage.handoffStages.map((stage) => (
            <li>
              <strong>{stage.name}</strong>
              <small class="ac-type-sm">{stage.record}</small>
            </li>
          ))
        }
      </ol>
      <p class="hero__criteria-note">
        One approved scope.<br />One accountable company.
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ac-color-warm-white);
  }

  .hero::after {
    position: absolute;
    z-index: 0;
    top: 0;
    right: max(var(--ac-gutter), calc((100vw - var(--ac-measure-wide)) / 2));
    width: 1px;
    height: 100%;
    background: var(--ac-color-rule);
    content: "";
  }

  .hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    padding-top: var(--ac-rhythm-open);
    padding-bottom: 0;
  }

  .hero__main {
    max-width: 49rem;
  }

  .hero__eyebrow span {
    padding-inline: 0.25rem;
    color: var(--ac-color-blue-500);
  }

  h1 {
    max-width: 17ch;
    margin: var(--ac-space-5) 0 0;
  }

  .hero__lead {
    max-width: 41rem;
    margin: var(--ac-space-6) 0 0;
  }

  .hero__detail {
    max-width: 41rem;
    margin: var(--ac-space-4) 0 0;
    color: var(--ac-color-ink-500);
  }

  .hero__form-block {
    max-width: 30rem;
    margin-top: var(--ac-space-6);
  }

  .hero__form-microcopy {
    margin: var(--ac-space-3) 0 0;
    color: var(--ac-color-ink-500);
  }

  .hero__urgent {
    margin: var(--ac-space-4) 0 0;
    color: var(--ac-color-ink-500);
  }

  .hero__criteria {
    position: relative;
    margin-top: var(--ac-space-7);
    border-top: 1px solid var(--ac-color-navy-800);
    padding-top: var(--ac-space-4);
  }

  .hero__criteria ol {
    margin: var(--ac-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__criteria li {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(4.5rem, 0.7fr) 1.5fr;
    align-items: baseline;
    gap: var(--ac-space-3);
    border-top: 1px solid var(--ac-color-rule);
    padding-block: var(--ac-space-3);
  }

  .hero__criteria small {
    color: var(--ac-color-ink-500);
  }

  .hero__criteria strong {
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-sans);
  }

  .hero__criteria-note {
    margin: var(--ac-space-5) 0 0;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-sm);
    font-weight: 700;
    line-height: 1.45;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    max-width: 41rem;
    margin-top: var(--ac-space-5);
  }

  .hero__trust span {
    color: var(--ac-color-navy-900);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .hero__trust span:not(:last-child)::after {
    margin-inline: 0.65rem;
    color: var(--ac-color-blue-500);
    content: "/";
  }

  @media (min-width: 64rem) {
    .hero__layout {
      grid-template-columns: minmax(0, 1.38fr) minmax(18rem, 1fr);
      align-items: start;
      gap: clamp(3rem, 8vw, 8rem);
    }

    .hero__criteria {
      align-self: start;
      margin-top: 0;
      border-top: 0;
      border-left: 1px solid var(--ac-color-rule);
      padding: var(--ac-space-4) 0 var(--ac-space-3) clamp(2rem, 4vw, 4rem);
    }

    .hero__criteria-note {
      margin-top: clamp(3rem, 6vh, 5rem);
    }
  }
</style>

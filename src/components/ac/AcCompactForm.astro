---
// COMPACT INTAKE FORM — the one form component shared by the homepage hero, all five service
// heroes, and the Contact page. docs/03-INTEGRATION-CONTRACT.md "Forms remain a secondary way to
// contact Aseptaclean" specifies the field set, the heading, and the submit label; doc 30 §3
// and §4 specify the dark hero panel and the light body variant.
//
// FIELD CONTRACT. This form posts field names functions/_lib/lead.ts already validates for the
// lean assessment path (form_version present, offer_type !== residence): full_name, phone,
// property_zip, property_situation, property_detail, plus the shared commonRequiredFields
// (privacy_consent, submission_timestamp, idempotency_key). Every one of those is unchanged, and
// the situation values remain the frozen CRM enum in src/data/assessment.ts — only their visible
// labels and order moved.
//
// EMAIL ADDED 2026-09-06 (owner requirement: customer confirmation must be possible from every
// active form). `email` is now part of commonRequiredFields in functions/_lib/lead.ts, so this
// form requires it like every other active form on the site.
//
// The submit/validation/error/Turnstile script below is QuickHandoffForm's working contract,
// extended with the two extra required inputs (property_zip, property_situation).
import { homeKitServices } from "@data/homeKit";
import { assessment } from "@data/assessment";
import { legal, site } from "@data/site";

interface Props {
  formId: string;
  /** Contact package presentation and optional supported photo upload. */
  contactKit?: boolean;
  homepage?: boolean;
  /** Homepage kit display only; submission and consent contracts are unchanged. */
  kit?: boolean;
  /** Estate public kit: display labels and accepted estate default only. */
  estateKit?: boolean;
  /** Hoarding public kit only: approved needs mapped to the existing CRM value. */
  hoardingKit?: boolean;
  /** Trauma public kit: cleanup type maps to the frozen trauma CRM enum. */
  traumaKit?: boolean;
  /** Extreme public kit: approved needs map to the existing severe-condition enum. */
  extremeKit?: boolean;
  /** Detailed Deep Cleaning kit: approved display options mapped to the frozen service enum. */
  detailedKit?: boolean;
  /**
   * The route this form sits on, recorded on the lead so a submission can be traced to its
   * page. Defaults to the homepage hero for backwards compatibility.
   */
  entryRoute?: string;
  /**
   * Preselect the situation matching this route (docs/03-INTEGRATION-CONTRACT.md: "Preselect
   * the relevant service on its page while permitting correction"). The visitor can still
   * change it — this sets the default option, it does not lock the field.
   */
  preselectRoute?: string;
  /** `dark` sits over hero photography; `light` is the body-content variant (Contact). */
  tone?: "dark" | "light";
  /**
   * When set, this form does NOT render its own `<h2>`+lede — the caller has already rendered a
   * single visible heading with this id outside the form, and `aria-labelledby` points at it
   * instead. Mirrors the identical convention on PpcHeroForm.astro. Added 2026-09-17 for the
   * relocated service-page contact sections (docs/Aseptaclean_Service_Hero_And_Spaces_Update.md
   * Part C: "If the form already has an appropriate heading and intro, render them once. Do not
   * repeat both in an outer wrapper."). Every other caller leaves this unset and renders exactly
   * as before.
   */
  headingId?: string;
}

const {
  formId,
  contactKit = false,
  entryRoute = "/#hero-form",
  preselectRoute,
  tone = "dark",
  headingId,
  kit = false,
  estateKit = false,
  hoardingKit = false,
  traumaKit = false,
  extremeKit = false,
  detailedKit = false,
  homepage = false
} = Astro.props;

const preselectValue = preselectRoute
  ? assessment.situations.find((situation) => situation.route === preselectRoute)?.value
  : undefined;

const endpointAvailable = Boolean(
  site.integrations.formEnabled &&
    site.urls.formEndpoint &&
    site.integrations.turnstileSiteKey
);
---

<form
  id={formId}
  class:list={["hero-form", `is-${tone}`]}
  method="post"
  enctype={contactKit || homepage || hoardingKit || traumaKit || extremeKit || detailedKit ? "multipart/form-data" : undefined}
  action={endpointAvailable ? site.urls.formEndpoint : undefined}
  aria-labelledby={headingId ?? `${formId}-title`}
  data-quick-form
  data-contact-kit={contactKit || undefined}
  data-estate-kit={estateKit || undefined}
  data-trauma-kit={traumaKit || undefined}
  data-extreme-kit={extremeKit || undefined}
  data-hoarding-kit={hoardingKit || undefined}
  data-detailed-kit={detailedKit || undefined}
  data-contact-phone={site.business.phone}
>
  <input type="hidden" name="form_version" value={assessment.version} />
  <input type="hidden" name="offer_type" value="handoff_reset" />
  <input type="hidden" name="entry_route" value={entryRoute} />
  <input type="hidden" name="submitted_from" value={entryRoute} />
  <input type="hidden" name="submission_timestamp" value="" />
  <input type="hidden" name="idempotency_key" value="" />
  <input
    class="hero-form__honeypot"
    type="text"
    name="company_website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  {/* Heading and supporting line are the source wording named in
      docs/03-INTEGRATION-CONTRACT.md "Forms", held in src/data/site.ts so every form surface
      shares one string. Skipped when `headingId` is set — the caller already rendered a single
      visible heading outside the form. */}
  {!headingId && (
    <Fragment>
      <h2 id={`${formId}-title`} class="ac-type-h4-mega hero-form__title">{site.offer.formHeading}</h2>
      <p class="hero-form__lede">{site.offer.formLede}</p>
    </Fragment>
  )}

  <div class="hero-form__errors" tabindex="-1" role="alert" hidden data-quick-form-errors>
    <ul></ul>
  </div>

  <div class="hero-form__grid">
    <div class="hero-form__field">
      <label for={`${formId}-name`}>Full Name</label>
      <input id={`${formId}-name`} name="full_name" type="text" autocomplete="name" placeholder={contactKit || kit ? "Your name" : undefined} required />
    </div>

    <div class="hero-form__field">
      <label for={`${formId}-phone`}>{contactKit || kit ? "Phone" : "Phone Number"}</label>
      <input
        id={`${formId}-phone`}
        name="phone"
        type="tel"
        inputmode="tel"
        placeholder={contactKit || hoardingKit ? "(408) 555-0123" : kit ? "Your phone number" : undefined}
        autocomplete="tel"
        required
      />
    </div>

    <div class="hero-form__field">
      <label for={`${formId}-email`}>Email</label>
      <input
        id={`${formId}-email`}
        name="email"
        type="email"
        inputmode="email"
        placeholder={contactKit || hoardingKit ? "you@example.com" : kit ? "Your email address" : undefined}
        autocomplete="email"
        required
      />
    </div>

    <div class="hero-form__field">
      <label for={`${formId}-zip`}>{contactKit || kit ? "Property ZIP" : "Property ZIP Code"}</label>
      <input
        id={`${formId}-zip`}
        name="property_zip"
        type="text"
        inputmode="numeric"
        placeholder={contactKit || hoardingKit ? "95112" : kit ? "ZIP code" : undefined}
        autocomplete="postal-code"
        pattern="[0-9]{5}(?:-[0-9]{4})?"
        required
      />
    </div>

    <div class="hero-form__field">
      <label for={`${formId}-situation`}>{contactKit ? "What do you need help with?" : traumaKit || extremeKit || detailedKit ? "Type of Cleanup" : estateKit || hoardingKit ? "How Can We Help?" : homepage ? "Service Needed" : "What are you dealing with?"}</label>
      {extremeKit && <input type="hidden" name="property_situation" value={preselectValue} />}
      {traumaKit && <input type="hidden" name="property_situation" value="Crime scene or trauma cleanup" />}
      {hoardingKit && <input type="hidden" name="property_situation" value="Hoarding or heavy clutter" />}
      {estateKit && <input type="hidden" name="property_situation" value="Inherited or estate property" />}
      {detailedKit && <input type="hidden" name="property_situation" value="Detailed deep cleaning" />}
      <select id={`${formId}-situation`} name={detailedKit ? "detailed_need" : extremeKit ? "extreme_need" : traumaKit ? "trauma_need" : hoardingKit ? "hoarding_need" : estateKit ? "estate_need" : "property_situation"} required>
        {contactKit ? <Fragment><option value="">Select a service</option>{[
          ["Inherited or estate property", "Estate cleanout"],
          ["Hoarding or heavy clutter", "Hoarding cleanup"],
          ["Rodent droppings or animal waste", "Rodent or animal waste cleanup"],
          ["Crime scene or trauma cleanup", "Trauma or crime scene cleanup"],
          ["Severe property condition", "Extreme cleaning"],
          ["Detailed deep cleaning", "Detailed deep cleaning"],
          ["Not sure", "Other / not sure"]
        ].map(([value, label]) => <option value={value}>{label}</option>)}</Fragment> : detailedKit ? <Fragment><option value="">Select the cleaning needed</option>{["Kitchen and bathroom cleaning", "Whole-home detailed deep cleaning", "Move-in cleaning", "Move-out cleaning", "Specific rooms or surfaces", "Not sure / prefer to discuss"].map(label => <option>{label}</option>)}</Fragment> : extremeKit ? <Fragment><option value="">Select the cleanup needed</option>{["Heavy kitchen or bathroom buildup", "Food waste or accumulated trash", "Neglected home or room", "Rental or move-out cleanup", "Contents removal and cleaning", "Not sure / prefer to discuss"].map(label => <option>{label}</option>)}</Fragment> : traumaKit ? <Fragment><option value="">Select the cleanup needed</option>{["Crime scene cleanup", "Unattended death cleanup", "Suicide cleanup", "Blood or bodily fluid cleanup", "Accident cleanup", "Not sure / prefer to discuss"].map(label => <option>{label}</option>)}</Fragment> : hoardingKit ? <Fragment><option value="">Select what you need</option>{["Full property cleanout", "Selected rooms or areas", "Clearing a loved one’s home", "Cleanout with contamination", "Not sure yet"].map(label => <option>{label}</option>)}</Fragment> : estateKit ? <Fragment><option value="">Select what you need</option>{["Full property cleanout", "Partial cleanout", "Sorting and inventory", "Cleanout with deep cleaning", "Heavy accumulation or contamination", "Not sure yet"].map(label => <option>{label}</option>)}</Fragment> : <Fragment>
        {kit ? (
          <Fragment>
            <option value="Not sure">Help me choose a service</option>
            {homeKitServices.map(service => <option value={service.value} selected={estateKit && service.value === "Inherited or estate property"}>{service.label}</option>)}
          </Fragment>
        ) : (
          <Fragment>
            <option value="" selected={!preselectValue} disabled={!preselectValue}>Select an option</option>
            {assessment.situations.map(situation => <option value={situation.value} selected={situation.value === preselectValue}>{situation.label}</option>)}
          </Fragment>
        )}
      </Fragment>}
      </select>
    </div>

    <div class="hero-form__field hero-form__field--full">
      <label for={`${formId}-detail`}>{contactKit ? "Tell us about the property" : detailedKit ? "How Can We Help?" : traumaKit || extremeKit ? "How Can We Help? — Optional" : hoardingKit ? "Tell Us About the Property" : estateKit ? "What Do You Need Help With?" : kit ? "What needs cleanup?" : homepage ? "Message" : "Tell us what’s going on"}</label>
      <textarea
        id={`${formId}-detail`}
        name="property_detail"
        placeholder={contactKit ? "What needs attention? Include any timing or access details you want us to know." : detailedKit ? "Describe the rooms, surfaces, and buildup you want cleaned. Include any access limits or move date." : extremeKit ? "Briefly describe the affected rooms, buildup, and any access limits or deadline." : traumaKit ? "Briefly describe the help needed and any access information. You can discuss the details by phone." : hoardingKit ? "What areas need clearing? Is access limited? Are there belongings you need to keep or a deadline to meet?" : estateKit ? "Tell us about the contents, anything you need to keep, and your timeline…" : kit ? "What areas are affected, and what would you like help with?" : undefined}
        rows="3"
        required={!traumaKit && !extremeKit}
      ></textarea>
    </div>
    {(contactKit || homepage || hoardingKit || traumaKit || extremeKit || detailedKit) && (
      <div class="hero-form__field hero-form__field--full">
        <label for={`${formId}-photos`}>Add Photos (Optional)</label>
        <input id={`${formId}-photos`} name="property_media[]" type="file" accept=".jpg,.jpeg,.png,.heic,.webp" multiple aria-describedby={`${formId}-photos-help`} />
        <p id={`${formId}-photos-help`} class="hero-form__note">Up to 10 photos, 10 MB each; 75 MB combined.</p>
      </div>
    )}
  </div>

  <label class="hero-form__consent">
    <input type="checkbox" name="privacy_consent" value="yes" required />
    <span>
      {legal.consentBase.lead}{" "}
      <a class="hero-form__link" href={site.urls.privacyPolicy}>
        {legal.consentBase.privacyLabel}
      </a>{legal.consentBase.tail}
      {homepage && <Fragment>{" "}{legal.consentAssessmentAppendix.lead}{" "}<a class="hero-form__link" href={site.urls.terms}>{legal.consentAssessmentAppendix.termsLabel}</a>{legal.consentAssessmentAppendix.tail}</Fragment>}
    </span>
  </label>

  {
    site.integrations.turnstileSiteKey && (
      <div class="hero-form__turnstile">
        <div
          class="cf-turnstile"
          data-sitekey={site.integrations.turnstileSiteKey}
          data-theme={tone === "light" ? "light" : "dark"}
          data-size={contactKit || homepage || traumaKit || extremeKit || detailedKit ? "compact" : "flexible"}
          data-error-callback={homepage ? "acHomepageSecurityError" : undefined}
          data-callback={homepage ? "acHomepageSecurityReady" : undefined}
        />
      </div>
    )
  }
  <noscript>
    <p class="hero-form__note">
      Security verification requires JavaScript. Please call Aseptaclean if you cannot enable it.
    </p>
  </noscript>

  {
    !endpointAvailable && (
      <p class="hero-form__note" role="status">
        Online submission is not fully configured in this preview. Your answers will not be sent.
      </p>
    )
  }

  <button class="button hero-form__submit" type="submit" disabled={!endpointAvailable} data-quick-form-submit>
    <span data-quick-form-submit-label>{homepage ? "Request an Assessment" : site.offer.formSubmitCta}</span>
  </button>
  <p class="hero-form__clarification">
    Submitting this form authorizes Aseptaclean to contact you. It does not authorize work or
    create a service agreement.
  </p>
  <p class="hero-form__status" data-quick-form-status role="status" aria-live="polite" hidden></p>
</form>

{homepage && (
  <script is:inline define:vars={{ formId }}>
    // Keep provider failures visible in the local preview and recover after a valid challenge.
    window.acHomepageSecurityError = function () {
      const form = document.getElementById(formId);
      const status = form?.querySelector("[data-quick-form-status]");
      const button = form?.querySelector("[data-quick-form-submit]");
      if (status) {
        status.hidden = false;
        status.textContent = "Security verification could not load. Your answers have not been sent. Reload this page or call " + form.dataset.contactPhone + ".";
      }
      if (button) button.disabled = true;
    };
    window.acHomepageSecurityReady = function () {
      const form = document.getElementById(formId);
      if (!form?.getAttribute("action") || form.getAttribute("aria-busy") === "true") return;
      const status = form.querySelector("[data-quick-form-status]");
      const button = form.querySelector("[data-quick-form-submit]");
      if (status) { status.hidden = true; status.textContent = ""; }
      if (button) button.disabled = false;
    };
  </script>
)}

{
  site.integrations.turnstileSiteKey && (
    <script
      is:inline
      data-categories="essential"
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import { storeAcceptedInquiryReceipt } from "../../scripts/acceptedInquiryReceipt";

  // Identical submit/validation/error-rendering contract to QuickHandoffForm.astro — see that
  // file for the field-by-field rationale. Duplicated here (not imported) because Astro scripts
  // are page-scoped and this hero form has one extra field group (property_zip,
  // property_situation) with its own approved-message overrides.
  type FormControl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  document
    .querySelectorAll<HTMLFormElement>("[data-quick-form]")
    .forEach((form) => {
      if (form.dataset.enhanced === "true") return;
      form.dataset.enhanced = "true";
      form.noValidate = true;

      const errorBox = form.querySelector<HTMLElement>("[data-quick-form-errors]");
      const errorList = errorBox?.querySelector("ul");
      const statusEl = form.querySelector<HTMLElement>("[data-quick-form-status]");
      const submitButton = form.querySelector<HTMLButtonElement>("[data-quick-form-submit]");
      const submitLabel = form.querySelector<HTMLElement>("[data-quick-form-submit-label]");
      const defaultLabel = submitLabel?.textContent ?? "Submit";
      const timestampInput = form.elements.namedItem("submission_timestamp");
      const idempotencyInput = form.elements.namedItem("idempotency_key");

      if (idempotencyInput instanceof HTMLInputElement) {
        idempotencyInput.value =
          window.crypto?.randomUUID?.() ??
          `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      const resetTurnstile = () => {
        const turnstile = (
          window as Window & {
            turnstile?: { reset: (widget?: string | HTMLElement) => void };
          }
        ).turnstile;
        const widget = form.querySelector<HTMLElement>(".cf-turnstile");
        if (turnstile && widget) turnstile.reset(widget);
      };

      const clearFieldErrors = () => {
        form.querySelectorAll<HTMLElement>("[data-generated-error]").forEach((el) => el.remove());
        form
          .querySelectorAll<FormControl>('[aria-invalid="true"]')
          .forEach((control) => control.removeAttribute("aria-invalid"));
      };

      const labelFor = (control: FormControl) => {
        const label = form.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(control.id)}"]`);
        return label?.textContent?.replace("*", "").trim() ?? "Field";
      };

      const approvedFieldMessage: Record<string, string> = {
        phone: "Add a phone number so Matthew can reach you about the property.",
        email: "Add a valid email address so we can send a confirmation.",
        privacy_consent: "Check the consent box so we're allowed to call or text you back.",
        property_zip: "Add the property ZIP code so we can confirm the service area.",
        property_situation: "Select the option that sounds closest to what's happening."
      };

      const contactPhone = form.dataset.contactPhone ?? "";
      const submissionErrorMessage = contactPhone
        ? `Something went wrong on our end and the form didn't send. Call or text ${contactPhone} and we'll take it from there.`
        : "Something went wrong on our end and the form didn't send. Call or text us and we'll take it from there.";

      // Keep the same accepted-lead event contract as PpcHeroForm. No submitted value is ever
      // included: identifiers are structural, the route is pathname-only, and error categories
      // are derived from HTTP status. The confirmation code is used only as a session-scoped
      // deduplication key and is not sent as an event parameter.
      const pagePath = window.location.pathname;
      const offerType =
        (form.elements.namedItem("offer_type") as HTMLInputElement | null)?.value ?? "";
      const photoInput = form.elements.namedItem("property_media[]") as HTMLInputElement | null;
      const trackingPayload = (
        event: string,
        detail: Record<string, string | number | boolean> = {}
      ) => ({
        event,
        form_id: form.id,
        page_path: pagePath,
        ...(offerType ? { offer_type: offerType } : {}),
        ...detail
      });
      const track = (
        event: string,
        detail: Record<string, string | number | boolean> = {}
      ) => {
        (window as Window & { dataLayer?: unknown[] }).dataLayer ??= [];
        (window as Window & { dataLayer?: unknown[] }).dataLayer!.push(
          trackingPayload(event, detail)
        );
      };
      const containerLoaded = () => {
        const containers = (window as Window & { google_tag_manager?: Record<string, unknown> })
          .google_tag_manager;
        return Boolean(containers && Object.keys(containers).some((key) => key.startsWith("GTM-")));
      };
      const trackAndSettle = (
        event: string,
        detail: Record<string, string | number | boolean>
      ) =>
        new Promise<void>((resolve) => {
          (window as Window & { dataLayer?: unknown[] }).dataLayer ??= [];
          if (!containerLoaded()) {
            (window as Window & { dataLayer?: unknown[] }).dataLayer!.push(
              trackingPayload(event, detail)
            );
            resolve();
            return;
          }
          let settled = false;
          const settle = () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timer);
            resolve();
          };
          const timer = window.setTimeout(settle, 1000);
          (window as Window & { dataLayer?: unknown[] }).dataLayer!.push({
            ...trackingPayload(event, detail),
            eventTimeout: 1000,
            eventCallback: settle
          });
        });
      const claimLead = (code: string) => {
        if (!code) return false;
        try {
          const key = `ac_ppc_lead:${code}`;
          if (window.sessionStorage.getItem(key)) return false;
          window.sessionStorage.setItem(key, "1");
          return true;
        } catch {
          return false;
        }
      };
      const errorCategory = (status: number) => {
        if (status === 400) return "verification_failed";
        if (status === 403) return "origin_rejected";
        if (status === 413) return "payload_too_large";
        if (status === 422) return "server_validation";
        if (status === 429) return "rate_limited";
        if (status === 503) return "service_unavailable";
        if (status >= 500) return "server_error";
        if (status >= 400) return "request_rejected";
        return "unexpected_response";
      };
      let startRecorded = false;
      const recordStart = () => {
        if (startRecorded) return;
        startRecorded = true;
        track("form_start");
      };
      form.addEventListener("input", recordStart);
      form.addEventListener("change", recordStart);

      const renderErrors = (errors: Record<string, string>) => {
        clearFieldErrors();
        const messages: string[] = [];

        for (const [key, serverMessage] of Object.entries(errors)) {
          const message = approvedFieldMessage[key] ?? serverMessage;
          if (key === "form") {
            messages.push(message);
            continue;
          }
          const control = form.elements.namedItem(key);
          if (control instanceof HTMLInputElement && control.type === "checkbox") {
            control.setAttribute("aria-invalid", "true");
            const wrapper = control.closest("label");
            if (wrapper) {
              const inline = document.createElement("p");
              inline.className = "form-error";
              inline.dataset.generatedError = "";
              inline.textContent = message;
              wrapper.after(inline);
            }
            messages.push(message);
            continue;
          }
          if (
            control instanceof HTMLInputElement ||
            control instanceof HTMLTextAreaElement ||
            control instanceof HTMLSelectElement
          ) {
            control.setAttribute("aria-invalid", "true");
            const field = control.closest(".hero-form__field");
            if (field) {
              const inline = document.createElement("p");
              inline.className = "form-error";
              inline.dataset.generatedError = "";
              inline.textContent = message;
              field.append(inline);
            }
            messages.push(`${labelFor(control)}: ${message}`);
            continue;
          }
          messages.push(message);
        }

        if (errorBox && errorList) {
          errorList.replaceChildren();
          if (messages.length) {
            messages.forEach((message) => {
              const item = document.createElement("li");
              item.textContent = message;
              errorList.append(item);
            });
            errorBox.hidden = false;
            errorBox.focus({ preventScroll: true });
            errorBox.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            errorBox.hidden = true;
          }
        }
      };

      const setSubmitting = (submitting: boolean, message = "") => {
        if (submitButton) submitButton.disabled = submitting;
        form.setAttribute("aria-busy", String(submitting));
        if (submitLabel) submitLabel.textContent = submitting ? "Sending request…" : defaultLabel;
        if (statusEl) {
          statusEl.hidden = !message;
          statusEl.textContent = message;
        }
      };

      let inFlight = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.action) return;
        if (inFlight) return;
        if (form.hasAttribute("data-contact-kit")) {
          const invalid = [...form.elements].filter((control): control is FormControl =>
            (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) && !control.checkValidity());
          if (invalid.length) {
            renderErrors(Object.fromEntries(invalid.map(control => [control.name, control.validationMessage])));
            return;
          }
        }

        clearFieldErrors();
        if (errorBox) errorBox.hidden = true;
        if (form.hasAttribute("data-estate-kit") && !(form.elements.namedItem("estate_need") as HTMLSelectElement)?.value) {
          renderErrors({ estate_need: "Select what you need." });
          return;
        }

        if (form.hasAttribute("data-hoarding-kit") && !(form.elements.namedItem("hoarding_need") as HTMLSelectElement)?.value) {
          renderErrors({ hoarding_need: "Select what you need." });
          return;
        }

        if (form.hasAttribute("data-extreme-kit") && !(form.elements.namedItem("extreme_need") as HTMLSelectElement)?.value) {
          renderErrors({ extreme_need: "Select the cleanup needed." });
          return;
        }
        if (form.hasAttribute("data-trauma-kit") && !(form.elements.namedItem("trauma_need") as HTMLSelectElement)?.value) {
          renderErrors({ trauma_need: "Select the cleanup needed." });
          return;
        }
        if (form.hasAttribute("data-detailed-kit") && !(form.elements.namedItem("detailed_need") as HTMLSelectElement)?.value) {
          renderErrors({ detailed_need: "Select the cleaning needed." });
          return;
        }

        const turnstileWidget = form.querySelector(".cf-turnstile");
        const turnstileToken = form.elements.namedItem("cf-turnstile-response");
        if (
          turnstileWidget &&
          (!(turnstileToken instanceof HTMLInputElement) || !turnstileToken.value)
        ) {
          setSubmitting(false, "Complete the security verification, then submit again.");
          return;
        }

        if (timestampInput instanceof HTMLInputElement) {
          timestampInput.value = new Date().toISOString();
        }

        const photosAttached = Boolean(photoInput?.files?.length);
        inFlight = true;
        track("ppc_form_submit_attempt", { photos_attached: photosAttached });
        setSubmitting(true, "Sending your request…");

        try {
          const formData = new FormData(form);
          // Estate's approved need labels stay visible; the frozen CRM enum stays intact.
          // Carry the selected need in the supported message field, without altering the input.
          if (form.hasAttribute("data-estate-kit")) {
            const need = String(formData.get("estate_need") || "");
            formData.set("property_detail", `${need}\n\n${formData.get("property_detail") || ""}`);
            formData.delete("estate_need");
          }
          if (form.hasAttribute("data-hoarding-kit")) {
            const need = String(formData.get("hoarding_need") || "");
            formData.set("property_detail", `${need}\n\n${formData.get("property_detail") || ""}`);
            formData.delete("hoarding_need");
          }
          if (form.hasAttribute("data-extreme-kit")) {
            const need = String(formData.get("extreme_need") || "");
            formData.set("property_detail", `${need}\n\n${formData.get("property_detail") || ""}`);
            formData.delete("extreme_need");
          }
          if (form.hasAttribute("data-trauma-kit")) {
            const need = String(formData.get("trauma_need") || "");
            formData.set("property_detail", `${need}\n\n${formData.get("property_detail") || ""}`);
            formData.delete("trauma_need");
          }
          if (form.hasAttribute("data-detailed-kit")) {
            const need = String(formData.get("detailed_need") || "");
            formData.set("property_detail", `${need}\n\n${formData.get("property_detail") || ""}`);
            formData.delete("detailed_need");
          }
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: formData
          });
          let payload: Record<string, unknown> = {};
          try {
            payload = await response.json();
          } catch {
            payload = {};
          }

          if (response.ok && payload.ok === true) {
            const code =
              typeof payload.confirmationCode === "string" ? payload.confirmationCode : "";
            const codeIsValid = /^AC-[0-9A-HJKMNP-TV-Z]{6}$/.test(code);
            if (!codeIsValid || claimLead(code)) {
              await trackAndSettle("ppc_form_success", {
                photos_attached: photosAttached
              });
            }
            // The receipt page trusts same-tab state written only on genuine backend
            // acceptance. No submitted field, delivery flag or forgeable success marker is
            // placed in the URL.
            storeAcceptedInquiryReceipt(payload);
            window.location.assign("/thank-you/");
            return;
          }

          if (payload.errors && typeof payload.errors === "object") {
            renderErrors(payload.errors as Record<string, string>);
          }
          track("ppc_form_error", {
            error_type: errorCategory(response.status),
            photos_attached: photosAttached
          });
          inFlight = false;
          setSubmitting(
            false,
            typeof payload.message === "string" ? payload.message : submissionErrorMessage
          );
          resetTurnstile();
        } catch {
          track("ppc_form_error", {
            error_type: "network",
            photos_attached: photosAttached
          });
          inFlight = false;
          setSubmitting(false, submissionErrorMessage);
          resetTurnstile();
        }
      });
    });
</script>


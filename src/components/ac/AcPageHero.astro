---
// CompactPhotoHero — doc 30 §3: "The hub and About use shorter photographic introductions
// without the full intake panel." Reference ClearPath p24/p29 (hub) and p26/p32 (About).
//
// REBUILT 2026-09-04. This used to be a white text hero with a small contained photograph on the
// right, which doc 30 §1 names as the thing NOT to do ("Do not substitute the old
// white-copy/isolated-photo split"). It is now the same photographic composition as
// AcHeroWithForm — full-bleed image, flat navy overlay, left copy — but SHORTER, and with a
// secondary "Send a Message" link to Contact's form instead of an intake panel.
//
// Same geometry rules as the hero-with-form: no fixed height, no overflow:hidden, content sets
// the height, and the call action sits directly under the headline.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import AcActions from "./AcActions.astro";
import { srcsetWidths } from "../imageWidths";

interface Props {
  eyebrow: string;
  heading: string;
  headingId?: string;
  lead?: string;
  body?: readonly string[];
  /** Additional paragraph(s) rendered at body size but bold — a source **bold** line that is not
   * the hero's lead sentence. Rendered after `body`, in order. */
  strongBody?: readonly string[];
  /** Short factual lines under the actions. Verified facts only — never a badge wall. */
  assurances?: readonly string[];
  image?: ImageMetadata;
  imageAlt?: string;
  needsAsset?: string;
  /** Overrides the default "Call Aseptaclean" label where a route's approved copy writes out
   * the number instead (e.g. "Call (408) 785-7588"). The action is unchanged — still
   * site.business.phoneUri, still omitted when that value is empty. */
  primaryLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  showActions?: boolean;
}

const {
  eyebrow,
  heading,
  headingId = "page-hero-title",
  lead,
  body = [],
  strongBody = [],
  assurances = [],
  image,
  imageAlt = "",
  needsAsset,
  primaryLabel,
  secondaryLabel,
  secondaryHref,
  showActions = true
} = Astro.props;

// Clamped to the master — see src/components/imageWidths.ts.
const heroWidths = image ? srcsetWidths(image, [480, 768, 1024, 1440, 1920]) : [];
---

<section class:list={["acx-phero", "ac-hero", { "is-flat": !image }]} aria-labelledby={headingId}>
  {image && (
    <div class="acx-phero__media">
      <Image
        src={image}
        alt={imageAlt}
        layout="full-width"
        widths={heroWidths}
        sizes="100vw"
        format="webp"
        quality={76}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  )}
  <div class="acx-phero__overlay" aria-hidden="true" data-needs-asset={needsAsset}></div>

  <div class="acx-phero__shell ac-shell">
    <div class="acx-phero__copy ac-hero__copy">
      <p class="acx-phero__eyebrow">{eyebrow}</p>
      <h1 id={headingId} class="ac-type-h1-hub">{heading}</h1>
      {lead && <p class="acx-phero__lead">{lead}</p>}
      {body.map((paragraph) => <p class="acx-phero__body">{paragraph}</p>)}
      {strongBody.map((paragraph) => <p class="acx-phero__body acx-phero__body--strong">{paragraph}</p>)}
      {showActions && (
        <div class="acx-phero__actions">
          <AcActions tone="dark" primaryLabel={primaryLabel} secondaryLabel={secondaryLabel} secondaryHref={secondaryHref} />
        </div>
      )}
      {assurances.length > 0 && (
        <ul class="acx-phero__assurances">
          {assurances.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .acx-phero {
    position: relative;
    isolation: isolate;
    background: var(--ac-color-navy-950);
    color: #fff;
  }

  /* SHARED HERO SIZING — docs/ASEPTACLEAN-DESIGN-SPEC.md §2.1/§2.2. Same floor as AcHeroWithForm
     (600/560/440 at 1024/768px baseline, escalated to 696/680 desktop/tablet), so About, Contact
     and the rodent public/campaign pages that render through this component measure the same as
     the homepage and the four sibling service pages. A MIN-height, not a fixed one —
     `.acx-phero__shell` stays in normal flow, so long approved copy still grows the section
     instead of clipping.

     696/680, corrected 2026-09-18 from a prior 736/592 — see AcHeroWithForm.astro's own comment
     for the full root-cause writeup (a misplaced in-hero trust paragraph and a duplicate hero
     trustLine on the homepage). This component's own callers (About, Contact, the rodent public
     page) were never the tall outlier; they simply inherited the inflated shared token. */
  .acx-phero {
    min-height: 440px;
  }

  @media (min-width: 48rem) {
    .acx-phero {
      min-height: 680px;
    }
  }

  @media (min-width: 64rem) {
    .acx-phero {
      min-height: 696px;
    }
  }

  .acx-phero__media {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .acx-phero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Same flat navy overlay as the hero-with-form. On `is-flat` (no photograph yet) the overlay
     is the surface itself, so the composition holds and a future asset drop is a one-line
     change rather than a layout change. */
  .acx-phero__overlay {
    position: absolute;
    z-index: 1;
    background: rgb(18 40 64 / 66%);
    inset: 0;
  }

  .is-flat .acx-phero__overlay {
    background: var(--ac-color-navy-900);
  }

  /* SHARED CONTENT INSET — Aseptaclean_Website_Design_Blueprint.md "Mandatory shared hero
     sizing": 40px mobile / 48px tablet (768px+) / 64px desktop (1024px+), top and bottom — the
     same stepped values AcHeroWithForm uses, so this component's four callers (rodent, About,
     Contact, and the rodent PPC landing page) measure identically to the homepage and the four
     sibling service pages. Was a fluid `clamp(40px, 5vw, 64px)`, which does not land on the
     blueprint's exact breakpoints. */
  .acx-phero__shell {
    position: relative;
    z-index: 2;
    padding-block: 40px;
  }

  @media (min-width: 48rem) {
    .acx-phero__shell {
      padding-block: 48px;
    }
  }

  @media (min-width: 64rem) {
    .acx-phero__shell {
      padding-block: 64px;
    }
  }

  .acx-phero__copy {
    max-width: 46rem;
  }

  .acx-phero__eyebrow {
    margin: 0 0 14px;
    max-width: none;
    color: var(--ac-color-blue-on-navy);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* Size comes from .ac-type-h1-hub — no font-size on a heading here (type law #1). */
  .acx-phero__copy h1 {
    color: #fff;
    line-height: 1.1;
    text-wrap: balance;
  }

  .acx-phero__lead {
    margin: 18px 0 0;
    color: #fff;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .acx-phero__body {
    margin: 14px 0 0;
    color: rgb(255 255 255 / 88%);
    font-size: var(--ac-text-body);
    line-height: 1.6;
  }

  .acx-phero__body--strong {
    color: #fff;
    font-weight: 650;
  }

  .acx-phero__actions {
    margin-top: 26px;
  }

  .acx-phero__assurances {
    display: flex;
    max-width: none;
    flex-wrap: wrap;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    gap: 6px 26px;
  }

  .acx-phero__assurances li {
    max-width: none;
    color: rgb(255 255 255 / 78%);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* Was an asymmetric 32px/36px, predating the blueprint's stepped inset table above (40px
     mobile, both sides, applied unconditionally at the top of this block). No separate mobile
     override needed — removed rather than left to silently win at this width. */
</style>

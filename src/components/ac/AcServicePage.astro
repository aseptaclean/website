---
// SERVICE PAGE RENDERER — one shared system, five different compositions.
//
// doc 30 §3: "Home and the five service pages share one responsive HeroWithForm component."
// doc 30 §5: "Services use the common photo hero/form, then page-specific arrangements in their
// briefs. Avoid duplicating the homepage architecture word for word on every page."
//
// This component renders a page's SECTION LIST. It does not define one. Each record in
// src/data/servicePageCopy.ts chooses its own section kinds, order, split directions, image
// ratios and surface tones, per that page's brief in docs/page-briefs/.
//
// HERO CHANGED 2026-09-04: these pages used AcPageHero — a white text hero with a small
// contained photograph. Reference ClearPath p28 shows the same photo-background hero the
// homepage uses, and doc 30 §1 says so explicitly: "Do not substitute the old
// white-copy/isolated-photo split."
//
// HERO FORM REMOVED 2026-09-17 (docs/Aseptaclean_Service_Hero_And_Spaces_Update.md; recorded in
// docs/05-CURRENT-DECISIONS.md and AGENTS.md's hero-form-scope rule). The owner directed that
// every service-detail-page hero match the rodent page's no-form composition: same full-bleed
// photo + flat navy overlay via AcHeroWithForm's `showForm={false}`, with the working
// AcCompactForm relocated to a centered contact section near the bottom of the page, replacing
// the old AcFinalCta closing band (whose copy is now that section's own introduction). The
// homepage is the only remaining caller of AcHeroWithForm with a hero-embedded form.
import BaseLayout from "@layouts/BaseLayout.astro";
import AcHeroWithForm from "./AcHeroWithForm.astro";
import AcTrustStrip from "./AcTrustStrip.astro";
import AcIntro from "./AcIntro.astro";
import AcSplit from "./AcSplit.astro";
import AcDarkBand from "./AcDarkBand.astro";
import AcSteps from "./AcSteps.astro";
import AcCheckList from "./AcCheckList.astro";
import AcCompactForm from "./AcCompactForm.astro";
import FaqAccordion from "@components/FaqAccordion.astro";
import { launchServiceLinks } from "@data/launchArchitecture";
import { legal, site } from "@data/site";
import type { ServicePageRecord } from "@data/servicePageCopy";

// Image registry. Keyed by the string names the copy records use, so a data file never imports
// an asset and an asset swap is a one-line change here.
//
// LEGACY STOCK AND COMMONS FILES REMOVED FROM THIS REGISTRY 2026-09-05. Every service-page slot
// that used one has been repointed to the owner image package below or, where the package has no
// image of the section's subject, left copy-only. The registry is now the package plus nothing
// else, so a copy record cannot reintroduce a stock person, a gloved hand or an unattributed
// Commons photograph by naming one — the build throws on an unknown hero key and silently drops
// an unknown section key, and neither name exists here any more. See docs/06-ASSET-MANIFEST.md.

// OWNER IMAGE PACKAGE, installed 2026-09-05. Registered under their canonical package filenames
// so a copy record names the same string the package's README-ASSET-MAP.md does, and the
// placement is traceable from data to file without a translation table.
import founderPortrait from "../../assets/aseptaclean/founder-matthew-ruiz.jpeg";
import propertyIntroduction from "../../assets/aseptaclean/property-interior-introduction.png";
import hoardingLivingRoom from "../../assets/aseptaclean/hoarding-living-room.png";
import hoardingRestrictedWalkway from "../../assets/aseptaclean/hoarding-restricted-walkway.png";
import hoardingGarageContents from "../../assets/aseptaclean/hoarding-garage-contents.png";
import extremeKitchen from "../../assets/aseptaclean/extreme-cleaning-neglected-kitchen.png";
import extremeBathroomBuildup from "../../assets/aseptaclean/extreme-cleaning-bathroom-buildup.png";
import extremeFloorEdges from "../../assets/aseptaclean/extreme-cleaning-floor-edges.png";
import deepCleaningKitchen from "../../assets/aseptaclean/detailed-deep-cleaning-kitchen.png";
import deepCleaningShower from "../../assets/aseptaclean/deep-cleaning-shower-deposits.png";
import deepCleaningWindowTrack from "../../assets/aseptaclean/deep-cleaning-window-track.png";
import deepCleaningBaseboard from "../../assets/aseptaclean/deep-cleaning-baseboard-edge.png";
import traumaContext from "../../assets/aseptaclean/trauma-residential-context.png";
import traumaSurfaces from "../../assets/aseptaclean/trauma-residential-surfaces.png";
// OWNER-APPROVED 2026-09-06, Crime & Trauma only. Three images were supplied separately from the
// 2026-09-05 package and approved by name for this page. They are the first images on the site
// that show a person, and the owner's approval is explicitly SCOPED: it supersedes the blanket
// "no AI-generated people" restriction (AGENTS.md §0.3 / doc 21 §6) for these assets on this
// route and nowhere else. It is not a licence to restore the stock technicians removed on
// 2026-09-05 — those stay removed. The figures are service visuals, not Aseptaclean employees:
// no logo, no "our team" caption, no project or before/after claim, and the alt text describes
// only the visible activity. Recorded in docs/06-ASSET-MANIFEST.md.
//
// `trauma-affected-carpet-detail.png` is installed in src/assets/aseptaclean/ but is DELIBERATELY
// ABSENT from this registry. It depicts carpet being cut out, and this page publishes no scope
// line covering material removal, so registering it would let a copy record place it and silently
// broaden the service offer. The owner ruled on 2026-09-06 that the image is supplied but NOT
// selected for publication, and that no service, claim or exclusions section is to be added to
// accommodate it — so this absence is settled, not pending. See docs/06-ASSET-MANIFEST.md.
import traumaFloorCleanup from "../../assets/aseptaclean/trauma-residential-floor-cleanup.png";
import traumaFloorSurface from "../../assets/aseptaclean/trauma-floor-surface-cleaning.png";
import rodentUtilityRoom from "../../assets/aseptaclean/rodent-utility-room-context.png";
import rodentSurfaceDetail from "../../assets/aseptaclean/rodent-hard-surface-detail.png";
import rodentStorageContents from "../../assets/aseptaclean/rodent-storage-contents.png";

const IMAGES: Record<string, ImageMetadata> = {
  // Genuine company asset. The four "Why Aseptaclean" sections are about the founder's own
  // background, so they carry his real photograph instead of the stock figures in coveralls that
  // stood there before. Always ratio "3/4" — the contained portrait plate.
  "founder-matthew-ruiz": founderPortrait,

  // Owner package — placement-guide slots 02-17.
  "property-interior-introduction": propertyIntroduction,
  "hoarding-living-room": hoardingLivingRoom,
  "hoarding-restricted-walkway": hoardingRestrictedWalkway,
  "hoarding-garage-contents": hoardingGarageContents,
  "extreme-cleaning-neglected-kitchen": extremeKitchen,
  "extreme-cleaning-bathroom-buildup": extremeBathroomBuildup,
  "extreme-cleaning-floor-edges": extremeFloorEdges,
  "detailed-deep-cleaning-kitchen": deepCleaningKitchen,
  "deep-cleaning-shower-deposits": deepCleaningShower,
  "deep-cleaning-window-track": deepCleaningWindowTrack,
  "deep-cleaning-baseboard-edge": deepCleaningBaseboard,
  "trauma-residential-context": traumaContext,
  "trauma-residential-surfaces": traumaSurfaces,

  // Owner-supplied and owner-approved 2026-09-06 — Crime & Trauma only. See the import note.
  "trauma-residential-floor-cleanup": traumaFloorCleanup,
  "trauma-floor-surface-cleaning": traumaFloorSurface,
  "rodent-utility-room-context": rodentUtilityRoom,
  "rodent-hard-surface-detail": rodentSurfaceDetail,
  "rodent-storage-contents": rodentStorageContents
};

// Image provenance — illustrative package art, licensed stock, or owner-shot — is recorded in
// docs/06-ASSET-MANIFEST.md. It is deliberately NOT printed next to the image: the visitor-facing
// reference captions were removed 2026-09-05 at the owner's instruction. Alt text still describes
// what is visible and never claims a photo is Aseptaclean project work.

interface Props {
  page: ServicePageRecord;
}

const { page } = Astro.props;
const img = (name?: string) => (name ? IMAGES[name] : undefined);

// Hero imagery is required by doc 30 §1, so resolve it strictly: an unknown key is a data error
// and should stop the build here rather than render a heroless page.
const heroImage = IMAGES[page.heroImage];
if (!heroImage) {
  throw new Error(
    `servicePageCopy: ${page.slug} names heroImage "${page.heroImage}", which is not in AcServicePage's image registry.`
  );
}

// Related services: every current public service except this one, as compact text links
// (docs/ASEPTACLEAN-DESIGN-SPEC.md §4.2-4.6 `-related`: "Compact links... no photos"). A page
// never lists itself.
const related = launchServiceLinks
  .filter((link) => link.href !== page.slug)
  .map((link) => ({ title: link.label, href: link.href }));

// FAQPage JSON-LD only where the page actually renders an FAQ accordion (doc 21 §6.1: schema
// must not describe content a visitor cannot see).
const faqSection = page.sections.find((section) => section.kind === "faq");

const schema: Record<string, unknown>[] = [
  {
    "@type": "Service",
    serviceType: page.name,
    name: page.name,
    description: page.seoDescription,
    url: new URL(page.slug, site.urls.site).href,
    provider: { "@id": new URL("/#business", site.urls.site).href },
    areaServed: site.location.cities.map((name) => ({ "@type": "City", name }))
  },
  {
    // "Services" breadcrumb node removed 2026-09-18: the hub it pointed at (/services/) is
    // retired (owner blueprint). No other real hub sits between Home and these four pages, so the
    // trail goes straight from Home to the page itself rather than pointing at a redirected URL.
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: page.name,
        item: new URL(page.slug, site.urls.site).href
      }
    ]
  }
];

if (faqSection && faqSection.kind === "faq") {
  schema.push({
    "@type": "FAQPage",
    mainEntity: faqSection.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  });
}
---

<BaseLayout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath={page.slug}
  schema={schema}
>
  {/* docs/20-COPY-MAP.md "Placement rules": the hero carries the page name, its first outcome
      subheading and the first two prose paragraphs; the remaining opening paragraphs move into
      the first white section directly below, so compactness never deletes copy. The form
      preselects this page's service via the frozen enum in src/data/assessment.ts. */}
  <AcHeroWithForm
    eyebrow={`${page.eyebrow} · San Jose · ${site.location.serviceArea}`}
    heading={page.h1}
    headingId="service-hero-title"
    lead={page.heroLead}
    body={page.heroBody}
    image={heroImage}
    imageAlt={page.heroImageAlt}
    imagePosition={page.heroImagePosition}
    stackedLayout={page.heroStackedLayout}
    stackedImagePosition={page.heroStackedImagePosition}
    showForm={false}
    secondaryHref="#service-contact"
  />

  {/* heroAssurances used to render as a trustLine INSIDE the hero (`.acx-hero__trust`), which
      pushed the two longest-headline pages (Hoarding, Extreme Cleaning) past the spec's 720px
      desktop hero-height ceiling (docs/ASEPTACLEAN-DESIGN-SPEC.md §2.2: "Trust signals... are
      outside that measurement"). Moved here, into the existing below-hero trust strip that
      already sits outside `.ac-hero` — same approved wording, same order, nothing dropped. */}
  <AcTrustStrip lead={[...(page.trustLead ?? []), ...page.heroAssurances]} />

  {page.sections.map((section) => {
    if (section.kind === "split") {
      return (
        <AcSplit
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          body={section.body}
          pullQuote={section.pullQuote}
          image={img(section.image)}
          imageAlt={section.imageAlt}
          needsAsset={section.needsAsset}
          ratio={section.ratio}
          reverse={section.reverse}
          tone={section.tone}
        >
          {section.list && (
            <div class="svc-list">
              <AcCheckList
                items={section.list}
                tone={section.listTone}
                columns={section.listColumns}
                compact
              />
            </div>
          )}
          {section.closing?.map((paragraph) => <p class="svc-closing">{paragraph}</p>)}
          {/* Mandatory wherever the founder's background appears —
              docs/02-CURRENT-FACTS.md "Preserve factual boundaries". Never reworded. */}
          {section.founderLimit && <p class="svc-limit">{legal.founderAuthorityLimit}</p>}
        </AcSplit>
      );
    }

    if (section.kind === "intro") {
      return (
        <AcIntro
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          body={section.body}
          tone={section.tone}
        >
          {section.list && (
            <div class="svc-list svc-list--wide">
              <AcCheckList
                items={section.list}
                tone={section.listTone}
                columns={section.listColumns}
              />
            </div>
          )}
        </AcIntro>
      );
    }

    if (section.kind === "dark") {
      return (
        <AcDarkBand
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingAccent={section.headingAccent}
          headingId={section.id}
          body={section.body}
          pullQuote={section.pullQuote}
          image={img(section.image)}
          imageAlt={section.imageAlt}
          needsAsset={section.needsAsset}
        />
      );
    }

    if (section.kind === "steps") {
      return (
        <AcIntro
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          tone="soft"
        >
          <div class="svc-steps">
            <AcSteps steps={section.steps} />
          </div>
        </AcIntro>
      );
    }

    // docs/ASEPTACLEAN-DESIGN-SPEC.md §4.4 `deep-rooms`: ".ac-room-grid three columns desktop,
    // one below 1024 ... Heading ABOVE grid. Each column contains its complete checklist. No
    // paired image, accordion, clipping, or fixed checklist height." A `roomLists` section with
    // no `image` renders this layout instead of the AcSplit-wrapped one below — the three
    // complete checklists used to sit beside one photo stretched the length of all three lists
    // combined, which the spec's evidence appendix flags by name.
    if (section.kind === "roomLists" && !section.image) {
      return (
        <AcIntro
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          body={section.body}
        >
          <div class="svc-room-grid">
            {section.groups.map((group) => (
              <div class="svc-room-grid__col">
                <h3 class="ac-type-h3-band">{group.title}</h3>
                <AcCheckList items={group.items} compact />
              </div>
            ))}
          </div>
          {section.pullQuote && <p class="svc-close">{section.pullQuote}</p>}
          {section.close && <p class="svc-close">{section.close}</p>}
        </AcIntro>
      );
    }

    if (section.kind === "roomLists") {
      return (
        <AcSplit
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          body={section.body}
          pullQuote={section.pullQuote}
          image={img(section.image)}
          imageAlt={section.imageAlt}
        >
          <div class="svc-rooms">
            {section.groups.map((group) => (
              <div class="svc-rooms__group">
                <h3 class="ac-type-h3-band">{group.title}</h3>
                <AcCheckList items={group.items} compact />
              </div>
            ))}
          </div>
          {section.close && <p class="svc-close">{section.close}</p>}
        </AcSplit>
      );
    }

    if (section.kind === "twoLists") {
      return (
        <AcIntro
          eyebrow={section.eyebrow}
          heading={section.heading}
          headingId={section.id}
          lead={section.lead}
          body={section.body}
        >
          <div class="svc-two">
            <div>
              <h3 class="ac-type-h3-band">{section.includeTitle}</h3>
              <AcCheckList items={section.include} />
            </div>
            <div>
              <h3 class="ac-type-h3-band">{section.excludeTitle}</h3>
              <AcCheckList items={section.exclude} tone="exclude" />
            </div>
          </div>
          {section.close && <p class="svc-close">{section.close}</p>}
        </AcIntro>
      );
    }

    return (
      <AcIntro heading={section.heading} headingId={section.id} tone="soft" narrow>
        <div class="svc-faq">
          <FaqAccordion items={section.items} headingId={section.id} />
        </div>
      </AcIntro>
    );
  })}

  {/* COMPACT RELATED-SERVICE LINKS — docs/ASEPTACLEAN-DESIGN-SPEC.md §4.2-4.6's `-related` row
      for every service page: "Compact links | Relevant public services only" / CSS contract §7
      `.ac-related`: "Compact title/text links to relevant public services; no photos." This used
      to render as a full AcServiceCards photo grid (five cards: four across a row plus one
      orphaned alone on the next), which is exactly what the spec's evidence appendix flags —
      "Full-height four-card grids repeat near the end of every service page and delay the form" —
      and duplicates the homepage's own card treatment instead of staying compact. Replaced with a
      text-link row; no image, no description, no orphan row. The lead copy's service count was
      also stale ("four other... conditions") from before Estate Cleanout became the sixth public
      service, leaving five "other" services on every page — corrected to match. */}
  <AcIntro
    eyebrow="Other services"
    heading="Not the right service?"
    headingId="related-title"
    lead="Aseptaclean handles five other property conditions. If you are not sure which one fits, tell us what is happening and we will help you decide."
  >
    <ul class="svc-related-list">
      {related.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a>
        </li>
      ))}
    </ul>
  </AcIntro>

  {/* RELOCATED CONTACT SECTION — replaces the old AcFinalCta closing band (2026-09-17, see the
      top-of-file note). `page.finalHeading`/`finalBody` are the same approved closing copy,
      reused here as the section's one visible introduction — Part C: "Reuse approved final copy
      as the contact introduction where appropriate. Do not repeat both in an outer wrapper." The
      form suppresses its own default heading via `headingId` so there is exactly one heading. */}
  <section class="svc-contact" id="service-contact" aria-labelledby="service-contact-heading">
    <div class="ac-shell">
      <div class="svc-contact__shell">
        <div class="svc-contact__intro">
          <h2 id="service-contact-heading" class="ac-type-h2">{page.finalHeading}</h2>
          {page.finalBody.map((paragraph) => <p class="svc-contact__lead">{paragraph}</p>)}
        </div>
        {/* `formId="service-form"` is preserved literally — scripts/launch-e2e-form-check.mjs
            hardcodes `#service-form` plus its `-name`/`-phone`/… child ids for this exact route.
            The wrapping section (not the form) carries the anchor the hero's secondary action and
            any other on-page CTA target, so scrolling there also reveals this heading. */}
        <AcCompactForm
          formId="service-form"
          headingId="service-contact-heading"
          entryRoute={`${page.slug}#service-form`}
          preselectRoute={page.slug}
          tone="light"
        />
        <p class="svc-contact__phone">
          Prefer to talk? <a href={site.business.phoneUri}>Call {site.business.phone}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-list {
    margin-top: 22px;
  }

  .svc-list--wide,
  .svc-steps {
    margin-top: 40px;
    text-align: left;
  }

  /* COMPACT RELATED-SERVICE LINKS — docs/ASEPTACLEAN-DESIGN-SPEC.md §7 `.ac-related`: a plain
     flex-wrap row of text links, no cards, no photos, no per-item panel chrome. */
  .svc-related-list {
    display: flex;
    flex-wrap: wrap;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    gap: 12px 32px;
    text-align: left;
  }

  .svc-related-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ac-color-navy-800);
    font-size: 1.0625rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .svc-two {
    display: grid;
    margin-top: 40px;
    gap: 40px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    text-align: left;
  }

  /* Named source lists inside a split's copy column: one per row, so each keeps its heading
     and every line item stays readable next to the photograph. */
  .svc-rooms {
    display: grid;
    margin-top: 26px;
    gap: 24px;
  }

  .svc-rooms__group h3 {
    margin: 0 0 12px;
  }

  /* docs/ASEPTACLEAN-DESIGN-SPEC.md §4.4 `deep-rooms` — three equal columns desktop, one below
     1024px, each a complete standalone checklist with its own top-aligned heading. No fixed
     height: `AcCheckList` sizes to its own content, so a longer column simply runs taller. */
  .svc-room-grid {
    display: grid;
    margin-top: 32px;
    gap: 40px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    text-align: left;
  }

  .svc-room-grid__col h3 {
    margin: 0 0 14px;
  }

  @media (max-width: 64rem) {
    .svc-room-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  .svc-two h3 {
    margin-bottom: 18px;
  }

  .svc-closing {
    margin: 14px 0 0;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.65;
  }

  .svc-limit {
    margin: 22px 0 0;
    border-left: 2px solid var(--ac-color-line-strong);
    padding-left: 18px;
    color: var(--ac-color-ink-500);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .svc-close {
    margin: 36px auto 0;
    max-width: 46rem;
    color: var(--ac-color-navy-900);
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .svc-faq {
    margin: 34px auto 0;
    text-align: left;
  }

  /* RELOCATED CONTACT SECTION — same recipe as the rodent page's `.rodent-form` (one centered
     ~680px column, no empty side column), added 2026-09-17. */
  .svc-contact {
    background: var(--ac-color-paper);
    padding-block: 64px;
  }

  .svc-contact__shell {
    display: grid;
    max-width: 680px;
    margin-inline: auto;
    gap: 28px;
    text-align: left;
  }

  .svc-contact__intro h2 {
    text-wrap: balance;
  }

  .svc-contact__lead {
    margin: 12px 0 0;
    color: var(--ac-color-ink-600);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .svc-contact__phone {
    margin: 0;
    border-top: 1px solid var(--ac-color-line-strong);
    padding-top: 24px;
    color: var(--ac-color-ink-600);
    font-size: 0.9375rem;
  }

  .svc-contact__phone a {
    color: var(--ac-color-navy-800);
    font-weight: 650;
  }

  @media (max-width: 26rem) {
    .svc-contact {
      padding-block: 40px;
    }
  }

  @media (max-width: 44rem) {
    .svc-two {
      gap: 32px;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

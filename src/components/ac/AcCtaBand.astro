---
// CTA BAND — Aseptaclean_Website_Design_Blueprint.md homepage sections 6 and 9.
//
// Section 6 ("First CTA section"): "A compact deep-navy band... Left: short invitation for
// someone unsure where to start; right: call and contact/assessment actions. One explanatory
// sentence at most... This is the strongest mid-page contact interruption. It should be visually
// distinct from both adjacent white sections."
//
// Section 9 ("Second CTA section"): "A short closing invitation immediately before the form...
// Warm-white or a fine divider, not another giant navy billboard... Give a direct call
// alternative and one link to the form if needed. Use a different purpose from section 6."
//
// One component, two tones, so both read as the same system at a different visual weight rather
// than two unrelated one-off bands. `tone="dark"` is section 6; `tone="light"` is section 9.
// Desktop is a row (short text left, actions right); mobile stacks text above actions, per the
// blueprint's "Mobile: text then stacked actions."
import AcActions from "./AcActions.astro";

interface Props {
  /** Stable anchor id, e.g. the homepage's `cta-mid`/`cta-close` (docs/ASEPTACLEAN-DESIGN-SPEC.md §3). */
  id?: string;
  /** `data-section` value for the spec's §12.4 DOM measurement helper. */
  dataSection?: string;
  eyebrow?: string;
  heading: string;
  headingId: string;
  body?: readonly string[];
  tone?: "dark" | "light";
  primaryLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  id,
  dataSection,
  eyebrow,
  heading,
  headingId,
  body = [],
  tone = "dark",
  primaryLabel,
  secondaryLabel,
  secondaryHref
} = Astro.props;
---

<section
  id={id}
  data-section={dataSection}
  class:list={["acx-ctaband", `is-${tone}`]}
  aria-labelledby={headingId}
>
  <div class="ac-shell">
    <div class="acx-ctaband__row">
      <div class="acx-ctaband__copy">
        {eyebrow && <p class="acx-ctaband__eyebrow">{eyebrow}</p>}
        <h2 id={headingId} class="ac-type-h3-band">{heading}</h2>
        {body.map((paragraph) => <p class="acx-ctaband__body">{paragraph}</p>)}
      </div>
      <div class="acx-ctaband__actions">
        <AcActions
          tone={tone === "dark" ? "dark" : "light"}
          {...(primaryLabel ? { primaryLabel } : {})}
          secondaryLabel={secondaryLabel}
          secondaryHref={secondaryHref}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .acx-ctaband {
    padding-block: 56px;
  }

  /* Deep navy, compact — section 6's "strongest mid-page contact interruption", visually
     distinct from the white sections on either side of it. */
  .is-dark {
    background: var(--ac-color-navy-900);
    color: #fff;
  }

  /* Warm-white with a fine top divider — section 9's "not another giant navy billboard", a
     quieter closing invitation right before the form. Shorter block padding, per the blueprint's
     32-48px range vs. section 6's 48-64px. */
  .is-light {
    border-top: 1px solid var(--ac-color-line);
    background: var(--ac-color-warm-white);
    padding-block: 40px;
  }

  .acx-ctaband__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .acx-ctaband__copy {
    max-width: 46ch;
    min-width: 0;
  }

  .acx-ctaband__eyebrow {
    margin: 0 0 8px;
    color: var(--ac-color-blue-on-navy);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .is-light .acx-ctaband__eyebrow {
    color: var(--ac-color-blue-deep);
  }

  .acx-ctaband__copy h2 {
    margin: 0;
    text-wrap: balance;
  }

  .is-dark .acx-ctaband__copy h2 {
    color: #fff;
  }

  .is-light .acx-ctaband__copy h2 {
    color: var(--ac-color-navy-900);
  }

  .acx-ctaband__body {
    margin: 10px 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .is-dark .acx-ctaband__body {
    color: rgb(255 255 255 / 82%);
  }

  .is-light .acx-ctaband__body {
    color: var(--ac-color-ink-600);
  }

  .acx-ctaband__actions {
    flex: 0 0 auto;
  }

  @media (max-width: 40rem) {
    .acx-ctaband__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .acx-ctaband__copy {
      max-width: none;
    }
  }
</style>

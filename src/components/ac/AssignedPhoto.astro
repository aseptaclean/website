---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { srcsetWidths } from "../imageWidths";

interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: "hero" | "editorial" | "card" | "fill";
  class?: string;
  position?: string;
}

const {
  src,
  alt,
  kind = "editorial",
  class: className,
  position = "center",
} = Astro.props;
const isHero = kind === "hero";
const widths = srcsetWidths(
  src,
  kind === "card" ? [180, 240, 360, 480, 640] : [480, 768, 1024, 1280, 1536]
);
const sizes = isHero
  ? "100vw"
  : kind === "card"
    ? "(max-width: 390px) 86px, (max-width: 760px) 112px, (max-width: 950px) 105px, 132px"
    : "(min-width: 1120px) 600px, (min-width: 621px) 55vw, calc(100vw - 40px)";
---

<Image
  src={src}
  alt={alt}
  class:list={["assigned-photo", `assigned-photo--${kind}`, className]}
  width={src.width}
  height={src.height}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={82}
  loading={isHero ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={isHero ? "high" : undefined}
  style={`object-position:${position}`}
/>

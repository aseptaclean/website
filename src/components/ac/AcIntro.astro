---
// Centred introduction block — reference page 24: an H2 on two lines, a bold lead paragraph,
// then a lighter secondary paragraph, contained to ~900-1000px. Used once per page, near the
// top, to carry the page's dominant idea before any routing or detail.
import AcEyebrow from "./AcEyebrow.astro";

interface Props {
  /** Stable anchor id on the rendered `<section>`, e.g. the homepage's `services` section
   * (Aseptaclean_Website_Design_Blueprint.md §4/§2: the "Services" nav link and the retired hub's
   * redirect both target `/#services`). Omit for sections with no anchor target. */
  id?: string;
  /** `data-section` value for docs/ASEPTACLEAN-DESIGN-SPEC.md §12.4's DOM measurement helper. */
  dataSection?: string;
  eyebrow?: string;
  heading: string;
  headingId?: string;
  lead?: string;
  body?: readonly string[];
  align?: "start" | "center";
  tone?: "light" | "soft";
  /**
   * Puts the heading AND the slotted content inside the SAME centered ~820px container, both
   * left-aligned — Aseptaclean_Website_Design_Blueprint.md's recurring FAQ finding: "Heading is
   * centered across a broad area while the accordion occupies the left portion, leaving a
   * disconnected right void. Put heading and accordion inside the same centered 760–840px
   * container; align both left." Normal `align="center"`/`"start"` only constrain the heading
   * block; the slot itself stays full-width (`max-width: none`) so card grids and process rows
   * elsewhere are unaffected. `narrow` is opt-in per call site — every existing caller that omits
   * it renders exactly as before.
   */
  narrow?: boolean;
}

const {
  id,
  dataSection,
  eyebrow,
  heading,
  headingId,
  lead,
  body = [],
  align = "center",
  tone = "light",
  narrow = false
} = Astro.props;
---

<section
  id={id}
  data-section={dataSection}
  class:list={["acx-intro", `is-${align}`, `is-${tone}`, { "is-narrow": narrow }]}
  aria-labelledby={headingId}
>
  <div class="ac-shell">
    <div class="acx-intro__inner">
      <div class="acx-intro__head">
        {eyebrow && <AcEyebrow text={eyebrow} align={align} />}
        <h2 id={headingId} class="ac-type-h2">{heading}</h2>
        {lead && <p class="acx-intro__lead">{lead}</p>}
        {body.map((paragraph) => <p class="acx-intro__body">{paragraph}</p>)}
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .acx-intro {
    background: var(--ac-color-paper);
  }

  .is-soft {
    background: var(--ac-color-warm-white);
  }

  /* The reading measure is applied to the TEXT, not to this wrapper. Slotted content — a card
     grid, a process row, a two-column list — needs the full 1200px shell, and capping the
     wrapper silently shrank every one of them to 992px. */
  .acx-intro__inner {
    max-width: none;
  }

  .acx-intro__head {
    max-width: 62rem;
  }

  .is-center .acx-intro__head {
    margin-inline: auto;
    text-align: center;
  }

  .is-center :global(.acx-eyebrow-rule) {
    align-items: center;
  }

  .acx-intro h2 {
    text-wrap: balance;
  }

  /* The reference's bold lead / lighter follow-on pair. Weight and colour carry the difference,
     not size — a second size here would compete with the H2 directly above it. */
  .acx-intro__lead {
    margin: 22px auto 0;
    max-width: 54rem;
    color: var(--ac-color-ink-900);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.65;
  }

  .acx-intro__body {
    margin: 16px auto 0;
    max-width: 54rem;
    color: var(--ac-color-ink-600);
    font-size: 1rem;
    line-height: 1.7;
  }

  .is-start .acx-intro__lead,
  .is-start .acx-intro__body {
    margin-inline: 0;
  }

  /* One shared centered column for the heading and the slotted content — see the prop comment.
     Overrides `.acx-intro__inner`'s usual `max-width: none` only when opted in. */
  .is-narrow .acx-intro__inner {
    max-width: 820px;
    margin-inline: auto;
  }

  .is-narrow .acx-intro__head {
    max-width: none;
    margin-inline: 0;
    text-align: left;
  }

  .is-narrow :global(.acx-eyebrow-rule) {
    align-items: flex-start;
  }

  .is-narrow .acx-intro__lead,
  .is-narrow .acx-intro__body {
    margin-inline: 0;
  }
</style>

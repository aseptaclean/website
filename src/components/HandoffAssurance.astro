---
import { homepage } from "@data/site";
---

<section class="assurance" aria-labelledby="assurance-title">
  <div class="container">
    <header class="assurance__header">
      <p>06 / The Handoff Assurance</p>
      <h2 id="assurance-title">The decisions stay yours</h2>
      <p>
        The emotional risk is not only the cost. It is the fear that something
        important will disappear, the scope will change without warning, or the
        property will still feel unfinished when the crew leaves. The
        Aseptaclean Handoff Assurance addresses those risks directly.
      </p>
    </header>

    <ol class="assurance__ledger">
      {
        homepage.assurance.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ol>

    <p class="assurance__note">
      Scope-completion correction applies to items specifically included in the
      signed scope. It does not guarantee results outside that scope.
    </p>
  </div>
</section>

<style>
  .assurance {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-navy-800);
    color: var(--color-warm-white);
  }

  .assurance__header {
    display: grid;
    gap: var(--space-4);
  }

  .assurance__header > p:first-child {
    margin: 0;
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 22ch;
    margin: 0;
    color: var(--color-paper);
    letter-spacing: -0.03em;
  }

  .assurance__header > p:last-child {
    max-width: 40rem;
    margin: 0;
    color: var(--color-steel-300);
  }

  .assurance__ledger {
    margin: var(--space-8) 0 0;
    border-top: 1px solid rgb(168 184 200 / 0.6);
    padding: 0;
    list-style: none;
  }

  .assurance__ledger li {
    display: grid;
    max-width: none;
    gap: var(--space-3);
    border-bottom: 1px solid rgb(168 184 200 / 0.35);
    padding-block: var(--space-5);
  }

  .assurance__ledger span {
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .assurance__ledger h3,
  .assurance__ledger p {
    margin: 0;
  }

  .assurance__ledger h3 {
    color: var(--color-paper);
    font-size: var(--step-1);
  }

  .assurance__ledger p {
    color: var(--color-steel-300);
  }

  .assurance__note {
    max-width: 48rem;
    margin: var(--space-6) 0 0 auto;
    border-left: 2px solid var(--color-blue-500);
    padding-left: var(--space-4);
    color: var(--color-paper);
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 600;
  }

  @media (min-width: 55rem) {
    .assurance__header {
      grid-template-columns: minmax(10rem, 2fr) minmax(22rem, 4fr) minmax(18rem, 3fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .assurance__ledger li {
      grid-template-columns: 3rem minmax(14rem, 3fr) minmax(24rem, 5fr);
      align-items: baseline;
      gap: clamp(1rem, 4vw, 4rem);
    }
  }
</style>

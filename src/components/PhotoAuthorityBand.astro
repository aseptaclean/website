---
// PhotoAuthorityBand — full-width photographic authority section: absolute full-cover image,
// solid translucent navy overlay, contained content. No gradients.
//
// The existing .ac-photoband (global.css) covers similar ground but uses a diagonal gradient
// sweep with no real <img> and pairs it with a floating white card — a different visual pattern
// (see this session's component audit). This is a new, separate component rather than an edit
// to .ac-photoband, since several already-shipped service pages depend on that exact treatment.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  align?: "left" | "center";
  headingId?: string;
}

const { image, imageAlt, align = "left", headingId } = Astro.props;
---

<section class="ac-photo-authority" aria-labelledby={headingId}>
  <div class="ac-photo-authority__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="ac-photo-authority__overlay" aria-hidden="true"></div>

  <div class:list={["ac-photo-authority__content", align === "center" && "ac-photo-authority__content--center"]}>
    <slot />
  </div>
</section>

<style>
  .ac-photo-authority {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 420px;
    overflow: hidden;
  }

  @media (min-width: 850px) {
    .ac-photo-authority {
      min-height: 480px;
    }
  }

  .ac-photo-authority__media {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .ac-photo-authority__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ac-photo-authority__overlay {
    position: absolute;
    inset: 0;
    background: rgb(18 40 64 / 80%);
  }

  .ac-photo-authority__content {
    position: relative;
    z-index: 1;
    width: min(100% - 64px, var(--ac-measure-wide));
    max-width: 820px;
    margin-inline: auto;
    padding-block: 64px;
    color: var(--ac-color-paper);
  }

  .ac-photo-authority__content--center {
    text-align: center;
    margin-inline: auto;
  }

  .ac-photo-authority__content :global(h2) {
    color: var(--ac-color-paper);
  }

  .ac-photo-authority__content :global(p) {
    color: var(--ac-color-steel-on-navy);
  }

  @media (max-width: 760px) {
    .ac-photo-authority__content {
      padding-block: 48px;
    }
  }
</style>

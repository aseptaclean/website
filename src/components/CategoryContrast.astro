---
import { homepage } from "@data/site";
---

<section class="contrast" aria-labelledby="contrast-title">
  <div class="container">
    <header class="contrast__header">
      <p>03 / The coordination gap</p>
      <h2 id="contrast-title">Removing the contents is not the same as finishing the property</h2>
    </header>

    <div class="contrast__sequence">
      {
        homepage.contrast.map((item, index) => (
          <article class:list={{ "contrast__step": true, "contrast__step--resolved": index === 2 }}>
            <p class="contrast__number">{String(index + 1).padStart(2, "0")}</p>
            <h3><span>{item.party}</span> {item.action}</h3>
            <p class="contrast__remainder">{item.remainder}</p>
            <p class="contrast__status">
              {index === 0 ? "Contents addressed" : index === 1 ? "Surfaces addressed" : "Handoff addressed"}
            </p>
          </article>
        ))
      }
    </div>

    <p class="contrast__close">
      That is the difference between an emptied property and a property that is
      ready for its next handoff.
    </p>
  </div>
</section>

<style>
  .contrast {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-navy-900);
    color: var(--color-warm-white);
  }

  .contrast__header {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .contrast__header p {
    margin: 0;
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 19ch;
    margin: 0;
    color: var(--color-paper);
    letter-spacing: -0.025em;
  }

  .contrast__sequence {
    border-top: 1px solid rgb(168 184 200 / 0.45);
  }

  .contrast__step {
    position: relative;
    display: grid;
    max-width: none;
    gap: var(--space-3);
    border-bottom: 1px solid rgb(168 184 200 / 0.35);
    padding-block: var(--space-6);
  }

  .contrast__number,
  .contrast__status,
  .contrast__remainder,
  h3 {
    margin: 0;
  }

  .contrast__number,
  .contrast__status {
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    color: var(--color-paper);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.28;
  }

  h3 span {
    font-weight: 700;
  }

  .contrast__remainder {
    color: var(--color-steel-300);
    line-height: 1.6;
  }

  .contrast__status {
    width: fit-content;
    border-top: 1px solid currentColor;
    padding-top: var(--space-2);
  }

  .contrast__step--resolved {
    margin-inline: calc(var(--gutter) * -1);
    border-bottom-color: var(--color-blue-500);
    padding-inline: var(--gutter);
    background: var(--color-navy-800);
  }

  .contrast__step--resolved h3,
  .contrast__step--resolved .contrast__status {
    color: var(--color-paper);
  }

  .contrast__close {
    max-width: 34rem;
    margin: var(--space-6) 0 0 auto;
    color: var(--color-paper);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.45;
  }

  @media (min-width: 52rem) {
    .contrast__header {
      grid-template-columns: minmax(10rem, 3fr) minmax(24rem, 7fr);
      gap: var(--space-7);
      align-items: end;
    }

    .contrast__step {
      grid-template-columns: 3rem minmax(15rem, 4fr) minmax(18rem, 5fr) minmax(9rem, 2fr);
      align-items: start;
      gap: clamp(1rem, 3vw, 3rem);
    }

    .contrast__step--resolved {
      margin-inline: 0;
      padding-inline: var(--space-5);
    }

    .contrast__status {
      justify-self: end;
      text-align: right;
    }
  }
</style>

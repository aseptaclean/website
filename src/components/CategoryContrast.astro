---
import { homepage } from "@data/site";

const [gapItems, resolvedItem] = [homepage.contrast.slice(0, 2), homepage.contrast[2]];
---

<section class="contrast" aria-labelledby="contrast-title">
  <div class="ac-measure-wide">
    <header class="contrast__header">
      <p class="ac-eyebrow">Category contrast</p>
      <h2 id="contrast-title" class="ac-type-h2">Removing the contents is not the same as finishing the property</h2>
    </header>

    <div class="contrast__comparison">
      <div class="contrast__gap">
        {
          gapItems.map((item) => (
            <p class="contrast__line ac-type-body">
              <strong>{item.party}</strong> {item.action} {item.remainder}
            </p>
          ))
        }
      </div>
      <div class="contrast__resolved">
        <p class="contrast__line ac-type-body">
          <strong>{resolvedItem.party}</strong> {resolvedItem.action} {resolvedItem.remainder}
        </p>
        <p class="contrast__close ac-type-lead">
          That is the difference between an emptied property and a property that is
          ready for its next handoff.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contrast {
    background: var(--ac-color-navy-900);
    color: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-standard);
    padding-bottom: 0;
  }

  /* This section's own .ac-eyebrow sits on the navy-900 background, not the
     light surface the shared class assumes. */
  .contrast :global(.ac-eyebrow) {
    color: var(--ac-color-steel-on-navy);
  }

  .contrast__header {
    display: grid;
    gap: var(--ac-space-4);
    max-width: 48rem;
    padding-bottom: var(--ac-space-6);
  }

  h2 {
    max-width: 19ch;
    color: var(--ac-color-paper);
  }

  .contrast__comparison {
    display: grid;
    gap: var(--ac-space-6);
    border-top: 1px solid rgb(168 184 200 / 0.45);
    padding-top: var(--ac-space-6);
  }

  .contrast__gap {
    display: grid;
    gap: var(--ac-space-4);
  }

  .contrast__line {
    margin: 0;
    color: var(--ac-color-steel-on-navy);
  }

  .contrast__gap .contrast__line strong {
    color: var(--ac-color-warm-white);
  }

  .contrast__resolved {
    border-top: 1px solid var(--ac-color-blue-500);
    padding-top: var(--ac-space-5);
  }

  .contrast__resolved .contrast__line {
    color: var(--ac-color-warm-white);
  }

  .contrast__resolved .contrast__line strong {
    color: var(--ac-color-paper);
  }

  .contrast__close {
    margin: var(--ac-space-4) 0 0;
    color: var(--ac-color-paper);
    font-weight: 700;
  }

  @media (min-width: 52rem) {
    .contrast__comparison {
      grid-template-columns: 5fr 6fr;
    }

    .contrast__resolved {
      border-top: 0;
      border-left: 1px solid var(--ac-color-blue-500);
      padding-top: 0;
      padding-left: var(--ac-space-6);
    }
  }
</style>

---
// PPC INTAKE FORM — brief "HERO FORM". A scoped variant of the shared hero form family
// (src/components/ac/AcCompactForm.astro), not a new integration.
//
// WHAT IS REUSED, UNCHANGED — this is the point of the component, so it is spelled out:
//   endpoint          site.urls.formEndpoint  → functions/api/lead.ts (the ONE lead endpoint,
//                     AGENTS.md §0.1). No new endpoint, no imitation, no fabricated success.
//   field names       full_name, phone, property_zip, email, property_detail,
//                     property_situation, property_media[], privacy_consent,
//                     submission_timestamp, idempotency_key, form_version, offer_type,
//                     entry_route, submitted_from — every one already validated by
//                     functions/_lib/lead.ts. No field name is introduced here.
//   required set      form_version present + offer_type !== private_residence_reset means the
//                     server requires full_name, phone, email, privacy_consent,
//                     submission_timestamp, idempotency_key, property_zip, property_situation,
//                     property_detail — email joined this set 2026-09-06 (owner requirement:
//                     customer confirmation must be possible from every active form; it is now
//                     part of functions/_lib/lead.ts's commonRequiredFields). The client mirrors
//                     exactly that set.
//   service value     "Hoarding or heavy clutter" — the FROZEN CRM enum from
//                     src/data/assessment.ts, the same string HubSpot and the owner-notification
//                     email already expect. Brief: "Fixed Hoarding service value; no redundant
//                     service selector", so it ships as a hidden input and the visible <select>
//                     is dropped. The value is read from the data file, never retyped.
//   upload            property_media[] with the real accepted types and the real published
//                     limits from src/data/assessment.ts. Nothing about the limits is invented.
//   consent           legal.consentBase + legal.consentAssessmentAppendix, verbatim, from
//                     src/data/site.ts. The appendix is the approved wording for a form that
//                     collects property media (owner ruling 2026-08-19), which this one does.
//                     The brief's bracketed placeholder is not publishable copy and is not used.
//   anti-spam         the existing honeypot (company_website) + Cloudflare Turnstile.
//
// WHAT IS SCOPED TO THIS ROUTE:
//   - A campaign-specific thank-you destination,
//     /hoarding-cleanup-san-jose/assessment/thank-you/, rather than the sitewide /thank-you/.
//     Same query contract; different shell, because /thank-you/ renders the full site navigation
//     that this campaign's PPC exception removes. The redirect fires ONLY on a confirmed
//     `ok === true` — never on click, never on a network error, never optimistically — and
//     because it is a GET, refreshing the destination cannot repost the form.
//   - Two-column field rows plus the compact geometry, for the profile §7 fold budget.
//
// PARTIAL FAILURE IS REPORTED HONESTLY. functions/api/lead.ts returns 503 with `ok:false` and a
// specific message when the details stored but the files did not. That message is surfaced
// verbatim and the entered values are preserved — this form never claims photos were received.
import { assessment } from "@data/assessment";
import { legal, site } from "@data/site";

interface Props {
  formId: string;
  /** Route recorded on the lead so a submission traces back to this campaign page. */
  entryRoute: string;
  /** Frozen CRM enum value for this campaign's service. */
  situationValue: string;
  title: string;
  intro: string;
  /**
   * Visible label on the submit control. Defaults to the sitewide `site.offer.formSubmitCta`
   * ("Send Message") so this component keeps behaving as it did; the hoarding campaign overrides
   * it per AC-PPC-HERO-ROOMS-1.0. It labels a real <button type="submit"> and must never become
   * a telephone link or promise a booking — see the role table in src/data/site.ts.
   */
  submitLabel?: string;
  descriptionHelper: string;
  photoHelper: string;
  microcopy: string;
  /** Where a CONFIRMED submission lands. Reached by GET, so a refresh cannot resubmit. */
  thankYouRoute: string;
}

const {
  formId,
  entryRoute,
  situationValue,
  title,
  intro,
  submitLabel = site.offer.formSubmitCta,
  descriptionHelper,
  photoHelper,
  microcopy,
  thankYouRoute
} = Astro.props;

// Fail the build rather than post a value the CRM enum does not contain. A silent typo here
// would be a 422 on every real lead.
if (!assessment.situations.some((situation) => situation.value === situationValue)) {
  throw new Error(
    `PpcHeroForm: "${situationValue}" is not a value in src/data/assessment.ts situations.`
  );
}

const endpointAvailable = Boolean(
  site.integrations.formEnabled &&
    site.urls.formEndpoint &&
    site.integrations.turnstileSiteKey
);

const uploadHelp = `${photoHelper} ${assessment.upload.visibleLimits}`;
---

<div class="ppc-form-shell">
  <form
    id={formId}
    class="ppc-form"
    method="post"
    enctype="multipart/form-data"
    action={endpointAvailable ? site.urls.formEndpoint : undefined}
    aria-labelledby={`${formId}-title`}
    data-ppc-form
    data-contact-phone={site.business.phone}
    data-thank-you={thankYouRoute}
  >
    <input type="hidden" name="form_version" value={assessment.version} />
    <input type="hidden" name="offer_type" value="handoff_reset" />
    {/* The brief's "Fixed Hoarding service value; no redundant service selector". */}
    <input type="hidden" name="property_situation" value={situationValue} />
    <input type="hidden" name="entry_route" value={entryRoute} />
    <input type="hidden" name="submitted_from" value={entryRoute} />
    {/* Campaign attribution, populated client-side from the query string only, capped at 250
        chars each, and never containing a name, phone, description, filename or photo. */}
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_term" value="" />
    <input type="hidden" name="utm_content" value="" />
    <input type="hidden" name="gclid" value="" />
    <input type="hidden" name="landing_page" value="" />
    <input type="hidden" name="referrer" value="" />
    <input type="hidden" name="submission_timestamp" value="" />
    <input type="hidden" name="idempotency_key" value="" />
    <input
      class="ppc-form__honeypot"
      type="text"
      name="company_website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    {/* Brief's `.ac-ppc .ac-form__header { display: grid; gap: 4px }` — the title and its
        supporting line are one block, so the panel's own row gap does not sit between them. */}
    <div class="ppc-form__header">
      <h2 id={`${formId}-title`} class="ac-type-ppc-form-title ppc-form__title">{title}</h2>
      <p class="ppc-form__intro">{intro}</p>
    </div>

    <div class="ppc-form__errors" tabindex="-1" role="alert" hidden data-ppc-form-errors>
      <ul></ul>
    </div>

    <div class="ppc-form__grid">
      <div class="ppc-form__field">
        <label for={`${formId}-name`}>Full Name</label>
        <input id={`${formId}-name`} name="full_name" type="text" autocomplete="name" required />
      </div>

      <div class="ppc-form__field">
        <label for={`${formId}-phone`}>Phone Number</label>
        <input
          id={`${formId}-phone`}
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          required
        />
      </div>

      <div class="ppc-form__field">
        <label for={`${formId}-zip`}>Property ZIP Code</label>
        <input
          id={`${formId}-zip`}
          name="property_zip"
          type="text"
          inputmode="numeric"
          autocomplete="postal-code"
          pattern="[0-9]{5}(?:-[0-9]{4})?"
          required
        />
      </div>

      <div class="ppc-form__field">
        <label for={`${formId}-email`}>Email</label>
        <input
          id={`${formId}-email`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          required
        />
      </div>

      <div class="ppc-form__field ppc-form__field--full">
        <label for={`${formId}-detail`}>Tell us what&rsquo;s going on</label>
        {/* rows="2" so the profile's compact 64px textarea minimum is the value that actually
            renders. `rows` sets a used height that a smaller min-height cannot reduce, which is
            why the shared form's rows="3" measures 87px in compact mode. Still resizable. */}
        <textarea id={`${formId}-detail`} name="property_detail" rows="2" required></textarea>
        <p class="ppc-form__helper" id={`${formId}-detail-help`}>{descriptionHelper}</p>
      </div>

      <div class="ppc-form__field ppc-form__field--full ppc-form__upload">
        <label for={`${formId}-media`}>
          Photos <span class="ppc-form__optional">(optional)</span>
        </label>
        {/* The compact accessible control the application already supports, not a dropzone —
            the brief prefers it explicitly. Limits and accepted types come from
            src/data/assessment.ts, which is the same configuration functions/_lib/lead.ts
            enforces server-side. */}
        <input
          id={`${formId}-media`}
          name="property_media[]"
          type="file"
          accept={assessment.upload.acceptedTypes}
          aria-describedby={`${formId}-media-help`}
          multiple
          data-ppc-upload
          data-max-files={assessment.upload.maxFiles}
          data-max-image-bytes={assessment.upload.maxImageBytes}
          data-max-video-bytes={assessment.upload.maxVideoBytes}
          data-max-total-bytes={assessment.upload.maxTotalBytes}
          data-allowed-extensions={assessment.upload.allowedExtensions.join(",")}
          data-image-extensions={assessment.upload.imageExtensions.join(",")}
        />
        <p class="ppc-form__helper" id={`${formId}-media-help`}>{uploadHelp}</p>
        <ul class="ppc-form__files" data-ppc-upload-list aria-label="Selected photos" hidden></ul>
        <p class="ppc-form__file-error form-error" data-ppc-upload-error role="alert" hidden></p>
        <p class="visually-hidden" data-ppc-upload-status role="status" aria-live="polite"></p>
      </div>
    </div>

    {/* Verbatim from src/data/site.ts. 10DLC-relevant consent language — never reworded, never
        retyped at a call site, never shrunk below 14px to win fold space. The appendix applies
        because this form collects property media. */}
    <label class="ppc-form__consent">
      <input type="checkbox" name="privacy_consent" value="yes" required />
      <span>
        {legal.consentBase.lead}{" "}
        <a class="ppc-form__link" href={site.urls.privacyPolicy}>
          {legal.consentBase.privacyLabel}
        </a>{legal.consentBase.tail}{" "}
        {legal.consentAssessmentAppendix.lead}{" "}
        <a class="ppc-form__link" href={site.urls.terms}>
          {legal.consentAssessmentAppendix.termsLabel}
        </a>{legal.consentAssessmentAppendix.tail}
      </span>
    </label>

    {/* The anti-spam control and its two fallback notices share ONE panel row. A bare <noscript>
        sitting directly in the form grid generates its own zero-height track plus an 8px gap —
        space no specification asks for, and profile §7 repair step 1's "remove unintended
        margins, spacers". Neither notice is dropped; they simply stop costing a row each. */}
    <div class="ppc-form__verify">
      {
        site.integrations.turnstileSiteKey && (
          <div class="ppc-form__turnstile">
            <div
              class="cf-turnstile"
              data-sitekey={site.integrations.turnstileSiteKey}
              data-theme="dark"
              data-size="flexible"
            />
          </div>
        )
      }
      <noscript>
        <p class="ppc-form__note">
          Security verification requires JavaScript. Please call Aseptaclean if you cannot enable
          it.
        </p>
      </noscript>

      {
        !endpointAvailable && (
          <p class="ppc-form__note" role="status">
            Online submission is not fully configured in this preview. Your answers will not be
            sent.
          </p>
        )
      }
    </div>

    <button
      class="button ppc-form__submit"
      type="submit"
      disabled={!endpointAvailable}
      data-ppc-form-submit
    >
      <span data-ppc-form-submit-label>{submitLabel}</span>
    </button>
    <p class="ppc-form__microcopy">{microcopy}</p>
    <p class="ppc-form__status" data-ppc-form-status role="status" aria-live="polite" hidden></p>
  </form>
</div>

{
  site.integrations.turnstileSiteKey && (
    <script
      is:inline
      data-categories="essential"
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  // Submit/validation/upload contract: the same shape AssessmentForm.astro and AcCompactForm
  // already ship. Duplicated rather than imported because Astro component scripts are
  // page-scoped and this variant has its own field set and its own inline success state.
  type FormControl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const form = document.querySelector<HTMLFormElement>("[data-ppc-form]");

  if (form) {
    const errorBox = form.querySelector<HTMLElement>("[data-ppc-form-errors]");
    const errorList = errorBox?.querySelector("ul");
    const statusEl = form.querySelector<HTMLElement>("[data-ppc-form-status]");
    const submitButton = form.querySelector<HTMLButtonElement>("[data-ppc-form-submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-ppc-form-submit-label]");
    const defaultLabel = submitLabel?.textContent ?? "Send Message";
    const thankYouRoute = form.dataset.thankYou || "/thank-you/";
    const uploadInput = form.querySelector<HTMLInputElement>("[data-ppc-upload]");
    const uploadList = form.querySelector<HTMLUListElement>("[data-ppc-upload-list]");
    const uploadError = form.querySelector<HTMLElement>("[data-ppc-upload-error]");
    const uploadStatus = form.querySelector<HTMLElement>("[data-ppc-upload-status]");
    const timestampInput = form.elements.namedItem("submission_timestamp");
    const idempotencyInput = form.elements.namedItem("idempotency_key");

    form.noValidate = true;

    if (idempotencyInput instanceof HTMLInputElement) {
      idempotencyInput.value =
        window.crypto?.randomUUID?.() ??
        `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    }

    // ---- Campaign attribution -------------------------------------------------------------
    // WHITELIST, not passthrough. Only these six parameters are read, each truncated, and none
    // of them is ever written into the DOM. No submitted answer reaches an analytics event.
    const sanitizeReferrer = (referrer: string) => {
      if (!referrer) return "";
      try {
        const url = new URL(referrer);
        return `${url.origin}${url.pathname}`;
      } catch {
        return "";
      }
    };

    const parameters = new URLSearchParams(window.location.search);
    for (const name of ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid"]) {
      const value = parameters.get(name);
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      if (value && input) input.value = value.slice(0, 250);
    }
    const landingPageInput = form.querySelector<HTMLInputElement>('input[name="landing_page"]');
    if (landingPageInput) landingPageInput.value = window.location.pathname;
    const referrerInput = form.querySelector<HTMLInputElement>('input[name="referrer"]');
    if (referrerInput) referrerInput.value = sanitizeReferrer(document.referrer);

    // ---- Uploads --------------------------------------------------------------------------
    const formatBytes = (bytes: number) => {
      if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };

    const renderUpload = () => {
      if (!uploadInput || !uploadList || !uploadError || !uploadStatus) return [];

      const files = Array.from(uploadInput.files ?? []);
      const maxFiles = Number(uploadInput.dataset.maxFiles);
      const maxImageBytes = Number(uploadInput.dataset.maxImageBytes);
      const maxVideoBytes = Number(uploadInput.dataset.maxVideoBytes);
      const maxTotalBytes = Number(uploadInput.dataset.maxTotalBytes);
      const allowed = new Set(uploadInput.dataset.allowedExtensions?.split(",") ?? []);
      const images = new Set(uploadInput.dataset.imageExtensions?.split(",") ?? []);
      const perFile = new Map<number, string[]>();
      const overall: string[] = [];
      const totalBytes = files.reduce((sum, file) => sum + file.size, 0);

      if (files.length > maxFiles) overall.push(`Select no more than ${maxFiles} files.`);
      if (totalBytes > maxTotalBytes) {
        overall.push(
          `The combined selection is ${formatBytes(totalBytes)}; the limit is ${formatBytes(maxTotalBytes)}.`
        );
      }

      files.forEach((file, index) => {
        const extension = file.name.split(".").pop()?.toLowerCase() ?? "";
        const problems: string[] = [];
        if (!allowed.has(extension)) problems.push("Unsupported file type");
        else if (file.size > (images.has(extension) ? maxImageBytes : maxVideoBytes)) {
          problems.push(
            `Exceeds the ${formatBytes(images.has(extension) ? maxImageBytes : maxVideoBytes)} limit`
          );
        }
        if (problems.length) perFile.set(index, problems);
      });

      uploadList.replaceChildren();
      files.forEach((file, index) => {
        const item = document.createElement("li");
        const details = document.createElement("span");
        const name = document.createElement("strong");
        const meta = document.createElement("small");
        const remove = document.createElement("button");
        const problems = perFile.get(index) ?? [];

        item.dataset.state = problems.length ? "error" : "selected";
        // textContent, never innerHTML: a filename is untrusted input. Long names wrap rather
        // than being truncated, so nothing about the selection is hidden from the visitor.
        name.textContent = file.name;
        meta.textContent = `${formatBytes(file.size)}${problems.length ? ` · ${problems.join(" · ")}` : ""}`;
        details.append(name, meta);

        remove.type = "button";
        remove.className = "ppc-form__file-remove";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.addEventListener("click", () => {
          try {
            const transfer = new DataTransfer();
            files.forEach((candidate, candidateIndex) => {
              if (candidateIndex !== index) transfer.items.add(candidate);
            });
            uploadInput.files = transfer.files;
            renderUpload();
            // Announce BOTH facts: which file went, and what is left. renderUpload() has already
            // written the count, so appending the removal keeps the live region complete.
            uploadStatus.textContent = `${file.name} removed. ${uploadStatus.textContent}`;
          } catch {
            uploadInput.value = "";
            renderUpload();
            uploadStatus.textContent =
              "The file selection was cleared because this browser does not support removing one file.";
          }
        });

        item.append(details, remove);
        uploadList.append(item);
      });

      const all = [...overall, ...Array.from(perFile.values()).flat()];
      uploadInput.setCustomValidity(all[0] ?? "");
      uploadInput.setAttribute("aria-invalid", all.length ? "true" : "false");
      uploadList.hidden = files.length === 0;
      uploadError.hidden = all.length === 0;
      uploadError.textContent = all.length
        ? `${overall.join(" ")} ${perFile.size ? "Remove the files marked with an error before continuing." : ""}`.trim()
        : "";
      uploadStatus.textContent = files.length
        ? `${files.length} file${files.length === 1 ? "" : "s"} selected.`
        : "No files selected.";

      return all;
    };

    uploadInput?.addEventListener("change", () => renderUpload());
    renderUpload();

    // ---- Validation -----------------------------------------------------------------------
    const labelFor = (control: FormControl) => {
      const label = form.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(control.id)}"]`);
      return label?.textContent?.replace("(optional)", "").replace("*", "").trim() ?? "Field";
    };

    // Approved wording, matching the messages the shared forms already use.
    const approvedFieldMessage: Record<string, string> = {
      full_name: "Add your name so we know who to ask for.",
      phone: "Add a phone number so Matthew can reach you about the property.",
      privacy_consent: "Check the consent box so we're allowed to call or text you back.",
      property_zip: "Add the property ZIP code so we can confirm the service area.",
      property_detail: "Tell us a little about what's going on.",
      email: "Add a valid email address so we can send a confirmation."
    };

    const contactPhone = form.dataset.contactPhone ?? "";
    const submissionErrorMessage = contactPhone
      ? `Something went wrong on our end and the form didn't send. Call or text ${contactPhone} and we'll take it from there.`
      : "Something went wrong on our end and the form didn't send. Call or text us and we'll take it from there.";

    const clearFieldErrors = () => {
      form.querySelectorAll<HTMLElement>("[data-generated-error]").forEach((el) => el.remove());
      form.querySelectorAll<FormControl>('[aria-invalid="true"]').forEach((control) => {
        if (control !== uploadInput) control.removeAttribute("aria-invalid");
      });
    };

    const attachError = (control: FormControl, message: string) => {
      control.setAttribute("aria-invalid", "true");
      if (control instanceof HTMLInputElement && control.type === "checkbox") {
        const wrapper = control.closest("label");
        if (!wrapper) return;
        const inline = document.createElement("p");
        inline.className = "form-error";
        inline.dataset.generatedError = "";
        inline.textContent = message;
        wrapper.after(inline);
        return;
      }
      const field = control.closest(".ppc-form__field");
      if (!field) return;
      const inline = document.createElement("p");
      inline.className = "form-error";
      inline.dataset.generatedError = "";
      inline.textContent = message;
      field.append(inline);
    };

    const showSummary = (messages: string[]) => {
      if (!errorBox || !errorList) return;
      errorList.replaceChildren();
      if (!messages.length) {
        errorBox.hidden = true;
        return;
      }
      messages.forEach((message) => {
        const item = document.createElement("li");
        item.textContent = message;
        errorList.append(item);
      });
      errorBox.hidden = false;
      errorBox.focus({ preventScroll: true });
      errorBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };

    // Client mirror of functions/_lib/lead.ts's required set for this form shape.
    const validateLocally = () => {
      clearFieldErrors();
      const messages: string[] = [];
      const controls = Array.from(
        form.querySelectorAll<FormControl>("input, select, textarea")
      ).filter((control) => !["hidden", "button", "submit"].includes(control.type));

      for (const control of controls) {
        if (control === uploadInput) continue;
        if (control.validity.valid) continue;
        const message =
          approvedFieldMessage[control.name] ??
          (control.validity.valueMissing
            ? `${labelFor(control)} is required.`
            : `Review ${labelFor(control).toLowerCase()}.`);
        attachError(control, message);
        messages.push(
          control instanceof HTMLInputElement && control.type === "checkbox"
            ? message
            : `${labelFor(control)}: ${message}`
        );
      }

      const uploadProblems = renderUpload();
      if (uploadProblems.length) messages.push(...uploadProblems);

      showSummary(messages);
      return messages.length === 0;
    };

    const resetTurnstile = () => {
      const turnstile = (
        window as Window & { turnstile?: { reset: (widget?: string | HTMLElement) => void } }
      ).turnstile;
      const widget = form.querySelector<HTMLElement>(".cf-turnstile");
      if (turnstile && widget) turnstile.reset(widget);
    };

    const setSubmitting = (submitting: boolean, message = "") => {
      if (submitButton) submitButton.disabled = submitting;
      form.setAttribute("aria-busy", String(submitting));
      if (submitLabel) submitLabel.textContent = submitting ? "Sending…" : defaultLabel;
      if (statusEl) {
        statusEl.hidden = !message;
        statusEl.textContent = message;
      }
    };

    // XHR rather than fetch: it is the only way to report real upload progress, which matters
    // when the visitor has attached 50 MB of room video over a phone connection.
    const send = () =>
      new Promise<{ status: number; payload: Record<string, unknown> }>((resolve, reject) => {
        const request = new XMLHttpRequest();
        request.open("POST", form.action);
        request.setRequestHeader("Accept", "application/json");
        request.timeout = 90_000;
        request.upload.addEventListener("progress", (event) => {
          if (!statusEl || !event.lengthComputable) return;
          const percentage = Math.round((event.loaded / event.total) * 100);
          statusEl.hidden = false;
          statusEl.textContent =
            percentage < 100
              ? `Uploading property details and photos: ${percentage}%`
              : "Upload complete. Confirming delivery…";
        });
        request.addEventListener("load", () => {
          let payload: Record<string, unknown> = {};
          try {
            payload = JSON.parse(request.responseText) as Record<string, unknown>;
          } catch {
            payload = {};
          }
          resolve({ status: request.status, payload });
        });
        request.addEventListener("error", () => reject(new Error("network")));
        request.addEventListener("timeout", () => reject(new Error("timeout")));
        request.send(new FormData(form));
      });

    // ---- Analytics ------------------------------------------------------------------------
    // Two DISTINCT events, per the brief: an attempt is not a success. `ppc_form_success` fires
    // only after a confirmed 2xx + ok:true. Neither event carries a name, phone, email, ZIP,
    // description, filename or photo — only whether files were attached, as a boolean.
    const track = (event: string, detail: Record<string, string | number | boolean> = {}) => {
      (window as Window & { dataLayer?: unknown[] }).dataLayer ??= [];
      (window as Window & { dataLayer?: unknown[] }).dataLayer!.push({
        event,
        form_id: form.id,
        ...detail
      });
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.action) return;

      if (!validateLocally()) return;

      const turnstileWidget = form.querySelector(".cf-turnstile");
      const turnstileToken = form.elements.namedItem("cf-turnstile-response");
      if (
        turnstileWidget &&
        (!(turnstileToken instanceof HTMLInputElement) || !turnstileToken.value)
      ) {
        setSubmitting(false, "Complete the security verification, then submit again.");
        return;
      }

      if (timestampInput instanceof HTMLInputElement) {
        timestampInput.value = new Date().toISOString();
      }

      const photoCount = uploadInput?.files?.length ?? 0;
      track("ppc_form_submit_attempt", { photos_attached: photoCount > 0 });
      setSubmitting(true, "Sending your request…");

      try {
        const { status, payload } = await send();

        if (status >= 200 && status < 300 && payload.ok === true) {
          // CONFIRMED — and only here. The visitor is sent to the campaign thank-you route.
          //
          // Redirecting rather than swapping in an inline panel is what makes a refresh safe:
          // the browser lands on the thank-you page via GET, so reloading re-fetches a static
          // document and cannot repost the form. Back-navigation returns to the form with the
          // fields the browser restored, not to a resubmission.
          //
          // NOTHING PERSONAL GOES IN THE URL. Only the derived display code and two state
          // flags — no name, phone, email address, ZIP or description.
          track("ppc_form_success", { photos_attached: photoCount > 0 });
          // THREE email states, not two. The endpoint reports `confirmationEmailSent` as a
          // bare boolean, which is false both when the provider rejected the message AND when
          // there was no address to send to. Collapsing those into one flag made the thank-you
          // page tell a visitor who deliberately left email blank that we "could not send" one —
          // describing a failure that never happened. Only this form knows which case it is,
          // because only this form knows whether an address was typed.
          const emailSupplied = Boolean(
            (form.elements.namedItem("email") as HTMLInputElement | null)?.value.trim()
          );
          const parameters = new URLSearchParams({
            received: "1",
            callback:
              typeof payload.callbackWindow === "string"
                ? payload.callbackWindow
                : "next-business-window",
            email: !emailSupplied
              ? "none"
              : payload.confirmationEmailSent === true
                ? "sent"
                : "attention"
          });
          const code = typeof payload.confirmationCode === "string" ? payload.confirmationCode : "";
          if (/^AC-[0-9A-HJKMNP-TV-Z]{6}$/.test(code)) parameters.set("code", code);
          window.location.assign(`${thankYouRoute}?${parameters.toString()}`);
          return;
        }

        // FAILURE — including the partial case where details stored but the files did not. The
        // server's own message is surfaced verbatim and every entered value stays in the form.
        if (payload.errors && typeof payload.errors === "object") {
          const messages: string[] = [];
          for (const [key, serverMessage] of Object.entries(
            payload.errors as Record<string, string>
          )) {
            const message = approvedFieldMessage[key] ?? serverMessage;
            const control = form.elements.namedItem(key);
            if (
              control instanceof HTMLInputElement ||
              control instanceof HTMLTextAreaElement ||
              control instanceof HTMLSelectElement
            ) {
              attachError(control, message);
              messages.push(`${labelFor(control)}: ${message}`);
            } else {
              messages.push(message);
            }
          }
          showSummary(messages);
        }
        setSubmitting(
          false,
          typeof payload.message === "string" ? payload.message : submissionErrorMessage
        );
        resetTurnstile();
      } catch {
        setSubmitting(false, submissionErrorMessage);
        resetTurnstile();
      }
    });
  }
</script>


---
// BRIGHT OPENING — docs/aseptaclean-layout-refresh.md §1, installed 2026-09-09.
//
// This replaces the dark full-bleed photographic hero on the estate campaign route only.
// PpcHero.astro is untouched and still opens /hoarding-cleanup-san-jose/assessment/.
//
// The refresh's recipe, implemented literally:
//   · warm white #F7F8FA surface, navy text, no photograph and no dark overlay
//   · centred container capped at 1200px, ~54/46 desktop split, 40px gap
//   · BOTH COLUMNS TOP-ALIGNED — `align-items: start`, not `center`. Centring is what produced
//     the empty bands the refresh is correcting.
//   · no viewport-height section, no spacer divs, no fixed heights
//
// The three-part line ("One person to call" · "Written plan and price" · "Help from start to
// finish") is a restrained inline row of three items separated by hairline rules — the refresh
// asks for exactly that "rather than adding a large badge wall". No icons, no cards, no badges,
// and nothing in it is a credential or a claim the site does not already make.
//
// The call sits above the form in DOM order so a phone visitor reaches the primary action first,
// and the form follows the copy on mobile with nothing in between.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import AcActions from "@components/ac/AcActions.astro";
import { srcsetWidths } from "@components/imageWidths";

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  headingId: string;
  lead: string;
  body: readonly string[];
  /** The restrained three-part line below the introduction. */
  points: readonly string[];
  /** Campaign call label — built from src/data/site.ts by the caller, never typed in. */
  primaryLabel: string;
  secondaryLabel: string;
  /** Same-page target for the subordinate action. */
  formHref: string;
  supportingLine: string;
  /**
   * Right column becomes a photograph instead of the `slot="form"` content when provided.
   * Added 2026-09-18 (Aseptaclean_Website_Design_Blueprint.md, estate campaign review): "text
   * left, meaningful image right... one centered form near the bottom" — the working form moves
   * out of this hero, so the column it used to fill needs a real image rather than staying empty.
   * The one remaining consumer of this component (the estate assessment landing page) now passes
   * this instead of a form slot; a future caller can still use the form slot by omitting `image`.
   */
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  id,
  eyebrow,
  heading,
  headingId,
  lead,
  body,
  points,
  primaryLabel,
  secondaryLabel,
  formHref,
  supportingLine,
  image,
  imageAlt = ""
} = Astro.props;

const heroWidths = image ? srcsetWidths(image, [480, 768, 1024]) : [];
---

<section class="est-hero ac-hero" id={id} aria-labelledby={headingId}>
  <div class="est-shell">
    <div class="est-hero__grid">
      <div class="est-hero__copy ac-hero__copy">
        <p class="est-hero__eyebrow">{eyebrow}</p>
        {/* The ONE H1 on this page. Size comes from .ac-type-h1-home; type law #1 (AGENTS.md §6)
            forbids a component declaring font-size on a heading, so nothing below touches it. */}
        <h1 id={headingId} class="ac-type-h1-home est-hero__title">{heading}</h1>
        <p class="est-hero__lead">{lead}</p>
        {body.map((paragraph) => <p class="est-hero__body">{paragraph}</p>)}

        <ul class="est-hero__points">
          {points.map((point) => <li>{point}</li>)}
        </ul>

        <div class="est-hero__actions">
          <AcActions
            primaryLabel={primaryLabel}
            secondaryLabel={secondaryLabel}
            secondaryHref={formHref}
          />
        </div>

        <p class="est-hero__note">{supportingLine}</p>
      </div>

      <div class="est-hero__form">
        {image ? (
          <Image
            class="est-hero__image"
            src={image}
            alt={imageAlt}
            width={960}
            height={1080}
            widths={heroWidths}
            sizes="(min-width: 62rem) 46vw, 92vw"
            format="webp"
            quality={76}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        ) : (
          <slot name="form" />
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* OPTS OUT OF THE GLOBAL SECTION RHYTHM. global.css gives every `main > section` 68px of block
     padding; this hero carries its own on the grid below, so without this it would render
     68 + 56 = 124px of opening space no specification asks for — the same correction global.css
     already records for `.acx-hero` and PpcLayout records for `.ppc-hero`. Measured before the
     fix: the eyebrow sat 207px down a 900px viewport. Space only; nothing is hidden or clipped. */
  /* No bottom border: the trust bar below continues this warm-white band and carries the boundary
     into the white section after it. Without a trust bar to render, PpcTrustBar emits nothing and
     the white `.est-offer` section provides the edge on its own. */
  .est-hero {
    padding-block: 0;
    background: var(--ac-color-warm-white);
  }

  /* SHARED HERO SIZING — docs/ASEPTACLEAN-DESIGN-SPEC.md §2.2: "The two reviewed campaign landing
     pages use the same hero sizing rules with their route-specific composition and offer; the
     estate split-image variant and rodent full-photo variant can differ in composition while
     retaining the same measured opening height." Same 600/560/440px baseline as the nine public
     marketing pages, escalated to 696/680 desktop/tablet (see AcHeroWithForm.astro's comment for
     the full root-cause writeup). A MIN-height, not fixed — the grid below stays in normal flow,
     so longer approved copy still grows the section.

     TABLET FIX, 2026-09-18. Before this pass, this route was the one documented exception to
     hero equality: measured 1060px at 820px tablet width against a 592px shared floor, because
     `.est-hero__grid` (below) stacked its two-column split at `max-width: 62rem` (992px) — ABOVE
     the spec's 768px tablet floor, so the ENTIRE 768-1023px tablet range rendered the STACKED
     layout (copy height + gap + image height) instead of the side-by-side composition every
     other reviewed hero uses at that width. Lowering the stacking breakpoint to 768px (see that
     rule below) keeps the two-column split through the whole tablet range; its real two-column
     content need at 820px measures 676px, which is why tablet's shared token is 680px (560 + 15
     x 8px) rather than the 592px the other ten pages alone would need — this is the new binding
     constraint, not Extreme Cleaning's hero, and 680px is still AT, not above, the spec's 680px
     tablet ceiling. */
  .est-hero {
    min-height: 440px;
  }

  @media (min-width: 48rem) {
    .est-hero {
      min-height: 680px;
    }
  }

  @media (min-width: 64rem) {
    .est-hero {
      min-height: 696px;
    }
  }

  /* Refresh: 1200px container, 32px desktop padding, 20px mobile. Declared here rather than
     reusing `.ac-shell` (1320px) because the refresh caps this route specifically. */
  .est-shell {
    margin-inline: auto;
    max-width: 1200px;
    padding-inline: 32px;
  }

  /* ~54/46 with a 40px gap. `minmax(0, …)` on both tracks so a long word or the Turnstile
     widget's 300px minimum can never push the grid past the container. */
  .est-hero__grid {
    display: grid;
    align-items: start;
    gap: 40px;
    grid-template-columns: minmax(0, 54fr) minmax(0, 46fr);
    /* Bottom padding is tighter than the top because the trust bar sits directly beneath and
       supplies the rest of the separation. */
    padding-block: 56px 40px;
  }

  .est-hero__copy {
    min-width: 0;
  }

  .est-hero__eyebrow {
    margin: 0 0 14px;
    color: var(--ac-color-blue-deep);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .est-hero__title {
    margin: 0;
    color: var(--ac-color-navy-950);
  }

  /* Refresh: "Keep prose lines near 55–65 characters." */
  .est-hero__lead {
    margin: 18px 0 0;
    max-width: 34ch;
    color: var(--ac-color-navy-900);
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .est-hero__body {
    margin: 14px 0 0;
    max-width: 58ch;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.6;
  }

  /* The three-part line. Hairline separators, no badges. */
  .est-hero__points {
    display: flex;
    flex-wrap: wrap;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    gap: 10px 18px;
  }

  .est-hero__points li {
    position: relative;
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .est-hero__points li + li {
    padding-left: 19px;
  }

  .est-hero__points li + li::before {
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 1px;
    background: var(--ac-color-line-strong);
    content: "";
  }

  .est-hero__actions {
    margin-top: 26px;
  }

  .est-hero__note {
    margin: 14px 0 0;
    color: var(--ac-color-ink-600);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .est-hero__form {
    min-width: 0;
    /* The walkthrough anchors land here; clear the sticky header before the form's first field. */
    scroll-margin-top: 90px;
  }

  /* Meaningful image right, replacing the hero-embedded form (blueprint, estate campaign review).
     4:3-ish contained plate, not a full-bleed crop — this hero stays the bright, white-surface
     composition the refresh established, just with a photograph where the form used to sit. */
  .est-hero__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Refresh: "On mobile: introduction, call/walkthrough buttons, then form." DOM order already
     is exactly that, so the columns simply collapse.

     STACKING THRESHOLD — was `max-width: 62rem` (992px), which put the ENTIRE 768-1023px tablet
     range into the stacked layout (copy height + gap + image height) instead of the shared
     592px tablet floor's side-by-side composition. Measured stacked at 820px: 1060px, nearly
     double the shared tablet token. Lowered to the shared tablet/mobile boundary (48rem/768px,
     docs/ASEPTACLEAN-DESIGN-SPEC.md §2.1) so the two-column split — like every other reviewed
     hero at tablet width — persists through the whole tablet range and only stacks on mobile,
     where content-driven height is explicitly allowed to grow (§2.2). Measured two-column at
     820px: 664px, under the spec's 680px tablet ceiling. */
  @media (max-width: 47.9375rem) {
    .est-hero__grid {
      gap: 32px;
      grid-template-columns: minmax(0, 1fr);
      padding-block: 40px 44px;
    }

    .est-hero__lead {
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .est-shell {
      padding-inline: 20px;
    }

    .est-hero__points li + li {
      padding-left: 0;
    }

    .est-hero__points li + li::before {
      display: none;
    }

    .est-hero__points {
      display: grid;
      gap: 8px;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import { homepage } from "@data/site";
---

<section class="timeline" aria-labelledby="timeline-title">
  <div class="container">
    <header class="timeline__header">
      <p>09 / What happens next</p>
      <h2 id="timeline-title">You do not have to solve the whole property before you contact us</h2>
      <p>
        Start with what you know. Photos help. A complete inventory does not
        have to exist before the first conversation.
      </p>
    </header>

    <ol class="timeline__steps">
      {
        homepage.nextSteps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-navy-900);
    color: var(--color-warm-white);
  }

  .timeline__header {
    display: grid;
    gap: var(--space-4);
  }

  .timeline__header > p:first-child {
    margin: 0;
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 21ch;
    margin: 0;
    color: var(--color-paper);
    letter-spacing: -0.025em;
  }

  .timeline__header > p:last-child {
    max-width: 34rem;
    margin: 0;
    color: var(--color-steel-300);
  }

  .timeline__steps {
    margin: var(--space-8) 0 0;
    border-top: 1px solid rgb(168 184 200 / 0.55);
    padding: 0;
    list-style: none;
  }

  .timeline__steps li {
    display: grid;
    max-width: none;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    border-bottom: 1px solid rgb(168 184 200 / 0.35);
    padding-block: var(--space-5);
  }

  .timeline__steps span {
    grid-row: 1 / 3;
    color: var(--color-steel-300);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .timeline__steps h3,
  .timeline__steps p {
    margin: 0;
  }

  .timeline__steps h3 {
    color: var(--color-paper);
    font-size: var(--step-1);
  }

  .timeline__steps p {
    color: var(--color-steel-300);
  }

  @media (min-width: 55rem) {
    .timeline__header {
      grid-template-columns: minmax(10rem, 2fr) minmax(22rem, 4fr) minmax(18rem, 3fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  @media (min-width: 70rem) {
    .timeline__steps {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .timeline__steps li {
      display: block;
      border-right: 1px solid rgb(168 184 200 / 0.35);
      border-bottom: 0;
      padding: var(--space-5);
    }

    .timeline__steps li:first-child {
      padding-left: 0;
    }

    .timeline__steps li:last-child {
      border-right: 0;
      padding-right: 0;
    }

    .timeline__steps h3 {
      min-height: 3.25rem;
      margin-top: var(--space-5);
    }

    .timeline__steps p {
      margin-top: var(--space-4);
      font-size: var(--step--1);
    }
  }
</style>

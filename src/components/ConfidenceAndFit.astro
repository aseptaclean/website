---
// 2026-08-18 visual port. This section has NO counterpart in any of the 12 mockups — it is a
// pre-port block that the doc 27 §9 section map never covered (recorded as "unaddressed, not
// stale" in docs/05-DECISIONS-LOG.md, 2026-08-17). Owner ruling: unmapped surfaces inherit the
// new shell via shared components rather than getting ad-hoc styling.
//
// So nothing here is redesigned and NOT ONE STRING CHANGED. The markup is re-expressed in the
// mockups' own vocabulary, because the mockups already have a component for exactly this
// content: the included/excluded pair is .ac-split + .ac-panel--in / .ac-panel--out, the same
// pair the service-page template uses, and the assurance list is the .ac-deps rail. Before
// this it was the last homepage block still rendering pre-port, and at ~3,500px it was the
// tallest thing on the page.
//
// The pricing half of this section stays intentionally dropped — it duplicates Pricing.astro's
// #pricing further down the homepage.
import { homepage, legal } from "@data/site";

const check = '<path d="m4 12 5 5L20 6"/>';
const minus = '<path d="M5 12h14"/>';
---

<section class="ac-sec confidence" id="confidence-and-fit" aria-labelledby="confidence-title">
  <div class="ac-shell">
    <div class="ac-sec__head">
      <p class="ac-label">Confidence and fit</p>
      <h2 id="confidence-title" class="ac-type-h2">The decisions stay yours</h2>
      <p>
        The emotional risk is not only the cost. It is the fear that something important will
        disappear, the scope will change without warning, or the property will still feel
        unfinished when the crew leaves. The Aseptaclean Handoff Assurance addresses those risks
        directly.
      </p>
      <p>Routine housekeeping, single-item pickup, and low-cost hauling are not the primary fit.</p>
    </div>

    <div class="ac-split" id="included">
      <div class="ac-panel ac-panel--in" aria-labelledby="included-title">
        <div class="ac-panel__h">
          <span id="included-title">Work that may be included</span>
          <span>Per approved scope</span>
        </div>
        <ul>
          {homepage.includedScope.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />
              {item}
            </li>
          ))}
        </ul>
        <p class="ac-panel__f">
          Before work begins, the written scope identifies what remains, what leaves, what gets
          cleaned, and what is outside the job. That is how both sides know what finished means.
        </p>
      </div>

      <div class="ac-panel ac-panel--out" aria-labelledby="excluded-title">
        <div class="ac-panel__h">
          <span id="excluded-title">Stop / notify / refer</span>
          <span>Outside this scope</span>
        </div>
        <ul>
          {homepage.excludedScope.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={minus} />
              {item}
            </li>
          ))}
        </ul>
        <p class="ac-panel__f">
          {legal.scopeDisclaimer} You will hear the boundaries before work begins, not halfway
          through the job.
        </p>
      </div>
    </div>

    <div class="assurance">
      <h3 class="ac-hdr-lite ac-type-label-head">The Handoff Assurance</h3>
      <ul class="ac-deps">
        {homepage.assurance.map((item, index) => (
          <li>
            <b>{String(index + 1).padStart(2, "0")}</b>
            <span>
              <strong>{item.title}</strong>
              {item.detail}
            </span>
          </li>
        ))}
      </ul>
      <p class="assurance__note">
        Scope-completion correction applies to items specifically included in the signed scope.
        It does not guarantee results outside that scope.
      </p>
    </div>
  </div>
</section>

<style>
  .confidence {
    background: var(--ac-color-warm-white);
  }

  .assurance {
    margin-top: 56px;
  }

  .assurance .ac-deps {
    margin-top: 22px;
  }

  .assurance .ac-deps strong {
    display: block;
    color: var(--ac-color-ink-900);
    font-weight: 700;
  }

  .assurance .ac-deps span {
    color: var(--ac-color-ink-600);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .assurance__note {
    border-left: 2px solid var(--ac-color-steel-300);
    margin-top: 22px;
    padding-left: 14px;
    color: var(--ac-color-ink-600);
    font-size: 0.75rem;
    line-height: 1.6;
  }
</style>

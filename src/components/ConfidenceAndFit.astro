---
import { homepage, legal, site } from "@data/site";

const currency = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0
});
---

<section class="confidence" id="confidence-and-fit" aria-labelledby="confidence-title">
  <div class="ac-measure-wide">
    <header class="confidence__intro">
      <p class="ac-eyebrow">Confidence and fit</p>
      <h2 id="confidence-title" class="ac-type-h2">The decisions stay yours</h2>
      <p class="ac-type-body">
        The emotional risk is not only the cost. It is the fear that something
        important will disappear, the scope will change without warning, or the
        property will still feel unfinished when the crew leaves. The
        Aseptaclean Handoff Assurance addresses those risks directly.
      </p>
      <p class="ac-type-body">
        Routine housekeeping, single-item pickup, and low-cost hauling are not
        the primary fit.
      </p>
    </header>

    <div class="confidence__blocks">
      <div class="confidence__block confidence__block--scope" id="included">
        <p class="confidence__block-label ac-type-h3">A defined finish, not an open-ended cleanup</p>
        <p class="ac-type-body">
          Before work begins, the written scope identifies what remains, what
          leaves, what gets cleaned, and what is outside the job. That is how both
          sides know what finished means.
        </p>

        <div class="confidence__scope-columns">
          <section aria-labelledby="included-title">
            <h3 id="included-title" class="ac-type-h3">Work that may be included</h3>
            <ul>
              {homepage.includedScope.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <aside aria-labelledby="excluded-title">
            <p class="scope__stop">Stop / notify / refer</p>
            <h3 id="excluded-title" class="ac-type-h3">What we do not quietly absorb into the job</h3>
            <ul>
              {homepage.excludedScope.map((item) => <li>{item}</li>)}
            </ul>
            <p class="scope__disclaimer">{legal.scopeDisclaimer}</p>
            <p class="scope__disclaimer">
              You will hear the boundaries before work begins, not halfway through
              the job.
            </p>
          </aside>
        </div>

        <ul class="confidence__assurance">
          {
            homepage.assurance.map((item) => (
              <li>
                <h3 class="ac-type-h3">{item.title}</h3>
                <p class="ac-type-body">{item.detail}</p>
              </li>
            ))
          }
        </ul>
        <p class="assurance__note ac-type-sm">
          Scope-completion correction applies to items specifically included in the
          signed scope. It does not guarantee results outside that scope.
        </p>
      </div>

      <div class="confidence__support">
        <div class="confidence__block confidence__block--pricing">
          <p class="confidence__block-label ac-type-h3">Know the starting point before you tell the whole story</p>
          <p class="ac-type-body">
            You should be able to decide whether this type of service is realistic
            before spending an hour explaining the property. Photo review comes
            first. Complex properties may require an on-site assessment before a
            final scope and price can be issued.
          </p>

          <div class="pricing__figure">
            <p class="ac-type-xs">Full Handoff Reset projects generally begin at</p>
            <strong>{currency.format(site.offer.startingPrice)}</strong>
            <small class="ac-type-sm">Not a flat package price</small>
          </div>

          <div class="pricing__drivers">
            <p class="ac-type-xs">Final pricing depends on</p>
            <ul>
              {homepage.pricingDrivers.map((driver) => <li class="ac-type-body">{driver}</li>)}
            </ul>
          </div>

          <aside class="pricing__assessment">
            <p class="ac-type-xs">When remote scoping is not reliable</p>
            <strong class="ac-type-h3">{currency.format(site.offer.assessmentFee)} on-site assessment</strong>
            <span class="ac-type-sm">{site.offer.assessmentFeeTerms}</span>
          </aside>
        </div>

        <div class="confidence__block confidence__block--founder" id="about">
          <p class="confidence__block-label ac-type-h3">The person defining the work stays accountable for how it is carried out</p>
          <p class="ac-type-body">
            {site.founder.name}, {site.founder.title}, is directly involved in scope
            review, project planning, communication, and operating oversight.
          </p>

          <blockquote>
            <p>
              &ldquo;Difficult properties are not handled well through vague promises.
              Before work begins, I want you to know what is included, what is
              excluded, what happens when something unexpected is found, and what you
              will receive when the job is closed. That is the standard I built
              Aseptaclean around.&rdquo;
            </p>
            <footer>
              <strong>{site.founder.name}</strong>
              <span class="ac-type-sm">{site.founder.title}</span>
            </footer>
          </blockquote>

          <div class="founder__record">
            <p class="ac-type-xs">Relevant operating background</p>
            <ul>
              {homepage.founderCredentials.map((credential) => <li class="ac-type-body">{credential}</li>)}
            </ul>
            <small class="ac-type-sm">
              This background does not grant contractor, remediation, medical,
              environmental, biohazard, or regulatory authority.
            </small>
          </div>

          {
            site.business.insuranceStatus && (
              <p class="confidence__insurance ac-type-sm">{site.business.insuranceStatus}</p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .confidence {
    background: var(--ac-color-warm-white);
    padding-top: var(--ac-rhythm-standard);
    padding-bottom: 0;
  }

  .confidence__intro {
    display: grid;
    gap: var(--ac-space-4);
    max-width: 48rem;
  }

  h2 {
    max-width: 22ch;
  }

  .confidence__blocks {
    display: grid;
    gap: var(--ac-space-8);
    margin-top: var(--ac-space-8);
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: var(--ac-space-7);
  }

  .confidence__block-label {
    max-width: 24ch;
    margin: 0;
  }

  .confidence__block > p.ac-type-body {
    margin-top: var(--ac-space-3);
  }

  .confidence__support {
    display: grid;
    gap: var(--ac-space-8);
  }

  /* Scope block */
  .confidence__scope-columns {
    display: grid;
    gap: var(--ac-space-6);
    margin-top: var(--ac-space-6);
  }

  .confidence__scope-columns h3 {
    max-width: 21ch;
    margin: 0;
  }

  .confidence__scope-columns ul {
    display: grid;
    gap: 0;
    margin: var(--ac-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .confidence__scope-columns li {
    position: relative;
    max-width: none;
    border-top: 1px solid var(--ac-color-rule);
    padding: var(--ac-space-3) 0 var(--ac-space-3) 1.75rem;
  }

  .confidence__scope-columns section li::before {
    position: absolute;
    left: 0;
    color: var(--ac-color-success);
    font-weight: 700;
    content: "✓";
  }

  .confidence__scope-columns aside {
    border-left: 3px solid var(--ac-color-error);
    padding: var(--ac-space-5);
    background: #f5efed;
  }

  .confidence__scope-columns aside li::before {
    position: absolute;
    left: 0;
    color: var(--ac-color-error);
    font-weight: 700;
    content: "—";
  }

  .scope__stop {
    margin: 0;
    color: var(--ac-color-error);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .confidence__scope-columns aside h3 {
    margin-top: var(--ac-space-3);
  }

  .scope__disclaimer {
    margin: var(--ac-space-5) 0 0;
    border-top: 1px solid rgb(161 38 34 / 0.25);
    padding-top: var(--ac-space-4);
    color: var(--ac-color-ink-500);
    font-size: var(--ac-text-xs);
    line-height: 1.55;
  }

  /* Assurance ledger, folded into the scope block */
  .confidence__assurance {
    margin: var(--ac-space-7) 0 0;
    border-top: 1px solid var(--ac-color-rule);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--ac-space-5);
  }

  .confidence__assurance li {
    border-bottom: 1px solid var(--ac-color-rule);
    padding-block: var(--ac-space-4);
  }

  .confidence__assurance h3,
  .confidence__assurance p {
    margin: 0;
  }

  .confidence__assurance p {
    margin-top: var(--ac-space-2);
    color: var(--ac-color-ink-500);
  }

  .assurance__note {
    max-width: 48rem;
    margin: var(--ac-space-5) 0 0;
    border-left: 2px solid var(--ac-color-blue-500);
    padding-left: var(--ac-space-4);
    color: var(--ac-color-navy-900);
    font-weight: 600;
  }

  /* Pricing block */
  .pricing__figure {
    margin-top: var(--ac-space-6);
    border-block: 2px solid var(--ac-color-navy-900);
    padding-block: var(--ac-space-5);
  }

  .pricing__figure p {
    margin: 0;
    color: var(--ac-color-ink-500);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing__figure strong {
    display: block;
    margin-top: var(--ac-space-2);
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-display);
    font-weight: 520;
    font-size: clamp(4rem, 12vw, 6.5rem);
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .pricing__figure small {
    display: block;
    margin-top: var(--ac-space-4);
    color: var(--ac-color-navy-800);
  }

  .pricing__drivers {
    margin-top: var(--ac-space-6);
  }

  .pricing__drivers > p {
    margin: 0;
    color: var(--ac-color-ink-500);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing__drivers ul {
    display: grid;
    margin: var(--ac-space-4) 0 0;
    border-top: 1px solid var(--ac-color-rule);
    padding: 0;
    list-style: none;
  }

  .pricing__drivers li {
    max-width: none;
    border-bottom: 1px solid var(--ac-color-rule);
    padding: var(--ac-space-3) var(--ac-space-3) var(--ac-space-3) 0;
  }

  .pricing__assessment {
    margin-top: var(--ac-space-6);
    border-left: 3px solid var(--ac-color-blue-500);
    padding: var(--ac-space-5);
    background: var(--ac-color-paper);
  }

  .pricing__assessment p {
    margin: 0;
    color: var(--ac-color-ink-500);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing__assessment strong,
  .pricing__assessment span {
    display: block;
  }

  .pricing__assessment strong {
    margin-top: var(--ac-space-3);
    color: var(--ac-color-navy-900);
  }

  .pricing__assessment span {
    margin-top: var(--ac-space-3);
    color: var(--ac-color-ink-500);
  }

  /* Founder block */
  .confidence__block--founder blockquote {
    position: relative;
    margin: var(--ac-space-6) 0 0;
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: var(--ac-space-6);
  }

  .confidence__block--founder blockquote > p {
    max-width: none;
    margin: 0;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-lead);
    font-weight: 400;
    line-height: 1.45;
  }

  .confidence__block--founder blockquote footer {
    display: grid;
    margin-top: var(--ac-space-5);
  }

  .confidence__block--founder blockquote strong {
    color: var(--ac-color-navy-900);
  }

  .founder__record {
    margin-top: var(--ac-space-6);
    border: 1px solid var(--ac-color-steel-300);
    padding: var(--ac-space-5);
    background: var(--ac-color-paper);
  }

  .founder__record > p {
    margin: 0;
    color: var(--ac-color-navy-800);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .founder__record ul {
    margin: var(--ac-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .founder__record li {
    max-width: none;
    border-top: 1px solid var(--ac-color-rule);
    padding-block: var(--ac-space-3);
  }

  .founder__record small {
    display: block;
    margin-top: var(--ac-space-4);
    border-left: 2px solid var(--ac-color-blue-500);
    padding-left: var(--ac-space-3);
    color: var(--ac-color-ink-500);
    line-height: 1.5;
  }

  .confidence__insurance {
    margin-top: var(--ac-space-4);
    color: var(--ac-color-ink-500);
  }

  @media (min-width: 70rem) {
    /*
      The assurance ledger (scope + assurance list) runs roughly 3x longer
      than pricing or founder content. Forcing it into a third equal-height
      column stretches the row to the ledger's height and leaves the shorter
      columns trailing in near-empty space (audit item 12). It gets the
      width its content needs instead; pricing and founder pair up as a
      shorter strip below it, sized to their own (much shorter) content.
    */
    .confidence__block--scope {
      max-width: 64%;
    }

    .confidence__support {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .confidence__scope-columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

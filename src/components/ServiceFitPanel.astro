---
// Shared "This service may fit when" screening panel — docs/27-COPY-CANONICAL.md §11 item 4,
// present on every individual service page (§12–15). Screening language, not a promise: it
// describes situations the service tends to suit, never an assurance the property qualifies.
interface Props {
  headingId: string;
  heading?: string;
  items: readonly string[];
}

const { headingId, heading = "This service may fit when", items } = Astro.props;
---

<section class="service-fit" aria-labelledby={headingId}>
  <div class="ac-measure-wide">
    <p class="ac-eyebrow">Screening</p>
    <h2 id={headingId} class="ac-type-h2 service-fit__heading">{heading}</h2>
    <ul class="service-fit__list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .service-fit {
    background: var(--ac-color-warm-white);
    border-top: 1px solid var(--ac-color-line);
  }

  .service-fit__heading {
    max-width: 30ch;
    margin-top: var(--ac-space-3);
  }

  .service-fit__list {
    display: grid;
    gap: var(--ac-space-3);
    max-width: 60rem;
    margin: var(--ac-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .service-fit__list li {
    position: relative;
    border-top: 1px solid var(--ac-color-line);
    padding-top: 12px;
    padding-left: 1.6rem;
    color: var(--ac-color-ink-600);
    font-size: 0.96rem;
  }

  .service-fit__list li::before {
    position: absolute;
    top: 12px;
    left: 0;
    color: var(--ac-color-blue-deep);
    font-family: var(--ac-font-mono);
    font-size: 0.8rem;
    content: "→";
  }

  @media (min-width: 40rem) {
    .service-fit__list {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--ac-space-6);
    }
  }
</style>

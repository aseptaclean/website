---
// 2026-08-18 visual port. docs/mockups .cred — the strip is now left-aligned h4 + supporting
// line, four up, divided by hairlines, replacing FINAL-v2's centred .credbar.
//
// CONTENT is unchanged and deliberately NOT doc 27 §9.3. §9.3's four cells are Insured /
// Owner-operated / Written scope / region; docs/18-VISUAL-DIRECTION.md §7 (rank 5) mandates
// this bar verbatim as Insured · Organic Pathogen Endorsed · Owner-Operated · region and
// outranks doc 27 (rank 7). That boundary was adjudicated on 2026-08-17 — see
// docs/05-DECISIONS-LOG.md, "CredentialBar.astro flagged mid-session as stale against doc 27
// §9.3 … that was a misread." The port changes the treatment, not the cells.
//
// The one supporting line doc 27 DOES own here — "Founder reviews the scope" (§9.3) — is now
// used verbatim in place of v2's "Founder on every scope", closing the last untraced string
// in this component. Never "licensed" (AGENTS.md §7); no job count, no years figure.
import { site } from "@data/site";
---

<section class="ac-cred" aria-label="Operating credentials">
  <div class="ac-shell">
    <div>
      <h4 class="ac-type-h4">Insured</h4>
      <p>COI available on request</p>
    </div>
    <div>
      <h4 class="ac-type-h4">Endorsed</h4>
      <p>Organic pathogen endorsement</p>
    </div>
    <div>
      <h4 class="ac-type-h4">Owner-operated</h4>
      <p>Founder reviews the scope</p>
    </div>
    <div>
      <h4 class="ac-type-h4">{site.location.regionLabel}</h4>
      <p>Service-area business</p>
    </div>
  </div>
</section>

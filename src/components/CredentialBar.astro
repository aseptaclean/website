---
// docs/aseptaclean-FINAL-v2.html .credbar — ported verbatim (05-DECISIONS-LOG.md).
import { site } from "@data/site";
---

<div class="credbar">
  <div class="credbar__inner ac-measure-wide">
    <div class="cred"><div class="t">Insured</div><div class="s">COI available on request</div></div>
    <div class="cred"><div class="t">Endorsed</div><div class="s">Organic pathogen endorsement</div></div>
    <div class="cred"><div class="t">Owner-operated</div><div class="s">Founder on every scope</div></div>
    <div class="cred"><div class="t">{site.location.county}</div><div class="s">{site.location.serviceArea}</div></div>
  </div>
</div>

<style>
  .credbar {
    border-bottom: 1px solid var(--ac-color-line);
    background: var(--ac-color-paper);
  }

  .credbar__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .cred {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 112px;
    border-right: 1px solid var(--ac-color-line);
    padding: 26px 18px;
    text-align: center;
  }

  .cred:last-child {
    border-right: 0;
  }

  .cred .t {
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .cred .s {
    margin-top: 2px;
    color: var(--ac-color-ink-400);
    font-size: 0.8rem;
  }

  @media (max-width: 51.25rem) {
    .credbar__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .cred:nth-child(2) {
      border-right: 0;
    }
  }
</style>

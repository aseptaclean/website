---
import { homepage, legal } from "@data/site";
---

<section class="scope" id="included" aria-labelledby="scope-title">
  <div class="container">
    <header class="scope__header">
      <p>05 / Scope boundary</p>
      <h2 id="scope-title">A defined finish, not an open-ended cleanup</h2>
      <p>
        Before work begins, the written scope identifies what remains, what
        leaves, what gets cleaned, and what is outside the job. That is how both
        sides know what finished means.
      </p>
    </header>

    <div class="scope__layout">
      <section class="scope__included" aria-labelledby="included-title">
        <h3 id="included-title">Work that may be included</h3>
        <ul>
          {homepage.includedScope.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <aside class="scope__excluded" aria-labelledby="excluded-title">
        <p class="scope__stop">Stop / notify / refer</p>
        <h3 id="excluded-title">What we do not quietly absorb into the job</h3>
        <ul>
          {homepage.excludedScope.map((item) => <li>{item}</li>)}
        </ul>
        <p class="scope__disclaimer">{legal.scopeDisclaimer}</p>
        <p class="scope__disclaimer">
          You will hear the boundaries before work begins, not halfway through
          the job.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .scope {
    border-block: 1px solid var(--color-rule);
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-warm-white);
  }

  .scope__header {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-7);
  }

  .scope__header > p:first-child,
  .scope__stop {
    margin: 0;
    color: var(--color-blue-500);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 22ch;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .scope__header > p:last-child {
    max-width: 40rem;
    margin: 0;
  }

  .scope__layout {
    display: grid;
    gap: var(--space-7);
  }

  .scope__included {
    border-top: 2px solid var(--color-navy-900);
    padding-top: var(--space-5);
  }

  .scope h3 {
    max-width: 21ch;
    margin: 0;
    font-size: var(--step-2);
  }

  .scope ul {
    display: grid;
    gap: 0;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .scope li {
    position: relative;
    max-width: none;
    border-top: 1px solid var(--color-rule);
    padding: var(--space-3) 0 var(--space-3) 1.75rem;
  }

  .scope__included li::before,
  .scope__excluded li::before {
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .scope__included li::before {
    color: var(--color-success);
    content: "✓";
  }

  .scope__excluded {
    align-self: start;
    border-left: 3px solid var(--color-error);
    padding: var(--space-5);
    background: #f5efed;
  }

  .scope__excluded h3 {
    margin-top: var(--space-3);
  }

  .scope__excluded li::before {
    color: var(--color-error);
    content: "—";
  }

  .scope__disclaimer {
    margin: var(--space-5) 0 0;
    border-top: 1px solid rgb(161 38 34 / 0.25);
    padding-top: var(--space-4);
    color: var(--color-ink-500);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  @media (min-width: 55rem) {
    .scope__header {
      grid-template-columns: minmax(10rem, 2fr) minmax(22rem, 4fr) minmax(18rem, 3fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .scope__layout {
      grid-template-columns: minmax(25rem, 7fr) minmax(20rem, 5fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .scope__included ul {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }
</style>

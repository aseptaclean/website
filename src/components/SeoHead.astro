---
import { site } from "@data/site";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  image?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  structuredDataEnabled?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  image,
  schema,
  structuredDataEnabled = true
} = Astro.props;
const canonical = new URL(canonicalPath, site.urls.site);
const shouldNoindex = noindex || !site.deployment.isPublicProduction;
// ONE business entity, ONE @id, defined here so it renders identically on every route.
//
// Before 2026-08-20 there were two competing identifiers for the same company: an
// `Organization` at `/#organization`, emitted on every route from this file, and a
// `LocalBusiness` at `/#business`, hand-written on three routes in three DIFFERENT and
// mutually incomplete shapes — `/` had `geo` and a PostalAddress but no telephone, `/contact/`
// had telephone but no geo, and `/about/` had nothing but a name and a founder link. Service
// nodes then split between the two ids depending on which file emitted them.
//
// `/#business` wins as the surviving id: `LocalBusiness` is a subtype of `Organization`, so the
// single node carries every property both used to, and `worksFor` on the /about/ Person node
// already pointed here. `/#organization` is retired — every `provider`, `publisher`, and
// `about` reference in src/ was repointed in the same change. If you find `/#organization`
// anywhere, it is a dangling reference, not a second entity.
//
// NO `address`. AGENTS.md §3: service-area business, no published street address, ever, and
// never infer a physical office from service-area coverage. The `/` node's PostalAddress was a
// violation of exactly that rule and was removed, not moved.
const businessId = new URL("/#business", site.urls.site).href;
const websiteId = new URL("/#website", site.urls.site).href;
const pageId = `${canonical.href}#webpage`;
const logoUrl = site.business.logoUrl
  ? new URL(site.business.logoUrl, site.urls.site).href
  : "";
// doc 19 §2.2: sameAs → GBP/Yelp/Nextdoor. Only owner-confirmed profile URLs are ever included
// (AGENTS.md §0.3 — never fabricate a profile). Moved here from src/pages/index.astro so the
// single entity carries them on every route instead of only on `/`.
const sameAs = [
  site.business.googleBusinessProfileUrl,
  site.business.yelpUrl,
  site.business.nextdoorUrl
].filter((url): url is string => Boolean(url));
const graph: Array<Record<string, unknown>> = [
  {
    "@type": "LocalBusiness",
    "@id": businessId,
    name: site.business.name,
    legalName: site.business.legalName,
    url: site.urls.site,
    email: site.business.email,
    ...(site.business.phone ? { telephone: site.business.phone } : {}),
    // Suppression rule (AGENTS.md §3): a missing asset omits the property rather than
    // shipping a placeholder URL.
    ...(logoUrl ? { logo: logoUrl, image: logoUrl } : {}),
    openingHours: site.business.hoursSchema,
    founder: {
      "@type": "Person",
      "@id": new URL("/#founder", site.urls.site).href,
      name: site.founder.name,
      jobTitle: site.founder.title
    },
    areaServed: site.location.cities.map((name) => ({
      "@type": "City",
      name
    })),
    geo: {
      "@type": "GeoCoordinates",
      latitude: site.location.geo.latitude,
      longitude: site.location.geo.longitude
    },
    ...(sameAs.length > 0 ? { sameAs } : {})
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: site.urls.site,
    name: site.business.name,
    publisher: { "@id": businessId }
  },
  {
    "@type": "WebPage",
    "@id": pageId,
    url: canonical.href,
    name: title,
    description,
    isPartOf: { "@id": websiteId },
    about: { "@id": businessId }
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])
];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
}).replace(/</g, "\\u003c");
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{/*
  "noindex, follow" — NOT "noindex, nofollow". docs/27-COPY-CANONICAL.md §21 specifies
  `noindex, follow` for gated pages, and the distinction matters: `nofollow` tells Google to
  stop crawling OUTWARD from the page, so a pre-launch draft that links to live pages passes
  no signal and its own outbound links are wasted. `follow` keeps the crawl graph intact while
  still withholding the page itself from the index. Changed 2026-08-17; the previous value was
  a defect against §21, not a decision.
*/}
<meta
  name="robots"
  content={shouldNoindex ? "noindex, follow" : "index, follow"}
/>
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.business.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={new URL(image, site.urls.site)} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
{structuredDataEnabled && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}

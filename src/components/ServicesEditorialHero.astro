---
// SERVICES EDITORIAL HERO — contained, non-photographic hero for the 2026-09-03 `/services/`
// editorial-catalog rebuild (docs/05-DECISIONS-LOG.md, "Services page rebuilt as an editorial
// catalog"). Deliberately NOT ServicesHero.astro: that component is a full-bleed photographic
// hero, and the rebuild brief calls for a contained white/warm-white hero instead — a different
// component, not a themed variant of the same one, so ServicesHero.astro is left untouched for
// any route that still wants the photographic treatment.
//
// COPY IS THE LOCKED SERVICES HERO, VERBATIM — docs/aseptaclean-all-website-copy.md, "PAGE:
// Services", the same servicesHub.hero fields ServicesHero.astro already read. Nothing reworded.
import { servicesHub } from "@data/servicePages";
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
const { eyebrow, h1, lede } = servicesHub.hero;
---

<section class="svc-ed-hero" aria-labelledby="svc-ed-hero-title">
  <div class="svc-ed-hero__inner">
    <p class="ac-eyebrow">{eyebrow}</p>
    <h1 id="svc-ed-hero-title" class="ac-type-h1">{h1}</h1>
    <div class="svc-ed-hero__lede">
      {lede.map((line) => <p>{line}</p>)}
    </div>
    <div class="svc-ed-hero__actions">
      <a class="svc-ed-hero__primary" href="/request-assessment/">Request an Assessment</a>
      {/* doc 27 §8 — the secondary door appears wherever the primary does. Suppressed with the
          phone value it derives from (AGENTS.md §3: never render an empty phone link). */}
      {phoneHref && <a class="svc-ed-hero__secondary" href={phoneHref}>Call {site.business.phone}</a>}
      {smsHref && <a class="svc-ed-hero__secondary" href={smsHref}>{site.offer.smsCta}</a>}
    </div>
  </div>
</section>

<style>
  .svc-ed-hero {
    background: var(--ac-color-paper);
    padding-block: 96px 72px;
  }

  .svc-ed-hero__inner {
    width: min(100% - 64px, var(--ac-measure-wide));
    max-width: 760px;
    margin-inline: auto;
  }

  .svc-ed-hero__inner h1 {
    margin-top: 14px;
    color: var(--ac-color-navy-900);
  }

  .svc-ed-hero__lede {
    margin-top: 22px;
  }

  .svc-ed-hero__lede p {
    margin: 0;
    max-width: 58ch;
    color: var(--ac-color-ink-600);
    font-size: 1.0625rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .svc-ed-hero__lede p + p {
    margin-top: 10px;
  }

  .svc-ed-hero__lede p:last-child {
    color: var(--ac-color-navy-900);
    font-weight: 600;
  }

  .svc-ed-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 32px;
    gap: 10px 28px;
  }

  .svc-ed-hero__primary {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--ac-color-navy-900);
    padding-inline: 30px;
    color: var(--ac-color-paper);
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .svc-ed-hero__primary:hover {
    background: var(--ac-color-navy-800);
  }

  .svc-ed-hero__primary:focus-visible,
  .svc-ed-hero__secondary:focus-visible {
    outline: 3px solid var(--ac-color-navy-900);
    outline-offset: 4px;
  }

  /* Text link, not a second button — doc 30 §13.2's hierarchy. 44px keeps the touch target. */
  .svc-ed-hero__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ac-color-navy-800);
    font-size: 0.9375rem;
    font-weight: 650;
    text-underline-offset: 5px;
  }

  .svc-ed-hero__secondary:hover {
    color: var(--ac-color-navy-900);
  }

  @media (max-width: 50rem) {
    .svc-ed-hero {
      padding-block: 72px 56px;
    }

    .svc-ed-hero__inner {
      width: calc(100% - 48px);
    }
  }

  @media (max-width: 40rem) {
    .svc-ed-hero {
      padding-block: 60px 48px;
    }

    .svc-ed-hero__inner {
      width: calc(100% - 40px);
    }

    .svc-ed-hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 10px;
    }

    .svc-ed-hero__primary {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-ed-hero__primary {
      transition: none;
    }
  }
</style>

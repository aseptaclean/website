---
// 2026-08-18 visual port. docs/mockups/aseptaclean-homepage-v3.html .tiles / .tile — the
// SERVPRO photo tile with the hover-reveal overlay (PORT-PROMPT §3, "hover-reveal overlay
// variant on homepage tiles"). Styling lives in global.css (.ac-tile*).
//
// STILL THREE CARDS, and still these three. The mockup draws four, but the mockup's four are
// doc 27 §9.4–9.5 verbatim, which docs/27-COPY-CANONICAL.md itself annotates DOES NOT SHIP for
// `/` on two independent grounds (docs/18-VISUAL-DIRECTION.md §6.1 photography gate, and §7 +
// doc 27 §21 + B&P §8550(a) for the Specialty card that names rodent and pigeon waste). Owner
// ruling 4 of 2026-08-18 rescinded D2 — the Why-field icon grid — and did not reach this
// section. PORT-PROMPT §0 says report a wrong-looking mockup rather than fix it silently: the
// tile TREATMENT is ported, the card SET is not. See docs/05-DECISIONS-LOG.md.
import { homepage } from "@data/site";

// docs/19-SYSTEM-AND-SITEMAP.md "Linking rules" — homepage cards ↔ service pages.
//
// "Animal & organic condition cleaning" is deliberately NOT linked to /specialty-cleaning/.
// That hub ships noindex and is out of sitemap.xml.ts because its cards name rodent and pigeon
// dropping cleanup — held behind doc 27 §21's compliance release and B&P §8550(a) (see
// 26b5278, which verified no indexable page links to them). `/` is indexable, so wiring this
// card there would create an indexable→noindex crawl path AND re-advertise the gated services
// from the most crawled page on the site. Clearing §21 is the unblock, not editing the link.
const links: Record<string, string> = {
  "Complex property clearing": "/property-clearing/",
  "Reset & restoration cleaning": "/detailed-cleaning/"
};
---

<section class="ac-sec service-cards" id="service-cards" aria-labelledby="service-cards-title">
  <div class="ac-shell">
    <div class="ac-sec__head">
      <p class="ac-label">Scope of work</p>
      <h2 id="service-cards-title" class="ac-type-h2">Three ways properties reach this handoff</h2>
      <p>Every project runs under a signed scope with a documented closeout — whichever way it starts.</p>
    </div>

    <div class="ac-tiles">
      {homepage.serviceCards.map((item) => {
        const href = links[item.title];
        const Tag = href ? "a" : "div";
        return (
          <Tag
            class="ac-tile"
            href={href}
            aria-label={href ? `${item.title} — what’s included` : undefined}
          >
            <div class="ac-tile__img" role="presentation">{item.imageLabel}</div>
            <div class="ac-tile__bar">
              <b>{item.title}</b>
              {href && <i aria-hidden="true">&rarr;</i>}
            </div>
            <div class="ac-tile__over">
              <b>{item.title}</b>
              <p>{item.detail}</p>
              {href && <span aria-hidden="true">What&rsquo;s included &rarr;</span>}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .service-cards {
    background: var(--ac-color-warm-white);
  }
</style>

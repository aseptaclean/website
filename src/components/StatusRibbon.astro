---
import { site } from "@data/site";
---

{/* Utility row — doc 30 §9: "small and quiet, factual information only".
    THE PHONE MOVED OUT OF THIS ROW, 2026-09-04. The header's primary CTA is now
    "Call Aseptaclean" (AGENTS.md §2.2.2), which put the same number in the ribbon and in the
    button directly beneath it, both visible at once on every route above 74rem. Doc 30 §9
    already forbids showing the same phone twice inside the header hierarchy, and reference
    page 23 shows exactly one phone in the header.

    The CTA button keeps it, not this row: the button is the action, it survives at every width
    (this row's link did not carry a 44px touch target), and the number itself stays reachable
    from the mobile drawer, the footer, the mobile bar, and every closing band.

    The service descriptor stays. It is the one factual line §9 asks for, and it is the only
    place the business category appears above the fold. */}
<div class="utility-bar" aria-label="Service category">
  <div class="utility-bar__inner">
    <span>{site.offer.utilityLabel}</span>
    <span class="utility-bar__hours">{site.business.hours}</span>
  </div>
</div>

<style>
  .utility-bar {
    background: var(--ac-color-navy-950);
    color: var(--ac-color-steel-on-navy);
  }

  .utility-bar__inner {
    display: flex;
    width: min(100% - 64px, 1504px);
    min-height: 30px;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
    gap: 24px;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .utility-bar__hours {
    color: var(--ac-color-paper);
    white-space: nowrap;
  }

  /* The hours string is the longer of the two items; below ~64rem it is the first thing that
     would wrap the row to two lines, so it drops and the category line stands alone. Hours stay
     on /contact/ and in the schema, which is where a visitor looks for them. */
  @media (max-width: 64rem) {
    .utility-bar__hours {
      display: none;
    }
  }

  /* Kept in step with Header.astro's collapse breakpoint, which moved from 70rem to 63.9375rem
     on 2026-08-25. The utility bar and the nav below it share one gutter; if only one of them
     narrows, the phone number and the logo stop lining up on their left and right edges through
     the whole 1024–1120px band. */
  @media (max-width: 63.9375rem) {
    .utility-bar__inner {
      width: min(100% - 40px, 1504px);
    }
  }

  @media (max-width: 30rem) {
    .utility-bar__inner {
      width: calc(100% - 40px);
      min-height: 28px;
      justify-content: flex-end;
      gap: 14px;
      font-size: 0.625rem;
      letter-spacing: 0.025em;
    }

    .utility-bar__inner > span {
      display: none;
    }

    .utility-bar a {
      min-height: 28px;
    }
  }

  @media print {
    .utility-bar {
      display: none;
    }
  }
</style>

---
import { site } from "@data/site";

// docs/aseptaclean-FINAL-v2.html .ribbon — ported verbatim (05-DECISIONS-LOG.md). Fixed
// wording per docs/18-VISUAL-DIRECTION.md §7 (retained): never "licensed," no job count or
// years figure.
---

<div class="status-ribbon" aria-label="Operating standards">
  <div class="status-ribbon__inner ac-measure-wide">
    <span><span class="status-ribbon__dot" aria-hidden="true"></span><b>Insured</b> — COI on request</span>
    <span><b>Organic Pathogen Endorsed</b></span>
    <span><b>Owner-operated</b> assessments</span>
    <span>{site.location.serviceArea}</span>
  </div>
</div>

<style>
  .status-ribbon {
    background: var(--ac-color-navy-950);
    color: #9fb2ca;
  }

  .status-ribbon__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    overflow-x: auto;
    height: 32px;
    font-family: var(--ac-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .status-ribbon__inner::-webkit-scrollbar {
    display: none;
  }

  .status-ribbon b {
    color: #fff;
    font-weight: 500;
  }

  .status-ribbon__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: #37b57e;
    vertical-align: middle;
  }
</style>

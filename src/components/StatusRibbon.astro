---
// 2026-08-18 visual port. docs/mockups .ribbon — ported verbatim. Content is doc 27 §8's
// "Utility ribbon" list, which is four items ending in the phone number; the mockup pushes
// that last item to the right edge with `margin-left:auto`.
//
// The previous ribbon carried "Organic Pathogen Endorsed" as a fourth cell. That belongs to
// docs/18-VISUAL-DIRECTION.md §7's CREDENTIAL BAR, which is a different component
// (CredentialBar.astro) and still renders it verbatim — §7 is not weakened by this change.
// Doc 27 §8 owns the ribbon and does not list it. Never "licensed" here; no job count, no
// years figure (docs/18-VISUAL-DIRECTION.md §7, retained).
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
---

<div class="ribbon">
  <div class="ribbon__in ac-measure-wide">
    <span><span class="ribbon__dot" aria-hidden="true"></span>Insured — COI on request</span>
    <span>Owner-operated assessments</span>
    <span>{site.location.regionLabel}</span>
    {phoneHref && <b><a href={phoneHref}>{site.business.phone}</a></b>}
  </div>
</div>

<style>
  .ribbon {
    background: var(--ac-color-navy-950);
    color: #8fa6bf;
    font-family: var(--ac-font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ribbon__in {
    display: flex;
    height: 34px;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
  }

  .ribbon b {
    margin-left: auto;
    color: #fff;
    font-weight: 500;
  }

  .ribbon b a {
    color: inherit;
    text-decoration: none;
  }

  .ribbon__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--ac-color-status-green);
    vertical-align: middle;
  }

  @media (max-width: 760px) {
    .ribbon__in {
      height: auto;
      padding-block: 8px;
      gap: 14px;
    }

    .ribbon b {
      margin-left: 0;
    }
  }
</style>

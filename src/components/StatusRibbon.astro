---
import { site } from "@data/site";
---

<div class="utility-bar" aria-label="Service category and phone">
  <div class="utility-bar__inner">
    <span>{site.offer.utilityLabel}</span>
    {site.business.phoneUri && (
      <a href={site.business.phoneUri}>{site.business.phone}</a>
    )}
  </div>
</div>

<style>
  .utility-bar {
    background: var(--ac-color-navy-950);
    color: var(--ac-color-steel-on-navy);
  }

  .utility-bar__inner {
    display: flex;
    width: min(100% - 64px, 1504px);
    min-height: 30px;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
    gap: 24px;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .utility-bar a {
    display: flex;
    min-height: 30px;
    align-items: center;
    color: var(--ac-color-paper);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-decoration: none;
  }

  .utility-bar a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Kept in step with Header.astro's collapse breakpoint, which moved from 70rem to 63.9375rem
     on 2026-08-25. The utility bar and the nav below it share one gutter; if only one of them
     narrows, the phone number and the logo stop lining up on their left and right edges through
     the whole 1024–1120px band. */
  @media (max-width: 63.9375rem) {
    .utility-bar__inner {
      width: min(100% - 40px, 1504px);
    }
  }

  @media (max-width: 30rem) {
    .utility-bar__inner {
      width: calc(100% - 40px);
      min-height: 28px;
      justify-content: flex-end;
      gap: 14px;
      font-size: 0.625rem;
      letter-spacing: 0.025em;
    }

    .utility-bar__inner > span {
      display: none;
    }

    .utility-bar a {
      min-height: 28px;
    }
  }

  @media print {
    .utility-bar {
      display: none;
    }
  }
</style>

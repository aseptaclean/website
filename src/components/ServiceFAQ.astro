---
// Generic FAQ section for Phase 3/3b draft service pages — same visual pattern as
// FAQ.astro (details/summary, no accordion JS) but accepts an items list so each service
// page's own question set (docs/19-SYSTEM-AND-SITEMAP.md §3.2: "FAQ — 4–6 in searcher
// phrasing (FAQPage schema)") can render without duplicating the homepage's fixed array.
// The matching FAQPage JSON-LD is built by the page itself from the same array, the same
// way index.astro does for FAQ.astro, so visible copy and schema never diverge.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  headingId: string;
  intro: string;
  items: readonly FaqItem[];
}

const { heading, headingId, intro, items } = Astro.props;
---

<section class="service-faq" id="faq" aria-labelledby={headingId}>
  <div class="ac-measure-wide">
    <p class="ac-eyebrow">Before you request a plan</p>
    <h2 id={headingId} class="ac-type-h2 service-faq__title">{heading}</h2>
    <p class="service-faq__intro">{intro}</p>

    <div class="faq-list">
      {
        items.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="faq-list__pm" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .service-faq {
    background: var(--ac-color-warm-white);
  }

  .service-faq__title {
    max-width: 32ch;
    margin: var(--ac-space-3) 0 8px;
  }

  .service-faq__intro {
    margin-bottom: 30px;
    color: var(--ac-color-ink-600);
  }

  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 820px;
  }

  details {
    overflow: hidden;
    border: 1px solid var(--ac-color-line);
    border-radius: var(--ac-r-sm);
    background: #fff;
    transition: 0.15s;
  }

  details[open] {
    border-color: var(--ac-color-blue-500);
    box-shadow: var(--ac-shadow-card);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 19px 22px;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-display);
    font-size: 1.02rem;
    font-weight: 600;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-list__pm {
    flex-shrink: 0;
    color: var(--ac-color-blue-deep);
    font-family: var(--ac-font-mono);
  }

  details p {
    max-width: 68ch;
    margin: 0;
    padding: 0 22px 20px;
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }
</style>

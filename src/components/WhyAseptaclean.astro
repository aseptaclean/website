---
// 2026-08-18 visual port. docs/mockups .fieldwrap / .field / .grid4 / .it — the saturated navy
// rounded field section with a 4-up icon grid.
//
// The 4-up grid is KEPT. §9.15.3 D2 recommended replacing it with a single statement; owner
// RESCINDED D2 on 2026-08-18 and ruled the mockup's .grid4 stays. The blacklist citation
// behind D2 was inaccurate anyway — docs/01-QUALITY-GUARDRAILS.md §5.2 forbids that pattern
// "repeated 6–12 times", and this is ×4. Mockup is pixel authority. See 05-DECISIONS-LOG.md.
//
// Copy: doc 27 §9.6 (eyebrow, H2, four items) plus §9.15.1's Why-field lede. The Approval
// controls item carries §9.15.2 amendment 1, which replaces "Uncertain items are held for
// review." with the labeled-clear-bag sentence — an approved amendment to doc 27, not a
// conflict with it, so the §9.15.2 wording governs.
const items = [
  {
    title: "One accountable company",
    detail: "Clearing, cleaning and closeout documentation stay under one written scope.",
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 14h6"/>'
  },
  {
    title: "Written scope",
    detail:
      "What stays, what leaves, what gets cleaned and what is excluded are written down first.",
    icon:
      '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 16h4"/>'
  },
  {
    title: "Approval controls",
    detail:
      "Anything we’re not sure about goes into a labeled clear bag and waits for your decision. Added work requires documented authorization.",
    icon:
      '<path d="M12 3 5 6v6c0 4.2 2.9 7.9 7 9 4.1-1.1 7-4.8 7-9V6z"/><path d="m9.5 12 1.8 1.8 3.4-3.4"/>'
  },
  {
    title: "Documented closeout",
    detail: "Completion photographs and noted exceptions show how the approved scope closed.",
    icon:
      '<rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/><path d="M8 6l1.4-2h5.2L16 6"/>'
  }
] as const;
---

<div class="ac-fieldwrap">
  <div class="ac-shell">
    <div class="ac-field" aria-labelledby="why-aseptaclean-title">
      <span class="ac-chip">Why Aseptaclean</span>
      <h2 id="why-aseptaclean-title" class="ac-type-h2-field">
        The difference is what happens before and after the work itself.
      </h2>
      <p class="ac-field__lede">
        Most of what goes wrong on these projects gets decided before anyone picks anything up.
      </p>

      <div class="ac-grid4">
        {items.map((item) => (
          <div class="ac-it">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            <div>
              <h3 class="ac-type-h3-card">{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

---
// ServiceHero — shared hero for standard service pages. Two-column grid, image confined to its
// own column (edge-to-edge, no card), copy vertically centered. Stacks at <=850px.
//
// Two hero systems already exist and neither matches this shape: ServicePageLayout.astro's
// .ac-ph header is a single-column solid-navy/gradient field with no <img> at all (its own
// comments confirm the photographic .ph--split variant was planned but never built — blocked on
// missing scope-table content, not on this CSS shape). Each gold-standard page
// (hoarding/crime-scene/extreme/rodent/deep-cleaning) hand-builds its own full-bleed
// background-image hero with an overlay, which is a different pattern (photo as page
// background) from this spec (photo confined to its own grid column). This is a new, separate,
// reusable component — wiring it into any specific page's layout is page-redesign work, out of
// scope for this pass.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  heading: string;
  headingId?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, heading, headingId, image, imageAlt } = Astro.props;
---

<section class="ac-service-hero" aria-labelledby={headingId}>
  <div class="ac-service-hero__copy">
    <div class="ac-service-hero__copy-inner">
      {eyebrow && <p class="ac-eyebrow">{eyebrow}</p>}
      <h1 id={headingId} class="ac-type-h1-hub">{heading}</h1>
      <div class="ac-service-hero__body">
        <slot />
      </div>
      <div class="ac-service-hero__actions">
        <slot name="actions" />
      </div>
    </div>
  </div>

  <figure class="ac-service-hero__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[560, 840, 1120, 1400]}
      sizes="(min-width: 850px) 52vw, 100vw"
      format="webp"
      quality={74}
      loading="eager"
      decoding="async"
    />
  </figure>
</section>

<style>
  .ac-service-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: stretch;
    min-height: 520px;
    background: var(--ac-color-paper);
  }

  @media (min-width: 850px) {
    .ac-service-hero {
      min-height: 560px;
    }
  }

  .ac-service-hero__copy {
    display: flex;
    align-items: center;
  }

  .ac-service-hero__copy-inner {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: 56px 32px;
  }

  .ac-service-hero__copy-inner h1 {
    margin: 0;
  }

  .ac-service-hero__body {
    margin-top: 18px;
    max-width: var(--ac-measure-intimate);
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-lead);
    line-height: 1.6;
  }

  .ac-service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .ac-service-hero__actions:empty {
    margin-top: 0;
  }

  .ac-service-hero__media {
    margin: 0;
    height: 100%;
  }

  .ac-service-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 850px) {
    .ac-service-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .ac-service-hero__copy-inner {
      max-width: none;
      padding: 48px 20px;
    }

    .ac-service-hero__media {
      min-height: 280px;
    }
  }
</style>

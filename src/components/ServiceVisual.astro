---
// ServiceVisual — large photographic service module. 4:3 image, no card container, no shadow.
// Title + short description + a simple "Learn More" link below.
//
// WhatWeHandle.astro's .route is the closest existing analogue but is a 4-up grid item at a 4:5
// ratio with no standalone reuse outside that one homepage section. This is a new, generalized
// single-module component for use anywhere a large photographic service tile is needed.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  href: string;
  linkLabel?: string;
}

const { image, imageAlt, title, description, href, linkLabel = "Learn more" } = Astro.props;
---

<article class="ac-service-visual">
  <figure class="ac-service-visual__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[420, 640, 860]}
      sizes="(min-width: 850px) 44vw, 92vw"
      format="webp"
      quality={72}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="ac-service-visual__body">
    <h3 class="ac-type-h3-card ac-service-visual__title-wrap"><a class="ac-service-visual__title" href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="ac-service-visual__link" href={href}>{linkLabel} →</a>
  </div>
</article>

<style>
  .ac-service-visual {
    display: block;
  }

  .ac-service-visual__media {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ac-color-steel-200);
  }

  .ac-service-visual__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ac-service-visual__body {
    padding-top: 20px;
  }

  .ac-service-visual__title-wrap {
    margin: 0 0 8px;
  }

  .ac-service-visual__title {
    display: inline-block;
    font-size: clamp(1.375rem, 1.6vw, 1.5rem);
    color: var(--ac-color-ink-900);
    text-decoration: none;
  }

  .ac-service-visual__title:hover {
    text-decoration: underline;
  }

  .ac-service-visual__body p {
    margin: 0;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.6;
  }

  .ac-service-visual__link {
    display: inline-flex;
    margin-top: 14px;
    color: var(--ac-color-navy-800);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .ac-service-visual__link:hover {
    text-decoration: underline;
  }
</style>

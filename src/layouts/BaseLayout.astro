---
import Footer from "@components/Footer.astro";
import Analytics from "@components/Analytics.astro";
import AnalyticsHead from "@components/AnalyticsHead.astro";
import AnalyticsNoscript from "@components/AnalyticsNoscript.astro";
import Header from "@components/Header.astro";
import MobileCTA from "@components/MobileCTA.astro";
import SeoHead from "@components/SeoHead.astro";
import { site } from "@data/site";
import { isLaunchPublicPath } from "@data/launchArchitecture";
import "@styles/fonts.css";
import "@styles/global.css";
// One face as of the 2026-08-18 visual port. The display-serif and monospace preloads were
// removed with their @font-face rules — see src/styles/fonts.css.
import interFontUrl from "../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  contactKit?: boolean;
  homeKit?: boolean;
  estateKit?: boolean;
  hoardingKit?: boolean;
  traumaKit?: boolean;
  extremeKit?: boolean;
  detailedKit?: boolean;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  showMobileCta?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  contactKit = false,
  homeKit = false,
  estateKit = false,
  hoardingKit = false,
  traumaKit = false,
  extremeKit = false,
  detailedKit = false,
  title,
  description,
  canonicalPath,
  noindex = false,
  showMobileCta = true,
  schema
} = Astro.props;

const termlyConsent = site.integrations.termly;
const hiddenFromLaunch = !isLaunchPublicPath(Astro.url.pathname);
const effectiveNoindex = noindex || hiddenFromLaunch;
// Homepage-only visual scope for src/styles/aseptaclean-home.css (owner CSS, installed
// 2026-09-18). `ac-home` on <body> wraps Header, <main> and Footer together — the CSS's own
// header comment scope — without touching any other route. The stylesheet itself is imported
// only from src/pages/index.astro, so this marker is inert everywhere else even though the
// class is technically present only when true.
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {termlyConsent.consentEnabled && (
      <script
        is:inline
        id={termlyConsent.websiteUuid}
        src={termlyConsent.consentScriptUrl}
        data-name="termly-embed-banner"
      />
    )}
    {/* Immediately after the Termly blocker and before anything else — the blocker has to be
        parsed first to gate the container, and this is the highest position in the shared <head>
        that leaves that guarantee intact. One installation for every route that uses this
        layout; never repeat it on a page. */}
    <AnalyticsHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#122840" />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href={site.business.siteIconUrl}
    />
    <link rel="apple-touch-icon" href={site.business.siteIconUrl} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFontUrl}
      crossorigin
    />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={effectiveNoindex}
      schema={hiddenFromLaunch ? undefined : schema}
      structuredDataEnabled={!hiddenFromLaunch}
    />
  </head>
  <body id={contactKit ? "ac-contact-page" : detailedKit ? "ac-detailed" : extremeKit ? "ac-extreme" : traumaKit ? "ac-trauma" : hoardingKit ? "ac-hoarding" : estateKit ? "ac-estate" : homeKit ? "ac-home-locked-mockup" : undefined} class:list={{ "has-mobile-cta": showMobileCta, "ac-site": true, "ac-home": isHome }}>
    {/* ac-site (on this <body>) — docs/ASEPTACLEAN-DESIGN-SPEC.md §7/§12.4: the read-only DOM
        measurement helper requires a `.ac-site` root to exist. Added as a marker class alongside
        the site's existing layout classes rather than loading the spec's parallel CSS block
        globally (the same "reference, not a second global stylesheet" treatment AGENTS.md §1.1
        already gives docs/styles/website-reference.css) — see
        docs/ASEPTACLEAN-IMPLEMENTATION-MAP.md for the full class-to-class mapping. */}
    <AnalyticsNoscript />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {/* UTILITY RIBBON REMOVED 2026-09-04. doc 30 §2 targets a combined header stack of ~72px
        desktop / 64px mobile "accounting for any real utility bar"; the ribbon put the stack at
        99px, and reference page 23 shows a single white header bar with no utility row above it.
        It also rendered as an empty 28px navy strip below 30rem, because the rule that hid its
        spans outlived the phone link that used to sit beside them.

        Nothing factual is lost: the hours string still renders on /contact/ and in the
        LocalBusiness JSON-LD, and the service descriptor is the homepage hero eyebrow.
        StatusRibbon.astro is retained, unreferenced, rather than deleted — no route outside this
        redesign imports it, but it is the only carrier of that descriptor pattern. */}
    <slot name="header"><Header homepage={isHome} /></slot>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <slot name="footer"><Footer homepage={isHome} /></slot>
    {showMobileCta && <MobileCTA />}
    <Analytics />
  </body>
</html>

---
import Footer from "@components/Footer.astro";
import Analytics from "@components/Analytics.astro";
import Header from "@components/Header.astro";
import MobileCTA from "@components/MobileCTA.astro";
import SeoHead from "@components/SeoHead.astro";
import StatusRibbon from "@components/StatusRibbon.astro";
import { site } from "@data/site";
import "@styles/fonts.css";
import "@styles/global.css";
// One face as of the 2026-08-18 visual port. The display-serif and monospace preloads were
// removed with their @font-face rules — see src/styles/fonts.css.
import interFontUrl from "../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  showMobileCta?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  showMobileCta = true,
  schema
} = Astro.props;

const termlyConsent = site.integrations.termly;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {termlyConsent.consentEnabled && (
      <script
        is:inline
        id={termlyConsent.websiteUuid}
        src={termlyConsent.consentScriptUrl}
        data-name="termly-embed-banner"
      />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#122840" />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href={site.business.siteIconUrl}
    />
    <link rel="apple-touch-icon" href={site.business.siteIconUrl} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFontUrl}
      crossorigin
    />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      schema={schema}
    />
  </head>
  <body class:list={{ "has-mobile-cta": showMobileCta }}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <StatusRibbon />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {showMobileCta && <MobileCTA />}
    <Analytics />
  </body>
</html>

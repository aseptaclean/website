---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@data/site";

// Retired-WordPress route preserved at an identical URL (docs/19-SYSTEM-AND-SITEMAP.md
// redirect law): the old site's CCPA/data-request page had a working request mechanism
// that must not silently vanish under a generic redirect. No provider (Termly data
// request/DSAR form) is wired in this repo yet — see docs/04-RELEASE-CHECKLIST.md
// "DNS cutover blockers." This page intentionally shows an honest not-configured state
// rather than substitute legal/process text, matching the LegalPolicy.astro fallback
// pattern used by /privacy/, /terms/, and /cookie-policy/.
//
// noindex, follow — the provider-hosted DSAR form is not wired, but the route now presents a
// complete email-based request path instead of exposing an unfinished preview state. Keep it
// noindex until the provider workflow is configured and verified; then flip robots and the
// sitemap entry in the same change.
const contactEmail = site.business.privacyContact || site.business.email;

// A5 — BreadcrumbList. This route had none; every other non-root route on the site does, and a
// crumb trail is how a leaf page tells a crawler where it sits. The "Home" item uses
// `site.urls.home` (WITH the trailing slash) so it matches the homepage canonical exactly —
// `site.urls.site` is a bare origin and produced a second URL for the same page.
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "Data Request",
        item: new URL("/data-request/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Data Request | Aseptaclean"
  description="Submit a data access, correction, or deletion request to Aseptaclean."
  canonicalPath="/data-request/"
  schema={schema}
  noindex={true}
  showMobileCta={false}
>
  <div class="ac-measure-wide">
    <article class="data-request">
      <header class="data-request__header">
        <p class="ac-type-xs">Legal record</p>
        <h1 class="ac-type-h1">Data Request</h1>
        <p class="ac-type-lead">
          This page is reserved for Aseptaclean's data access, correction, and deletion
          request process.
        </p>
      </header>

      <section class="data-request__status" aria-labelledby="request-status">
        <p class="data-request__label">How to submit</p>
        <h2 id="request-status" class="ac-type-h2">Email a privacy request</h2>
        <p class="ac-type-body">
          Email Aseptaclean with your name, the email address or phone number connected to your
          interactions with the company, and whether you are requesting access, correction, or
          deletion. Do not include sensitive identification documents in the first message.
        </p>
        <p class="ac-type-body">
          Aseptaclean will reply with any identity-verification steps and the information needed
          to continue the request. The email link below opens a message with a descriptive subject.
        </p>
        <div class="data-request__actions">
          <a href={`mailto:${contactEmail}?subject=Privacy%20data%20request`}>Email a privacy data request</a>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  /* Mirrors LegalPolicy.astro — this route has no section wrapper of its own, so the article
     carries the mockup `.sec` rhythm (68px/60px) directly instead of the pre-port 96px/72px.
     Internal gap drops from 96px to 48px so it stays inside the section rhythm, and the
     viewport-coupled 55vh floor becomes a fixed 480px on the 8px scale. */
  .data-request {
    display: grid;
    gap: var(--ac-space-5);
    min-height: 480px;
    padding-block: 68px;
  }

  @media (max-width: 760px) {
    .data-request {
      padding-block: 60px;
    }
  }

  .data-request__header {
    max-width: 48rem;
    border-top: 3px solid var(--ac-color-navy-900);
    padding-top: var(--ac-space-5);
  }

  .data-request__header > p:first-child {
    margin: 0;
    color: var(--ac-color-navy-800);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-label-chip);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .data-request__header h1 {
    margin: var(--ac-space-3) 0 0;
  }

  .data-request__header > p:last-child {
    margin: var(--ac-space-4) 0 0;
  }

  .data-request__status {
    max-width: 48rem;
    border: 1px solid var(--ac-color-steel-300);
    padding: var(--ac-space-5);
    background: var(--ac-color-paper);
  }

  .data-request__label {
    margin: 0;
    color: var(--ac-color-navy-800);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-label-chip);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .data-request__status h2 {
    margin: var(--ac-space-3) 0 0;
  }

  .data-request__status p:last-of-type {
    margin: var(--ac-space-3) 0 0;
  }

  .data-request__actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--ac-space-3);
    margin-top: var(--ac-space-5);
  }

  .data-request__actions > a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
  }
</style>

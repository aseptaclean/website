---
// Hoarding public-service kit only. Campaign route and commercial offer remain separate.
import BaseLayout from '@layouts/BaseLayout.astro';
import AssignedPhoto from '@components/ac/AssignedPhoto.astro';
import hoardingHero from '../../assets/aseptaclean/public-pages/hoarding-service/01-hoarding-service-hero-assessment.webp';
import hoardingBedroom from '../../assets/aseptaclean/public-pages/hoarding-service/02-hoarding-service-full-bedroom.webp';
import hoardingPhotos from '../../assets/aseptaclean/public-pages/hoarding-service/03-hoarding-service-preserve-family-photos.webp';
import hoardingAssessment from '../../assets/aseptaclean/public-pages/hoarding-service/04-hoarding-service-access-assessment.webp';
import AcCompactForm from '@components/ac/AcCompactForm.astro';
import HoardingHeader from '@components/hoarding/HoardingHeader.astro';
import HoardingIcon from '@components/hoarding/HoardingIcon.astro';
import { site, legal } from '@data/site';
import '@styles/hoarding-service-kit.css';
import '@styles/hero-consistency.css';
import '@styles/assigned-photos.css';
const faq = [["Do I need to sort or clean before you arrive?", "No. Contact us with the property as it is. Tell us about items that must stay and any conditions you already know about. We\u2019ll discuss preparation after assessing the work."], ["Can you help clear a loved one\u2019s home?", "Yes. We help families, executors, trustees, and authorized property representatives with homes containing heavy accumulation. We establish who can approve the work and make decisions about the contents."], ["Will everything be thrown away?", "No. We follow the instructions established for the job. Belongings marked to keep or review are separated from contents approved for removal."], ["Can I manage the cleanup from out of town?", "Tell us who can provide access and how you need to receive updates. We\u2019ll discuss communication and approvals before confirming the arrangements for the job."], ["What if there are droppings, needles, or other contamination?", "Tell us about known conditions when you contact us. We assess the cleanup needed and explain what we can take on. Any proposed specialty cleanup has a separate scope and price."], ["How long does hoarding cleanup take?", "The amount of contents, sorting detail, access, and cleaning all affect the schedule. We provide an estimated timeline after assessing the property. Let us know early if you\u2019re working toward a deadline."], ["How do you price hoarding cleanup?", "We assess the property and the tasks you need completed. Your proposal identifies the work and price before you commit. You do not need to identify a hoarding level to request an assessment."]];
const schema = [
 { '@type':'Service', name:'Hoarding Cleanup in San Jose', serviceType:'Hoarding cleanup', provider:{'@id':new URL('/#business',site.urls.site).href}, areaServed:{'@type':'City',name:'San Jose'} },
 { '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.urls.home},{'@type':'ListItem',position:2,name:'Hoarding Cleanup',item:new URL('/hoarding-cleanup-san-jose/',site.urls.site).href}] },
 { '@type':'FAQPage', mainEntity:faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}})) }
];
---
<BaseLayout title="Hoarding Cleanup in San Jose | Aseptaclean" description="Hoarding cleanup in San Jose. Sorting, clearing approved contents, and cleaning with a written plan and price before work begins." canonicalPath="/hoarding-cleanup-san-jose/" schema={schema} showMobileCta={false} hoardingKit>
<HoardingHeader slot="header" />
<footer slot="footer"><div class="wrap"><div class="footergrid"><div><a class="brand" href="/"><img src={site.business.logoReversedUrl} width="900" height="215" alt="Aseptaclean" /></a><p>Specialized property cleanup.<br/>A clear path forward.</p><p><a href={site.business.phoneUri}>Call {site.business.phone}</a></p></div><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-9">Hoarding Cleanup</h3><div class="footlinks"><a href="#hoarding-scope">Cleanup Services</a><a href="#hoarding-belongings">Belongings &amp; Contents</a><a href="#hoarding-process">Our Process</a><a href="#hoarding-pricing">Your Quote</a></div></div><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-9">Get in Touch</h3><div class="footlinks"><a href="#hoarding-contact">Request an Assessment</a><a href="#hoarding-faq">Common Questions</a><a href={site.business.phoneUri}>Call {site.business.phone}</a></div></div><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-9">Serving</h3><div class="footlinks"><a href="#hoarding-area">South Bay</a><a href="#hoarding-area">Peninsula</a></div></div></div><div class="legal"><span>© 2026 Aseptaclean. All rights reserved.</span><div class="legal-links"><a href={site.urls.privacyPolicy}>Privacy Policy</a><a href={site.urls.terms}>Terms &amp; Conditions</a><a href={site.urls.cookiePolicy}>Cookie Policy</a><button class="termly-display-preferences" type="button">Cookie Preferences</button></div></div></div><div class="wrap legal-notes"><p data-nosnippet>{legal.scopeDisclaimer}</p><p data-nosnippet>Disposal and transport are handled by a City-authorized hauler engaged for the project.</p><p data-nosnippet>Aseptaclean may clean accepted conditions left behind after an appropriately licensed pest operator has confirmed the active pest issue is resolved. Aseptaclean does not inspect for, identify, exclude, trap, or treat pests.</p><p data-nosnippet>Cleaning only — not a decontamination, sterilization, or health-safety determination.</p></div></footer>

<section class="hero" id="hoarding-top"><AssignedPhoto src={hoardingHero} alt="Technician assessing a heavily cluttered living room." kind="hero" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">Hoarding Cleanup · South Bay &amp; Peninsula</p><h1 class="ac-type-hoarding-0 ac-type-hoarding-11">Take Back Your Space.<br>Leave The Cleanup To Us.</h1><p class="body">When belongings fill the rooms and getting started feels difficult, Aseptaclean can help. We sort the contents, clear approved items, and clean the areas included in your plan—with attention to what needs to stay.</p><div class="actions"><a class="action light" href="#hoarding-contact">Request an Assessment <HoardingIcon name="arrow-up-right" /></a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<div class="wrap"><div class="trust"><div><HoardingIcon name="clipboard-check" /><div><strong>Written Plan &amp; Price</strong><span>Review the work before you commit</span></div></div><div><HoardingIcon name="heart-handshake" /><div><strong>Respectful Service</strong><span>Your instructions guide the cleanup</span></div></div><div><HoardingIcon name="camera" /><div><strong>Documented Work</strong><span>Photos and records included as agreed</span></div></div></div></div>
<section class="section intro-wide-heading"><div class="wrap"><div class="intro-heading"><p class="eyebrow">For the person responsible</p><h2 class="ac-type-hoarding-1"><span class="ac-heading-line">A full home.</span> <span class="ac-heading-line">A lot on your shoulders.</span></h2></div><div class="split"><div><p>You may have inherited a home filled with belongings, discovered the extent of the accumulation after a loss, or become responsible for a property that needs clearing.</p><p>You don’t need to inspect every box or work out the entire job before contacting us. Tell us what you know, what needs attention, and anything you need to preserve.</p></div><div><AssignedPhoto src={hoardingBedroom} alt="Bedroom filled with accumulated clothes, boxes, and household belongings." /></div></div><ul class="checks intro-points"><li><HoardingIcon name="check" />Identify the rooms and areas that need work.</li><li><HoardingIcon name="check" />Discuss belongings and papers that need review.</li><li><HoardingIcon name="check" />Tell us about access limits and any deadline.</li></ul></div></section>
<section class="section warm" id="hoarding-scope"><div class="wrap"><div class="section-top"><div><p class="eyebrow">Hoarding cleanup services</p><h2 class="ac-type-hoarding-1">Sort the contents. Clear the way forward.</h2></div><p>A heavily filled home can need sorting, clearing, and substantial cleaning. We assess the property and explain which tasks belong in your cleanup.</p></div><div class="scope-grid">
<div class="scope-item"><HoardingIcon name="tags" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Sorting &amp; Separation</h3><p>Sort belongings into what stays, what can be removed, and what needs a decision.</p></div></div>
<div class="scope-item"><HoardingIcon name="package-open" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Contents Removal</h3><p>Clear approved belongings, debris, and unwanted contents from the rooms and areas in your plan.</p></div></div>
<div class="scope-item"><HoardingIcon name="folder-heart" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Important Items &amp; Papers</h3><p>Look for the belongings you identify within the agreed sorting areas. Set identified keepsakes, photos, and papers aside for review.</p></div></div>
<div class="scope-item"><HoardingIcon name="clipboard-list" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Inventory &amp; Photos</h3><p>Record selected belongings and the work completed, with the level of detail set out in your proposal.</p></div></div>
<div class="scope-item"><HoardingIcon name="truck" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Disposal Coordination</h3><p>Confirm disposal arrangements for the approved contents before clearing starts.</p></div></div>
<div class="scope-item"><HoardingIcon name="sparkles" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-10">Cleaning After Removal</h3><p>Clean the agreed rooms and surfaces after contents are cleared. Contamination cleanup is assessed separately.</p></div></div>
</div></div></section>
<section class="section" id="hoarding-belongings"><div class="wrap"><div class="full-section-heading"><p class="eyebrow">Your belongings matter</p><h2 class="ac-type-hoarding-1"><span class="ac-heading-line">Keep what matters.</span> <span class="ac-heading-line">Decide what goes.</span></h2></div><div class="split"><div><p>Important belongings can be mixed in with everyday contents. Tell us about family photos, documents, keepsakes, and anything specific you want us to look for.</p><p>Before sorting starts, we establish what can be removed and what needs review. Instructions come from the person authorized to make those decisions.</p></div><div class="assigned-photo-frame"><AssignedPhoto src={hoardingPhotos} alt="Black-gloved hands placing family photographs into a large manila envelope." kind="fill" /><div class="image-note">Your instructions guide the work.<small>No guessing about what matters to you.</small></div></div></div><div class="audience belongings-steps"><div><HoardingIcon name="search" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-4">Identify what must stay</h3><p>Describe important belongings, papers, and areas that should be left alone.</p></div></div><div><HoardingIcon name="tags" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-4">Agree on the next step</h3><p>Separate items approved for removal from those being kept or awaiting a decision.</p></div></div><div><HoardingIcon name="clipboard-check" /><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-4">Put the scope in writing</h3><p>Record the work, handling instructions, and who can approve changes.</p></div></div></div></div></section>
<section class="band"><div class="wrap"><div><h2 class="ac-type-hoarding-1 ac-type-hoarding-5">You don’t need all the answers.</h2><p>Tell us which areas are filled, whether you can move through the property, and what you need help getting done.</p></div><a class="action light" href="#hoarding-contact">Request an Assessment <HoardingIcon name="arrow-right" /></a></div></section>
<section class="section warm before-work"><div class="wrap"><div class="full-section-heading"><p class="eyebrow">Before work begins</p><h2 class="ac-type-hoarding-1"><span class="ac-heading-line">Know the work.</span> <span class="ac-heading-line">Know the price.</span></h2></div><div class="split"><div><p>We look at the contents, access, sorting needs, and visible property conditions. You receive a written description of the work and its price before deciding to proceed.</p><p>If clearing exposes something that changes the job, we explain the finding and any proposed additional work before you approve it.</p></div><AssignedPhoto src={hoardingAssessment} alt="Technician documenting access through a cluttered hallway on a tablet." class="assigned-photo--wide" /></div><div class="boundaries"><div><h3 class="ac-type-hoarding-2">Included in your cleanup plan</h3><p>The areas to clear, belongings to sort or preserve, disposal arrangements, cleaning tasks, and records included in the job.</p></div><div><h3 class="ac-type-hoarding-2">Additional work, clearly separated</h3><p>Rodent waste, blood, or other contamination may require specialty cleanup with a separate scope and price. Repairs and pest control are outside the cleanout service.</p></div></div><p class="scope-note" data-nosnippet>{legal.documentationDisclaimer}</p></div></section>
<section class="section" id="hoarding-process"><div class="wrap"><p class="eyebrow">Our process</p><h2 class="ac-type-hoarding-1">A clear plan from first call to finish.</h2><div class="steps"><div class="step"><b>01</b><h3 class="ac-type-hoarding-2 ac-type-hoarding-6">Tell Us About the Home</h3><p>Share the location, what you know about the conditions, and what needs to happen.</p></div><div class="step"><b>02</b><h3 class="ac-type-hoarding-2 ac-type-hoarding-6">Review Your Plan</h3><p>Review the sorting, clearing, cleaning, expected schedule, and written price.</p></div><div class="step"><b>03</b><h3 class="ac-type-hoarding-2 ac-type-hoarding-6">We Complete the Work</h3><p>We follow the approved instructions and bring decisions needing your attention back to you.</p></div><div class="step"><b>04</b><h3 class="ac-type-hoarding-2 ac-type-hoarding-6">Review &amp; Document</h3><p>Review the completed work and receive the photos and records included in your plan.</p></div></div></div></section>
<section class="section warm" id="hoarding-pricing"><div class="wrap"><div class="section-top"><div><p class="eyebrow">Your cleanup quote</p><h2 class="ac-type-hoarding-1">A plan for your home. A price you can review.</h2></div><p>Two homes of the same size can require very different work. The amount of belongings and how carefully they need to be sorted both affect the job.</p></div><div class="boundaries"><div><h3 class="ac-type-hoarding-2">What shapes your quote</h3><p>Contents volume, sorting time, stairs, carrying distance, disposal, cleaning, and inventory detail. Tell us about limited parking or a deadline during the assessment.</p></div><div><h3 class="ac-type-hoarding-2">What your written plan includes</h3><p>The tasks and areas included in the price, the disposal arrangements, and any work priced separately. You can review the proposal and ask questions before deciding.</p></div></div><div class="actions"><a class="action" href="#hoarding-contact">Request an Assessment</a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></section>
<section class="section" id="hoarding-faq"><div class="wrap faq-layout"><div class="faq-heading"><p class="eyebrow">Common questions</p><h2 class="ac-type-hoarding-1">A few things you may be wondering.</h2></div><div class="faq-list">
<details open=""><summary>Do I need to sort or clean before you arrive?</summary><p>No. Contact us with the property as it is. Tell us about items that must stay and any conditions you already know about. We’ll discuss preparation after assessing the work.</p></details>
<details><summary>Can you help clear a loved one’s home?</summary><p>Yes. We help families, executors, trustees, and authorized property representatives with homes containing heavy accumulation. We establish who can approve the work and make decisions about the contents.</p></details>
<details><summary>Will everything be thrown away?</summary><p>No. We follow the instructions established for the job. Belongings marked to keep or review are separated from contents approved for removal.</p></details>
<details><summary>Can I manage the cleanup from out of town?</summary><p>Tell us who can provide access and how you need to receive updates. We’ll discuss communication and approvals before confirming the arrangements for the job.</p></details>
<details><summary>What if there are droppings, needles, or other contamination?</summary><p>Tell us about known conditions when you contact us. We assess the cleanup needed and explain what we can take on. Any proposed specialty cleanup has a separate scope and price.</p></details>
<details><summary>How long does hoarding cleanup take?</summary><p>The amount of contents, sorting detail, access, and cleaning all affect the schedule. We provide an estimated timeline after assessing the property. Let us know early if you’re working toward a deadline.</p></details>
<details><summary>How do you price hoarding cleanup?</summary><p>We assess the property and the tasks you need completed. Your proposal identifies the work and price before you commit. You do not need to identify a hoarding level to request an assessment.</p></details>
</div><div class="faq-contact"><p>Have a question about the property? Let’s talk it through.</p><div class="actions"><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<section class="section warm" id="hoarding-area"><div class="wrap coverage"><div><p class="eyebrow">Service area</p><h2 class="ac-type-hoarding-1">South Bay<br>&amp; Peninsula.</h2><p>Hoarding cleanup for families, executors, trustees, and property managers in Santa Clara County and San Mateo County. Share the property’s location to confirm availability.</p></div><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-7">Santa Clara County</h3><ul><li>Campbell</li><li>Cupertino</li><li>Gilroy</li><li>Los Altos</li><li>Los Altos Hills</li><li>Los Gatos</li><li>Milpitas</li><li>Monte Sereno</li><li>Morgan Hill</li><li>Mountain View</li><li>Palo Alto</li><li>San Jose</li><li>Santa Clara</li><li>Saratoga</li><li>Sunnyvale</li></ul></div><div><h3 class="ac-type-hoarding-2 ac-type-hoarding-7">San Mateo County</h3><ul><li>Atherton</li><li>Belmont</li><li>Brisbane</li><li>Burlingame</li><li>Colma</li><li>Daly City</li><li>East Palo Alto</li><li>Foster City</li><li>Half Moon Bay</li><li>Hillsborough</li><li>Menlo Park</li><li>Millbrae</li><li>Pacifica</li><li>Portola Valley</li><li>Redwood City</li><li>San Bruno</li><li>San Carlos</li><li>San Mateo</li><li>Woodside</li></ul></div></div></section>
<section class="quiet"><div class="wrap"><div><h2 class="ac-type-hoarding-1 ac-type-hoarding-8">Let’s make a plan for your property.</h2><p>Tell us what needs clearing, what matters to you, and any deadline. We’ll help you understand the work involved.</p></div><a class="action" href="#hoarding-contact">Request an Assessment</a></div></section>
<section class="section" id="hoarding-contact"><div class="wrap"><div class="formwrap"><p class="eyebrow">Contact Aseptaclean</p><h2 id="hoarding-form-title" class="center ac-type-hoarding-1">Tell us what needs cleanup.</h2><p>Describe the rooms or areas that need attention. Include anything you know about access, property conditions, or belongings to preserve.</p><AcCompactForm formId="service-form" entryRoute="/hoarding-cleanup-san-jose/#service-form" preselectRoute="/hoarding-cleanup-san-jose/" tone="light" headingId="hoarding-form-title" kit hoardingKit /></div></div></section>

</BaseLayout>
<script>
const root=document.getElementById('ac-hoarding');
root?.querySelectorAll<HTMLAnchorElement>('a[href="#hoarding-contact"]').forEach(link=>link.addEventListener('click',(event)=>{event.preventDefault();document.getElementById('hoarding-contact')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});document.querySelector<HTMLInputElement>('#service-form-name')?.focus({preventScroll:true});}));
</script>

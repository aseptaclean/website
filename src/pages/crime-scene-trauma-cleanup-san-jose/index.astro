---
// Approved trauma public-service fragment, installed 2026-09-19. No campaign offer.
import BaseLayout from '@layouts/BaseLayout.astro';
import AssignedPhoto from '@components/ac/AssignedPhoto.astro';
import traumaHero from '../../assets/aseptaclean/public-pages/trauma-service/01-trauma-service-closed-containment-clear-poly.webp';
import AcCompactForm from '@components/ac/AcCompactForm.astro';
import TraumaHeader from '@components/trauma/TraumaHeader.astro';
import TraumaIcon from '@components/trauma/TraumaIcon.astro';
import { site, legal } from '@data/site';
import { findServicePage } from '@data/servicePageCopy';
import '@styles/trauma-service-kit.css';
import '@styles/hero-consistency.css';
import '@styles/assigned-photos.css';
const page = findServicePage('/crime-scene-trauma-cleanup-san-jose/')!;
const faq = [["When can cleanup begin?", "Call to discuss the property and our availability. Before work begins, we confirm access and authorization. If authorities are involved, the scene must be released first."], ["What types of incidents do you clean?", "We assess cleanup involving blood and bodily fluids after crime scenes, suicides, unattended deaths, accidents, and injuries. Tell us the general situation so we can confirm whether we can help."], ["Will everything need to be thrown away?", "Not necessarily. The material, condition, and extent of contamination affect what can be cleaned. Tell us about important belongings. We explain proposed removal before the authorized person approves it."], ["Can you help with insurance documentation?", "We can provide your written scope, invoice, and the work records included in the job. Ask your insurer what it requires and whether your policy covers the cleanup. Providing records does not guarantee payment."], ["How much does trauma cleanup cost?", "The affected surfaces, extent of contamination, access, and materials requiring removal all affect the price. We assess the work and provide a written proposal before you decide to proceed."], ["Do I need to send photos?", "No. A brief description is enough for first contact. If photos would help, we can discuss them with you. You do not need to enter the affected area or take graphic photos to request help."]];
const schema = [
 {'@type':'Service',name:page.name,serviceType:page.name,description:page.seoDescription,url:new URL(page.slug,site.urls.site).href,provider:{'@id':new URL('/#business',site.urls.site).href},areaServed:site.location.cities.map(name=>({'@type':'City',name}))},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.urls.home},{'@type':'ListItem',position:2,name:'Crime Scene & Trauma Cleanup',item:new URL(page.slug,site.urls.site).href}]},
 {'@type':'FAQPage',mainEntity:faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
];
---
<BaseLayout title={page.seoTitle} description={page.seoDescription} canonicalPath={page.slug} schema={schema} showMobileCta={false} traumaKit>
<TraumaHeader slot="header" />
<footer slot="footer"><div class="wrap"><div class="footergrid"><div><a class="brand" href="/"><img src={site.business.logoReversedUrl} width="900" height="215" alt="Aseptaclean" /></a><p>Specialized property cleanup.<br>A clear path forward.</p><p><a href={site.business.phoneUri}>Call {site.business.phone}</a></p><p>Available 7 AM–7 PM</p></div><div><h3 class="ac-type-trauma-2 ac-type-trauma-9">Trauma &amp; Crime Scene</h3><div class="footlinks"><a href="#trauma-scope">Cleanup Services</a><a href="#trauma-belongings">Belongings &amp; Contents</a><a href="#trauma-process">Our Process</a><a href="#trauma-faq">Common Questions</a></div></div><div><h3 class="ac-type-trauma-2 ac-type-trauma-9">Get in Touch</h3><div class="footlinks"><a href="#trauma-contact">Request an Assessment</a><a href="#trauma-area">Service Area</a><a href={site.business.phoneUri}>Call {site.business.phone}</a></div></div><div><h3 class="ac-type-trauma-2 ac-type-trauma-9">Serving</h3><div class="footlinks"><a href="#trauma-area">South Bay</a><a href="#trauma-area">Peninsula</a></div></div></div><div class="legal"><span>© 2026 Aseptaclean. All rights reserved.</span><div class="legal-links"><a href={site.urls.privacyPolicy}>Privacy Policy</a><a href={site.urls.terms}>Terms &amp; Conditions</a><a href={site.urls.cookiePolicy}>Cookie Policy</a><button class="termly-display-preferences" type="button">Cookie Preferences</button></div></div></div><div class="wrap legal-notes"><p data-nosnippet>{legal.scopeDisclaimer}</p><p data-nosnippet>Disposal and transport are handled by a City-authorized hauler engaged for the project.</p><p data-nosnippet>Cleaning only — not a decontamination, sterilization, or health-safety determination.</p></div></footer>

<section class="hero" id="trauma-top"><AssignedPhoto src={traumaHero} alt="Closed containment doorway with clear polyethylene floor protection." kind="hero" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">Trauma &amp; Crime Scene Cleanup</p><h1 class="ac-type-trauma-0"><span class="ac-heading-line">Trauma &amp; Crime Scene Cleanup.</span> <span class="ac-heading-line">Care Comes First.</span></h1><p class="body">Cleanup of blood, bodily fluids, and affected materials after a death, injury, or traumatic event. Tell us what you know. We’ll explain what the cleanup involves and how to arrange it.</p><div class="actions"><a class="action light" href="#trauma-contact">Request an Assessment <TraumaIcon name="arrow-up-right" /></a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<div class="wrap"><div class="trust"><div><TraumaIcon name="clipboard-check" /><div><strong>CDPH Registered</strong><span>Trauma Scene Waste · TSW 933</span></div></div><div><TraumaIcon name="user-round-check" /><div><strong>Written Plan &amp; Price</strong><span>Review the work before it starts</span></div></div><div><TraumaIcon name="house" /><div><strong>Documented Work</strong><span>Records included in your scope</span></div></div></div></div>
<section class="section" id="trauma-scope"><div class="wrap"><div class="section-top"><div><p class="eyebrow">When you need help</p><h2 class="ac-type-trauma-1">Specialized cleanup after a difficult event.</h2></div><p>For families, property owners, and managers responsible for a property affected by blood or bodily fluids. We assess the situation before confirming the work.</p></div><div class="scope-grid">
<div class="scope-item"><TraumaIcon name="shield-check" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Crime Scene Cleanup</h3><p>Cleanup of affected areas after law enforcement has released the scene.</p></div></div>
<div class="scope-item"><TraumaIcon name="house" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Unattended Death Cleanup</h3><p>Assessment and cleanup of affected rooms, surfaces, and materials after a death goes undiscovered.</p></div></div>
<div class="scope-item"><TraumaIcon name="heart-handshake" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Suicide Cleanup</h3><p>Cleanup of affected areas, with belongings and removal decisions reviewed with the authorized contact.</p></div></div>
<div class="scope-item"><TraumaIcon name="droplets" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Blood &amp; Bodily Fluids</h3><p>Removal of contamination, cleaning, and disinfection of surfaces that can be treated.</p></div></div>
<div class="scope-item"><TraumaIcon name="briefcase-medical" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Accidents &amp; Injuries</h3><p>Cleanup following an injury or medical event involving blood or bodily fluids.</p></div></div>
<div class="scope-item"><TraumaIcon name="package-open" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-10">Affected Belongings</h3><p>Review of furniture, personal items, and other contents before proposed cleaning or removal.</p></div></div>
</div></div></section>
<section class="section warm care-section"><div class="wrap"><div class="wide-heading"><p class="eyebrow">Care beyond the cleanup</p><h2 class="ac-type-trauma-1"><span class="ac-heading-line">You do not</span> <span class="ac-heading-line">have to handle this alone.</span></h2></div><div class="split"><div><p>You may be arranging access, answering calls, or helping family members while deciding what to do with the property.</p><p>Start with its location and a brief description. We’ll ask whether authorities have released the scene, who can approve the work, and how to reach that person. You do not need to clean or prepare the affected area before contacting us.</p><div class="actions"><a class="action" href="#trauma-contact">Request an Assessment <TraumaIcon name="arrow-right" /></a></div></div><div><div aria-label="Close-up of a cleanup professional documenting work on a tablet" class="photo p1" role="img"></div></div></div><ul class="checks"><li><TraumaIcon name="check" />Establish one contact for questions and approvals.</li><li><TraumaIcon name="check" />Discuss belongings that need individual attention.</li><li><TraumaIcon name="check" />Review the work and price before cleanup begins.</li></ul></div></section>
<section class="section" id="trauma-belongings">
<div class="wrap">
<div class="wide-heading"><p class="eyebrow">Your belongings matter</p><h2 class="ac-type-trauma-1"><span class="ac-heading-line">Personal belongings</span> <span class="ac-heading-line">deserve careful decisions.</span></h2></div><div class="split">
<div><p>A piece of furniture, a photograph, or a personal item may matter to someone in the family. Tell us about anything you want us to pay particular attention to.</p><p>The material and extent of contamination affect what can be cleaned. We explain proposed cleaning or removal to the authorized decision-maker before proceeding.</p></div>
<div aria-label="Property owner and cleanup professional reviewing a plan" class="photo p2" role="img"><div class="image-note">Your property. Your decisions.<small>Review proposed removal before work starts.</small></div></div>
</div>
<div class="audience belongings-steps">
<div><TraumaIcon name="package-check" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-4">Review affected items</h3><p>Identify important belongings and assess their condition.</p></div></div>
<div><TraumaIcon name="messages-square" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-4">Agree on what happens</h3><p>Review which items are included in cleaning and which are proposed for removal.</p></div></div>
<div><TraumaIcon name="clipboard-list" /><div><h3 class="ac-type-trauma-2 ac-type-trauma-4">Record the decisions</h3><p>Include handling instructions and approved removal in the written scope.</p></div></div>
</div>
</div>
</section>
<section class="band"><div class="wrap"><div><h2 class="ac-type-trauma-1 ac-type-trauma-5">Not sure what to do next?</h2><p>Tell us the property’s location and the kind of help you need. A brief description is enough to begin the conversation.</p></div><a class="action light" href="#trauma-contact">Request an Assessment <TraumaIcon name="arrow-right" /></a></div></section>
<section class="section" id="trauma-process"><div class="wrap"><p class="eyebrow">Our process</p><h2 class="ac-type-trauma-1">A clear plan from first call to finish.</h2><div class="steps"><div class="step"><b>01</b><h3 class="ac-type-trauma-2 ac-type-trauma-6">Tell Us What You Need</h3><p>Share the location and general situation. We’ll discuss scene release, access, and who can authorize the cleanup.</p></div><div class="step"><b>02</b><h3 class="ac-type-trauma-2 ac-type-trauma-6">Review the Plan</h3><p>We assess the affected areas and explain the work, proposed removal, and written price.</p></div><div class="step"><b>03</b><h3 class="ac-type-trauma-2 ac-type-trauma-6">Complete the Cleanup</h3><p>We remove approved affected materials, clean the area, and disinfect surfaces that can be treated.</p></div><div class="step"><b>04</b><h3 class="ac-type-trauma-2 ac-type-trauma-6">Review &amp; Document</h3><p>Review the completed work, receive the records included in your scope, and discuss any remaining property needs.</p></div></div></div></section>
<section class="section warm before-work"><div class="wrap">
<div class="wide-heading"><p class="eyebrow">Before work begins</p><h2 class="ac-type-trauma-1"><span class="ac-heading-line">A written scope.</span> <span class="ac-heading-line">Clear expectations.</span></h2></div><div class="split">
<div><p>The surfaces involved, extent of contamination, access, and materials requiring removal affect the work and price. We assess these details before you commit to the cleanup.</p><p>If we uncover something that changes the job, we explain the finding and proposed additional cost before you approve it.</p><div class="actions"><a class="action" href="#trauma-contact">Request an Assessment</a></div></div>
<div aria-label="Technician documenting property cleanup" class="photo p1" role="img"></div>
</div>
<div class="boundaries"><div><h3 class="ac-type-trauma-2">Before We Begin</h3><p>We confirm access and authorization with the person responsible for the property. When authorities are involved, cleanup begins after they release the scene.</p></div><div><h3 class="ac-type-trauma-2">Cleanup &amp; Follow-Up Work</h3><p>Your proposal identifies the cleaning, disinfection, and approved materials removal. Repairs and replacement of flooring, finishes, or other building materials require a separate provider.</p></div></div>
<p class="scope-note" data-nosnippet>{legal.documentationDisclaimer}</p></div></section>
<section class="section" id="trauma-faq"><div class="wrap faq-layout"><div class="faq-heading"><p class="eyebrow">Common questions</p><h2 class="ac-type-trauma-1">A few things you may be wondering.</h2></div><div class="faq-list">
<details open=""><summary>When can cleanup begin?</summary><p>Call to discuss the property and our availability. Before work begins, we confirm access and authorization. If authorities are involved, the scene must be released first.</p></details>
<details><summary>What types of incidents do you clean?</summary><p>We assess cleanup involving blood and bodily fluids after crime scenes, suicides, unattended deaths, accidents, and injuries. Tell us the general situation so we can confirm whether we can help.</p></details>
<details><summary>Will everything need to be thrown away?</summary><p>Not necessarily. The material, condition, and extent of contamination affect what can be cleaned. Tell us about important belongings. We explain proposed removal before the authorized person approves it.</p></details>
<details><summary>Can you help with insurance documentation?</summary><p>We can provide your written scope, invoice, and the work records included in the job. Ask your insurer what it requires and whether your policy covers the cleanup. Providing records does not guarantee payment.</p></details>
<details><summary>How much does trauma cleanup cost?</summary><p>The affected surfaces, extent of contamination, access, and materials requiring removal all affect the price. We assess the work and provide a written proposal before you decide to proceed.</p></details>
<details><summary>Do I need to send photos?</summary><p>No. A brief description is enough for first contact. If photos would help, we can discuss them with you. You do not need to enter the affected area or take graphic photos to request help.</p></details>
</div><div class="faq-contact"><p>Have a question about arranging cleanup? Call us to discuss it.</p><div class="actions"><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<section class="section warm" id="trauma-area"><div class="wrap coverage"><div><p class="eyebrow">Trauma and crime scene cleanup in Santa Clara County and San Mateo County. Share the property’s location and situation so we can confirm availability.</p><h2 class="ac-type-trauma-1">South Bay<br>&amp; Peninsula.</h2><p>Trauma and crime scene cleanup for families, property owners, and property managers.</p></div><div><h3 class="ac-type-trauma-2 ac-type-trauma-7">Santa Clara County</h3><ul><li>Campbell</li><li>Cupertino</li><li>Gilroy</li><li>Los Altos</li><li>Los Altos Hills</li><li>Los Gatos</li><li>Milpitas</li><li>Monte Sereno</li><li>Morgan Hill</li><li>Mountain View</li><li>Palo Alto</li><li>San Jose</li><li>Santa Clara</li><li>Saratoga</li><li>Sunnyvale</li></ul></div><div><h3 class="ac-type-trauma-2 ac-type-trauma-7">San Mateo County</h3><ul><li>Atherton</li><li>Belmont</li><li>Brisbane</li><li>Burlingame</li><li>Colma</li><li>Daly City</li><li>East Palo Alto</li><li>Foster City</li><li>Half Moon Bay</li><li>Hillsborough</li><li>Menlo Park</li><li>Millbrae</li><li>Pacifica</li><li>Portola Valley</li><li>Redwood City</li><li>San Bruno</li><li>San Carlos</li><li>San Mateo</li><li>Woodside</li></ul></div></div></section>
<section class="quiet"><div class="wrap"><div><h2 class="ac-type-trauma-1 ac-type-trauma-8">Let us help with the next step.</h2><p>Call or request an assessment to discuss the property, access, and cleanup needed.</p></div><a class="action" href="#trauma-contact">Request an Assessment</a></div></section>
<section class="section" id="trauma-contact"><div class="wrap"><div class="formwrap"><p class="eyebrow">Contact Aseptaclean</p><h2 id="trauma-form-title" class="center ac-type-trauma-1">Tell us how we can help.</h2><p>Share the property’s location and a brief description. If you know whether authorities have released the scene, include that too. Graphic details and photos are not required.</p><AcCompactForm formId="service-form" entryRoute="/crime-scene-trauma-cleanup-san-jose/#service-form" preselectRoute="/crime-scene-trauma-cleanup-san-jose/" tone="light" headingId="trauma-form-title" kit traumaKit /></div></div></section>

</BaseLayout>
<script>
const root=document.getElementById('ac-trauma');
root?.querySelectorAll<HTMLAnchorElement>('a[href="#trauma-contact"]').forEach(link=>link.addEventListener('click',(event)=>{event.preventDefault();document.getElementById('trauma-contact')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});document.querySelector<HTMLInputElement>('#service-form-name')?.focus({preventScroll:true});}));
</script>

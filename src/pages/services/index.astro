---
// Chunk 3 of the nested-hub-layer IA expansion (owner-approved plan, 2026-08-11): this page
// shipped as an unpublished noindex draft in Chunk 1 and is now a real, linked, indexable
// page — linked from primary nav and the footer, included in sitemap.xml.ts. Hybrid IA
// decision: this hub sits ABOVE the existing flat service-page URLs without migrating or
// 301-ing them — every pillar card below links straight to an existing flat page (e.g.
// /hoarding-cleanup-san-jose/), never to a not-yet-built nested child route. No dropdown/
// submenu — flat nav entry only (owner decision, see src/data/site.ts). No biohazard pillar
// or link exists anywhere on this page, per the standing owner directive
// (docs/05-DECISIONS-LOG.md, docs/19-SYSTEM-AND-SITEMAP.md Part 2.1 Phase 5, docs/90) — this
// is out of scope in any form.
//
// DIFFERENTIATION: this is a hub/directory page, not a buyer-decision service page — same
// class as /service-areas/ (no Track A/B split, no FAQ, no proof section, no pricing). Its
// three pillar cards reuse copy verbatim from site.ts's already-approved homepage.serviceCards
// (docs/18-VISUAL-DIRECTION.md §6 row 3) so no new claim is introduced by this page.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import RequestForm from "@components/RequestForm.astro";
import { servicesHub } from "@data/servicePages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: new URL(servicesHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Services | Aseptaclean"
  description="Property clearing, animal and organic condition cleaning, and reset cleaning — every project starts with one written scope. San Jose & the South Bay."
  canonicalPath={servicesHub.slug}
  noindex={false}
  schema={schema}
>
  <PageHeader
    headingId="services-title"
    eyebrow="Services"
    h1={"What Aseptaclean handles"}
    lede={servicesHub.intro}
    crumb="Services"
  />

  <section class="pillars" aria-labelledby="pillars-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">By category</p>
      <h2 id="pillars-title" class="ac-type-h2 pillars__heading">Three kinds of work, one signed scope</h2>
      <div class="pillars__grid">
        {
          servicesHub.pillars.map((pillar) => (
            <div class="pillar-card">
              <h3 class="ac-type-h3">{pillar.title}</h3>
              <p class="pillar-card__detail">{pillar.detail}</p>
              <ul class="pillar-card__links">
                {pillar.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label} →</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .pillars {
    background: var(--ac-color-paper);
  }

  .pillars__heading {
    max-width: 36ch;
    margin-top: var(--ac-space-3);
  }

  .pillars__grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .pillar-card {
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
  }

  .pillar-card h3 {
    margin-bottom: 8px;
  }

  .pillar-card__detail {
    max-width: 44ch;
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }

  .pillar-card__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: var(--ac-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .pillar-card__links a {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .pillar-card__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 40rem) {
    .pillars__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

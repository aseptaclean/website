---
// Homepage-only kit v1.2. Wording: kit/01-APPROVED-COPY.md; visual: reference/home-preview.html.
import BaseLayout from "@layouts/BaseLayout.astro";
import AcCompactForm from "@components/ac/AcCompactForm.astro";
import HomeHeader from "@components/home/HomeHeader.astro";
import HomeFooter from "@components/home/HomeFooter.astro";
import HomeIcon from "@components/home/HomeIcon.astro";
import AssignedPhoto from "@components/ac/AssignedPhoto.astro";
import { homeKitServices } from "@data/homeKit";
import { site } from "@data/site";
import homeHero from "../assets/aseptaclean/public-pages/home/01-home-hero-garage-cleanup.webp";
import homeWhy from "../assets/aseptaclean/public-pages/home/02-home-why-aseptaclean-tablet.webp";
import homeWho from "../assets/aseptaclean/public-pages/home/03-home-who-we-help-walkthrough.webp";
import "@styles/home-kit.css";
import "@styles/hero-consistency.css";
import "@styles/assigned-photos.css";
const existingSchemaDescriptions = [
  "Structured cleanup for hoarding conditions, with care for your belongings.",
  "Detailed cleaning for heavily soiled and neglected properties.",
  "Focused cleaning of buildup, edges, and hard-to-reach surfaces.",
  "Discreet cleanup after a crime scene or traumatic event.",
  "Cleaning of accepted residual waste after active pest issues are resolved.",
  "Careful sorting, approved removal, and cleaning of estate contents."
];
const schema = homeKitServices.map((card, index) => ({
  "@type": "Service", serviceType: card.label, description: existingSchemaDescriptions[index],
  url: new URL(card.href, site.urls.site).href,
  provider: { "@id": new URL("/#business", site.urls.site).href },
  areaServed: site.location.cities.map(name => ({ "@type": "City", name }))
}));
---
<BaseLayout title="Aseptaclean | Biohazard Remediation & Specialty Property Cleanup"
 description="Aseptaclean provides biohazard remediation and specialty property cleanup in San Jose and surrounding areas, including trauma, hoarding, and rodent waste cleanup."
 canonicalPath="/" schema={schema} showMobileCta={false} homeKit>
 <HomeHeader slot="header" />
 <HomeFooter slot="footer" />

<section class="hero" id="hero"><span id="ac-top" class="legacy-anchor" aria-hidden="true"></span><AssignedPhoto src={homeHero} alt="Protective-clothed technician cleaning a garage workbench." kind="hero" position="center 58%" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">ASEPTACLEAN · SOUTH BAY &amp; PENINSULA</p><h1 class="ac-type-home-h1"><span class="ac-heading-line">Specialized Property Cleanup.</span> <span class="ac-heading-line">A Clear Path Forward.</span></h1><p class="body">Biohazard remediation, estate cleanouts, and specialty cleaning for homes and businesses. Tell us what needs attention. We’ll explain how we can help.</p><div class="actions"><a class="action light" href="#home-contact">Request an Assessment <HomeIcon name="arrow-up-right" /></a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<div class="wrap"><div class="trust"><div><HomeIcon name="shield-check" /><div><strong>CDPH Registered</strong><span>Trauma Scene Waste · TSW 933</span></div></div><div><HomeIcon name="user-round-check" /><div><strong>Owner-Operated</strong><span>Speak directly with the owner</span></div></div><div><HomeIcon name="clipboard-check" /><div><strong>Written Plan &amp; Price</strong><span>Review the work before it starts</span></div></div></div></div>
<section class="section" id="ac-why"><span id="why" class="legacy-anchor" aria-hidden="true"></span><div class="wrap why-layout"><div class="why-heading"><p class="eyebrow">Why Aseptaclean</p><h2 class="ac-type-home-h2"><span class="ac-heading-line">Careful Work.</span> <span class="ac-heading-line">Clear Steps.</span></h2></div><div class="why-copy"><p>Before founding Aseptaclean, Matthew Ruiz worked in surgical pathology at Stanford Health Care and pharmaceutical manufacturing at BioMarin. His work required careful handling, contamination control, and accurate records.</p><p>He brings those habits to Aseptaclean: follow written steps, pay attention to what is being handled, and document the work.</p></div><AssignedPhoto src={homeWhy} alt="Black-gloved professional reviewing a property assessment on a tablet." class="why-photo" position="center 54%" /><ul class="checks why-points"><li><HomeIcon name="check" /><span><strong>Careful handling:</strong> Discuss your belongings and what needs to stay, go, or be reviewed.</span></li><li><HomeIcon name="check" /><span><strong>Clear steps:</strong> Review the cleanup plan and price before work begins.</span></li><li><HomeIcon name="check" /><span><strong>Written records:</strong> Receive the agreed documentation of the completed work.</span></li></ul><div class="actions why-action"><a class="action" href="#home-contact">Request an Assessment <HomeIcon name="arrow-right" /></a></div></div></section>
<section class="section warm" id="ac-services"><span id="services" class="legacy-anchor" aria-hidden="true"></span><div class="wrap"><div class="section-top"><div><p class="eyebrow">Our services</p><h2 class="ac-type-home-h2">Specialized help for your property.</h2></div><p>Find help for the condition you’re facing, from a single room to a full property cleanout.</p></div><div class="services">{homeKitServices.map(service => (
  <a class="tile" href={service.href}>
    {service.image && service.imageAlt
      ? <AssignedPhoto src={service.image} alt={service.imageAlt} kind="card" />
      : <div class:list={["photo", service.photo]} aria-hidden="true"></div>}
    <div class="label"><h3 class="ac-type-home-h3 ac-type-home-card">{service.label}<HomeIcon name="arrow-up-right" /></h3><p>{service.description}</p></div>
  </a>
))}</div></div></section>
<section class="section" id="ac-who"><span id="who-we-help" class="legacy-anchor" aria-hidden="true"></span><div class="wrap split"><div class="audience-heading"><p class="eyebrow">Who we help</p><h2 class="ac-type-home-h2"><span>Help for the people responsible.</span></h2></div><div><div class="audience"><div><HomeIcon name="house" /><div><h3 class="ac-type-home-h3 ac-type-home-audience">Homeowners &amp; Families</h3><p>Get help with a difficult cleanup while keeping a say in what happens to your belongings.</p></div></div><div><HomeIcon name="file-check" /><div><h3 class="ac-type-home-h3 ac-type-home-audience">Executors &amp; Trustees</h3><p>Arrange property clearing with agreed sorting, inventory, and documentation for your records.</p></div></div><div><HomeIcon name="key-round" /><div><h3 class="ac-type-home-h3 ac-type-home-audience">Property Managers &amp; Landlords</h3><p>Address cleanup needs before preparing a property for its next use.</p></div></div><div><HomeIcon name="building-2" /><div><h3 class="ac-type-home-h3 ac-type-home-audience">Businesses &amp; Facilities</h3><p>Coordinate the cleanup around site access, your requirements, and the agreed work.</p></div></div></div></div><AssignedPhoto src={homeWho} alt="Two people reviewing a furnished home, viewed from behind." position="center 42%" /></div></section>
<section class="band" id="cta-mid"><div class="wrap"><div><p class="eyebrow" style="color:#b7d0e3">Start with a conversation</p><h2 class="ac-type-home-h2 ac-type-home-band">Not sure where to start?</h2><p>Describe the condition, even if you’re unsure which service you need. We’ll ask questions and explain the next step.</p></div><a class="action light" href="#home-contact">Request an Assessment <HomeIcon name="arrow-right" /></a></div></section>
<section class="section" id="ac-process"><span id="process" class="legacy-anchor" aria-hidden="true"></span><div class="wrap"><p class="eyebrow">Our process</p><h2 class="ac-type-home-h2">A clear plan from first call to finish.</h2><ol class="steps"><li class="step"><b>01</b><h3 class="ac-type-home-h3 ac-type-home-step">Contact Us</h3><p>Tell us what happened, where the property is, and what you need help with.</p></li><li class="step"><b>02</b><h3 class="ac-type-home-h3 ac-type-home-step">Review Your Plan</h3><p>We assess the property and explain the work and price for your approval.</p></li><li class="step"><b>03</b><h3 class="ac-type-home-h3 ac-type-home-step">Complete the Work</h3><p>We carry out the agreed cleanup and keep you updated on progress.</p></li><li class="step"><b>04</b><h3 class="ac-type-home-h3 ac-type-home-step">Review &amp; Document</h3><p>We review the completed work with you and provide the agreed documentation.</p></li></ol></div></section>
<section class="section warm" id="ac-area"><span id="service-area" class="legacy-anchor" aria-hidden="true"></span><div class="wrap coverage"><div class="coverage-heading"><p class="eyebrow">Local service</p><h2 class="ac-type-home-h2">South Bay and Peninsula.</h2></div><div class="coverage-intro"><p>Serving homes and businesses in Santa Clara County and San Mateo County. Share the property’s location and cleanup needs so we can confirm availability.</p></div><div class="coverage-county"><h3 class="ac-type-home-h3 ac-type-home-county">Santa Clara County</h3><ul class="county-cities"><li>Campbell</li><li>Cupertino</li><li>Gilroy</li><li>Los Altos</li><li>Los Altos Hills</li><li>Los Gatos</li><li>Milpitas</li><li>Monte Sereno</li><li>Morgan Hill</li><li>Mountain View</li><li>Palo Alto</li><li>San Jose</li><li>Santa Clara</li><li>Saratoga</li><li>Sunnyvale</li></ul></div><div class="coverage-county"><h3 class="ac-type-home-h3 ac-type-home-county">San Mateo County</h3><ul class="county-cities"><li>Atherton</li><li>Belmont</li><li>Brisbane</li><li>Burlingame</li><li>Colma</li><li>Daly City</li><li>East Palo Alto</li><li>Foster City</li><li>Half Moon Bay</li><li>Hillsborough</li><li>Menlo Park</li><li>Millbrae</li><li>Pacifica</li><li>Portola Valley</li><li>Redwood City</li><li>San Bruno</li><li>San Carlos</li><li>San Mateo</li><li>Woodside</li></ul></div><p class="coverage-note"><strong>Outside these cities?</strong><br/>Send the property’s ZIP code and tell us what needs cleanup. We’ll confirm whether we can help.</p></div></section>
<section class="quiet" id="cta-close"><div class="wrap"><div><h2 class="ac-type-home-h2 ac-type-home-quiet">Let’s make a plan for your property.</h2><p>Tell us what needs to happen next. We’ll discuss the cleanup needed to get you there.</p></div></div></section>
<section class="section" id="ac-form"><span id="contact" class="legacy-anchor" aria-hidden="true"></span><span id="home-contact" class="legacy-anchor" aria-hidden="true"></span><div class="wrap"><div class="formwrap"><p class="eyebrow">Request an assessment</p><h2 id="hero-form-title" class="ac-type-home-h2 center">Tell us what needs cleanup.</h2><p>Describe the condition and what you need help with. A short description is enough to start.</p><AcCompactForm formId="hero-form" entryRoute="/#hero-form" preselectRoute="/" tone="light" headingId="hero-form-title" homepage kit /></div></div></section>

</BaseLayout>
<script>
const root = document.querySelector("#ac-home-locked-mockup");
root?.querySelectorAll<HTMLAnchorElement>('a[href="#home-contact"]').forEach(link => link.addEventListener("click", event => {
 event.preventDefault();
 history.pushState(null, "", link.hash);
 document.querySelector("#ac-form")?.scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",block:"start"});
 const field = document.querySelector<HTMLInputElement>("#hero-form-name");
 field?.focus({preventScroll:true});
}));
</script>

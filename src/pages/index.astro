---
// Section order and markup ported verbatim from docs/aseptaclean-FINAL-v2.html
// (05-DECISIONS-LOG.md supersedes docs/11-COMPOSITION-AND-TYPE.md and
// docs/18-VISUAL-DIRECTION.md's homepage section map for this page).
import BaseLayout from "@layouts/BaseLayout.astro";
import AccentBand from "@components/AccentBand.astro";
import AreasWeServe from "@components/AreasWeServe.astro";
import ConfidenceAndFit from "@components/ConfidenceAndFit.astro";
import CredentialBar from "@components/CredentialBar.astro";
import FAQ, { faqItems } from "@components/FAQ.astro";
import FinalCTA from "@components/FinalCTA.astro";
import HandoffRecord from "@components/HandoffRecord.astro";
import HandoffStandard from "@components/HandoffStandard.astro";
import Hero from "@components/Hero.astro";
import OperatorAccountability from "@components/OperatorAccountability.astro";
import Pricing from "@components/Pricing.astro";
import RequestForm from "@components/RequestForm.astro";
import ServiceCards from "@components/ServiceCards.astro";
import WhyAseptaclean from "@components/WhyAseptaclean.astro";
import { homepage, site } from "@data/site";

// doc 19 §2.2: sameAs → GBP/Yelp/Nextdoor. Only owner-confirmed profile URLs are ever
// included (never fabricated) — matches AGENTS.md's "never invent proof" rule.
const sameAs = [
  site.business.googleBusinessProfileUrl,
  site.business.yelpUrl,
  site.business.nextdoorUrl
].filter((url): url is string => Boolean(url));

const localBusinessSchema = {
  "@type": "LocalBusiness",
  "@id": new URL("/#business", site.urls.site).href,
  name: site.business.name,
  url: site.urls.site,
  email: site.business.email,
  areaServed: site.location.cities.map((name) => ({
    "@type": "City",
    name
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: "San Jose",
    addressRegion: "CA",
    addressCountry: "US"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 37.3382,
    longitude: -121.8863
  },
  ...(sameAs.length > 0 ? { sameAs } : {})
};

const serviceSchemas = homepage.serviceCards.map((card) => ({
  "@type": "Service",
  serviceType: card.title,
  description: card.detail,
  provider: { "@id": new URL("/#business", site.urls.site).href },
  areaServed: site.location.cities.map((name) => ({
    "@type": "City",
    name
  }))
}));

const faqSchema = {
  "@type": "FAQPage",
  "@id": new URL("/#faq", site.urls.site).href,
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="Property Cleanout & Deep Cleaning | San Jose & South Bay | Aseptaclean"
  description="Whole-property cleanout and deep cleaning in San Jose & the South Bay. Written scope before work, nothing removed without approval, documented closeout."
  canonicalPath="/"
  schema={[localBusinessSchema, ...serviceSchemas, faqSchema]}
>
  <Hero />
  <CredentialBar />
  <ServiceCards />
  <ConfidenceAndFit />
  <WhyAseptaclean />
  <AccentBand />
  <HandoffStandard />
  <HandoffRecord />
  <Pricing />
  <AreasWeServe />
  <OperatorAccountability />
  <FAQ />
  <RequestForm />
  <FinalCTA />
</BaseLayout>

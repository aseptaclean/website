---
// HOMEPAGE — docs/page-briefs/HOME.md, under doc 30 §5 "Page architecture".
// Composition from docs/reference/clearpath-911-visual-reference.pdf p23–27 and 911 p3–4/p8.
// Copy from docs/aseptaclean-all-website-copy.md via docs/20-COPY-MAP.md.
//
// BRIEF ORDER (HOME.md), one component per row:
//   1  SiteHeader                  BaseLayout
//   2  HeroWithForm                AcHeroWithForm
//   3  Verified trust row          AcTrustStrip
//   4  White image/text intro      AcSplit        "Some properties need more than cleaning."
//   5  Five-service photo grid     AcServiceCards "What are you dealing with?" + card excerpts
//   6  Dark image/text scope       AcDarkBand     "You should know what you are paying us…"
//   7  Compact five-step process   AcSteps        "How it starts" — five steps, not four
//   8  Founder split               AcSplit        "Why Aseptaclean"
//   9  Verified service area       AcIntro        verified city list, no invented counties
//  10  FAQ                         FaqAccordion   the complete source question set
//  11  Final call section          AcFinalCta     "You do not need to know exactly what kind…"
//  12  SiteFooter                  BaseLayout
//
// EXPLICIT HOMEPAGE OMISSIONS — docs/20-COPY-MAP.md "Homepage selection". These source sections
// are deliberately NOT rendered here, and must not be re-added because the source has more
// headings: "Show us the condition first."; "We do not pretend every problem belongs to us.";
// "Real trust starts with clear expectations."; "Who calls Aseptaclean?"; "What affects the
// cost?" Their text is untouched in the source file, and the scope/process/cost detail lives on
// the service and hub pages.
import BaseLayout from "@layouts/BaseLayout.astro";
import AcHeroWithForm from "@components/ac/AcHeroWithForm.astro";
import AcTrustStrip from "@components/ac/AcTrustStrip.astro";
import AcIntro from "@components/ac/AcIntro.astro";
import AcServiceCards from "@components/ac/AcServiceCards.astro";
import AcSplit from "@components/ac/AcSplit.astro";
import AcDarkBand from "@components/ac/AcDarkBand.astro";
import AcSteps from "@components/ac/AcSteps.astro";
import AcCheckList from "@components/ac/AcCheckList.astro";
import AcFinalCta from "@components/ac/AcFinalCta.astro";
import FaqAccordion from "@components/FaqAccordion.astro";
import { home } from "@data/publicCopy";
import { legal, site } from "@data/site";

// IMAGERY — docs/06-ASSET-MANIFEST.md, owner image package installed 2026-09-05.
// Slots follow that package's README-ASSET-MAP.md and aseptaclean-image-placement-guide.md
// placement index: 01 hero, 02 introduction, 03/06/09/13/15 the five service cards, 18 the dark
// scope section. The numbered files are ORIGINAL ILLUSTRATIVE images, not company job
// documentation. That provenance is recorded in the asset manifest, not printed on the page:
// the visitor-facing reference captions were removed 2026-09-05 at the owner's instruction, so
// no section is captioned at all. Nothing here is labelled as Aseptaclean project work.
// No two adjacent sections share a photograph.
//
// The founder portrait is the only genuine company asset on this page: a real photograph of
// Matthew Ruiz supplied by the owner.
import heroNeglectedInterior from "../assets/aseptaclean/home-hero-neglected-interior.png";
import propertyIntroduction from "../assets/aseptaclean/property-interior-introduction.png";
import hoardingLivingRoom from "../assets/aseptaclean/hoarding-living-room.png";
import extremeKitchen from "../assets/aseptaclean/extreme-cleaning-neglected-kitchen.png";
import deepCleaningKitchen from "../assets/aseptaclean/detailed-deep-cleaning-kitchen.png";
import traumaContext from "../assets/aseptaclean/trauma-residential-context.png";
import rodentUtilityRoom from "../assets/aseptaclean/rodent-utility-room-context.png";
import propertyScopeDetail from "../assets/aseptaclean/home-property-scope-detail.png";
import founderPortrait from "../assets/aseptaclean/founder-matthew-ruiz.jpeg";

// Card images, indexed against the SITEMAP-MASTER service order the copy data already uses:
// Hoarding · Extreme Cleaning · Detailed Deep Cleaning · Crime Scene & Trauma · Rodent.
// Each card now carries its own service's main package image (guide 03, 06, 09, 13, 15) rather
// than a subject-adjacent stand-in, so the card and the page it links to open on the same scene.
const cardMedia = [
  {
    image: hoardingLivingRoom,
    alt: "A living room where boxes, textiles and household belongings cover the sofa and floor, leaving a narrow walkway"
  },
  {
    image: extremeKitchen,
    alt: "A neglected kitchen with heavy grease buildup around the stove and grime along the floor edges"
  },
  {
    image: deepCleaningKitchen,
    alt: "An everyday residential kitchen with light grease around the cooking area and dust along the edges"
  },
  {
    image: traumaContext,
    alt: "A quiet, unoccupied residential room with plain flooring and an open doorway"
  },
  {
    image: rodentUtilityRoom,
    alt: "A residential utility room with a low shelf, cardboard boxes and a small scattering of rodent droppings near the wall"
  }
];

const serviceCards = home.serviceCards.map((card, index) => ({
  title: card.title,
  description: card.description,
  href: card.href,
  image: cardMedia[index]?.image,
  imageAlt: cardMedia[index]?.alt ?? ""
}));

// The service-area FAQ answer is rebuilt from verified data rather than transcribed — the
// source answer names "Santa Clara County", which docs/02-CURRENT-FACTS.md rejects because the
// footprint includes Atherton (San Mateo County). See docs/20-COPY-MAP.md.
const faqItems = [
  ...home.faq,
  {
    question: "What areas do you serve?",
    answer: `Aseptaclean serves the ${site.location.serviceArea}, including ${site.location.cities.slice(0, -1).join(", ")}, and ${site.location.cities.at(-1)}. Contact us with the property location and we will confirm whether it falls within our current service area.`
  }
];

const serviceSchemas = home.serviceCards.map((card) => ({
  "@type": "Service",
  serviceType: card.title,
  description: card.description,
  url: new URL(card.href, site.urls.site).href,
  provider: { "@id": new URL("/#business", site.urls.site).href },
  areaServed: site.location.cities.map((name) => ({ "@type": "City", name }))
}));

// FAQPage JSON-LD describes the visible accordion below and is sourced from the same array, so
// schema and rendered copy cannot drift.
const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};

const schema = [...serviceSchemas, faqSchema];
---

<BaseLayout
  title="Specialty Property Cleanup in San Jose | Aseptaclean"
  description="Hoarding cleanup, extreme cleaning, detailed deep cleaning, crime scene and trauma cleanup, and rodent droppings and animal waste cleanup for properties that need more than a normal cleaning company. Serving the South Bay & Peninsula."
  canonicalPath="/"
  schema={schema}
>
  {/* 2 */}
  <AcHeroWithForm
    eyebrow={home.hero.eyebrow}
    heading={home.hero.heading}
    headingId="home-hero-title"
    body={home.hero.body}
    image={heroNeglectedInterior}
    imageAlt="A modest living room with a worn sofa, cardboard boxes, scattered papers and a layer of household dust"
    trustLine={`Owner-operated · Serving the ${site.location.serviceArea}`}
    formId="hero-form"
    route="/"
  />

  {/* 3 — verified facts only. "Insured" renders only when a current COI is recorded; TSW #933
      is not published here (AGENTS.md §3 limits it to the trauma route and its cross-links). */}
  <AcTrustStrip />

  {/* 4 */}
  <AcSplit
    eyebrow="01 / The difference"
    heading={home.intro.heading}
    headingAccent={home.intro.headingAccent}
    headingId="home-intro-title"
    body={home.intro.body}
    pullQuote={home.intro.pullQuote}
    image={propertyIntroduction}
    imageAlt="An unfurnished residential interior looking from the living room toward an adjoining hallway"
  />

  {/* 5 */}
  <AcIntro
    eyebrow="02 / What we handle"
    heading={home.doorsIntro.heading}
    headingId="home-services-title"
    lead={home.doorsIntro.lead}
    body={home.doorsIntro.body}
    tone="soft"
  >
    <div class="home-services">
      <AcServiceCards cards={serviceCards} layout="five" />
    </div>
  </AcIntro>

  {/* 6 */}
  <AcDarkBand
    eyebrow="03 / Scope"
    heading={home.scope.heading}
    headingId="home-scope-title"
    lead={home.scope.lead}
    body={home.scope.body}
    pullQuote={home.scope.pullQuote}
    image={propertyScopeDetail}
    imageAlt="A residential room with a worn chair, stacked boxes and visible dirt along the floor edges"
  >
    <div class="home-scope-list">
      <AcCheckList items={home.scopeQuestions} tone="quiet" compact />
    </div>
  </AcDarkBand>

  {/* 7 — five steps. doc 30 §4: "Process: five steps where the main copy has five." */}
  <AcIntro
    eyebrow="04 / How it starts"
    heading="How it starts"
    headingId="home-process-title"
    tone="soft"
  >
    <div class="home-steps">
      <AcSteps steps={home.steps} />
    </div>
  </AcIntro>

  {/* 8 — founder. THE MISSING ASSET IS NO LONGER MISSING. The owner supplied a real photograph
      of Matthew Ruiz on 2026-09-05, so this split now renders its media column instead of
      collapsing to one readable column with a recorded `needsAsset`. It is a genuine company
      asset, not illustration, so it carries NO illustrative caption — that disclosure exists to
      stop a visitor reading a generated interior as documentation of a job, and applying it to
      a real founder portrait would say the opposite of the truth.
      Portrait 3:4, contained plate — see the portrait note in AcSplit. */}
  <AcSplit
    eyebrow="05 / Why Aseptaclean"
    heading={home.why.heading}
    headingId="home-founder-title"
    lead={`${home.why.lead} ${site.founder.name} is ${site.founder.title}.`}
    body={home.why.body}
    pullQuote={home.why.pullQuote}
    image={founderPortrait}
    imageAlt="Matthew Ruiz, founder of Aseptaclean"
    ratio="3/4"
  >
    {home.why.close.map((paragraph) => <p class="home-founder__body">{paragraph}</p>)}
    {/* Mandatory wherever the founder's background appears — docs/02-CURRENT-FACTS.md. */}
    <p class="home-founder__limit">{legal.founderAuthorityLimit}</p>
  </AcSplit>

  {/* 9 — verified service area. The real city list, not a directory of city buttons and not a
      county promise the business has not verified (docs/02-CURRENT-FACTS.md "Geography"). */}
  <AcIntro
    eyebrow="06 / Service area"
    heading={`Serving the ${site.location.serviceArea}`}
    headingId="home-area-title"
    lead="Contact us with the property location and we will confirm whether it falls within our current service area."
  >
    <ul class="home-cities">
      {site.location.cities.map((city) => <li>{city}</li>)}
    </ul>
  </AcIntro>

  {/* 10 */}
  <AcIntro
    eyebrow="07 / Questions"
    heading="Frequently asked questions"
    headingId="home-faq-title"
    tone="soft"
  >
    <div class="home-faq">
      <FaqAccordion items={faqItems} headingId="home-faq-title" />
    </div>
  </AcIntro>

  {/* 11 */}
  <AcFinalCta heading={home.final.heading} body={home.final.body} />
</BaseLayout>

<style>
  .home-services,
  .home-steps {
    margin-top: 40px;
    text-align: left;
  }

  .home-scope-list {
    margin-top: 22px;
  }

  .home-founder__body {
    margin: 14px 0 0;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.65;
  }

  .home-founder__limit {
    margin: 22px 0 0;
    border-left: 2px solid var(--ac-color-line-strong);
    padding-left: 18px;
    color: var(--ac-color-ink-500);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .home-cities {
    display: grid;
    max-width: 60rem;
    margin: 36px auto 0;
    padding: 0;
    list-style: none;
    gap: 1px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    /* The 1px gap over a rule-coloured background draws the grid lines — no per-cell borders,
       so no doubled rules where cells meet. Quiet, and not a row of city buttons. */
    background: var(--ac-color-line);
    border: 1px solid var(--ac-color-line);
  }

  .home-cities li {
    max-width: none;
    padding: 15px 12px;
    background: var(--ac-color-paper);
    color: var(--ac-color-navy-900);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
  }

  .home-faq {
    margin: 34px auto 0;
    text-align: left;
  }

  @media (max-width: 62rem) {
    .home-cities {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .home-cities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
// Built 2026-08-16 from docs/27-COPY-CANONICAL.md §17.4, per docs/SITEMAP-MASTER.md's Company
// row ("/faq/ | FAQ | index | 27 §17"). Until now FAQ existed only as a homepage section
// (src/components/FAQ.astro, a different and shorter question set); this is the standalone
// route master calls for.
//
// The two question sets are intentionally NOT merged: the homepage set is the short
// objection-handling pass doc 27 §9.12 specifies, this is the fuller §17.4 set. Both are doc 27
// copy. If they ever need to converge, doc 27 is the place to reconcile them, not the components.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import ServiceFAQ from "@components/ServiceFAQ.astro";
import AccentBand from "@components/AccentBand.astro";
import RequestForm from "@components/RequestForm.astro";
import { faqPage } from "@data/doc27CompanyPages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faqPage.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "FAQ",
        item: new URL(faqPage.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={faqPage.seoTitle}
  description={faqPage.metaDescription}
  canonicalPath={faqPage.slug}
  schema={schema}
>
  <PageHeader
    headingId="faq-page-title"
    eyebrow={faqPage.eyebrow}
    h1={faqPage.h1}
    lede={faqPage.lead}
    crumb="FAQ"
  />

  <ServiceFAQ
    heading="Questions we answer before scheduling"
    headingId="faq-page-list-title"
    intro="These answers describe how a project is reviewed and scoped. The signed scope controls the actual work."
    items={faqPage.items}
  />

  {/* §9.15.5 "FAQ / Projects connective" — sidebar label. Mockup page-faq.html:609-614 puts
      this in a .relcol beside the question list. The three link LABELS in that mockup
      ("How the five-stage process works", "About Matthew and Aseptaclean") are mockup-only
      wording approved nowhere, so the existing shipping nav labels are used instead of
      writing copy — PORT-PROMPT §1. */}
  <section class="faq-still" aria-labelledby="faq-still-title">
    <div class="ac-measure-wide">
      <p id="faq-still-title" class="ac-eyebrow">Still deciding?</p>
      <nav class="faq-still__list" aria-label="Related pages">
        <a href="/handoff-standard/">The Handoff Standard →</a>
        <a href="/about/">About Aseptaclean →</a>
        <a href="/request-assessment/">{site.offer.primaryCta} →</a>
      </nav>
    </div>
  </section>

  {/* §9.15.5 FAQ band heading; CTA reuses §9.15.1 "Company pages" Process record CTA.
      Mockup position: page-faq.html:616-619, after the list, before the footer. */}
  <AccentBand
    heading="Didn't find your question?"
    headingId="faq-band-title"
  />

  <RequestForm />
</BaseLayout>

<style>
  .faq-still {
    padding-block: var(--ac-space-6);
    background: var(--ac-color-paper);
  }

  .faq-still__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ac-space-4) var(--ac-space-6);
    margin-top: var(--ac-space-3);
  }

  .faq-still__list a {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    text-decoration: none;
  }

  .faq-still__list a:hover,
  .faq-still__list a:focus-visible {
    text-decoration: underline;
  }
</style>

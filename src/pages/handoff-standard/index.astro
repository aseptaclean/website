---
// doc 19 §2.2 HANDOFF STANDARD + §3.7 wireframe: "five stages FULL version (homepage shows
// condensed) → the complete sample Record, annotated: each field gets a one-line 'what this
// protects' note → 'Who relies on this' 4-up → CTA." This is the page the live footer's
// "Handoff Standard" link now resolves to (previously #standards, an in-page homepage anchor —
// doc 19 §2.2 calls this out explicitly as "fixes the dead footer link").
//
// Stage copy: full version pulled verbatim from docs/06-APPROVED-HOMEPAGE-COPY.md §8.11 (the
// homepage's HandoffStandard.astro renders the same stages condensed to name+detail+record tag
// only — this page adds no new stage claims, just the fuller phrasing already approved there).
// Record annotations restate claims already approved elsewhere (homepage.assurance,
// legal.documentationDisclaimer) rather than asserting anything new.
//
// Title, meta, eyebrow, H1, and lead migrated to docs/27-COPY-CANONICAL.md §17.1 ("Process")
// on 2026-08-16. docs/SITEMAP-MASTER.md maps doc 27's bare /process route onto this existing
// /handoff-standard/ URL ("Company | /handoff-standard/ (= Process)"), so the route is
// unchanged and no redirect is needed. Layout below is unchanged.
import BaseLayout from "@layouts/BaseLayout.astro";
import CompactHero from "@components/CompactHero.astro";
import RequestForm from "@components/RequestForm.astro";
import { processPage } from "@data/doc27CompanyPages";
import { homepage, legal, site } from "@data/site";

const record = homepage.sampleRecord;

const stageIntros = {
  Scope:
    "We write down what stays, what goes, what gets cleaned, what is excluded, and what the project will require.",
  Protect:
    "Keep areas are identified. Uncertain and important discovered items are separated and reported. We do not decide what mattered to your family.",
  Clear:
    "Approved unwanted contents are consolidated, removed, or coordinated for disposal within the signed scope.",
  Reset:
    "The property receives the detailed cleaning included for its next handoff, including animal and organic conditions within lawful scope.",
  Verify:
    "You receive completion photographs, documented exceptions, and a Property Handoff Record showing how the approved scope was closed."
} as const;

const statusMap: Record<string, { label: string; className: string }> = {
  Keep: { label: "✓ Keep", className: "keep" },
  Review: { label: "? Review", className: "rev" },
  Remove: { label: "— Remove", className: "rem" }
};

const recordFields = [
  {
    label: "Authorized decision-maker",
    value: record.decisionMaker,
    protects: "One accountable approver, so instructions can't conflict or get overridden informally."
  },
  {
    label: "Approved clearing scope",
    value: record.clearingScope,
    protects: "What leaves the property is limited to what was written down and approved."
  },
  {
    label: "Approved cleaning scope",
    value: record.cleaningScope,
    protects: "What gets cleaned is defined before work starts, not decided room-by-room on site."
  },
  {
    label: "Excluded conditions",
    value: record.excludedConditions,
    protects: "The boundary of the job is visible up front — no surprise add-ons framed as \"included.\""
  }
] as const;

const roomProtects: Record<string, string> = {
  Keep: "Stays untouched; included in the cleaning pass, not treated as clutter.",
  Review: "Held for the decision-maker's review — not discarded while uncertain.",
  Remove: "Cleared only because it was specifically approved for removal."
};

const closeoutFields = [
  {
    label: "Change authorization",
    value: record.changeAuthorization,
    protects: "Added scope is documented and approved before it's billed — no unapproved charges."
  },
  {
    label: "Discovered item log",
    value: record.discoveredItemLog,
    protects: "Keys, documents, valuables, and similar finds are isolated and reported, not judged or discarded."
  },
  {
    label: "Exception status",
    value: record.exceptionStatus,
    protects: "Anything still open at closeout is named, not hidden inside a \"completed\" label."
  },
  {
    label: "Photograph index",
    value: record.photographIndex,
    protects: "Starting and closeout condition are both on record, not just the finished result."
  },
  {
    label: "Final review status",
    value: record.finalReviewStatus,
    protects: "Completion is a defined, reviewed state — not just the crew leaving the property."
  },
  {
    label: "Closeout date",
    value: record.closeoutDate,
    protects: "The record ties to a specific walkthrough, not an assumed or estimated finish."
  }
] as const;

const reliesOn = [
  {
    title: "Family",
    detail: "A single written record of what stayed, what left, and what was cleaned — instead of relying on memory during an already difficult time."
  },
  {
    title: "Executor",
    detail: "Documentation that scope was approved and completed as authorized, for the estate file."
  },
  {
    title: "Attorney",
    detail: "A citable standard to reference when advising a client on what a cleanout vendor should provide in writing."
  },
  {
    title: "Property manager",
    detail: "A completion record with photographs and exceptions that can be handed to an owner or the next tenant file."
  }
] as const;

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "The Aseptaclean Handoff Standard",
        item: new URL("/handoff-standard/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={processPage.seoTitle}
  description={processPage.metaDescription}
  canonicalPath={processPage.slug}
  schema={schema}
>
  <CompactHero eyebrow={processPage.eyebrow} headingId="standard-title">
    <h1 id="standard-title" class="ac-type-h1">{processPage.h1}</h1>
    <p class="compact-hero__lead">{processPage.lead}</p>
  </CompactHero>

  <section class="standard-stages" aria-labelledby="stages-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">Five-stage standard, in full</p>
      <h2 id="stages-title" class="ac-type-h2">You should not have to coordinate a hauler, a cleaner, disposal, access, family approvals, and a final walkthrough yourself.</h2>
      <ol class="stages">
        {
          homepage.handoffStages.map((stage, index) => (
            <li class="stage">
              <span class="stage__n">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="ac-type-h3">{stage.name}</h3>
                <p class="ac-type-body">{stageIntros[stage.name as keyof typeof stageIntros] ?? stage.detail}</p>
              </div>
              <span class="stage__rec">{stage.record} · {stage.status}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="standard-record" id="record" aria-labelledby="record-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">The complete sample record</p>
      <h2 id="record-title" class="ac-type-h2 standard-record__title">Property Handoff Record — annotated</h2>
      <p class="standard-record__intro">
        Every field below exists because it protects a specific decision. This is the sample
        used in letters and referrals; a real project's record follows the same structure.
      </p>

      <div class="record">
        <div class="rtop">
          <div>
            <div class="rtop__title">Property Handoff Record</div>
            <div class="rtop__meta">Project {record.projectId}</div>
          </div>
          <span class="rtop__sample">Sample / not a client record</span>
        </div>

        <div class="rgrid">
          {
            recordFields.map((field) => (
              <div class="rcell">
                <div class="rcell__k">{field.label}</div>
                <div class="rcell__v">{field.value}</div>
                <div class="rcell__protects"><span>Protects:</span> {field.protects}</div>
              </div>
            ))
          }
        </div>

        <div class="rtable">
          <p class="rtable__label">Room-by-room disposition</p>
          {
            record.rooms.map((room) => {
              const status = statusMap[room.disposition] ?? { label: room.disposition, className: "rem" };
              return (
                <div class="rrow">
                  <span class="rrow__a">{room.area}</span>
                  <span class={`rrow__st rrow__st--${status.className}`}>{status.label}</span>
                  <span class="rrow__note">{room.note}</span>
                  <span class="rrow__protects">{roomProtects[room.disposition] ?? ""}</span>
                </div>
              );
            })
          }
        </div>

        <div class="rclose">
          <p class="rtable__label">Closeout fields</p>
          {
            closeoutFields.map((field) => (
              <div class="rclose__row">
                <div>
                  <div class="rcell__k">{field.label}</div>
                  <div class="rcell__v">{field.value}</div>
                </div>
                <div class="rcell__protects"><span>Protects:</span> {field.protects}</div>
              </div>
            ))
          }
        </div>
      </div>
      <p class="standard-record__cap">{legal.documentationDisclaimer}</p>
    </div>
  </section>

  <section class="standard-relies" aria-labelledby="relies-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">Who relies on this</p>
      <h2 id="relies-title" class="ac-type-h2">The record is written to hold up outside the project, too.</h2>
      <div class="relies-grid">
        {
          reliesOn.map((item) => (
            <div class="relies-card">
              <h3 class="ac-type-h3">{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .standard-stages {
    background: var(--ac-color-paper);
  }

  .standard-stages h2 {
    max-width: 34ch;
    margin: 12px 0 0;
    line-height: 1.1;
  }

  .stages {
    border-top: 2px solid var(--ac-color-navy-900);
    margin: var(--ac-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--ac-s3);
    border-bottom: 1px solid var(--ac-color-line);
    padding-block: var(--ac-s4);
    /* Layout row, not prose — must span the container rather than the global 62ch li measure. */
    max-width: none;
  }

  /* Numbered step rail — matches HandoffStandard.astro so the homepage's condensed five stages
     and this page's full version read as the same sequence. */
  .stage__n {
    color: var(--ac-color-blue-deep);
    font-family: var(--ac-font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }

  .stage h3 {
    margin-bottom: 6px;
  }

  .stage p {
    max-width: 62ch;
    color: var(--ac-color-ink-600);
  }

  .stage__rec {
    margin-top: 6px;
    border: 1px solid var(--ac-color-line);
    border-radius: 5px;
    background: var(--ac-color-blue-ghost);
    padding: 6px 10px;
    color: var(--ac-color-blue-deep);
    font-family: var(--ac-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .standard-record {
    background: var(--ac-color-warm-white);
  }

  .standard-record__title {
    margin: 10px 0 0;
  }

  .standard-record__intro {
    max-width: 60ch;
    margin: var(--ac-space-4) 0 var(--ac-space-6);
    color: var(--ac-color-ink-600);
  }

  .record {
    overflow: hidden;
    border-radius: var(--ac-r);
    background: #fff;
    box-shadow: var(--ac-shadow-pop);
  }

  .rtop {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 2px solid var(--ac-color-navy-900);
    padding: 24px 28px;
  }

  .rtop__title {
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-display);
    font-size: 1.45rem;
    font-weight: 600;
  }

  .rtop__meta {
    margin-top: 3px;
    color: var(--ac-color-ink-400);
    font-family: var(--ac-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rtop__sample {
    border: 1px solid #e0b6b0;
    border-radius: 5px;
    background: #fbeeec;
    padding: 5px 9px;
    color: #a3392f;
    font-family: var(--ac-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .rgrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .rcell {
    border-right: 1px solid var(--ac-color-line);
    border-bottom: 1px solid var(--ac-color-line);
    padding: 20px 22px;
  }

  .rcell__k {
    margin-bottom: 7px;
    color: var(--ac-color-ink-400);
    font-family: var(--ac-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rcell__v {
    color: var(--ac-color-navy-900);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .rcell__protects {
    max-width: 44ch;
    margin-top: 10px;
    color: var(--ac-color-ink-500);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .rcell__protects span {
    color: var(--ac-color-blue-deep);
    font-weight: 700;
  }

  .rtable {
    border-top: 1px solid var(--ac-color-line);
    padding: 20px 28px;
  }

  .rtable__label {
    margin: 0 0 14px;
    color: var(--ac-color-ink-400);
    font-family: var(--ac-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rrow {
    display: grid;
    grid-template-columns: 1fr auto 1.4fr;
    align-items: start;
    gap: 16px;
    border-bottom: 1px solid var(--ac-color-line);
    padding: 14px 0;
    font-size: 0.9rem;
  }

  .rrow:last-child {
    border-bottom: 0;
  }

  .rrow__a {
    color: var(--ac-color-navy-900);
    font-weight: 600;
  }

  .rrow__note {
    color: var(--ac-color-ink-600);
    font-size: 0.85rem;
  }

  .rrow__protects {
    grid-column: 1 / -1;
    margin-top: 2px;
    color: var(--ac-color-ink-500);
    font-size: 0.8rem;
  }

  .rrow__protects::before {
    content: "Protects: ";
    color: var(--ac-color-blue-deep);
    font-weight: 700;
  }

  .rrow__st {
    border: 1px solid;
    border-radius: 5px;
    padding: 4px 9px;
    font-family: var(--ac-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rrow__st--keep {
    border-color: #bde0cc;
    background: var(--ac-color-clear-pale);
    color: var(--ac-color-clear);
  }

  .rrow__st--rev {
    border-color: #ecd6a8;
    background: var(--ac-color-review-pale);
    color: var(--ac-color-review);
  }

  .rrow__st--rem {
    border-color: var(--ac-color-line-strong);
    background: var(--ac-color-bg-soft);
    color: var(--ac-color-ink-600);
  }

  .rclose {
    border-top: 1px solid var(--ac-color-line);
    padding: 20px 28px 24px;
  }

  .rclose__row {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 20px;
    border-bottom: 1px solid var(--ac-color-line);
    padding-block: 16px;
  }

  .rclose__row:last-child {
    border-bottom: 0;
  }

  .rclose__row .rcell__v {
    max-width: 40ch;
  }

  .standard-record__cap {
    max-width: 72ch;
    margin-top: 18px;
    color: var(--ac-color-ink-400);
    font-size: 0.78rem;
  }

  .standard-relies {
    background: var(--ac-color-paper);
  }

  .standard-relies h2 {
    max-width: 30ch;
    margin: 10px 0 0;
  }

  .relies-grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .relies-card {
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
  }

  .relies-card h3 {
    margin-bottom: 8px;
  }

  .relies-card p {
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }

  @media (min-width: 40rem) {
    .relies-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62.5rem) {
    .rgrid {
      grid-template-columns: repeat(4, 1fr);
    }

    .relies-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .stage {
      /* minmax(0, 1fr) — a bare `1fr` is `minmax(auto, 1fr)`, and that `auto` floor is the
         track's min-content width. .stage__rec is `white-space: nowrap`, so it floored this
         track at ~302px and pushed the row past the 280px container at 320px viewports. */
      grid-template-columns: 44px minmax(0, 1fr);
    }

    .stage__rec {
      grid-column: 2;
      /* Paired with the track fix above: the track can now shrink, so the chip has to be
         allowed to wrap or it re-creates the same overflow on its own. */
      justify-self: start;
      white-space: normal;
    }

    .rrow {
      grid-template-columns: 1fr auto;
    }

    .rrow__note {
      grid-column: 1 / -1;
      padding-top: 2px;
    }

    .rclose__row {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// TERMS AND CONDITIONS — docs/page-briefs/TERMS.md. Page label is "Terms and Conditions"
// (docs/20-COPY-MAP.md display map); provider policy text is preserved exactly.
import AcLegalPage from "@components/ac/AcLegalPage.astro";
import { site } from "@data/site";

const policy = site.integrations.termly.policies.terms;
---

<AcLegalPage
  label="Terms and Conditions"
  headingId="terms-title"
  canonicalPath="/terms/"
  seoTitle="Terms and Conditions | Aseptaclean"
  seoDescription="The terms that apply to using the Aseptaclean website and requesting service."
  policyId={policy.id}
  hostedUrl={policy.hostedUrl}
/>

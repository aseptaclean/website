---
// Rebuilt 2026-09-02 for conversion — AssessmentForm is now a single lean page instead of a
// three-step questionnaire (see docs/05-DECISIONS-LOG.md). The form keeps its endpoint,
// Turnstile, consent, and honeypot wiring; only the field set and layout changed.
//
// The "What happens next" band below is unchanged from the prior build.
import AssessmentForm from "@components/AssessmentForm.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import CredentialBar from "@components/CredentialBar.astro";
import { site } from "@data/site";

// A5 — BreadcrumbList. This route had none; every other non-root route on the site does, and a
// crumb trail is how a leaf page tells a crawler where it sits. The "Home" item uses
// `site.urls.home` (WITH the trailing slash) so it matches the homepage canonical exactly —
// `site.urls.site` is a bare origin and produced a second URL for the same page.
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "Request a Property Assessment",
        item: new URL("/request-assessment/", site.urls.site).href
      }
    ]
  }
];

const nextSteps = [
  "Send the details below — two or three phone photos help more than a long description.",
  "If the property is complicated, we’ll say whether a walkthrough is needed before a firm number.",
  "The scope and price come to you in writing before anything is scheduled."
];
---

<BaseLayout
  title="Request an Assessment | Aseptaclean"
  description="Tell Aseptaclean what's happening at the property, add photos if you have them, and get a clear next step."
  canonicalPath="/request-assessment/"
  schema={schema}
  showMobileCta={false}
>
  <AssessmentForm />

  <CredentialBar />

  <section class="ac-sec ac-sec--tight next" aria-labelledby="next-title">
    <div class="ac-shell">
      <div class="ac-sec__head">
        <p class="ac-label">What happens next</p>
        <h2 id="next-title" class="ac-type-h2-record">Matthew reads every request himself.</h2>
      </div>

      <ol class="ac-steps4 next__steps">
        {nextSteps.map((step, index) => (
          <li class="ac-stage">
            <b>{String(index + 1).padStart(2, "0")}</b>
            <p>{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .next {
    background: var(--ac-color-warm-white);
  }

  .next__steps {
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
  }

  .next__steps p {
    margin-top: 12px;
  }

  @media (max-width: 760px) {
    .next__steps {
      grid-template-columns: 1fr;
    }
  }
</style>

        </div>
      </div>
    </div>
  </section>

  {/* ══ 07 · QUESTIONS ═══════════════════════════════════════════════════════════════════════
      Open Q&A, not an accordion — same reasoning as the six prior rebuilds. */}
  <section class="rc-faq" aria-labelledby="faq-title">

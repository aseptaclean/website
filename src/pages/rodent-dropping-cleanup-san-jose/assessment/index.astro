---
import { Image } from "astro:assets";
import PpcLayout from "@layouts/PpcLayout.astro";
import PpcHeroForm from "@components/ppc/PpcHeroForm.astro";
import { srcsetWidths } from "@components/imageWidths";
import rodentAssessment from "../../../assets/aseptaclean/approved-landings/rodent-assessment.png";
import { site } from "@data/site";
import { ppcRodent } from "@data/ppcRodent";
import "@styles/approved-landing.css";

const roles = ["Property owner", "Family member", "Tenant / occupant", "Property manager / landlord", "Real estate professional", "Other / not sure"] as const;
---

<PpcLayout title="Rodent Droppings Cleanup | Aseptaclean" description="Rodent droppings, nesting material and contamination cleanup in the South Bay and Peninsula." canonicalPath={ppcRodent.route} stickyHeroSelector="#top" stickyFormHref="#contact" stickySecondaryLabel="Request a callback" showStickyBar={false}>
  <Fragment slot="header"><header class="approved-landing-header"><div class="lp-container lp-header"><a href="#top" class="lp-logo" aria-label="Aseptaclean home"><img src={site.business.logoUrl} width="900" height="215" alt="Aseptaclean" /></a><a class="lp-call" href={site.business.phoneUri} aria-label={`Call Aseptaclean at ${site.business.phone}`}>{site.business.phone}</a></div></header></Fragment>

  <div class="approved-landing lp-rodent" id="top">
    <section class="lp-hero"><div class="lp-container"><p class="lp-eyebrow">South Bay &amp; Peninsula</p><h1>Rodent droppings.<br />Handled with care.</h1><p class="lp-lead">We remove rodent droppings, nesting material, and contamination from affected areas of your home.</p><a class="lp-button lp-button--light" href="#contact">Request a callback <span aria-hidden="true">→</span></a><p class="lp-reassurance">Tell us where you found signs of rodents.</p></div></section>
    <section class="lp-credibility"><div class="lp-container"><div class="lp-rule"></div><h2>Careful cleanup. Clear steps.</h2><p>Founded by Matthew Ruiz • Former Stanford Health Care &amp; BioMarin professional</p></div></section>
    <section class="lp-services lp-container"><h2>Help with what rodents leave behind.</h2>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 38h31c5-1 5-8 0-10 2-6-3-10-8-8 0-7-8-10-12-5-6-2-10 3-8 8-7 0-10 9-3 12Z"></path><path d="m21 5 1-3m13 9 3-2M19 26h.1M30 29h.1M24 35h.1"></path></svg><div><h3>Droppings &amp; nesting material</h3><p>Cleanup of affected areas, from a garage corner to a crawl space.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m18 3 4 10 10 4-10 4-4 10-4-10L4 17l10-4Zm19 23 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z"></path></svg><div><h3>Urine &amp; affected surfaces</h3><p>Cleaning and treatment based on the materials and conditions.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 12 35 5l9 5v31L14 46 5 40Zm0 0 9 6 30-8M14 18v28M5 20l9 6 30-8M24 15v10l9-2V13"></path></svg><div><h3>Contaminated contents</h3><p>A clear plan for what can be cleaned and what needs removal.</p></div></article>
      <p class="lp-scope-note">Cleanup follows pest control. We do not trap rodents or seal entry points.</p>
    </section>
    <figure class="lp-photo"><Image src={rodentAssessment} alt="Garage assessment with a gloved professional holding a tablet." width={2048} height={688} widths={srcsetWidths(rodentAssessment, [480, 768, 1024, 1440, 2048])} sizes="100vw" format="webp" quality={82} loading="lazy" decoding="async" /></figure>
    <section class="lp-process"><div class="lp-container"><h2>Know the work.<br class="lp-desktop-break" /> Know the price.</h2><p>We review the affected areas and explain the scope before cleanup begins.</p><ol><li><span>01</span><div><h3>Tell us what you found</h3><p>Share the location and any photos you have.</p></div></li><li><span>02</span><div><h3>Review the cleanup plan</h3><p>Understand what is included and what it costs.</p></div></li><li><span>03</span><div><h3>Approve the work</h3><p>Cleanup begins after you approve the scope.</p></div></li></ol></div></section>
    <section class="lp-contact lp-container" id="contact"><h2 id="rodent-approved-contact-title">Let’s talk about the cleanup.</h2><p>Tell us how to reach you.</p><PpcHeroForm formId="rodent-approved-lead-form" headingId="rodent-approved-contact-title" entryRoute={`${ppcRodent.route}#contact`} situationValue="Rodent droppings or animal waste" campaignContext="rodent_assessment" approvedLanding roleOptions={roles} namePlaceholder="Full name" phonePlaceholder="Phone number" optionalDisclosureLabel="Email, role & details (optional)" detailLabel="Additional information" detailRequired={false} photoHelper="Photos are uploaded securely with your inquiry." microcopy="Submitting does not authorize work." submitLabel="Request a callback →" thankYouRoute={ppcRodent.thankYou.route} tone="light" turnstileSize="compact" /></section>
  </div>
  <Fragment slot="footer"><footer class="approved-landing-footer"><div class="lp-container lp-footer"><strong>Aseptaclean, LLC</strong><p>South Bay &amp; Peninsula</p></div></footer></Fragment>
</PpcLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.approved-landing a[href="#contact"]').forEach((link) => link.addEventListener("click", (event) => { event.preventDefault(); document.querySelector("#contact")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); document.querySelector<HTMLInputElement>("#rodent-approved-lead-form-name")?.focus({ preventScroll: true }); }));
</script>

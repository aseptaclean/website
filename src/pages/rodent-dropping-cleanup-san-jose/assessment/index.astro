---
import { Image } from "astro:assets";
import PpcLayout from "@layouts/PpcLayout.astro";
import PpcHeroForm from "@components/ppc/PpcHeroForm.astro";
import { srcsetWidths } from "@components/imageWidths";
import rodentAssessment from "../../../assets/aseptaclean/approved-landings/rodent-assessment.png";
import { site } from "@data/site";
import { ppcRodent } from "@data/ppcRodent";
import "@styles/approved-landing.css";

const roles = ["Property owner", "Family member", "Tenant / occupant", "Property manager / landlord", "Real estate professional", "Other / not sure"] as const;
---

<PpcLayout title="Rodent Droppings Cleanup | Aseptaclean" description="Rodent droppings, nesting material and contamination cleanup in the South Bay and Peninsula." canonicalPath={ppcRodent.route} stickyHeroSelector="#top" stickyFormHref="#contact" stickySecondaryLabel="Request a callback" showStickyBar={false}>
  <Fragment slot="header"><header class="approved-landing-header"><div class="lp-container lp-header"><a href="#top" class="lp-logo" aria-label="Aseptaclean home"><img src={site.business.logoUrl} width="900" height="215" alt="Aseptaclean" /></a><a class="lp-call" href={site.business.phoneUri} aria-label={`Call Aseptaclean at ${site.business.phone}`}>{site.business.phone}</a></div></header></Fragment>

  <div class="approved-landing lp-rodent" id="top">
    <section class="lp-hero"><div class="lp-container"><p class="lp-eyebrow">South Bay &amp; Peninsula</p><h1>Rodent droppings.<br />Handled with care.</h1><p class="lp-lead">We remove rodent droppings, nesting material, and contamination from affected areas of your home.</p><div class="lp-hero-actions"><a class="lp-button lp-button--light" href="#contact">Request a callback <span aria-hidden="true">→</span></a><a class="lp-button lp-button--outline-light" href={site.business.phoneUri} aria-label={`Call Aseptaclean at ${site.business.phone}`}>Call {site.business.phone}</a></div><p class="lp-reassurance">Start with a free conversation. Any paid assessment is agreed before booking.</p></div></section>
    <section class="lp-credibility"><div class="lp-container"><div class="lp-rule"></div><h2>Careful cleanup. Clear steps.</h2><p>Founded by Matthew Ruiz • Former Stanford Health Care &amp; BioMarin professional</p></div></section>
    <section class="lp-services lp-container"><h2>Help with what rodents leave behind.</h2>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 38h31c5-1 5-8 0-10 2-6-3-10-8-8 0-7-8-10-12-5-6-2-10 3-8 8-7 0-10 9-3 12Z"></path><path d="m21 5 1-3m13 9 3-2M19 26h.1M30 29h.1M24 35h.1"></path></svg><div><h3>Droppings &amp; nesting material</h3><p>Cleanup of affected areas, from a garage corner to a crawl space.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m18 3 4 10 10 4-10 4-4 10-4-10L4 17l10-4Zm19 23 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z"></path></svg><div><h3>Urine &amp; affected surfaces</h3><p>Cleaning and treatment based on the materials and conditions.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 12 35 5l9 5v31L14 46 5 40Zm0 0 9 6 30-8M14 18v28M5 20l9 6 30-8M24 15v10l9-2V13"></path></svg><div><h3>Contaminated contents</h3><p>A clear plan for what can be cleaned and what needs removal.</p></div></article>
      <p class="lp-scope-note">Cleanup follows pest control. We do not trap rodents or seal entry points.</p>
    </section>
    <figure class="lp-photo"><Image src={rodentAssessment} alt="Garage assessment with a gloved professional holding a tablet." width={2048} height={688} widths={srcsetWidths(rodentAssessment, [480, 768, 1024, 1440, 2048])} sizes="100vw" format="webp" quality={82} loading="lazy" decoding="async" /></figure>
    <section class="lp-process"><div class="lp-container"><h2>Know the work.<br class="lp-desktop-break" /> Know the price.</h2><p>We review the affected areas and explain the scope before cleanup begins.</p><ol><li><span>01</span><div><h3>Tell us what you found</h3><p>Start with a free phone or photo review. We’ll discuss the affected areas and a preliminary cleanup price range when possible.</p></div></li><li><span>02</span><div><h3>Assess and plan</h3><p>If a site visit is needed, we confirm the assessment fee before booking. You receive a written cleanup scope and price.</p></div></li><li><span>03</span><div><h3>Approve the cleanup</h3><p>Once you approve the scope and service terms, we arrange the cleanup. Your paid assessment fee is credited toward the assessed work.</p></div></li></ol></div></section>
    <section class="lp-pricing" aria-labelledby={ppcRodent.cost.id}><div class="lp-container">
      <p class="lp-eyebrow">{ppcRodent.cost.eyebrow}</p>
      <h2 id={ppcRodent.cost.id}>{ppcRodent.cost.heading}</h2>
      <p class="lp-pricing__lead">{ppcRodent.cost.lead}</p>
      <div class="lp-pricing__cards">
        {ppcRodent.cost.cards.map((card) => <article><h3>{card.title}</h3><p class="lp-pricing__label">Starting at</p><p class="lp-pricing__price">{card.price}</p><p>{card.body}</p></article>)}
      </div>
      <p class="lp-pricing__note">{ppcRodent.cost.note}</p>
      <div class="lp-assessment" aria-labelledby="assessment-options-heading">
        <h3 id="assessment-options-heading">{ppcRodent.cost.assessment.heading}</h3>
        <p class="lp-assessment__intro">{ppcRodent.cost.assessment.intro}</p>
        <div class="lp-assessment__cards">
          {ppcRodent.cost.assessment.options.map((option) => <article><p class="lp-assessment__type">{option.title}</p><p class="lp-assessment__price">{option.price}</p><p>{option.body}</p><h4>Includes:</h4><ul>{option.includes.map((item) => <li>{item}</li>)}</ul>{option.note && <p class="lp-assessment__note">{option.note}</p>}</article>)}
        </div>
        <div class="lp-assessment__credit"><strong>{ppcRodent.cost.assessment.creditHeading}</strong><p>{ppcRodent.cost.assessment.creditBody}</p></div>
        <p class="lp-assessment__complex">{ppcRodent.cost.assessment.complexLine}</p>
        <p class="lp-assessment__terms">{ppcRodent.cost.assessment.terms}</p>
        <a class="lp-button lp-assessment__cta" href="#contact">{ppcRodent.cost.assessment.buttonLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div></section>
    <section class="lp-faq" aria-labelledby="assessment-faq-heading"><div class="lp-container"><h2 id="assessment-faq-heading">Assessment questions</h2><div class="lp-faq__list">
      {ppcRodent.assessmentFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </div></div></section>
    <section class="lp-contact lp-container" id="contact"><h2 id="rodent-approved-contact-title">Let’s talk about the cleanup.</h2><p>Tell us how to reach you. The initial conversation is free. Any paid assessment is agreed before booking.</p><PpcHeroForm formId="rodent-approved-lead-form" headingId="rodent-approved-contact-title" entryRoute={`${ppcRodent.route}#contact`} situationValue="Rodent droppings or animal waste" campaignContext="rodent_assessment" approvedLanding roleOptions={roles} namePlaceholder="Full name" phonePlaceholder="Phone number" optionalDisclosureLabel="Add photos or details — optional" detailLabel="Additional information" detailRequired={false} photoHelper="Photos are uploaded securely with your inquiry." microcopy="Submitting does not authorize work." submitLabel="Request a callback" thankYouRoute={ppcRodent.thankYou.route} tone="light" turnstileSize="compact" /></section>
  </div>
  <Fragment slot="footer"><footer class="approved-landing-footer"><div class="lp-container lp-footer"><strong>Aseptaclean, LLC</strong><p>South Bay &amp; Peninsula</p></div></footer></Fragment>
</PpcLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.approved-landing a[href="#contact"]').forEach((link) => link.addEventListener("click", (event) => { event.preventDefault(); document.querySelector("#contact")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); document.querySelector<HTMLInputElement>("#rodent-approved-lead-form-name")?.focus({ preventScroll: true }); }));
</script>

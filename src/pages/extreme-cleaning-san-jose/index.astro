---
// Approved extreme public-service fragment, installed 2026-09-19. No campaign offer.
import BaseLayout from '@layouts/BaseLayout.astro';
import AssignedPhoto from '@components/ac/AssignedPhoto.astro';
import extremeHero from '../../assets/aseptaclean/public-pages/extreme-service/01-extreme-service-kitchen-cleanup.webp';
import extremeBathroom from '../../assets/aseptaclean/public-pages/extreme-service/02-extreme-service-neglected-bathroom.webp';
import extremeBelongings from '../../assets/aseptaclean/public-pages/extreme-service/03-extreme-service-belongings-review.webp';
import extremeAssessment from '../../assets/aseptaclean/public-pages/extreme-service/04-extreme-service-surface-assessment.webp';
import AcCompactForm from '@components/ac/AcCompactForm.astro';
import ExtremeHeader from '@components/extreme/ExtremeHeader.astro';
import ExtremeIcon from '@components/extreme/ExtremeIcon.astro';
import { site, legal } from '@data/site';
import { findServicePage } from '@data/servicePageCopy';
import '@styles/extreme-service-kit.css';
import '@styles/hero-consistency.css';
import '@styles/assigned-photos.css';
import '@styles/public-page-rhythm.css';
const page = findServicePage('/extreme-cleaning-san-jose/')!;
const faq = [["What is extreme cleaning?", "This service addresses heavy buildup, accumulated waste, and neglected rooms that need more preparation and cleaning than routine service. We assess the condition before confirming the work."], ["How is this different from a deep clean?", "Our detailed deep cleaning focuses on accessible rooms and surfaces. Extreme cleaning addresses heavier buildup and may require waste or contents to be cleared before cleaning can begin."], ["Do I need to clear the property first?", "No. Describe the property as it is. We\u2019ll discuss what needs to be moved, which belongings need attention, and any preparation required before work starts."], ["Will you throw everything away?", "No. Removal is based on what the authorized person approves. Tell us about important papers, valuables, and sentimental belongings so their handling can be addressed in the scope."], ["Can you remove every stain or odor?", "We do not promise complete stain or odor removal. During the assessment, we discuss the materials involved, likely cleaning limits, and whether other work may be needed."], ["How much does extreme cleaning cost?", "The affected areas, buildup, contents, access, and removal requirements determine the price. You receive a written proposal before deciding to proceed. Photos may help us understand the condition, but an on-site assessment may still be needed."]];
const schema = [
 {'@type':'Service',name:page.seoTitle,serviceType:'Extreme cleaning',provider:{'@id':new URL('/#business',site.urls.site).href},areaServed:{'@type':'City',name:'San Jose'}},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.urls.home},{'@type':'ListItem',position:2,name:'Extreme Cleaning',item:new URL(page.slug,site.urls.site).href}]},
 {'@type':'FAQPage',mainEntity:faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
];
---
<BaseLayout title={page.seoTitle} description={page.seoDescription} canonicalPath={page.slug} schema={schema} showMobileCta={false} extremeKit>
<ExtremeHeader slot="header" />
<footer slot="footer"><div class="wrap"><div class="footergrid"><div><a class="brand" href="/"><img src={site.business.logoReversedUrl} width="900" height="215" alt="Aseptaclean" /></a><p>Specialty property cleanup.<br>A clear path forward.</p><p><a href={site.business.phoneUri}>Call {site.business.phone}</a></p><p>Available 7 AM–7 PM</p></div><div><h3 class="ac-type-extreme-2 ac-type-extreme-9">Extreme Cleaning</h3><div class="footlinks"><a href="#extreme-scope">Cleanup Services</a><a href="#extreme-belongings">Belongings &amp; Contents</a><a href="#extreme-process">Our Process</a><a href="#extreme-faq">Common Questions</a></div></div><div><h3 class="ac-type-extreme-2 ac-type-extreme-9">Get in Touch</h3><div class="footlinks"><a href="#extreme-contact">Request an Assessment</a><a href="#extreme-area">Service Area</a><a href={site.business.phoneUri}>Call {site.business.phone}</a></div></div><div><h3 class="ac-type-extreme-2 ac-type-extreme-9">Serving</h3><div class="footlinks"><a href="#extreme-area">South Bay</a><a href="#extreme-area">Peninsula</a></div></div></div><div class="legal"><span>© 2026 Aseptaclean. All rights reserved.</span><div class="legal-links"><a href={site.urls.privacyPolicy}>Privacy Policy</a><a href={site.urls.terms}>Terms &amp; Conditions</a><a href={site.urls.cookiePolicy}>Cookie Policy</a><button class="termly-display-preferences" type="button">Cookie Preferences</button></div></div></div><div class="wrap legal-notes"><p data-nosnippet>{legal.scopeDisclaimer}</p><p data-nosnippet>Disposal and transport are handled by a City-authorized hauler engaged for the project.</p><p data-nosnippet>Cleaning only — not a decontamination, sterilization, or health-safety determination.</p></div></footer>

<section class="hero" id="extreme-top"><AssignedPhoto src={extremeHero} alt="Technician cleaning a heavily soiled kitchen stove." kind="hero" position="center 52%" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">Extreme Cleaning · South Bay &amp; Peninsula</p><h1 class="ac-type-extreme-0"><span class="hero-heading-line">Extreme Cleaning.</span><span class="hero-heading-line">A Fresh Start for Your Property.</span></h1><p class="body">Heavy grease, food waste, and buildup can leave a property needing more than a deep clean. We assess the affected rooms, explain what can be cleaned, and review any contents that need removal.</p><div class="actions"><a class="action light" href="#extreme-contact">Request an Assessment <ExtremeIcon name="arrow-up-right" /></a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<div class="wrap"><div class="trust"><div><ExtremeIcon name="clipboard-check" /><div><strong>Respectful Service</strong><span>Discuss the property as it is</span></div></div><div><ExtremeIcon name="user-round-check" /><div><strong>Written Plan &amp; Price</strong><span>Review the work before it starts</span></div></div><div><ExtremeIcon name="house" /><div><strong>Documented Work</strong><span>Records included in your scope</span></div></div></div></div>
<section class="section" id="extreme-scope"><div class="wrap"><div class="section-top"><div><p class="eyebrow">When everyday cleaning is not enough</p><h2 class="ac-type-extreme-1">Heavy buildup needs more than a quick clean.</h2></div><p>For homes and rental properties with heavy soil, accumulated waste, or rooms that have gone without regular cleaning.</p></div><div class="scope-grid">
<div class="scope-item"><ExtremeIcon name="cooking-pot" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Neglected Kitchens</h3><p>Built-up grease, food residue, and grime on accessible kitchen surfaces.</p></div></div>
<div class="scope-item"><ExtremeIcon name="bath" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Heavily Soiled Bathrooms</h3><p>Heavy soil and buildup on fixtures, floors, and other bathroom surfaces.</p></div></div>
<div class="scope-item"><ExtremeIcon name="trash-2" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Food Waste &amp; Debris</h3><p>Spoiled food and loose waste identified for removal as part of the cleanup.</p></div></div>
<div class="scope-item"><ExtremeIcon name="brush-cleaning" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Floors &amp; Surfaces</h3><p>Cleaning suited to the material, its condition, and the buildup present.</p></div></div>
<div class="scope-item"><ExtremeIcon name="package-open" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Cluttered Rooms</h3><p>Sorting and approved clearing to reach the areas that need cleaning.</p></div></div>
<div class="scope-item"><ExtremeIcon name="house" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-10">Rental &amp; Vacant Properties</h3><p>Cleanup of heavy buildup and waste after a difficult move-out or prolonged vacancy.</p></div></div>
</div></div></section>
<section class="section warm care-section"><div class="wrap"><div class="split"><div><div class="wide-heading"><p class="eyebrow">A practical way forward</p><h2 class="ac-type-extreme-1"><span class="ac-heading-line">Start where</span> <span class="ac-heading-line">the property is today.</span></h2></div><p>You do not need to clean before contacting us. Tell us which rooms need attention and what you want help with.</p><p>We’ll ask about access, belongings, and who can approve the work. If you’re arranging cleanup for someone else, explain your role and any deadline.</p><div class="actions"><a class="action" href="#extreme-contact">Request an Assessment <ExtremeIcon name="arrow-right" /></a></div></div><div><AssignedPhoto src={extremeBathroom} alt="Neglected bathroom with heavy buildup on the shower and surrounding surfaces." /></div></div><ul class="checks"><li><ExtremeIcon name="check" />Identify the rooms that need attention.</li><li><ExtremeIcon name="check" />Point out belongings that need review.</li><li><ExtremeIcon name="check" />Discuss access and your timing.</li></ul></div></section>
<section class="section" id="extreme-belongings">
<div class="wrap">
<div class="split"><div><div class="wide-heading"><p class="eyebrow">Your belongings matter</p><h2 class="ac-type-extreme-1"><span class="ac-heading-line">A thorough cleanup.</span> <span class="ac-heading-line">Thoughtful decisions.</span></h2></div><p>Important papers and personal belongings can be mixed in with accumulated waste. Tell us about anything that needs particular attention.</p><p>We review what stays, what needs a decision, and what you authorize us to remove. Any sorting or inventory is included in the job scope before work begins.</p></div>
<div class="assigned-photo-frame"><AssignedPhoto src={extremeBelongings} alt="Black-gloved technician examining an armchair cushion." kind="fill" /><div class="image-note">Your property. Your decisions.<small>Review proposed removal before work starts.</small></div></div>
</div>
<div class="audience belongings-steps">
<div><ExtremeIcon name="package-check" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-4">Review what is there</h3><p>Identify important belongings and items that need a closer look.</p></div></div>
<div><ExtremeIcon name="messages-square" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-4">Agree on the next step</h3><p>Review proposed cleaning and removal with the person authorizing the work.</p></div></div>
<div><ExtremeIcon name="clipboard-list" /><div><h3 class="ac-type-extreme-2 ac-type-extreme-4">Put the scope in writing</h3><p>Record handling instructions and approved removal before cleanup starts.</p></div></div>
</div>
</div>
</section>
<section class="band"><div class="wrap"><div><h2 class="ac-type-extreme-1 ac-type-extreme-5">Overwhelmed by the cleanup?</h2><p>Start with the property’s location and a brief description. You do not need to know which service to request.</p></div><a class="action light" href="#extreme-contact">Request an Assessment <ExtremeIcon name="arrow-right" /></a></div></section>
<section class="section" id="extreme-process"><div class="wrap"><p class="eyebrow">Our process</p><h2 class="ac-type-extreme-1">A clear plan from first call to finish.</h2><div class="steps"><div class="step"><b>01</b><h3 class="ac-type-extreme-2 ac-type-extreme-6">Tell Us What You Need</h3><p>Share the location, affected rooms, and general condition. Tell us about access limits or a deadline.</p></div><div class="step"><b>02</b><h3 class="ac-type-extreme-2 ac-type-extreme-6">Review the Plan</h3><p>We assess the surfaces, buildup, and contents. You review the proposed work, its limits, and the written price.</p></div><div class="step"><b>03</b><h3 class="ac-type-extreme-2 ac-type-extreme-6">Complete the Cleanup</h3><p>We clear approved waste and contents, then clean the accessible surfaces included in the job.</p></div><div class="step"><b>04</b><h3 class="ac-type-extreme-2 ac-type-extreme-6">Review &amp; Document</h3><p>Review the completed work, receive the records included in your scope, and discuss any remaining property needs.</p></div></div></div></section>
<section class="section warm before-work"><div class="wrap">
<div class="split"><div><div class="wide-heading"><p class="eyebrow">Before work begins</p><h2 class="ac-type-extreme-1"><span class="ac-heading-line">Know what</span> <span class="ac-heading-line">the cleanup includes.</span></h2></div><p>The amount of buildup, surface condition, contents, and access affect the work and price. We explain which areas we can clean and where cleaning may have limits.</p><p>If we uncover conditions that change the job, we discuss the additional work and cost before you approve it.</p><div class="actions"><a class="action" href="#extreme-contact">Request an Assessment</a></div></div>
<AssignedPhoto src={extremeAssessment} alt="Black-gloved technician inspecting a soiled utility floor with a flashlight." class="assigned-photo--wide" />
</div>
<div class="boundaries"><div><h3 class="ac-type-extreme-2">Cleanup &amp; Removal</h3><p>Your proposal identifies the rooms and surfaces to clean, items approved for removal, and any suitable disinfection. Removal and disposal arrangements are confirmed for the specific job.</p></div><div><h3 class="ac-type-extreme-2">Separate Services</h3><p>Pest control, repairs, and replacement materials are not included. Blood, rodent waste, or other contamination may require a different cleanup scope, which we review before proceeding.</p></div></div>
<p class="scope-note" data-nosnippet>{legal.documentationDisclaimer}</p></div></section>
<section class="section" id="extreme-faq"><div class="wrap faq-layout"><div class="faq-heading"><p class="eyebrow">Common questions</p><h2 class="ac-type-extreme-1">A few things you may be wondering.</h2></div><div class="faq-list">
<details open=""><summary>What is extreme cleaning?</summary><p>This service addresses heavy buildup, accumulated waste, and neglected rooms that need more preparation and cleaning than routine service. We assess the condition before confirming the work.</p></details>
<details><summary>How is this different from a deep clean?</summary><p>Our detailed deep cleaning focuses on accessible rooms and surfaces. Extreme cleaning addresses heavier buildup and may require waste or contents to be cleared before cleaning can begin.</p></details>
<details><summary>Do I need to clear the property first?</summary><p>No. Describe the property as it is. We’ll discuss what needs to be moved, which belongings need attention, and any preparation required before work starts.</p></details>
<details><summary>Will you throw everything away?</summary><p>No. Removal is based on what the authorized person approves. Tell us about important papers, valuables, and sentimental belongings so their handling can be addressed in the scope.</p></details>
<details><summary>Can you remove every stain or odor?</summary><p>We do not promise complete stain or odor removal. During the assessment, we discuss the materials involved, likely cleaning limits, and whether other work may be needed.</p></details>
<details><summary>How much does extreme cleaning cost?</summary><p>The affected areas, buildup, contents, access, and removal requirements determine the price. You receive a written proposal before deciding to proceed. Photos may help us understand the condition, but an on-site assessment may still be needed.</p></details>
</div><div class="faq-contact"><p>Have a question about the condition of your property? Call us to discuss it.</p><div class="actions"><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<section class="section warm" id="extreme-area"><div class="wrap coverage"><div><p class="eyebrow">Extreme cleaning for homes and properties in Santa Clara County and San Mateo County. Share the location and cleanup needs so we can confirm availability.</p><h2 class="ac-type-extreme-1">South Bay<br>&amp; Peninsula.</h2><p>Extreme cleaning for homeowners, families, property managers, and people responsible for a neglected property.</p></div><div><h3 class="ac-type-extreme-2 ac-type-extreme-7">Santa Clara County</h3><ul><li>Campbell</li><li>Cupertino</li><li>Gilroy</li><li>Los Altos</li><li>Los Altos Hills</li><li>Los Gatos</li><li>Milpitas</li><li>Monte Sereno</li><li>Morgan Hill</li><li>Mountain View</li><li>Palo Alto</li><li>San Jose</li><li>Santa Clara</li><li>Saratoga</li><li>Sunnyvale</li></ul></div><div><h3 class="ac-type-extreme-2 ac-type-extreme-7">San Mateo County</h3><ul><li>Atherton</li><li>Belmont</li><li>Brisbane</li><li>Burlingame</li><li>Colma</li><li>Daly City</li><li>East Palo Alto</li><li>Foster City</li><li>Half Moon Bay</li><li>Hillsborough</li><li>Menlo Park</li><li>Millbrae</li><li>Pacifica</li><li>Portola Valley</li><li>Redwood City</li><li>San Bruno</li><li>San Carlos</li><li>San Mateo</li><li>Woodside</li></ul></div></div></section>
<section class="quiet"><div class="wrap"><div><h2 class="ac-type-extreme-1 ac-type-extreme-8">Let’s make a plan for your property.</h2><p>Tell us which rooms need attention and what you want the cleanup to accomplish.</p></div><a class="action" href="#extreme-contact">Request an Assessment</a></div></section>
<section class="section" id="extreme-contact"><div class="wrap"><div class="formwrap"><p class="eyebrow">Contact Aseptaclean</p><h2 id="extreme-form-title" class="center ac-type-extreme-1">Tell us what needs cleanup.</h2><p>Share the property’s location, affected rooms, and general condition. A short description is enough to begin.</p><AcCompactForm formId="service-form" entryRoute="/extreme-cleaning-san-jose/#service-form" preselectRoute="/extreme-cleaning-san-jose/" tone="light" headingId="extreme-form-title" kit extremeKit /></div></div></section>

</BaseLayout>
<script>
const root=document.getElementById('ac-extreme');
root?.querySelectorAll<HTMLAnchorElement>('a[href="#extreme-contact"]').forEach(link=>link.addEventListener('click',(event)=>{event.preventDefault();document.getElementById('extreme-contact')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});document.querySelector<HTMLInputElement>('#service-form-name')?.focus({preventScroll:true});}));
</script>

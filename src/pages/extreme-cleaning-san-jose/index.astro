            {answer.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ══ 08 · CLOSE ═══════════════════════════════════════════════════════════════════════════
      Typographic on navy, same as the four prior rebuilds' close — no image to lead with here
      either, and repeating that composition keeps the sitewide rhythm rather than improvising a
      fifth close pattern. */}
  <section class="ec-close" aria-labelledby="close-title">
    <div class="ec-close__inner">
      <div class="ec-close__copy">
        <h2 id="close-title" class="ac-type-h2-final">
          Not sure how far the property has gone?
        </h2>
        <p class="ec-close__lede">
          You do not need to diagnose it. Send photos or tell us what is happening. We will
          determine whether the property needs detailed cleaning, extreme cleanup, clearing first,
          or another service.
        </p>
      </div>

      <div class="ec-close__action">
        <a class="ec-btn ec-btn--light" href={assessmentHref}>Send Photos for Review</a>
        <div class="ec-close__secondary">
          {phoneHref && <a href={phoneHref}>Call {site.business.phone}</a>}
          {smsHref && <a href={smsHref}>{site.offer.secondaryCta}</a>}
        </div>
        <p class="ec-close__note">
          Submitting a request does not authorize work or create a service agreement.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>


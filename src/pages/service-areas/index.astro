---
// UNPUBLISHED DRAFT — docs/19-SYSTEM-AND-SITEMAP.md §2.1 Phase 3, §2.2 SERVICE AREAS HUB spec
// ("Contents: county framing paragraph, city pill grid, one short paragraph per area cluster...
// links down to city pages as they exist. Parent for all Phase 3c pages."), §2.2 CITY PAGES
// ("Hard gate: ≥1 completed job in that city... No verified original content → no page.").
// Ships noindex, excluded from sitemap.xml.ts, not linked from nav/footer.
//
// No city page exists yet (confirmed: no src/pages/service-areas/{city}/ directories exist in
// this repo), so per the hard content gate, no city links render — this page renders the
// cluster paragraphs and the existing AreasWeServe pill component only, exactly as the spec
// describes for the current state ("city links rendered only when city pages exist — none
// yet"). The city-link list below is written to render conditionally so this file requires no
// further edits once the first real city page ships — see cityPages below.
//
// DIFFERENTIATION: this is the only page in the batch that is a directory/hub, not a
// buyer-decision service page — no Track A/B, no fiduciary block, no FAQ, no PROOF section (a
// hub has no single job to cite). Its first section after the hero is the county framing
// paragraph plus the pill grid, structurally distinct from every recognition/scope pattern
// used elsewhere in this batch.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import AreasWeServe from "@components/AreasWeServe.astro";
import RequestForm from "@components/RequestForm.astro";
import { serviceAreasHub } from "@data/servicePages";
import { serviceAreasPage } from "@data/doc27CompanyPages";
import { site } from "@data/site";

// Phase 3c gate (docs/19-SYSTEM-AND-SITEMAP.md §2.1): "one per city actually worked; hard
// content gate." Populate this list only once a real /service-areas/{city}/ page exists with
// ≥1 completed job and genuine local content — never pre-link a page that doesn't exist.
const cityPages: ReadonlyArray<{ city: string; href: string }> = [];

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Service Areas",
        item: new URL(serviceAreasHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={serviceAreasPage.seoTitle}
  description={serviceAreasPage.metaDescription}
  canonicalPath={serviceAreasHub.slug}
  schema={schema}
>
  <PageHeader
    headingId="areas-title"
    eyebrow={serviceAreasPage.eyebrow}
    h1={serviceAreasPage.h1}
    lede={serviceAreasPage.lead}
    crumb="Service Areas"
  />

  <AreasWeServe />

  <section class="clusters" aria-labelledby="clusters-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">By area</p>
      <h2 id="clusters-title" class="ac-type-h2 clusters__heading">{serviceAreasPage.h2}</h2>
      <p class="clusters__body">{serviceAreasPage.body}</p>
      <div class="clusters__grid">
        {
          serviceAreasHub.clusters.map((cluster) => (
            <div class="cluster-card">
              <h3 class="ac-type-h3">{cluster.name}</h3>
              <p>{cluster.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    cityPages.length > 0 && (
      <section class="city-links" aria-labelledby="city-links-title">
        <div class="ac-measure-wide">
          <p class="ac-eyebrow">City pages</p>
          <h2 id="city-links-title" class="ac-type-h2">Cities with a completed project on record</h2>
          <ul class="city-links__list">
            {cityPages.map((entry) => (
              <li>
                <a href={entry.href}>Estate cleanout in {entry.city} →</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="services-up" aria-labelledby="services-up-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">Start with the situation, not the city</p>
      <h2 id="services-up-title" class="ac-type-h3">Every service page covers the same service area</h2>
      <nav class="services-up__list" aria-label="Service pages">
        <a href="/estate-cleanout-san-jose/">Estate cleanout →</a>
        <a href="/hoarding-cleanup-san-jose/">Hoarding cleanup →</a>
        <a href="/animal-waste-cleanup-san-jose/">Animal waste & organic condition cleaning →</a>
        <a href="/senior-downsizing-san-jose/">Senior downsizing →</a>
      </nav>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .clusters {
    background: var(--ac-color-paper);
  }

  .clusters__heading {
    max-width: 36ch;
    margin-top: var(--ac-space-3);
  }

  .clusters__body {
    max-width: 58ch;
    margin-top: var(--ac-space-4);
    color: var(--ac-color-ink-600);
  }

  .clusters__grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .cluster-card {
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
  }

  .cluster-card h3 {
    margin-bottom: 8px;
  }

  .cluster-card p {
    max-width: 44ch;
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }

  .city-links {
    background: var(--ac-color-warm-white);
  }

  .city-links__list {
    display: grid;
    gap: 10px;
    margin: var(--ac-space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .city-links__list a {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    text-decoration: none;
  }

  .city-links__list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .services-up {
    background: var(--ac-color-warm-white);
    padding-top: 0;
  }

  .services-up__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: var(--ac-space-4);
  }

  .services-up__list a {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    text-decoration: none;
  }

  .services-up__list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 40rem) {
    .clusters__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .services-up__list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
    }
  }
</style>

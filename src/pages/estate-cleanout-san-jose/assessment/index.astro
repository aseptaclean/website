---
import { Image } from "astro:assets";
import PpcLayout from "@layouts/PpcLayout.astro";
import PpcHeroForm from "@components/ppc/PpcHeroForm.astro";
import { srcsetWidths } from "@components/imageWidths";
import inheritedHome from "../../../assets/aseptaclean/approved-landings/inherited-home.png";
import { site } from "@data/site";
import { ppcEstate } from "@data/ppcEstate";
import "@styles/approved-landing.css";

const roles = ["Family member", "Executor / personal representative", "Trustee / fiduciary", "Real estate professional", "Property owner", "Other / not sure"] as const;
---

<PpcLayout title="Inherited Home Cleanouts | Aseptaclean" description="Inherited home cleanouts, hoarding and contamination cleanup in the South Bay and Peninsula." canonicalPath={ppcEstate.route} stickyHeroSelector="#top" stickyFormHref="#contact" stickySecondaryLabel="Request a callback" showStickyBar={false}>
  <Fragment slot="header"><header class="approved-landing-header"><div class="lp-container lp-header"><a href="#top" class="lp-logo" aria-label="Aseptaclean home"><img src={site.business.logoUrl} width="900" height="215" alt="Aseptaclean" /></a><a class="lp-call" href={site.business.phoneUri} aria-label={`Call Aseptaclean at ${site.business.phone}`}>{site.business.phone}</a></div></header></Fragment>

  <div class="approved-landing lp-estate" id="top">
    <section class="lp-hero"><div class="lp-container"><p class="lp-eyebrow">South Bay &amp; Peninsula</p><h1>Inherited home.<br />Overwhelming cleanup.</h1><p class="lp-lead">We clear packed homes and handle contamination—so you can move forward without doing it all yourself.</p><a class="lp-button lp-button--light" href="#contact">Request a callback <span aria-hidden="true">→</span></a><p class="lp-reassurance">Start with a conversation. No sorting required.</p></div></section>
    <section class="lp-credibility"><div class="lp-container"><div class="lp-rule"></div><h2>Careful handling. Clear accountability.</h2><p>Founded by Matthew Ruiz • Former Stanford Health Care &amp; BioMarin professional</p></div></section>
    <section class="lp-services lp-container"><h2>A full home doesn’t have to fall on you.</h2>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M4 22 24 4l20 18M9 18v26h11V29h8v15h11V18"></path></svg><div><h3>Packed rooms &amp; hoarding</h3><p>We carefully clear packed spaces, from single rooms to entire homes.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="10" cy="18" rx="4" ry="6"></ellipse><ellipse cx="20" cy="9" rx="4" ry="6"></ellipse><ellipse cx="31" cy="9" rx="4" ry="6"></ellipse><ellipse cx="40" cy="20" rx="4" ry="6"></ellipse><path d="M13 32c3-3 5-10 11-10s8 7 11 10c7 8 0 14-6 10-4-2-6-2-10 0-7 4-13-2-6-10Z"></path></svg><div><h3>Rodent &amp; animal waste</h3><p>We safely handle contamination and restore spaces for a cleaner, healthier home.</p></div></article>
      <article><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m24 3 19 10v23L24 46 5 36V13Zm0 20v23M5 13l19 10 19-10M15 8l19 10v10"></path></svg><div><h3>Belongings that need care</h3><p>We sort with care, set aside what you want to keep, and responsibly remove the rest.</p></div></article>
    </section>
    <figure class="lp-photo"><Image src={inheritedHome} alt="Inherited home with books, furniture and boxes." width={2048} height={683} widths={srcsetWidths(inheritedHome, [480, 768, 1024, 1440, 2048])} sizes="100vw" format="webp" quality={82} loading="lazy" decoding="async" /></figure>
    <section class="lp-process"><div class="lp-container"><h2>Your decisions come first.</h2><p>We agree on what stays, what goes, and what needs more family review before work begins.</p><ol><li><span>01</span><div><h3>Talk through the home</h3><p>Tell us about the property and your goals.</p></div></li><li><span>02</span><div><h3>Review the scope and price</h3><p>We walk through the plan and answer your questions.</p></div></li><li><span>03</span><div><h3>Approve the cleanup plan</h3><p>We get your go-ahead before any work begins.</p></div></li></ol></div></section>
    <section class="lp-contact lp-container" id="contact"><h2 id="estate-approved-contact-title">Let’s talk about the home.</h2><p>Tell us how to reach you.</p><PpcHeroForm formId="estate-approved-lead-form" headingId="estate-approved-contact-title" entryRoute={`${ppcEstate.route}#contact`} situationValue="Inherited or estate property" campaignContext="estate_assessment" approvedLanding roleOptions={roles} namePlaceholder="Name" phonePlaceholder="Phone" optionalDisclosureLabel="Email, role & details (optional)" detailLabel="Additional information" detailRequired={false} photoHelper="Photos are uploaded securely with your inquiry." microcopy="Submitting does not authorize work." submitLabel="Request a callback →" thankYouRoute={ppcEstate.thankYou.route} tone="light" turnstileSize="compact" /></section>
  </div>
  <Fragment slot="footer"><footer class="approved-landing-footer"><div class="lp-container lp-footer"><strong>Aseptaclean, LLC</strong><p>South Bay &amp; Peninsula</p></div></footer></Fragment>
</PpcLayout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.approved-landing a[href="#contact"]').forEach((link) => link.addEventListener("click", (event) => { event.preventDefault(); document.querySelector("#contact")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); document.querySelector<HTMLInputElement>("#estate-approved-lead-form-name")?.focus({ preventScroll: true }); }));
</script>

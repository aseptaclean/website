---
// Estate public-service kit only. Campaign route and commercial offer remain separate.
import BaseLayout from '@layouts/BaseLayout.astro';
import AssignedPhoto from '@components/ac/AssignedPhoto.astro';
import estateHero from '../../assets/aseptaclean/public-pages/estate-service/01-estate-service-hero.webp';
import estateSort from '../../assets/aseptaclean/public-pages/estate-service/02-estate-service-four-sorting-tarps.webp';
import estateDocument from '../../assets/aseptaclean/public-pages/estate-service/04-estate-service-inventory-documentation.webp';
import AcCompactForm from '@components/ac/AcCompactForm.astro';
import EstateHeader from '@components/estate/EstateHeader.astro';
import EstateIcon from '@components/estate/EstateIcon.astro';
import { site, legal } from '@data/site';
import '@styles/estate-service-kit.css';
import '@styles/hero-consistency.css';
import '@styles/assigned-photos.css';
const faq = [["Do I need to sort everything before you arrive?", "No. We can include sorting in the work. Start by telling us what you know you want to keep, any belongings you\u2019re looking for, and areas that should be left alone."], ["Can you work with an executor or trustee?", "Yes. We work with families, executors, trustees, fiduciaries, and other authorized representatives. Before starting, we establish who can approve the work and make decisions about the belongings."], ["Can I manage the cleanout from out of town?", "Tell us where you\u2019re based and who can provide access. We\u2019ll discuss how updates and decisions can be handled, then confirm the arrangements before scheduling."], ["Do you inventory every item?", "The inventory covers what is listed in your scope. We can discuss selected-item records or a request for more detailed inventory work. Cleanup records do not replace an appraisal or estate accounting."], ["What happens to donations and personal papers?", "We can separate belongings intended for donation and set personal papers aside for review as part of the sorting work. Any donation coordination or shredding would need to be discussed and confirmed separately."], ["Do you value or sell estate items?", "This service does not include appraisals or estate sales. Tell us which belongings need to be set aside for you or your chosen specialist to review."], ["What if there is heavy clutter or contamination?", "You can contact us with the property as it is. Describe any known conditions, such as packed rooms or rodent droppings. We\u2019ll assess the cleanup needed and explain what we can take on."]];
const schema = [
 { '@type':'Service', name:'Estate Cleanout in San Jose', serviceType:'Estate cleanout', provider:{'@id':new URL('/#business',site.urls.site).href}, areaServed:{'@type':'City',name:'San Jose'} },
 { '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.urls.home},{'@type':'ListItem',position:2,name:'Estate Cleanouts',item:new URL('/estate-cleanout-san-jose/',site.urls.site).href}] },
 { '@type':'FAQPage', mainEntity:faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}})) }
];
---
<BaseLayout title="Estate Cleanout in San Jose | Aseptaclean" description="Estate cleanout in San Jose for families, executors and trustees. Important items are protected and a save list is agreed before any approved contents leave the property." canonicalPath="/estate-cleanout-san-jose/" schema={schema} showMobileCta={false} estateKit>
<EstateHeader slot="header" />
<footer slot="footer"><div class="wrap"><div class="footergrid"><div><a class="brand" href="/"><img src={site.business.logoReversedUrl} width="900" height="215" alt="Aseptaclean" /></a><p>Specialized property cleanup.<br/>A clear path forward.</p><p><a href={site.business.phoneUri}>Call {site.business.phone}</a></p></div><div><h3 class="ac-type-estate-h3 ac-type-estate-footer">Estate Cleanout</h3><div class="footlinks"><a href="#estate-scope">Cleanout Services</a><a href="#estate-belongings">Belongings &amp; Contents</a><a href="#estate-process">Our Process</a><a href="#estate-faq">Common Questions</a></div></div><div><h3 class="ac-type-estate-h3 ac-type-estate-footer">Get in Touch</h3><div class="footlinks"><a href="#estate-contact">Request an Assessment</a><a href="#estate-area">Service Area</a><a href={site.business.phoneUri}>Call {site.business.phone}</a></div></div><div><h3 class="ac-type-estate-h3 ac-type-estate-footer">Serving</h3><div class="footlinks"><a href="#estate-area">South Bay</a><a href="#estate-area">Peninsula</a></div></div></div><div class="legal"><span>© 2026 Aseptaclean. All rights reserved.</span><div class="legal-links"><a href={site.urls.privacyPolicy}>Privacy Policy</a><a href={site.urls.terms}>Terms &amp; Conditions</a><a href={site.urls.cookiePolicy}>Cookie Policy</a><button class="termly-display-preferences" type="button">Cookie Preferences</button></div></div></div><div class="wrap legal-notes"><p data-nosnippet>{legal.scopeDisclaimer}</p><p data-nosnippet>Disposal and transport are handled by a City-authorized hauler engaged for the project.</p><p data-nosnippet>Aseptaclean may clean accepted conditions left behind after an appropriately licensed pest operator has confirmed the active pest issue is resolved. Aseptaclean does not inspect for, identify, exclude, trap, or treat pests.</p><p data-nosnippet>Cleaning only — not a decontamination, sterilization, or health-safety determination.</p></div></footer>

<section class="hero" id="estate-top"><AssignedPhoto src={estateHero} alt="Professional reviewing belongings in a furnished study." kind="hero" position="center 45%" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">Estate Cleanout · South Bay &amp; Peninsula</p><h1 class="ac-type-estate-h1">Estate Cleanout.<br/>Care for What Matters.</h1><p class="hero-lead">A home to clear. Belongings to sort. Decisions that deserve care.</p><p class="body">Aseptaclean helps families, executors, and trustees handle estate cleanouts, from sorting personal belongings to clearing and cleaning the property. We work from your priorities, with the work and price in writing before we begin.</p><div class="actions"><a class="action light" href="#estate-contact">Request an Assessment <EstateIcon name="arrow-up-right" /></a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<div class="wrap"><div class="trust"><div><EstateIcon name="clipboard-check" /><div><strong>Written Plan &amp; Price</strong><span>Review the work before you commit</span></div></div><div><EstateIcon name="package-check" /><div><strong>Your Belongings Matter</strong><span>Decide what stays, goes, or needs review</span></div></div><div><EstateIcon name="camera" /><div><strong>Documented Work</strong><span>Photos and inventory included as agreed</span></div></div></div></div>
<section class="section"><div class="wrap split"><div><p class="eyebrow">For families, executors &amp; trustees</p><h2 class="ac-type-estate-h2">You don’t have to sort through it alone.</h2><p>You may know the home needs to be cleared without knowing where to begin. There may be rooms you haven’t looked through, papers you need to keep, and belongings the family still needs to discuss.</p><p>We help with the work around those decisions: sorting the contents, setting aside items for review, clearing what’s approved, and cleaning the areas included in your proposal.</p><p>You can start with the home as it is.</p></div><div><AssignedPhoto src={estateSort} alt="Four tarps outside a garage marked KEEP, DONATE, REVIEW, and DISCARD." position="center" /><p class="photo-caption">Illustrative photo</p></div></div></section>
<section class="section warm" id="estate-scope"><div class="wrap"><div class="section-top"><div><p class="eyebrow">What we can help with</p><h2 class="ac-type-estate-h2"><span>More than clearing out the rooms.</span></h2></div><p>From sorting the contents to cleaning cleared spaces, we help you work through the property. Your proposal explains which services are included.</p></div><div class="scope-grid">
<div class="scope-item"><EstateIcon name="package-open" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Sorting &amp; Separation</h3><p>Separate belongings to keep, remove, or hold for review, following the instructions for your job.</p></div></div>
<div class="scope-item"><EstateIcon name="clipboard-list" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Inventory &amp; Photos</h3><p>Create a record of selected belongings, with photos and details included in your scope.</p></div></div>
<div class="scope-item"><EstateIcon name="folder-lock" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Important Papers</h3><p>Set aside personal papers found during sorting so you can review them before making a decision.</p></div></div>
<div class="scope-item"><EstateIcon name="house" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Property Cleanout</h3><p>Clear approved contents from rooms, garages, and storage areas, with disposal arrangements confirmed before work begins.</p></div></div>
<div class="scope-item"><EstateIcon name="heart-handshake" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Items for Donation</h3><p>Set aside belongings you want considered for donation. We discuss the arrangements needed before including further help.</p></div></div>
<div class="scope-item"><EstateIcon name="sparkles" /><div><h3 class="ac-type-estate-h3 ac-type-estate-scope">Cleaning After Removal</h3><p>Clean the rooms and surfaces included in your proposal once the approved contents have been cleared.</p></div></div>
</div></div></section>
<section class="section" id="estate-belongings"><div class="wrap"><div class="split"><div><p class="eyebrow">Your belongings matter</p><h2 class="ac-type-estate-h2">Decide what stays.<br/>Approve what goes.</h2><p>A photograph tucked into a drawer. A folder of financial papers. Something a family member asked you to keep.</p><p>Before sorting begins, tell us what needs attention. We establish what stays, what can be removed, and what needs your review. Those instructions guide the work.</p></div><div aria-label="Illustrative family member and professional reviewing a property plan" class="photo p2" role="img"><div class="image-note">Clear instructions. Careful handling.<small>Decisions agreed before removal.</small></div></div></div><div class="audience belongings-steps"><div><EstateIcon name="search" /><div><h3 class="ac-type-estate-h3 ac-type-estate-audience">Identify what matters</h3><p>Tell us about keepsakes, papers, and specific belongings you want us to look for.</p></div></div><div><EstateIcon name="tags" /><div><h3 class="ac-type-estate-h3 ac-type-estate-audience">Agree on each category</h3><p>Separate decisions already made from belongings that still need a closer look.</p></div></div><div><EstateIcon name="clipboard-check" /><div><h3 class="ac-type-estate-h3 ac-type-estate-audience">Record the decisions</h3><p>Keep the handling instructions and approved changes in writing.</p></div></div></div></div></section>
<section class="band"><div class="wrap"><div><h2 class="ac-type-estate-h2 ac-type-estate-band">A full house. A place to start.</h2><p>Tell us what you’re responsible for and what you need help getting done. You don’t have to work out the entire cleanout before you call.</p></div><a class="action light" href="#estate-contact">Request an Assessment <EstateIcon name="arrow-right" /></a></div></section>
<section class="section warm before-work"><div class="wrap"><div class="split"><div><p class="eyebrow">Inventory &amp; documentation</p><h2 class="ac-type-estate-h2">Know what was done.<br/>Keep a record of it.</h2><p>When you’re responsible for a property, it helps to have a record you can refer back to. We discuss the photos, selected-item inventory, and completion records you need before work begins.</p><p>Tell us if you’re managing the cleanout from another city or sharing updates with family or a professional adviser.</p></div><AssignedPhoto src={estateDocument} alt="Black-gloved hands photographing a labeled wooden jewelry chest." position="center" class="assigned-photo--wide" /></div><div class="boundaries"><div><h3 class="ac-type-estate-h3">Records matched to your needs</h3><p>Your scope can include before-and-after photos, records of selected belongings, and a summary of completed work. We confirm the detail included before you approve the price.</p></div><div><h3 class="ac-type-estate-h3">Managing the property from a distance</h3><p>We discuss access, your point of contact, and how decisions will reach you. Communication arrangements are confirmed before the work is scheduled.</p></div></div><p class="scope-note" data-nosnippet>{legal.documentationDisclaimer}</p><div class="founder-note"><p>Aseptaclean founder Matthew Ruiz worked in surgical pathology at Stanford Health Care and pharmaceutical manufacturing at BioMarin. Both roles required careful handling, written procedures, and accurate records.</p><p>He brings those habits to property cleanup: understand the task, follow the instructions, and document the work.</p><p data-nosnippet>{legal.founderAuthorityLimit}</p></div></div></section>
<section class="section" id="estate-process"><div class="wrap"><p class="eyebrow">Our process</p><h2 class="ac-type-estate-h2">A clear plan from first call to finish.</h2><div class="steps"><div class="step"><b>01</b><h3 class="ac-type-estate-h3 ac-type-estate-step">Tell Us About the Home</h3><p>Share the location, property condition, and what you need help sorting, clearing, or cleaning.</p></div><div class="step"><b>02</b><h3 class="ac-type-estate-h3 ac-type-estate-step">Approve Your Plan</h3><p>Review the proposed work, belongings instructions, records, and written price.</p></div><div class="step"><b>03</b><h3 class="ac-type-estate-h3 ac-type-estate-step">Sort, Clear &amp; Clean</h3><p>We complete the approved tasks and contact you when a decision needs your attention.</p></div><div class="step"><b>04</b><h3 class="ac-type-estate-h3 ac-type-estate-step">Review the Results</h3><p>Review the finished work and receive the records included in your scope.</p></div></div></div></section>
<section class="section warm"><div class="wrap"><div class="section-top"><div><p class="eyebrow">Before work begins</p><h2 class="ac-type-estate-h2"><span>A written scope. A price you can review.</span></h2></div><p>The work depends on what’s inside the property and how it needs to be handled. We assess those details before preparing your proposal.</p></div><div class="boundaries"><div><h3 class="ac-type-estate-h3">What shapes your quote</h3><p>The amount of belongings, sorting time, access, inventory detail, disposal, and cleaning all affect the price. Let us know about stairs, parking restrictions, or a deadline.</p></div><div><h3 class="ac-type-estate-h3">When the property needs more</h3><p>Some estate properties also need help with heavy accumulation, rodent waste, or biohazard conditions. We assess those needs and explain any additional work and cost before you approve it.</p></div></div><div class="actions"><a class="action" href="#estate-contact">Request an Assessment</a><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></section>
<section class="section" id="estate-faq"><div class="wrap faq-layout"><div class="faq-heading"><p class="eyebrow">Common questions</p><h2 class="ac-type-estate-h2">A few things you may be wondering.</h2></div><div class="faq-list">
<details open=""><summary>Do I need to sort everything before you arrive?</summary><p>No. We can include sorting in the work. Start by telling us what you know you want to keep, any belongings you’re looking for, and areas that should be left alone.</p></details>
<details><summary>Can you work with an executor or trustee?</summary><p>Yes. We work with families, executors, trustees, fiduciaries, and other authorized representatives. Before starting, we establish who can approve the work and make decisions about the belongings.</p></details>
<details><summary>Can I manage the cleanout from out of town?</summary><p>Tell us where you’re based and who can provide access. We’ll discuss how updates and decisions can be handled, then confirm the arrangements before scheduling.</p></details>
<details><summary>Do you inventory every item?</summary><p>The inventory covers what is listed in your scope. We can discuss selected-item records or a request for more detailed inventory work. Cleanup records do not replace an appraisal or estate accounting.</p></details>
<details><summary>What happens to donations and personal papers?</summary><p>We can separate belongings intended for donation and set personal papers aside for review as part of the sorting work. Any donation coordination or shredding would need to be discussed and confirmed separately.</p></details>
<details><summary>Do you value or sell estate items?</summary><p>This service does not include appraisals or estate sales. Tell us which belongings need to be set aside for you or your chosen specialist to review.</p></details>
<details><summary>What if there is heavy clutter or contamination?</summary><p>You can contact us with the property as it is. Describe any known conditions, such as packed rooms or rodent droppings. We’ll assess the cleanup needed and explain what we can take on.</p></details>
</div><div class="faq-contact"><p>Have a question about the home or its contents? Let’s talk it through.</p><div class="actions"><a class="action outline" href={site.business.phoneUri}>Call {site.business.phone}</a></div></div></div></section>
<section class="section warm" id="estate-area"><div class="wrap coverage"><div><p class="eyebrow">Service area</p><h2 class="ac-type-estate-h2">South Bay<br/>&amp; Peninsula.</h2><p>Estate cleanout for families, executors, trustees, and authorized property representatives in Santa Clara County and San Mateo County. Contact us with the property’s location to confirm availability.</p></div><div><h3 class="ac-type-estate-h3 ac-type-estate-county">Santa Clara County</h3><ul><li>Campbell</li><li>Cupertino</li><li>Gilroy</li><li>Los Altos</li><li>Los Altos Hills</li><li>Los Gatos</li><li>Milpitas</li><li>Monte Sereno</li><li>Morgan Hill</li><li>Mountain View</li><li>Palo Alto</li><li>San Jose</li><li>Santa Clara</li><li>Saratoga</li><li>Sunnyvale</li></ul></div><div><h3 class="ac-type-estate-h3 ac-type-estate-county">San Mateo County</h3><ul><li>Atherton</li><li>Belmont</li><li>Brisbane</li><li>Burlingame</li><li>Colma</li><li>Daly City</li><li>East Palo Alto</li><li>Foster City</li><li>Half Moon Bay</li><li>Hillsborough</li><li>Menlo Park</li><li>Millbrae</li><li>Pacifica</li><li>Portola Valley</li><li>Redwood City</li><li>San Bruno</li><li>San Carlos</li><li>San Mateo</li><li>Woodside</li></ul></div></div></section>
<section class="quiet"><div class="wrap"><div><h2 class="ac-type-estate-h2 ac-type-estate-quiet">Let’s make a plan for your property.</h2><p>Tell us what needs to be cleared, what you want to preserve, and when you need the work done.</p></div><a class="action" href="#estate-contact">Request an Assessment</a></div></section>
<section class="section" id="estate-contact"><div class="wrap"><div class="formwrap"><p class="eyebrow">Contact Aseptaclean</p><h2 id="estate-form-title" class="ac-type-estate-h2 center">Tell us about the property.</h2><p>Where is the home, and what do you need help with? Include any deadline or belongings that need special attention. A short description is enough to start.</p><AcCompactForm formId="estate-form" entryRoute="/estate-cleanout-san-jose/#estate-contact" tone="light" headingId="estate-form-title" homepage kit estateKit /></div></div></section>

</BaseLayout>
<script>
const root=document.getElementById('ac-estate');
root?.querySelectorAll<HTMLAnchorElement>('a[href="#estate-contact"]').forEach(link=>link.addEventListener('click',(event)=>{event.preventDefault();document.getElementById('estate-contact')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});document.querySelector<HTMLInputElement>('#estate-form-name')?.focus({preventScroll:true});}));
</script>

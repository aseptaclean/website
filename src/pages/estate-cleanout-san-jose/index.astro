  }

  .ec-savelist__row:first-child {
    border-top-color: rgb(255 255 255 / 42%);
    border-top-width: 2px;
  }

  .ec-savelist__rules dt {
    color: var(--ac-color-paper);
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.07em;

    font-size: 0.875rem;
    line-height: 1.55;
  }

  /* #8ba2bf, not #7f96b4, as of 2026-09-04. At 12px this is small text, so AA needs 4.5:1 and
     the old value measured 4.38:1 against the #1e304b panel — axe reported it as a serious
     violation. #8ba2bf measures 5.08:1. Pre-existing defect, unrelated to the redesign; fixed
     here because it is one line and this route is still live. */
  .ec-savelist__disclaimer {
    margin: 14px 0 0;
    max-width: none;
    color: #8ba2bf;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  /* ══ 03 · WHO DECIDES + PROPERTY GOAL ══════════════════════════════════════════════════ */

  .ec-decide {
    background: var(--ac-color-paper);
    padding-block: clamp(76px, 7.5vw, 112px);

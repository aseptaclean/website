---
// Category hub, docs/SITEMAP-MASTER.md "Detailed Cleaning". Copy source doc 27 §10.1.
// Indexable — the "UNPUBLISHED DRAFT / ships noindex" note that stood here was stale; this
// route carries no noindex prop and is in sitemap.xml.ts.
// 2026-08-18 visual port: the whole page body is now docs/mockups/template-service-hub.html
// via ServiceHub.astro. Card titles stay verbatim doc 27 §10.1; unlinked cards render an
// inert "Page in development" bar rather than a dead link.
import BaseLayout from "@layouts/BaseLayout.astro";
import RequestForm from "@components/RequestForm.astro";
import ServiceHub from "@components/ServiceHub.astro";
import { detailedCleaningHub } from "@data/servicePages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Detailed Cleaning",
        item: new URL(detailedCleaningHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Detailed Cleaning | San Jose | Aseptaclean"
  description="Deep cleaning, move-in/move-out, post-construction, and window cleaning — one written scope, whichever reset the property needs. San Jose & the South Bay."
  canonicalPath={detailedCleaningHub.slug}
  schema={schema}
>
  <ServiceHub
    eyebrow={detailedCleaningHub.eyebrow}
    h1={detailedCleaningHub.h1}
    lead={detailedCleaningHub.lead}
    cards={detailedCleaningHub.cards}
    crumb="Detailed Cleaning"
  />

  <RequestForm />
</BaseLayout>

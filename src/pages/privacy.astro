---
import BaseLayout from "@layouts/BaseLayout.astro";
import LegalPolicy from "@components/LegalPolicy.astro";
import PageHeader from "@components/PageHeader.astro";
import { site } from "@data/site";

const policy = site.integrations.termly.policies.privacy;
---

<BaseLayout
  title="Privacy Policy | Aseptaclean"
  description="Read Aseptaclean’s Termly-managed Privacy Policy or access the provider fallback."
  canonicalPath="/privacy/"
  showMobileCta={false}
>
  <PageHeader
    headingId="privacy-title"
    eyebrow="Legal record · Managed by Termly"
    h1={"Privacy Policy"}
    lede={"This page is an integration surface for Aseptaclean’s provider-controlled policy document. Aseptaclean does not replace the provider’s published policy with locally drafted legal text."}
    crumb="Privacy Policy"
  />

  <div class="legal-body">
    <LegalPolicy
      title="Privacy Policy"
      label="Privacy Policy"
      policyId={policy.id}
      hostedUrl={policy.hostedUrl}
    />
  </div>
</BaseLayout>

<style>
  /* Mockup template-legal.html body shell — 820px, narrower than the 1200px page shell. */
  .legal-body {
    padding-block: 68px;
  }

  .legal-body :global(.legal-policy) {
    max-width: 820px;
  }
</style>

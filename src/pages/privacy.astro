---
// PRIVACY POLICY — docs/page-briefs/PRIVACY.md. The shell is AcLegalPage; the policy body is the
// actual Termly document and is not authored here. Provider id, script and fallbacks unchanged.
import AcLegalPage from "@components/ac/AcLegalPage.astro";
import { site } from "@data/site";

const policy = site.integrations.termly.policies.privacy;
---

<AcLegalPage
  label="Privacy Policy"
  headingId="privacy-title"
  canonicalPath="/privacy/"
  seoTitle="Privacy Policy | Aseptaclean"
  seoDescription="How Aseptaclean collects, uses, and protects personal information."
  policyId={policy.id}
  hostedUrl={policy.hostedUrl}
/>

---
// ABOUT — recomposed 2026-09-04 onto the shared ClearPath/911 section system (doc 30 §6.0).
//
// COPY IS UNCHANGED. Neither copy document supplied by the owner has an About section
// (docs/20-COPY-MAP.md §2), so nothing here was rewritten: the H1, lead, founder heading and
// body, and the three operating principles are the approved strings already in
// src/data/doc27CompanyPages.ts, and the founder-authority-limit clause is doc 21 §2.4 verbatim
// via src/data/site.ts. This pass changed the page's composition, not its words.
//
// FOUNDER PORTRAIT INSTALLED 2026-09-05 — the asset dependency this file used to record is
// closed. The owner supplied a genuine photograph of Matthew Ruiz (1152x1536, 3:4) in the
// website image package; docs/page-briefs/ABOUT.md wants a real portrait at roughly half the
// founder split, and docs/06-ASSET-MANIFEST.md requires a genuine asset for a real-proof role.
// This is that asset, so the split renders its media column again instead of collapsing to one
// readable column with a `needsAsset` note.
//
// It is a real company photograph; the other images on this page are licensed or generated
// reference imagery. That distinction lives in docs/06-ASSET-MANIFEST.md — the visitor-facing
// reference captions were removed 2026-09-05 at the owner's instruction, so no image on this
// page carries a caption.
//
// Historical note kept for traceability: before this package there was no portrait in the
// repository at all, and the only founder-named files were viewport screenshots under
// artifacts/. A stock or generated person was never an acceptable substitute (AGENTS.md §0.3).
// DEDUPLICATION PASS 2026-09-04, profile AC-CP70-91130-1.1 §7 + docs/page-briefs/ABOUT.md.
// The brief draws About from BOTH Homepage → "Why Aseptaclean" AND the dedicated About copy, and
// combining the two sources restated the founder's background three times in one section. Each
// removal below is recorded in docs/page-briefs/ABOUT.md § "Intentional omissions" so a later
// pass does not restore it. No unique fact, qualification or service boundary was dropped, and
// no source document was edited — only which occurrence this page renders.
import BaseLayout from "@layouts/BaseLayout.astro";
import AcPageHero from "@components/ac/AcPageHero.astro";
import AcTrustStrip from "@components/ac/AcTrustStrip.astro";
import AcIntro from "@components/ac/AcIntro.astro";
import AcSplit from "@components/ac/AcSplit.astro";
import AcDarkBand from "@components/ac/AcDarkBand.astro";
import AcFinalCta from "@components/ac/AcFinalCta.astro";
import { aboutPage } from "@data/doc27CompanyPages";
import { home } from "@data/publicCopy";
import { legal, site } from "@data/site";

// The compact About hero is package slot 02 (`property-interior-introduction`), the same
// introduction image the homepage and Services hub use for their own introduction roles. The
// scope dark band below is not in the package's placement index.
//
// REVISED 2026-09-05. That band held `equipment_gear.jpg`, a gloved-hands stock photograph, which
// doc 21 §6 rules out on a public page and which had no recorded licence. It now takes package
// slot 18, `home-property-scope-detail`, which is the image the package itself assigns to the
// homepage's scope dark band — the same section role, on a different route. That is deliberate
// cross-route reuse of an assigned image, not the invention of a new numbered slot.
import propertyIntroduction from "../../assets/aseptaclean/property-interior-introduction.png";
import founderPortrait from "../../assets/aseptaclean/founder-matthew-ruiz.jpeg";
import propertyScopeDetail from "../../assets/aseptaclean/home-property-scope-detail.png";

const schema = [
  {
    "@type": "Person",
    "@id": new URL("/#founder", site.urls.site).href,
    name: site.founder.name,
    jobTitle: site.founder.title,
    worksFor: { "@id": new URL("/#business", site.urls.site).href },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "University of California, Riverside"
    }
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "About",
        item: new URL("/about/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={aboutPage.seoTitle}
  description={aboutPage.metaDescription}
  canonicalPath="/about/"
  schema={schema}
>
  {/* Compact photographic introduction — brief: "concise introduction to Aseptaclean".
      Two things were removed here, both duplicates:

      1. `assurances` rendered "Owner-operated" and "Serving the South Bay & Peninsula" as a list
         directly above AcTrustStrip, which renders those same two strings verbatim plus the
         response time. Same words, twice, ~30px apart. The trust strip is the stronger version
         (it is the shared sitewide band and carries the third fact), so the hero copy goes.
      2. An unsourced body paragraph ("We work on properties where the condition is the
         problem…"). It resolved to no named source — docs/20-COPY-MAP.md § Copy trace requires
         every visible marketing sentence to resolve to one — and it restated the condition-first
         point that home.why.close makes in the founder section below.

      Removing both is also what brings the hero inside the §7 desktop budget at 1366x768. */}
  <AcPageHero
    eyebrow={aboutPage.eyebrow}
    heading={aboutPage.h1}
    headingId="about-hero-title"
    lead={aboutPage.lead}
    image={propertyIntroduction}
    imageAlt="An unfurnished residential interior looking from the living room toward an adjoining hallway"
  />

  <AcTrustStrip />

  {/* Founder — brief: Matthew Ruiz, his relevant background, and how it informs the approach.
      This section stated the same background THREE times before this pass:

        a. aboutPage.founderBody — "…a B.S. in Biochemistry from UC Riverside, pharmaceutical
           manufacturing, and histology and surgical pathology."                        RETAINED
        b. home.why.body[0]      — "Our founder's background includes biochemistry,
           pharmaceutical manufacturing, and surgical pathology."                        REMOVED
        c. homepage.founderCredentials — the same four facts again as a check list.      REMOVED

      (a) is the strongest: it is this page's own approved About copy, it names Matthew, and it
      is the most specific (UC Riverside, histology). (b) is the homepage's generic third-person
      restatement of (a) and added nothing on a page whose subject is already Matthew. (c) added
      only the word "communication" over (a). Both are still rendered on `/` by HomeFounder.

      home.why.body[1] is KEPT — "That experience shaped the way…" is the transition into the
      pull quote and now refers to (a). home.why.close is KEPT: it is the only copy that says how
      the background informs the work, which is this section's assigned purpose. */}
  <AcSplit
    eyebrow="01 / The operator"
    heading={aboutPage.founderHeading}
    headingId="about-founder-title"
    lead={`${site.founder.name} — ${site.founder.title}`}
    body={[aboutPage.founderBody, home.why.body[1]]}
    pullQuote={home.why.pullQuote}
    image={founderPortrait}
    imageAlt="Matthew Ruiz, founder of Aseptaclean"
    ratio="3/4"
  >
    {home.why.close.map((paragraph) => <p class="about-body">{paragraph}</p>)}
    {/* doc 21 §2.4 — verbatim, mandatory wherever the founder's background appears. */}
    <p class="about-limit">{legal.founderAuthorityLimit}</p>
  </AcSplit>

  <AcIntro
    eyebrow="02 / How we operate"
    heading="Operating principles"
    headingId="about-principles-title"
    lead="Three things are settled before a property is scheduled."
    tone="soft"
  >
    <div class="about-principles">
      {aboutPage.operatingPrinciples.map((principle) => (
        <div class="about-principles__item">
          <h3 class="ac-type-h3-band">{principle.title}</h3>
          <p>{principle.body}</p>
        </div>
      ))}
    </div>
  </AcIntro>

  {/* Company context — ONE section, per the brief's
      "…→ OperatingPrinciples → factual company context → FinalCallSection" order.

      There were two sections here. The first, "Real trust starts with clear expectations.",
      is REMOVED as pure restatement — it carried no fact the page did not already state:
        · "We are not going to turn every small problem into a large project."
              = home.why.close "we do not assume every difficult property is a major
                remediation project" (founder section, three paragraphs earlier)
        · "explain what we believe needs attention" = "Written boundaries" (principles above)
        · "…tell you where our responsibility begins and ends" was, verbatim, the HEADING of
                the very next section.
      docs/20-COPY-MAP.md already parks this block ("Do not render these as additional
      sections"), and its source text is untouched in aseptaclean-all-website-copy.md.

      The second section held the only unique material — the scope and documentation
      boundaries — so it keeps that content and inherits the removed band's dark treatment and
      photograph, which preserves the 70/30 dark break and the page's second substantial image.
      Its actions are off: hero and the closing band are the page's two CTAs, per
      docs/20-COPY-MAP.md "one contextual call action where appropriate and a final call
      section". legal.* appearing here and in the footer is the doc 21 §6 placement pattern
      ("in the footer and near exclusions where practical") used on every service page, not
      editorial repetition. */}
  <AcDarkBand
    eyebrow="03 / Scope"
    heading="Where our responsibility"
    headingAccent="begins and ends."
    headingId="about-scope-title"
    lead={legal.scopeDisclaimer}
    body={[legal.documentationDisclaimer]}
    image={propertyScopeDetail}
    imageAlt="A residential living room with belongings across a worn floor, seen through to an adjoining hallway"
    showActions={false}
  />

  <AcFinalCta
    heading="Tell us what you are looking at."
    headingId="about-final-title"
    body={[
      "You do not need to know which service you need, and you do not need to prepare the property first.",
      "Send a few photos and tell us what is happening. We will help you determine the next step."
    ]}
  />
</BaseLayout>

<style>
  .about-body {
    margin: 14px 0 0;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.65;
  }

  .about-limit {
    margin: 22px 0 0;
    border-left: 2px solid var(--ac-color-line-strong);
    padding-left: 18px;
    color: var(--ac-color-ink-500);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .about-principles {
    display: grid;
    margin-top: 40px;
    gap: 32px 40px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    text-align: left;
  }

  .about-principles__item {
    border-top: 1px solid var(--ac-color-line-strong);
    padding-top: 20px;
  }

  .about-principles__item p {
    margin: 12px 0 0;
    color: var(--ac-color-ink-600);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-width: 56rem) {
    .about-principles {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
  }
</style>

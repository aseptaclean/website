---
// doc 19 §2.2 ABOUT + §3.5 wireframe. Founder-story copy assembled verbatim from
// docs/06-APPROVED-HOMEPAGE-COPY.md §8.15 (paragraphs, quote, credential list) and
// src/data/site.ts (legal.scopeDisclaimer, site.business.insuranceStatus) — no new
// sentences invented. No founder portrait has been supplied, so the section is text-first.
// Copy migrated to docs/27-COPY-CANONICAL.md §17.3 on 2026-08-16 (title, meta, eyebrow, H1,
// lead, founder heading/body, operating principles). Layout unchanged — the founder-story,
// credentials composition below retains the current documented background and authority limit.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import RequestForm from "@components/RequestForm.astro";
import { aboutPage } from "@data/doc27CompanyPages";
import { legal, site } from "@data/site";

const credentials = [
  { k: "Education", v: "B.S. Biochemistry, UC Riverside" },
  { k: "Background", v: "Pharmaceutical manufacturing" },
  { k: "Background", v: "Histology & surgical pathology" },
  { k: "On project", v: "Scope, planning, operating oversight" }
] as const;

const links = [
  { href: "/handoff-standard/", label: "The Handoff Standard" },
  { href: "/#service-cards", label: "Services" },
  { href: "/contact/", label: "Contact" }
] as const;

const schema = [
  {
    "@type": "Person",
    "@id": new URL("/#founder", site.urls.site).href,
    name: site.founder.name,
    jobTitle: site.founder.title,
    worksFor: { "@id": new URL("/#business", site.urls.site).href },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "University of California, Riverside"
    }
  },
  // The name-and-founder-only LocalBusiness stub that sat here is removed: the single business
  // node in src/components/SeoHead.astro carries `founder` on every route, so this page-level
  // fragment added nothing and was one of the three conflicting partial descriptions. The
  // `worksFor` link above already resolves to it.
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "About",
        item: new URL("/about/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={aboutPage.seoTitle}
  description={aboutPage.metaDescription}
  canonicalPath={aboutPage.slug}
  schema={schema}
>
  <PageHeader
    headingId="about-title"
    eyebrow={aboutPage.eyebrow}
    h1={aboutPage.h1}
    lede={aboutPage.lead}
    crumb="About"
  />

  <section class="founder-story" aria-labelledby="founder-story-title">
    <div class="ac-measure-wide founder-story__shell">
      <div>
        <p class="ac-eyebrow">Founder &amp; Principal Operator</p>
        <h2 id="founder-story-title" class="ac-type-h2">{aboutPage.founderHeading}</h2>
        <p class="founder-story__lead">{aboutPage.founderBody}</p>
        <blockquote class="founder-story__quote">
          <p>
            &ldquo;Difficult properties are not handled well through vague promises. Before work
            begins, I want you to know what is included, what is excluded, what happens when
            something unexpected is found, and what you will receive when the job is closed.
            That is the standard I built Aseptaclean around.&rdquo;
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="founder-credentials" aria-labelledby="credentials-title">
    <div class="ac-measure-wide">
      <h2 id="credentials-title" class="ac-type-h3">Verified background</h2>
      <div class="creds">
        {
          credentials.map((item) => (
            <div class="cr">
              <span class="cr__k">{item.k}</span>
              <span class="cr__v">{item.v}</span>
            </div>
          ))
        }
      </div>

      <p class="disclaimer">{legal.scopeDisclaimer}</p>
      <p class="disclaimer">{legal.founderAuthorityLimit}</p>
      {/* AGENTS.md §3 / doc 21 §2.5: unverified against a current COI → suppress the statement
          entirely rather than rendering a placeholder or a stale claim. */}
      {site.business.insuranceStatus && (
        <p class="insurance">{site.business.insuranceStatus}</p>
      )}
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">Operating principles</p>
      <h2 id="principles-title" class="ac-type-h2 principles__heading">How the work is decided before it starts</h2>
      <div class="principles__grid">
        {
          aboutPage.operatingPrinciples.map((principle) => (
            <div class="principle">
              <h3 class="ac-type-h3">{principle.title}</h3>
              <p class="principle__body">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="founder-links" aria-labelledby="founder-links-title">
    <div class="ac-measure-wide founder-links__shell">
      <div>
        <p class="ac-eyebrow">More about the operator</p>
        <h2 id="founder-links-title" class="ac-type-h3">The standard, the services, and how to reach us</h2>
      </div>
      <nav class="founder-links__list" aria-label="Related pages">
        {links.map((link) => <a href={link.href}>{link.label} →</a>)}
      </nav>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .principles {
    background: var(--ac-color-warm-white);
    border-top: 1px solid var(--ac-color-line);
  }

  .principles__heading {
    max-width: 32ch;
    margin-top: var(--ac-space-3);
  }

  .principles__grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .principle {
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
  }

  .principle h3 {
    margin-bottom: 8px;
  }

  .principle__body {
    max-width: 44ch;
    color: var(--ac-color-ink-600);
    font-size: 0.92rem;
  }

  @media (min-width: 40rem) {
    .principles__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .founder-story {
    background: var(--ac-color-paper);
  }

  .founder-story__shell {
    display: grid;
    max-width: 54rem;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .founder-story h2 {
    margin-bottom: 16px;
  }

  .founder-story__lead {
    max-width: 54ch;
    margin-bottom: 16px;
    color: var(--ac-color-ink-600);
    font-size: 1.02rem;
  }

  .founder-story p {
    max-width: 54ch;
    color: var(--ac-color-ink-600);
  }

  .founder-story__quote {
    max-width: 52ch;
    margin: 24px 0 0;
    border-left: 3px solid var(--ac-color-gold);
    padding-left: 18px;
  }

  .founder-story__quote p {
    margin: 0;
    color: var(--ac-color-navy-900);
    font-family: var(--ac-font-display);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.45;
  }

  .founder-credentials {
    background: var(--ac-color-warm-white);
  }

  .founder-credentials h2 {
    margin-bottom: 20px;
  }

  .creds {
    border-top: 1px solid var(--ac-color-line);
    max-width: 40rem;
  }

  .cr {
    display: grid;
    grid-template-columns: 130px 1fr;
    align-items: baseline;
    gap: 16px;
    border-bottom: 1px solid var(--ac-color-line);
    padding: 13px 0;
  }

  .cr__k {
    color: var(--ac-color-ink-400);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cr__v {
    color: var(--ac-color-navy-900);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .disclaimer {
    max-width: 64ch;
    margin-top: 28px;
    border-left: 2px solid var(--ac-color-line-strong);
    padding-left: 14px;
    color: var(--ac-color-ink-500);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .insurance {
    max-width: 64ch;
    margin-top: 12px;
    color: var(--ac-color-navy-900);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .founder-links {
    background: var(--ac-color-navy-900);
    color: var(--ac-color-warm-white);
  }

  /* This section's own .ac-eyebrow sits on the navy-900 background, not the light surface the
     shared class assumes. Recolouring alone left the shared class's pale-blue chip painted
     underneath, so light steel text sat on a near-white chip — measured 1.89:1. Take the
     background from the on-dark modifier as well, matching .ac-eyebrow--on-dark. */
  .founder-links :global(.ac-eyebrow) {
    background: rgb(255 255 255 / 12%);
    color: #cbd9e8;
  }

  .founder-links__shell {
    display: grid;
    gap: var(--ac-space-5);
  }

  .founder-links h2 {
    margin-top: 8px;
    color: var(--ac-color-paper);
  }

  .founder-links__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .founder-links__list a {
    color: #cfe0f2;
    font-weight: 600;
    text-decoration: none;
  }

  .founder-links__list a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 54rem) {
    .founder-story__shell {
      grid-template-columns: 0.85fr 1.35fr;
    }

    .founder-links__shell {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
</style>

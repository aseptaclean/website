---
// UNPUBLISHED DRAFT — added 2026-08-16 per docs/SITEMAP-MASTER.md ("Specialty Cleaning" category
// hub, index status, copy source doc 27 §10.2). Ships noindex, excluded from sitemap.xml.ts, not
// linked from nav/footer — same pre-launch pattern as every other page in this batch. Card titles
// are verbatim doc 27 §10.2; only "Animal Waste Cleanup" links out — extreme-condition, rodent,
// and pigeon pages aren't built yet, so they render as plain, unlinked text rather than a dead
// link. WORDING LAW carried from animal-waste-cleanup-san-jose/index.astro: cleaning under the
// organic pathogen endorsement only — no biohazard/remediation/decontaminate/sanitize/sterilize/
// hantavirus/rodent-specific handling language anywhere on this page (grep-verified, zero hits).
import BaseLayout from "@layouts/BaseLayout.astro";
import CompactHero from "@components/CompactHero.astro";
import RequestForm from "@components/RequestForm.astro";
import { specialtyCleaningHub, hubClose } from "@data/servicePages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Specialty Cleaning",
        item: new URL(specialtyCleaningHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Specialty Cleaning | San Jose | Aseptaclean"
  description="Condition-reviewed cleaning for difficult properties — extreme-condition and animal or organic-material cleaning under our organic pathogen endorsement. San Jose & the South Bay."
  canonicalPath={specialtyCleaningHub.slug}
  noindex={true}
  schema={schema}
>
  <CompactHero eyebrow={specialtyCleaningHub.eyebrow} headingId="specialty-title">
    <h1 id="specialty-title" class="ac-type-h1">{specialtyCleaningHub.h1}</h1>
    <p class="compact-hero__lead">{specialtyCleaningHub.lead}</p>
  </CompactHero>

  {/* docs/21-CLAIMS-AND-COMPLIANCE-LAW.md / AGENTS.md §0.2 — this hub names animal, rodent and
      pigeon waste conditions in its cards, so it describes organic work and carries the same
      verbatim-mandatory clause the individual specialty pages carry. Never paraphrase it. */}
  <aside class="compliance-clause" aria-label="Scope limitation">
    <div class="ac-measure-wide">
      <p>Cleaning only — not a decontamination, sterilization, or health-safety determination.</p>
    </div>
  </aside>

  <section class="cards" aria-labelledby="cards-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">By service</p>
      <h2 id="cards-title" class="ac-type-h2 cards__heading">Choose the page that matches the condition</h2>
      <div class="cards__grid">
        {
          specialtyCleaningHub.cards.map((card) =>
            card.href ? (
              <a class="card-tile" href={card.href}>
                <h3 class="ac-type-h3">{card.title}</h3>
                <span class="card-tile__cta">See the service page →</span>
              </a>
            ) : (
              <div class="card-tile card-tile--pending">
                <h3 class="ac-type-h3">{card.title}</h3>
                <span class="card-tile__cta">Page in development</span>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <section class="hub-close" aria-labelledby="hub-close-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">{hubClose.label}</p>
      <h2 id="hub-close-title" class="ac-type-h2 hub-close__heading">{hubClose.heading}</h2>
      <p class="hub-close__body">{hubClose.body}</p>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .compliance-clause {
    border-bottom: 1px solid var(--ac-color-line);
    background: var(--ac-color-warm-white);
    padding-block: 14px;
  }

  .compliance-clause p {
    margin: 0;
    color: var(--ac-color-ink-600);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .cards {
    background: var(--ac-color-paper);
  }

  .cards__heading {
    max-width: 36ch;
    margin-top: var(--ac-space-3);
  }

  .cards__grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .card-tile {
    display: block;
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
    color: inherit;
    text-decoration: none;
  }

  .card-tile h3 {
    margin-bottom: 8px;
  }

  .card-tile__cta {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .card-tile:hover .card-tile__cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-tile--pending {
    border-top-color: var(--ac-color-line);
  }

  .card-tile--pending .card-tile__cta {
    color: var(--ac-color-ink-400);
    font-weight: 500;
  }

  .hub-close {
    background: var(--ac-color-warm-white);
    border-top: 1px solid var(--ac-color-line);
  }

  .hub-close__heading {
    max-width: 30ch;
    margin-top: var(--ac-space-3);
  }

  .hub-close__body {
    max-width: 56ch;
    margin-top: var(--ac-space-4);
    color: var(--ac-color-ink-600);
  }

  @media (min-width: 40rem) {
    .cards__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

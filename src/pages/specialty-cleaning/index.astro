---
// Category hub, docs/SITEMAP-MASTER.md "Specialty Cleaning". Copy source doc 27 §10.2.
// Ships NOINDEX and stays out of sitemap.xml.ts until doc 27 §21's compliance-release inputs
// are on record. Do not flip that flag as part of a visual change.
// WORDING LAW, carried from animal-waste-cleanup-san-jose/index.astro: cleaning under the
// organic pathogen endorsement only — no biohazard / remediation / decontaminate / sanitize /
// sterilize / hantavirus / rodent-specific handling language anywhere on this page.
// 2026-08-18 visual port: body is docs/mockups/template-service-hub.html via ServiceHub.astro.
// The verbatim-mandatory scope clause (doc 21 §2.3) is passed through, not dropped.
import BaseLayout from "@layouts/BaseLayout.astro";
import RequestForm from "@components/RequestForm.astro";
import ServiceHub from "@components/ServiceHub.astro";
import { specialtyCleaningHub } from "@data/servicePages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Specialty Cleaning",
        item: new URL(specialtyCleaningHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Specialty Cleaning | San Jose | Aseptaclean"
  description="Condition-reviewed cleaning for difficult properties — extreme-condition and animal or organic-material cleaning under our organic pathogen endorsement. San Jose & the South Bay."
  canonicalPath={specialtyCleaningHub.slug}
  noindex={true}
  schema={schema}
>
  <ServiceHub
    eyebrow={specialtyCleaningHub.eyebrow}
    h1={specialtyCleaningHub.h1}
    lead={specialtyCleaningHub.lead}
    cards={specialtyCleaningHub.cards}
    crumb="Specialty Cleaning"
    complianceClause={"Cleaning only — not a decontamination, sterilization, or health-safety determination."}
  />

  <RequestForm />
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
const currentYear = new Date().getFullYear();
---

<BaseLayout
  title="Thank You | Aseptaclean"
  description="Aseptaclean inquiry receipt."
  canonicalPath="/thank-you/"
  noindex={true}
  showMobileCta={false}
>
  <header slot="header" class="receipt-header">
    <div class="receipt-wrap receipt-header__inner">
      <a class="receipt-brand" href="/" aria-label="Aseptaclean home">
        <span>{site.business.name}</span>
        <small>Specialty Property Cleanup</small>
      </a>
      {phoneHref && <a class="receipt-phone" href={phoneHref}>{site.business.phone}</a>}
    </div>
  </header>

  <div id="ac-submission-receipt">
    <section class="receipt-main" aria-live="polite">
      <div class="receipt-wrap">
        <div data-receipt-success hidden>
          <p class="receipt-label">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="m8 12 2.6 2.6L16.5 9"></path>
            </svg>
            Inquiry received
          </p>
          <h1 class="receipt-title" tabindex="-1" data-receipt-focus>
            Thank you.<br />We’ll take it from here.
          </h1>
          <p class="receipt-lead">
            Your inquiry is with Aseptaclean. We’ll review the details and contact you to
            discuss the property and the next step.
          </p>

          <div class="receipt-grid">
            <div>
              <h2 class="receipt-heading">Your inquiry</h2>
              <dl class="receipt-details" data-receipt-details hidden>
                <div data-reference-row hidden>
                  <dt>Reference</dt>
                  <dd data-reference></dd>
                </div>
              </dl>
              <p class="receipt-fine receipt-boundary">
                This confirms your inquiry. An assessment or cleanup appointment has not been
                booked.
              </p>
            </div>
            <div>
              <h2 class="receipt-heading">Want to talk now?</h2>
              <p>Call us if you’d like to discuss the property or add a detail.</p>
              {
                phoneHref && (
                  <a class="receipt-action" href={phoneHref}>
                    Call {site.business.phone}
                    <span aria-hidden="true">↗</span>
                  </a>
                )
              }
              <p class="receipt-fine">{site.business.hours}</p>
            </div>
          </div>
        </div>

        <div class="receipt-neutral" data-receipt-neutral>
          <p class="receipt-label">Receipt unavailable</p>
          <h1 class="receipt-title" tabindex="-1" data-neutral-focus>
            No inquiry is confirmed on this page.
          </h1>
          <p class="receipt-lead">
            A confirmation appears here only after Aseptaclean accepts an inquiry. If you have
            not submitted the form, return to the contact page to begin.
          </p>
          <div class="receipt-neutral__actions">
            <a class="receipt-action" href="/contact/#contact-form">Go to the contact form</a>
            {phoneHref && <a class="receipt-text-link" href={phoneHref}>Call {site.business.phone}</a>}
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer slot="footer" class="receipt-footer">
    <div class="receipt-wrap receipt-footer__inner">
      <span>© {currentYear} {site.business.name}</span>
      <a href="/">Return to Aseptaclean ↗</a>
    </div>
  </footer>
</BaseLayout>

<script>
  import { readAcceptedInquiryReceipt } from "../scripts/acceptedInquiryReceipt";

  const success = document.querySelector<HTMLElement>("[data-receipt-success]");
  const neutral = document.querySelector<HTMLElement>("[data-receipt-neutral]");
  const receipt = readAcceptedInquiryReceipt();

  // Query parameters are intentionally not evidence of acceptance. Remove any legacy or
  // hand-authored flags so a refresh/share cannot imply a successful submission.
  if (window.location.search || window.location.hash) {
    window.history.replaceState({}, "", "/thank-you/");
  }

  if (receipt && success && neutral) {
    neutral.hidden = true;
    success.hidden = false;

    if (receipt.confirmationCode) {
      const details = document.querySelector<HTMLElement>("[data-receipt-details]");
      const row = document.querySelector<HTMLElement>("[data-reference-row]");
      const reference = document.querySelector<HTMLElement>("[data-reference]");
      if (details && row && reference) {
        reference.textContent = receipt.confirmationCode;
        row.hidden = false;
        details.hidden = false;
      }
    }

    document.querySelector<HTMLElement>("[data-receipt-focus]")?.focus({
      preventScroll: true
    });
  }
</script>

<style>
  :global(body) {
    background: #fff;
  }

  .receipt-wrap {
    width: calc(100% - 80px);
    max-width: 1050px;
    margin-inline: auto;
  }

  .receipt-header {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid #e0e5ea;
    background: #fff;
    color: #122840;
  }

  .receipt-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
    padding-block: 14px;
  }

  .receipt-brand {
    color: #1c355e;
    font-size: 25px;
    font-weight: 750;
    letter-spacing: -0.8px;
    line-height: 1.1;
    text-decoration: none;
  }

  .receipt-brand small {
    display: block;
    margin-top: 1px;
    color: #1c355e;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .receipt-phone {
    color: #1c355e;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  #ac-submission-receipt {
    color-scheme: light;
    min-height: calc(100vh - 153px);
    background: #fff;
    color: #122840;
    font-family: Inter, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  #ac-submission-receipt * {
    box-sizing: border-box;
  }

  #ac-submission-receipt [hidden] {
    display: none !important;
  }

  .receipt-main {
    padding-block: 68px 55px;
    background: #fff;
    color: #122840;
  }

  .receipt-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #446479;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .receipt-label svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .receipt-title {
    max-width: 20ch;
    margin: 22px 0 20px;
    color: #122840;
    font-size: clamp(36px, 5.2vw, 55px);
    font-weight: 650;
    letter-spacing: -1.9px;
    line-height: 1.12;
  }

  .receipt-title:focus {
    outline: none;
  }

  .receipt-lead {
    max-width: 660px;
    margin: 0;
    color: #536779;
    font-size: 18px;
    line-height: 1.7;
  }

  .receipt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 70px;
    margin-top: 43px;
    border-top: 1px solid #cbd5df;
    padding-top: 32px;
  }

  .receipt-grid > * {
    min-width: 0;
  }

  .receipt-heading {
    margin: 0 0 14px;
    color: #122840;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.4px;
    line-height: 1.3;
  }

  .receipt-grid p {
    margin: 0 0 17px;
    color: #536779;
    font-size: 15px;
  }

  .receipt-details {
    margin: 0;
  }

  .receipt-details div {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 15px;
    padding-block: 7px;
    font-size: 14px;
  }

  .receipt-details dt {
    color: #536779;
  }

  .receipt-details dd {
    margin: 0;
    color: #122840;
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  .receipt-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 48px;
    margin: 5px 0 16px;
    padding: 13px 21px;
    border: 1px solid #1c355e;
    border-radius: 0;
    background: #1c355e;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .receipt-action:hover {
    background: #122840;
    color: #fff;
  }

  .receipt-action:focus-visible,
  .receipt-text-link:focus-visible,
  .receipt-phone:focus-visible,
  .receipt-brand:focus-visible,
  .receipt-footer a:focus-visible {
    outline: 3px solid #1c355e;
    outline-offset: 4px;
  }

  .receipt-fine {
    color: #536779 !important;
    font-size: 12px !important;
  }

  .receipt-boundary {
    margin-top: 19px !important;
  }

  .receipt-neutral {
    max-width: 760px;
  }

  .receipt-neutral .receipt-title {
    max-width: 15ch;
  }

  .receipt-neutral__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 28px;
  }

  .receipt-neutral__actions .receipt-action {
    margin: 0;
  }

  .receipt-text-link {
    color: #1c355e;
    font-size: 14px;
    font-weight: 600;
  }

  .receipt-footer {
    border-top: 1px solid #d9e0e6;
    padding-block: 25px;
    background: #f7f8fa;
    color: #536779;
  }

  .receipt-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 12px;
  }

  .receipt-footer a {
    color: #1c355e;
    text-decoration: none;
  }

  @media (max-width: 620px) {
    .receipt-wrap {
      width: calc(100% - 40px);
    }

    .receipt-header__inner {
      min-height: 70px;
    }

    .receipt-brand {
      font-size: 22px;
    }

    .receipt-phone {
      font-size: 12px;
    }

    .receipt-main {
      padding-block: 40px;
    }

    .receipt-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 30px;
    }

    .receipt-neutral__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .receipt-neutral__actions .receipt-action {
      width: 100%;
    }

    .receipt-footer__inner {
      flex-direction: column;
      gap: 10px;
    }
  }

  @media (forced-colors: active) {
    .receipt-action {
      border: 1px solid ButtonText;
    }
  }
</style>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;

// A5 — BreadcrumbList. This route had none; every other non-root route on the site does, and a
// crumb trail is how a leaf page tells a crawler where it sits. The "Home" item uses
// `site.urls.home` (WITH the trailing slash) so it matches the homepage canonical exactly —
// `site.urls.site` is a bare origin and produced a second URL for the same page.
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "Thank You",
        item: new URL("/thank-you/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Thank You | Aseptaclean"
  description="Aseptaclean assessment request confirmation."
  canonicalPath="/thank-you/"
  schema={schema}
  noindex={true}
  showMobileCta={false}
>
  <div class="confirmation">
    <div class="ac-measure-wide confirmation__layout">
      <section
        class="confirmation__record"
        data-confirmation
      >
        <p class="confirmation__eyebrow" data-confirmation-eyebrow>Assessment request</p>
        <h1 class="ac-type-h1" data-confirmation-title>This page does not confirm that a request was received.</h1>
        <div data-confirmed hidden>
          <p class="confirmation__status">Received</p>
          <!-- Exact required copy — do not paraphrase. The email-delivery paragraph below it
               stays: it reports which delivery states actually occurred, which this line does
               not claim. -->
          <p class="confirmation__lead" data-confirmation-email>
            We'll review what you sent and contact you about the next step. If we need more
            information or an on-site assessment before pricing the work, we'll let you know.
          </p>
          <p class="confirmation__callback" data-callback-message></p>
          <p class="confirmation__reference" data-submission-reference hidden></p>
        </div>

        <div data-unconfirmed>
          <p class="confirmation__status confirmation__status--neutral">No submission confirmed</p>
          <p class="confirmation__lead">
            If you arrived here without submitting the assessment, start the
            request below. If you just submitted and expected a confirmation,
            check your email or contact Aseptaclean before submitting again.
            Successfully received requests receive a Handoff Plan within one
            business day.
          </p>
          <a class="button" href="/contact/#contact-form">Start the assessment</a>
        </div>

        <aside class="confirmation__boundary">
          <strong>What this submission does—and does not do</strong>
          <p>
            It begins a property fit review. It does not authorize work, create
            a service agreement, reserve a project date, or guarantee that the
            property is within Aseptaclean’s scope.
          </p>
        </aside>
      </section>

      <aside class="confirmation__next" aria-labelledby="next-title">
        <p class="confirmation__next-label">While you wait</p>
        <h2 id="next-title" class="ac-type-h3">Photos speed everything up.</h2>
        <p class="confirmation__next-body">
          Stand in the doorway and get the whole room, then step in close on the
          worst spots. Text them to the number below and mention your name.
        </p>
        {
          phoneHref && (
            <a href={phoneHref}>
              Urgent or complex property? Call {site.business.phone}
            </a>
          )
        }
        <small>{site.business.hours}</small>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const parameters = new URLSearchParams(window.location.search);
  const valid = parameters.get("received") === "1";
  const isResidence =
    parameters.get("offer") === "private-residence-reset";
  const confirmed = document.querySelector<HTMLElement>("[data-confirmed]");
  const unconfirmed = document.querySelector<HTMLElement>("[data-unconfirmed]");
  const callback = document.querySelector<HTMLElement>(
    "[data-callback-message]"
  );
  const reference = document.querySelector<HTMLElement>(
    "[data-submission-reference]"
  );
  const confirmationEmail = document.querySelector<HTMLElement>(
    "[data-confirmation-email]"
  );
  const title = document.querySelector<HTMLElement>(
    "[data-confirmation-title]"
  );
  if (isResidence) {
    const eyebrow = document.querySelector<HTMLElement>(
      "[data-confirmation-eyebrow]"
    );
    if (eyebrow) eyebrow.textContent = "Private Residence Reset intake";
    if (title) title.textContent = "Your residence assessment is in the review queue.";
    if (confirmationEmail) {
      confirmationEmail.textContent =
        "A confirmation email is on its way. Aseptaclean will review the residence, desired baseline, priority rooms, finish instructions, access, and whether an on-site walkthrough is required.";
    }
  }

  if (valid && confirmed && unconfirmed) {
    if (title) {
      title.textContent = isResidence
        ? "Your residence assessment is in the review queue."
        : "Request received.";
    }
    confirmed.hidden = false;
    unconfirmed.hidden = true;
    const callbackWindow = parameters.get("callback");
    if (callback) {
      callback.textContent =
        callbackWindow === "business-hours"
          ? "Because this request arrived during published business hours, Aseptaclean’s operating standard is to call within 5 minutes."
          : "Because this request arrived outside published business hours, Aseptaclean will call during the next business window.";
    }
    const emailState = parameters.get("email");
    if (isResidence && confirmationEmail) {
      confirmationEmail.textContent =
        "A confirmation email is on its way. Aseptaclean will review the residence, desired baseline, priority rooms, finish instructions, access, and whether an on-site walkthrough is required.";
    } else if (confirmationEmail && emailState === "none") {
      // No email was collected on this submission, so no confirmation email is ever
      // attempted. Reporting unverified delivery here would describe a message that was
      // never sent.
      confirmationEmail.textContent =
        "We'll review what you sent and contact you by phone about the next step. If we need more information or an on-site assessment before pricing the work, we'll let you know.";
    } else if (confirmationEmail && emailState !== "sent") {
      confirmationEmail.textContent =
        "We'll review what you sent and contact you about the next step. Save the confirmation code below in case you need to reference it. If we need more information or an on-site assessment before pricing the work, we'll let you know.";
    }
    // Six Crockford base32 characters, so the visitor can read this down the phone or
    // type it from a photo. The submission UUID stays internal and is never shown here.
    const code = parameters.get("code");
    if (reference && code && /^AC-[0-9A-HJKMNP-TV-Z]{6}$/.test(code)) {
      reference.hidden = false;
      reference.textContent = `Confirmation code: ${code}`;
    }
    window.history.replaceState({}, "", "/thank-you/");
  }
</script>

<style>
  .confirmation {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    background: var(--ac-color-warm-white);
  }

  .confirmation__layout {
    display: grid;
    gap: var(--ac-space-7);
  }

  .confirmation__record {
    border-top: 3px solid var(--ac-color-navy-900);
    padding-top: var(--ac-space-5);
  }

  .confirmation__eyebrow,
  .confirmation__next-label,
  .confirmation__status {
    margin: 0;
    color: var(--ac-color-navy-800);
    font-family: var(--ac-font-sans);
    font-size: var(--ac-text-label-chip);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .confirmation__status {
    width: fit-content;
    margin-top: var(--ac-space-6);
    border: 1px solid var(--ac-color-success);
    padding: 0.35rem 0.55rem;
    color: var(--ac-color-success);
  }

  .confirmation__status--neutral {
    border-color: var(--ac-color-ink-500);
    color: var(--ac-color-ink-500);
  }

  h1 {
    max-width: 18ch;
    margin: var(--ac-space-4) 0 0;
  }

  .confirmation__lead {
    max-width: 43rem;
    margin: var(--ac-space-5) 0 0;
    font-size: var(--ac-text-lead);
  }

  .confirmation__callback,
  .confirmation__reference {
    max-width: 43rem;
    margin: var(--ac-space-5) 0 0;
    border-left: 3px solid var(--ac-color-blue-500);
    padding-left: var(--ac-space-4);
    color: var(--ac-color-navy-900);
    font-weight: 700;
  }

  .confirmation__boundary {
    max-width: 43rem;
    margin-top: var(--ac-space-7);
    border-top: 1px solid var(--ac-color-rule);
    padding-top: var(--ac-space-4);
  }

  .confirmation__boundary p {
    margin: var(--ac-space-2) 0 0;
  }

  .confirmation__next {
    align-self: start;
    border: 1px solid var(--ac-color-steel-300);
    padding: var(--ac-space-5);
    background: var(--ac-color-paper);
  }

  .confirmation__next h2 {
    margin: var(--ac-space-3) 0 0;
  }

  /* Replaced the 01/02/03 rail: §9.15.5 supplies a single connective body paragraph for
     this slot, and no approved copy exists for the three step strings. */
  .confirmation__next-body {
    margin: var(--ac-space-4) 0 0;
    border-top: 1px solid var(--ac-color-rule);
    padding-top: var(--ac-space-4);
  }

  .confirmation__next a,
  .confirmation__next small {
    display: block;
    margin-top: var(--ac-space-4);
  }

  @media (min-width: 60rem) {
    .confirmation__layout {
      grid-template-columns: minmax(0, 7fr) minmax(18rem, 4fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>

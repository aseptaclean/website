---
// Locked contact layout; supplied copy remains provisional. See installation checklist.
import BaseLayout from "@layouts/BaseLayout.astro";
import AcCompactForm from "@components/ac/AcCompactForm.astro";
import Icon from "@components/estate/EstateLandingIcon.astro";
import { contactPage } from "@data/doc27CompanyPages";
import { site, legal } from "@data/site";
import "@styles/contact-kit.css";
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "Contact",
        item: new URL("/contact/", site.urls.site).href
      }
    ]
  }
];
---
<BaseLayout title={contactPage.seoTitle} description={contactPage.metaDescription} canonicalPath="/contact/" schema={schema} contactKit showMobileCta={false}>

<section class="contact-open-heading"><div class="wrap"><p class="eyebrow">Aseptaclean · Contact</p><h1 class="ac-type-contact-h1">Let’s talk about your property.</h1><p>Tell us what needs attention. We’ll help you understand the next step.</p></div></section>
<section class="contact-open-body" id="contact-inquiry"><div class="wrap contact-open-grid"><div class="contact-open-form"><h2 class="ac-type-contact-h2" id="contact-form-title">Send an inquiry</h2><AcCompactForm formId="contact-form" entryRoute="/contact/" tone="light" headingId="contact-form-title" contactKit /></div><aside class="contact-open-details"><div class="contact-open-block"><p class="eyebrow">Prefer to call?</p><a class="contact-open-phone" href={site.business.phoneUri}>{site.business.phone} <Icon name="arrow-up-right" /></a><p>Talk through the property, the cleanup,<br/>and your questions.</p></div><div class="contact-open-block"><h3 class="ac-type-contact-h3">Hours</h3><p>{site.business.hours}</p></div><div class="contact-open-block"><h3 class="ac-type-contact-h3">Service area</h3><p>South Bay &amp; Peninsula</p><p class="contact-open-small">Share the property ZIP code to confirm coverage.</p></div><div class="contact-open-block contact-open-next"><h3 class="ac-type-contact-h3">What happens next?</h3><p>We discuss what you need and whether an assessment is the next step.</p><p>You review the proposed scope and price before work begins.</p></div></aside></div></section>

<footer slot="footer"><div class="wrap contact-open-footer"><div><a class="brand" href="/">Aseptaclean</a><p>© 2026 Aseptaclean. All rights reserved.</p></div><a href="/">Back to main website ↗</a></div><div class="wrap contact-legal"><div class="contact-legal-links" aria-label="Legal and preferences">
<a href={site.urls.privacyPolicy}>Privacy Policy</a><a href={site.urls.terms}>Terms &amp; Conditions</a><a href={site.urls.cookiePolicy}>Cookie Policy</a>
{site.integrations.termly.consentEnabled && <button type="button" class="termly-display-preferences">Cookie Preferences</button>}
</div><p><span data-nosnippet>Aseptaclean is not a licensed general contractor, remediation contractor, pest-control operator, or appraiser.</span></p><p><span data-nosnippet>{legal.scopeDisclaimer} {legal.documentationDisclaimer}</span></p></div></footer>
</BaseLayout>

---
// doc 19 §2.2 CONTACT + §3.6 wireframe. Public phone number only (NAP law) — same
// site.business.phone used everywhere else (footer, header, ribbon). No street address:
// site.business.addressPolicy is "service-area business — no published street address",
// so the map slot is a labeled placeholder rather than an embed built on a fabricated pin.
// Title, meta, eyebrow, H1, and lead migrated to docs/27-COPY-CANONICAL.md §17.5 on
// 2026-08-16. Layout and the contact-details/map-placeholder composition below are unchanged.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import RequestForm from "@components/RequestForm.astro";
import { contactPage } from "@data/doc27CompanyPages";
import { site } from "@data/site";

const phoneHref = site.business.phoneUri;
const smsHref = site.business.smsUri;
const pin =
  '<path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>';

const schema = [
  {
    "@type": "LocalBusiness",
    "@id": new URL("/#business", site.urls.site).href,
    name: site.business.name,
    url: site.urls.site,
    email: site.business.email,
    ...(site.business.phone ? { telephone: site.business.phone } : {}),
    areaServed: site.location.cities.map((name) => ({ "@type": "City", name }))
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Contact",
        item: new URL("/contact/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={contactPage.seoTitle}
  description={contactPage.metaDescription}
  canonicalPath={contactPage.slug}
  schema={schema}
>
  <PageHeader
    headingId="contact-title"
    eyebrow={contactPage.eyebrow}
    h1={contactPage.h1}
    lede={contactPage.lead}
    crumb="Contact"
  />

  {/* 2026-08-18 visual port. docs/mockups/page-contact.html .contactgrid / .cbox — the three
      contact cards are doc 27 §17.5's Call / Text photos / Service area set, and rendering them
      is what finally lands `callNote`, `textNote` and `serviceAreaNote`, which existed in
      src/data/doc27CompanyPages.ts but had no render site. `textNote` carries §9.15.2
      amendment 5 ("Stand in the doorway…"), so that amendment ships with this section.

      The city list below was a pill list. Owner ruling 5 scopes the pill treatment to section
      labels and forbids it as a LIST MARKER, so it is now the mockup's .ac-iconrow, matching
      the homepage's where-we-work row. */}
  <section class="ac-sec ac-sec--tight contact-info" aria-labelledby="contact-info-title">
    <div class="ac-shell">
      <h2 id="contact-info-title" class="visually-hidden">Contact details</h2>

      <div class="ac-contactgrid">
        {phoneHref && (
          <div class="ac-cbox">
            <b>Call</b>
            <strong><a href={phoneHref}>{site.business.phone}</a></strong>
            <p>{contactPage.callNote}</p>
            <p class="cbox__hours">{site.business.hours}</p>
          </div>
        )}

        {smsHref && (
          <div class="ac-cbox">
            <b>Text photos</b>
            <strong><a href={smsHref}>{site.business.phone}</a></strong>
            <p>{contactPage.textNote}</p>
          </div>
        )}

        <div class="ac-cbox">
          <b>Email</b>
          <strong class="cbox__email">
            <a href={`mailto:${site.business.email}`}>{site.business.email}</a>
          </strong>
          <p>Assessment requests are reviewed {site.offer.responseTime}.</p>
        </div>
      </div>

      <div class="contact-area">
        <h3 class="ac-hdr-lite ac-type-label-head">Service area</h3>
        <ul class="ac-iconrow">
          {site.location.cities.map((city) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={pin} />
              {city}
            </li>
          ))}
        </ul>
        <p class="ac-note-strip contact-area__note">
          {contactPage.serviceAreaNote} {site.business.addressPolicy}.
        </p>
      </div>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .contact-info {
    background: var(--ac-color-paper);
  }

  .ac-cbox strong a {
    color: inherit;
    text-decoration: none;
  }

  .cbox__email {
    font-size: 1rem;
    word-break: break-word;
  }

  .cbox__hours {
    margin-top: 8px;
    color: var(--ac-color-ink-400);
    font-size: 0.8125rem;
  }

  .contact-area {
    margin-top: 56px;
  }

  .contact-area .ac-iconrow {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-area .ac-iconrow li {
    max-width: none;
  }

  .contact-area__note {
    margin-top: 24px;
  }
</style>

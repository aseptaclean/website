---
import BaseLayout from "@layouts/BaseLayout.astro";
import LegalPolicy from "@components/LegalPolicy.astro";
import PageHeader from "@components/PageHeader.astro";
import { site } from "@data/site";

const policy = site.integrations.termly.policies.cookie;
// The Cookie Policy ID is wired in Termly but intentionally held: the current
// version was scanned against the old WordPress site and is wrong. It stays
// disabled until it is regenerated against the live site post-deploy, at
// which point it is re-enabled together with the consent banner (the same
// flag gates both) — see docs/05-DECISIONS-LOG.md.
const cookiePolicyPublished = site.integrations.termly.consentEnabled;

// A5 — BreadcrumbList. This route had none; every other non-root route on the site does, and a
// crumb trail is how a leaf page tells a crawler where it sits. The "Home" item uses
// `site.urls.home` (WITH the trailing slash) so it matches the homepage canonical exactly —
// `site.urls.site` is a bare origin and produced a second URL for the same page.
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.home },
      {
        "@type": "ListItem",
        position: 2,
        name: "Cookie Policy",
        item: new URL("/cookie-policy/", site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Cookie Policy | Aseptaclean"
  description="Read Aseptaclean’s Termly-managed Cookie Policy or access the provider fallback."
  canonicalPath="/cookie-policy/"
  schema={schema}
  showMobileCta={false}
>
  <PageHeader
    headingId="cookie-title"
    eyebrow="Legal record · Managed by Termly"
    h1={"Cookie Policy"}
    lede={"This page is an integration surface for Aseptaclean’s provider-controlled policy document. Aseptaclean does not replace the provider’s published policy with locally drafted legal text."}
    crumb="Cookie Policy"
  />

  <div class="legal-body">
    <LegalPolicy
      title="Cookie Policy"
      label="Cookie Policy"
      policyId={cookiePolicyPublished ? policy.id : ""}
      hostedUrl={cookiePolicyPublished ? policy.hostedUrl : ""}
    />
  </div>
</BaseLayout>

<style>
  /* Mockup template-legal.html body shell — 820px, narrower than the 1200px page shell. */
  .legal-body {
    padding-block: 68px;
  }

  /* `.legal-body` is a div, so the `main > section` mobile step does not reach it. */
  @media (max-width: 760px) {
    .legal-body {
      padding-block: 60px;
    }
  }

  .legal-body :global(.legal-policy) {
    max-width: 820px;
  }
</style>

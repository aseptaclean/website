---
// COOKIE POLICY — docs/page-briefs/COOKIE.md. The readable policy page does not replace the
// banner or the consent settings: the working Cookie Settings control lives in the footer
// (Footer.astro, `.termly-display-preferences`) and reopens the provider's preference manager.
//
// The policy id is gated on the same consent flag as the banner, because the two are configured
// together in the provider. That gate is a real integration state, not a styling decision.
import AcLegalPage from "@components/ac/AcLegalPage.astro";
import { site } from "@data/site";

const policy = site.integrations.termly.policies.cookie;
const published = site.integrations.termly.consentEnabled;
---

<AcLegalPage
  label="Cookie Policy"
  headingId="cookie-title"
  canonicalPath="/cookie-policy/"
  seoTitle="Cookie Policy | Aseptaclean"
  seoDescription="How Aseptaclean uses cookies, and how to change your cookie preferences."
  policyId={published ? policy.id : ""}
  hostedUrl={published ? policy.hostedUrl : ""}
>
  <p class="cookie-settings">
    You can change your choices at any time using the <strong>Cookie Preferences</strong> link in
    the footer of any page.
  </p>
</AcLegalPage>

<style>
  .cookie-settings {
    margin: 28px 0 0;
    color: var(--ac-color-ink-600);
    font-size: var(--ac-text-body);
    line-height: 1.65;
  }
</style>

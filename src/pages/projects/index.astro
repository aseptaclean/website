---
// Built 2026-08-16 from docs/27-COPY-CANONICAL.md §17.2, per docs/SITEMAP-MASTER.md's Company
// row ("/projects/ | Projects | publishes when real photos exist | 27 §22").
//
// This page deliberately contains NO project photographs, case studies, counts, or before/after
// images — none exist, and AGENTS.md §0.3 says an empty proof slot ships empty rather than
// fake. Doc 27 §17.2's own copy is written for exactly that state: it describes project TYPES
// and states the publication standard a future case study must meet. When real, permissioned
// photography exists, doc 27 §22 governs what a published project record must contain.
//
// Building this route required removing the `/projects/* / 301` splat rule from
// public/_redirects — Cloudflare Pages applies _redirects before checking for a real asset, so
// leaving it would have 301'd this page away. See docs/05-DECISIONS-LOG.md.
import BaseLayout from "@layouts/BaseLayout.astro";
import CompactHero from "@components/CompactHero.astro";
import RequestForm from "@components/RequestForm.astro";
import { projectsPage } from "@data/doc27CompanyPages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: new URL(projectsPage.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title={projectsPage.seoTitle}
  description={projectsPage.metaDescription}
  canonicalPath={projectsPage.slug}
  schema={schema}
>
  <CompactHero eyebrow={projectsPage.eyebrow} headingId="projects-title">
    <h1 id="projects-title" class="ac-type-h1">{projectsPage.h1}</h1>
    <p class="compact-hero__lead">{projectsPage.lead}</p>
  </CompactHero>

  <section class="types" aria-labelledby="types-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">Project types</p>
      <h2 id="types-title" class="ac-type-h2 types__heading">{projectsPage.h2}</h2>
      <ul class="types__list">
        {projectsPage.projectTypes.map((type) => <li>{type}</li>)}
      </ul>
    </div>
  </section>

  <section class="standard" aria-labelledby="standard-title">
    <div class="ac-measure-intimate">
      <p class="ac-eyebrow">Publication standard</p>
      <h2 id="standard-title" class="ac-type-h2 standard__heading">
        {projectsPage.publicationStandardHeading}
      </h2>
      {projectsPage.publicationStandardBody.map((p) => <p class="standard__body">{p}</p>)}
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .types {
    background: var(--ac-color-paper);
  }

  .types__heading {
    max-width: 32ch;
    margin-top: var(--ac-space-3);
  }

  .types__list {
    display: grid;
    gap: var(--ac-space-3);
    max-width: 60rem;
    margin: var(--ac-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .types__list li {
    border-top: 1px solid var(--ac-color-line);
    padding-top: 12px;
    color: var(--ac-color-ink-600);
    font-size: 0.96rem;
  }

  .standard {
    background: var(--ac-color-warm-white);
    border-top: 1px solid var(--ac-color-line);
  }

  .standard__heading {
    max-width: 30ch;
    margin-top: var(--ac-space-3);
  }

  .standard__body {
    max-width: 58ch;
    margin-top: var(--ac-space-4);
    color: var(--ac-color-ink-600);
  }

  @media (min-width: 40rem) {
    .types__list {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--ac-space-6);
    }
  }
</style>

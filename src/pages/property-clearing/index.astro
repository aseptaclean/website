---
// UNPUBLISHED DRAFT — added 2026-08-16 per docs/SITEMAP-MASTER.md ("Property Clearing" category
// hub, index status, copy source doc 27 §10.3). Ships noindex, excluded from sitemap.xml.ts, not
// linked from nav/footer — same pre-launch pattern as every other page in this batch. Card titles
// are verbatim doc 27 §10.3; "Property Cleanouts" links to propertyManagersPage.slug (the page
// renamed to /property-cleanouts-san-jose/ this same session — see servicePages.ts), "Hoarding
// Cleanup" and "Estate Cleanouts" link to their built pages. Debris Removal and Eviction
// Cleanouts aren't built yet, so they render as plain, unlinked text rather than a dead link.
// Senior Downsizing is grouped under Property Clearing in docs/SITEMAP-MASTER.md but doesn't
// appear in doc 27 §10.3's card list — omitted here to stay verbatim to doc 27 hub copy per the
// task directive; see docs/05-DECISIONS-LOG.md.
import BaseLayout from "@layouts/BaseLayout.astro";
import CompactHero from "@components/CompactHero.astro";
import RequestForm from "@components/RequestForm.astro";
import { propertyClearingHub, hubClose } from "@data/servicePages";
import { site } from "@data/site";

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.urls.site },
      {
        "@type": "ListItem",
        position: 2,
        name: "Property Clearing",
        item: new URL(propertyClearingHub.slug, site.urls.site).href
      }
    ]
  }
];
---

<BaseLayout
  title="Property Clearing | San Jose | Aseptaclean"
  description="Property cleanouts, hoarding cleanup, and estate cleanouts — one written scope, one accountable operator, one documented closeout. San Jose & the South Bay."
  canonicalPath={propertyClearingHub.slug}
  noindex={true}
  schema={schema}
>
  <CompactHero eyebrow={propertyClearingHub.eyebrow} headingId="clearing-title">
    <h1 id="clearing-title">{propertyClearingHub.h1}</h1>
    <p class="compact-hero__lead">{propertyClearingHub.lead}</p>
  </CompactHero>

  <section class="cards" aria-labelledby="cards-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">By service</p>
      <h2 id="cards-title" class="ac-type-h2 cards__heading">Choose the page that matches the situation</h2>
      <div class="cards__grid">
        {
          propertyClearingHub.cards.map((card) =>
            card.href ? (
              <a class="card-tile" href={card.href}>
                <h3 class="ac-type-h3">{card.title}</h3>
                <span class="card-tile__cta">See the service page →</span>
              </a>
            ) : (
              <div class="card-tile card-tile--pending">
                <h3 class="ac-type-h3">{card.title}</h3>
                <span class="card-tile__cta">Page in development</span>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <section class="hub-close" aria-labelledby="hub-close-title">
    <div class="ac-measure-wide">
      <p class="ac-eyebrow">{hubClose.label}</p>
      <h2 id="hub-close-title" class="ac-type-h2 hub-close__heading">{hubClose.heading}</h2>
      <p class="hub-close__body">{hubClose.body}</p>
    </div>
  </section>

  <RequestForm />
</BaseLayout>

<style>
  .cards {
    background: var(--ac-color-paper);
  }

  .cards__heading {
    max-width: 36ch;
    margin-top: var(--ac-space-3);
  }

  .cards__grid {
    display: grid;
    gap: var(--ac-space-5);
    margin-top: var(--ac-space-6);
  }

  .card-tile {
    display: block;
    border-top: 2px solid var(--ac-color-navy-900);
    padding-top: 16px;
    color: inherit;
    text-decoration: none;
  }

  .card-tile h3 {
    margin-bottom: 8px;
  }

  .card-tile__cta {
    color: var(--ac-color-navy-800);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .card-tile:hover .card-tile__cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-tile--pending {
    border-top-color: var(--ac-color-line);
  }

  .card-tile--pending .card-tile__cta {
    color: var(--ac-color-ink-400);
    font-weight: 500;
  }

  .hub-close {
    background: var(--ac-color-warm-white);
    border-top: 1px solid var(--ac-color-line);
  }

  .hub-close__heading {
    max-width: 30ch;
    margin-top: var(--ac-space-3);
  }

  .hub-close__body {
    max-width: 56ch;
    margin-top: var(--ac-space-4);
    color: var(--ac-color-ink-600);
  }

  @media (min-width: 40rem) {
    .cards__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
